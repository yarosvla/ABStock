@page "/trading"
@layout CreateAssetLayout
@rendermode InteractiveServer
@using ABStock.Application.Simulation
@using ABStock.Shared
@implements IDisposable
@inject ISimulationRunner SimulationRunner

<PageTitle>Торги</PageTitle>

<div class="trading-shell">
    <nav class="top-navigation" aria-label="Основная навигация">
        <a class="brand" href="/" aria-label="ABStock">
            <span class="brand-mark" aria-hidden="true">
                <img src="images/abstock-logo.png" alt="" />
            </span>
            <span class="brand-name">ABStock</span>
        </a>

        <div class="nav-links" aria-label="Разделы">
            <a href="/create-asset">Создание актива</a>
            <a class="active" href="/trading">Торги</a>
            <a href="/news">Новости</a>
            <a href="#agents-screen">Агенты</a>
            <a href="#profile-screen">Профиль</a>
        </div>

        <div class="nav-actions">
            <span class="market-status"><span aria-hidden="true"></span>Торги запущены</span>
            <span class="clock-chip"><i class="bi bi-clock" aria-hidden="true"></i>@Clock.Time</span>
            <span class="date-chip">@Clock.Date</span>
            <button class="icon-button" type="button" aria-label="Уведомления">
                <i class="bi bi-bell" aria-hidden="true"></i>
                <span class="notification-badge">3</span>
            </button>
            <button class="icon-button" type="button" aria-label="Настройки">
                <i class="bi bi-gear" aria-hidden="true"></i>
            </button>
            <button class="avatar-button" type="button" aria-label="Профиль пользователя">АК</button>
        </div>
    </nav>

    <main class="trading-main">
        <header class="page-heading">
            <div>
                <p class="breadcrumbs">
                    <a href="/create-asset">Создание актива</a>
                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                    <span>Торги</span>
                </p>
                <h1>Экран торгов</h1>
                <p>Торги по активу запущены. Следите за ценой, ликвидностью и последними сделками</p>
            </div>
        </header>

        <section class="trading-grid" aria-label="Рабочее место трейдера">
            <aside class="left-column">
                <section class="glass-card asset-card" aria-labelledby="asset-title">
                    <div class="asset-head">
                        <span class="asset-emblem" aria-hidden="true">
                            <i class="bi bi-lightning-charge-fill"></i>
                        </span>
                        <div>
                            <h2 id="asset-title">КвантЭнерго</h2>
                            <div class="asset-meta">
                                <span>KZEN</span>
                                <span>Акция</span>
                                <span>Энергетика</span>
                            </div>
                            <p class="asset-state"><i class="bi bi-check-circle-fill" aria-hidden="true"></i>Актив
                                создан</p>
                            </div>
                        </div>
                        <p class="asset-description">Инновационная энергетическая компания, разрабатывающая и внедряющая
                            системы накопления энергии нового поколения на основе квантовых технологий.</p>
                        </section>

                        <section class="glass-card parameter-card" aria-labelledby="parameters-title">
                            <h2 id="parameters-title">Параметры актива</h2>
                            <dl class="parameter-list">
                                @foreach (var parameter in AssetParameters)
                                {
                                    <div>
                                        <dt>@parameter.Label</dt>
                                        <dd class="@parameter.ValueClass">@parameter.Value</dd>
                                    </div>
                                }
                            </dl>
                        </section>
                    </aside>

                    <section class="center-column">
                        <div class="metrics-strip" aria-label="Ключевые рыночные показатели">
                            @foreach (var metric in MarketMetrics)
                            {
                                <article class="glass-card metric-card @metric.Accent">
                                    <span>@metric.Label</span>
                                    <strong>@metric.Value</strong>
                                    <small>@metric.Detail</small>
                                    @if (metric.Accent == "volume")
                                    {
                                        <svg class="volume-bars" viewBox="0 0 96 42" aria-hidden="true">
                                            @foreach (var bar in metric.Bars)
                                            {
                                                <rect x="@bar.X" y="@bar.Y" width="@bar.Width" height="@bar.Height" rx="2" />
                                            }
                                        </svg>
                                    }
                                    else
                                    {
                                        <svg class="sparkline-chart" viewBox="0 0 96 42" aria-hidden="true">
                                            <polygon points="@metric.Projection" />
                                            <polyline points="@metric.Sparkline" />
                                        </svg>
                                    }
                                </article>
                            }
                        </div>

                        @{
                            var chartData = ChartData;
                        }
                        <section class="glass-card chart-card" aria-labelledby="chart-title">
                            <div class="chart-toolbar">
                                <div class="chart-topline">
                                    <div class="timeframe-row" aria-label="Таймфрейм">
                                        @foreach (var item in Timeframes)
                                        {
                                            <button class="@(item == selectedTimeframe ? "active" : null)" type="button"
                                                    @onclick="() => SelectTimeframe(item)">@item</button>
                                        }
                                    </div>
                                    <span class="market-active"><i class="bi bi-record-circle"
                                                                       aria-hidden="true"></i>@chartData.MarketState</span>
                                    </div>

                                    <div class="chart-header">
                                        <h2 id="chart-title">КвантЭнерго · @selectedTimeframe · ABStock</h2>
                                        <dl>
                                            <div>
                                                <dt>ОТКР</dt>
                                                <dd>@chartData.Open</dd>
                                            </div>
                                            <div>
                                                <dt>МАКС</dt>
                                                <dd>@chartData.High</dd>
                                            </div>
                                            <div>
                                                <dt>МИН</dt>
                                                <dd>@chartData.Low</dd>
                                            </div>
                                            <div>
                                                <dt>ЗАКР</dt>
                                                <dd>@chartData.Close</dd>
                                            </div>
                                            <div>
                                                <dt></dt>
                                                <dd class="@chartData.ChangeClass">@chartData.Change</dd>
                                            </div>
                                        </dl>
                                    </div>
                                </div>

                                <div class="chart-stage">
                                    <svg class="price-chart" viewBox="0 0 960 430" role="img"
                                         aria-label="Свечной график цены КвантЭнерго">
                                        <defs>
                                            <linearGradient id="chartFill" x1="0" x2="0" y1="0" y2="1">
                                                <stop offset="0" stop-color="#122842" />
                                                <stop offset="0.54" stop-color="#0E1B2E" />
                                                <stop offset="1" stop-color="#09111F" />
                                            </linearGradient>
                                            <linearGradient id="chartGlow" x1="0" x2="1" y1="0" y2="0">
                                                <stop offset="0" stop-color="#7C5CFF" stop-opacity="0.18" />
                                                <stop offset="0.52" stop-color="#55C7FF" stop-opacity="0.1" />
                                                <stop offset="1" stop-color="#36D98A" stop-opacity="0.12" />
                                            </linearGradient>
                                        </defs>
                                        <rect width="960" height="430" fill="url(#chartFill)" />
                                        <rect x="@ChartPanelLeft" y="18" width="@ChartPanelWidth" height="332" rx="10"
                                              fill="url(#chartGlow)" />

                                        @foreach (var x in chartData.GridX)
                                        {
                                            <line class="grid-line vertical-grid-line" x1="@x" y1="@ChartPlotTop" x2="@x"
                                                  y2="@ChartPlotBottom" />
                                        }
                                        @foreach (var label in chartData.PriceLabels)
                                        {
                                            <line class="grid-line horizontal-grid-line" x1="@ChartPlotLeft" y1="@label.Y"
                                                  x2="@ChartPlotRight" y2="@label.Y" />
                                        }

                                        <line class="price-marker-line" x1="@ChartPlotLeft" y1="@chartData.LastPriceY"
                                              x2="@chartData.PlotRight" y2="@chartData.LastPriceY" />

                                        @foreach (var candle in chartData.Candles)
                                        {
                                            <g class="candle @(candle.IsUp ? "up" : "down")">
                                                <line x1="@candle.X" y1="@candle.HighY" x2="@candle.X" y2="@candle.LowY" />
                                                <rect x="@candle.BodyX" y="@candle.BodyY" width="@candle.BodyWidth"
                                                      height="@candle.BodyHeight" rx="1.5" />
                                            </g>
                                        }

                                        <g class="axis-labels">
                                            @foreach (var label in chartData.PriceLabels)
                                            {
                                                @SvgText(ChartAxisLabelX, label.Y, label.Text, "end")
                                            }
                                            @foreach (var label in chartData.TickLabels)
                                            {
                                                @SvgText(label.X, 377, label.Text, "middle")
                                            }
                                        </g>

                                        <g class="price-tag">
                                            <rect x="@chartData.PriceTagX" y="@chartData.PriceTagY" width="66" height="22" rx="7" />
                                            <text x="@chartData.PriceTagTextX"
                                                  y="@chartData.PriceTagTextY">@chartData.LastPrice</text>
                                        </g>
                                    </svg>
                                </div>

                                <footer class="chart-footer">
                                    <span>@chartData.UpdatedAt</span>
                                </footer>
                            </section>
                        </section>

                        <aside class="right-column">
                            @{
                                var orderBook = OrderBookData;
                            }
                            <section class="glass-card order-book" aria-labelledby="book-title">
                                <h2 id="book-title">Книга заявок</h2>
                                <div class="book-head">
                                    <span class="book-cell-price">Цена (₽)</span>
                                    <span class="book-cell-volume">Объём (шт.)</span>
                                    <span class="book-cell-total">Сумма (шт.)</span>
                                </div>

                                <div class="book-side sells">
                                    <svg class="book-depth-shape ask-depth" viewBox="0 0 300 125" preserveAspectRatio="none"
                                         aria-hidden="true">
                                        <path d="@orderBook.AskFillPath" />
                                        <path class="depth-line" d="@orderBook.AskLinePath" />
                                    </svg>
                                    @foreach (var row in orderBook.Asks)
                                    {
                                        <div class="book-row">
                                            <span class="book-row-depth" style="@row.DepthStyle"></span>
                                            <strong class="book-cell-price">@row.Price</strong>
                                            <span class="book-cell-volume">@row.Volume</span>
                                            <span class="book-cell-total">@row.Total</span>
                                        </div>
                                    }
                                </div>

                                <div class="spread-row">
                                    <i class="@Spread.Icon" aria-hidden="true"></i>
                                    <strong>@Spread.Value</strong>
                                    <span>@Spread.Detail</span>
                                </div>

                                <div class="book-side buys">
                                    <svg class="book-depth-shape bid-depth" viewBox="0 0 300 125" preserveAspectRatio="none"
                                         aria-hidden="true">
                                        <path d="@orderBook.BidFillPath" />
                                        <path class="depth-line" d="@orderBook.BidLinePath" />
                                    </svg>
                                    @foreach (var row in orderBook.Bids)
                                    {
                                        <div class="book-row">
                                            <span class="book-row-depth" style="@row.DepthStyle"></span>
                                            <strong class="book-cell-price">@row.Price</strong>
                                            <span class="book-cell-volume">@row.Volume</span>
                                            <span class="book-cell-total">@row.Total</span>
                                        </div>
                                    }
                                </div>
                            </section>

                            <section class="glass-card trades-card" aria-labelledby="trades-title">
                                <h2 id="trades-title">Последние сделки</h2>
                                <div class="trade-head">
                                    <span>Время</span>
                                    <span>Цена (₽)</span>
                                    <span>Объём (шт.)</span>
                                    <span>Участники</span>
                                </div>
                                @foreach (var trade in RecentTrades)
                                {
                                    <div class="trade-row @trade.SideClass">
                                        <span>@trade.Time</span>
                                        <strong>@trade.Price</strong>
                                        <span>@trade.Volume</span>
                                        <em>@trade.Side</em>
                                    </div>
                                }
                            </section>
                        </aside>

                        @{
                            var status = Status;
                        }
                        <section class="glass-card status-strip" aria-label="Показатели рынка">
                            <div class="status-metric">
                                <small>С момента запуска</small>
                                <strong class="positive">@status.Elapsed</strong>
                            </div>
                            <div class="status-metric">
                                <small>Количество сделок</small>
                                <strong>@status.TradeCount</strong>
                            </div>
                            <div class="status-metric">
                                <small>Участников</small>
                                <strong>@status.Participants</strong>
                            </div>
                            <div class="status-metric status-range">
                                <small>Дневной диапазон</small>
                                <strong>@status.Range</strong>
                                <div class="range-track" aria-hidden="true">
                                    <span></span>
                                    <i style="@status.RangeMarkerStyle"></i>
                                </div>
                            </div>
                            <div class="status-metric">
                                <small>Ликвидность</small>
                                <strong class="@status.LiquidityClass">@status.Liquidity</strong>
                                <span>@status.LiquidityDetail</span>
                            </div>

                            <a class="portfolio-button" href="/news">
                                <i class="bi bi-newspaper" aria-hidden="true"></i>
                                <span>Добавить новость</span>
                            </a>
                        </section>
                    </section>
                </main>
            </div>

@code {
    private static readonly string[] Timeframes = ["1м", "5м", "15м", "1ч", "4ч", "1д"];
    private const decimal DemoStartPrice = 124.35m;
    private const double ChartPanelLeft = 18;
    private const double ChartPanelWidth = 906;
    private const double ChartPlotLeft = 34;
    private const double ChartPlotRight = 884;
    private const double ChartAxisLabelX = 914;
    private const double ChartPlotTop = 28;
    private const double ChartPlotBottom = 336;
    private const double ChartPlotHeight = ChartPlotBottom - ChartPlotTop;
    private const int MetricHistoryLimit = 24;

    private MarketMetric[] MarketMetrics => BuildMarketMetrics(latestTick);

    private OrderBookViewData OrderBookData => BuildOrderBookData(latestTick?.OrderBook);

    private SpreadData Spread => BuildSpreadData(latestTick);

    private StatusStripData Status => BuildStatusStripData(latestTick);

    private ClockData Clock => BuildClockData();

    private TradeRow[] RecentTrades => BuildTradeRows(latestTick?.Snapshot.RecentTrades ?? []);

    private static readonly AssetParameter[] AssetParameters =
    [
        new("Тип актива", "Акция", null),
        new("Сектор", "Энергетика", null),
        new("Валюта торгов", "RUB", null),
        new("Шаг цены", "0.05 ₽", null),
        new("Капитализация (оценка)", "12.43 млрд ₽", null),
        new("Количество акций", "100 000 000", null),
        new("Дата создания", "23.05.2025", null),
        new("Статус", "Актив создан", "positive")
    ];

    private string selectedTimeframe = "5м";
    private SimulationTickResult? latestTick;
    private CancellationTokenSource? simulationCts;
    private DateTimeOffset lastChartUpdate = DateTimeOffset.Now;
    private DateTimeOffset startedAt = DateTimeOffset.Now;
    private decimal previousVolume;
    private readonly HashSet<Guid> seenTradeIds = [];
    private readonly List<decimal> priceMetricHistory = [DemoStartPrice];
    private readonly List<decimal> bidMetricHistory = [DemoStartPrice];
    private readonly List<decimal> askMetricHistory = [DemoStartPrice];
    private readonly List<decimal> volumeMetricHistory = [0m];

    private PriceChartData ChartData => BuildPriceChartData(latestTick, selectedTimeframe, lastChartUpdate);

    private void SelectTimeframe(string timeframe)
    {
        selectedTimeframe = timeframe;
    }

    protected override void OnInitialized()
    {
        SimulationRunner.OnTick += HandleTick;
        latestTick = SimulationRunner.Current;

        _ = RunSimulationAsync();
    }

    private async Task RunSimulationAsync()
    {
        await SimulationRunner.StartAsync(CreateDemoConfig());
    }

    private void HandleTick(SimulationTickResult tickResult)
    {
        latestTick = tickResult;
        lastChartUpdate = DateTimeOffset.Now;
        UpdateMetricHistory(tickResult);
        _ = InvokeAsync(StateHasChanged);
    }

    private static SimulationConfig CreateDemoConfig() =>
        new(
            "КвантЭнерго",
            "Демо-актив для проверки связки UI, Application и Exchange.",
            AssetType.Stock,
            DemoStartPrice,
            TimeSpan.FromSeconds(1),
            [
                new AgentSpec(AgentType.MarketMaker, 100_000m, 100m),
                new AgentSpec(AgentType.TrendFollowing, 100_000m, 50m),
                new AgentSpec(AgentType.CounterTrend, 100_000m, 50m),
                new AgentSpec(AgentType.NewsDriven, 100_000m, 50m)
            ]);

    private void UpdateMetricHistory(SimulationTickResult tickResult)
    {
        var snapshot = tickResult.Snapshot;
        var volumeDelta = Math.Max(0m, snapshot.Volume - previousVolume);
        previousVolume = snapshot.Volume;

        AppendMetricValue(priceMetricHistory, snapshot.LastPrice);
        AppendMetricValue(volumeMetricHistory, volumeDelta);

        if (snapshot.BestBid is not null)
        {
            AppendMetricValue(bidMetricHistory, snapshot.BestBid.Value);
        }

        if (snapshot.BestAsk is not null)
        {
            AppendMetricValue(askMetricHistory, snapshot.BestAsk.Value);
        }

        foreach (var trade in snapshot.RecentTrades)
        {
            seenTradeIds.Add(trade.Id);
        }
    }

    private static void AppendMetricValue(List<decimal> values, decimal value)
    {
        values.Add(value);
        if (values.Count > MetricHistoryLimit)
        {
            values.RemoveRange(0, values.Count - MetricHistoryLimit);
        }
    }

    private MarketMetric[] BuildMarketMetrics(SimulationTickResult? tickResult)
    {
        var snapshot = tickResult?.Snapshot;
        var bestBidQuantity = tickResult?.OrderBook.Bids.FirstOrDefault()?.Quantity ?? 0m;
        var bestAskQuantity = tickResult?.OrderBook.Asks.FirstOrDefault()?.Quantity ?? 0m;
        var lastPrice = snapshot?.LastPrice ?? DemoStartPrice;
        var bestBid = snapshot?.BestBid;
        var bestAsk = snapshot?.BestAsk;
        var volume = snapshot?.Volume ?? 0m;
        var tradeCount = snapshot?.RecentTrades.Count ?? 0;
        var priceAccent = GetChangeClass(priceMetricHistory);
        var bidAccent = GetChangeClass(bidMetricHistory);
        var askAccent = GetChangeClass(askMetricHistory);

        return
        [
            new("Текущая цена", FormatMoney(lastPrice), tickResult is null ? "ожидание тика" : $"Тик {tickResult.Tick}",
priceAccent, BuildSparkline(priceMetricHistory), BuildArea(priceMetricHistory), []),
            new("Лучший bid", FormatNullableMoney(bestBid), $"{FormatQuantity(bestBidQuantity)} шт.", bidAccent,
BuildSparkline(bidMetricHistory), BuildArea(bidMetricHistory), []),
            new("Лучший ask", FormatNullableMoney(bestAsk), $"{FormatQuantity(bestAskQuantity)} шт.", askAccent,
BuildSparkline(askMetricHistory), BuildArea(askMetricHistory), []),
            new("Объём торгов", FormatQuantity(volume), $"{tradeCount} сделок", "volume", "", "",
BuildVolumeBars(volumeMetricHistory))
        ];
    }

    private static OrderBookViewData BuildOrderBookData(OrderBookSnapshot? orderBook)
    {
        var asks = orderBook?.Asks ?? [];
        var bids = orderBook?.Bids ?? [];

        return new OrderBookViewData(
            BuildOrderBookRows(asks),
            BuildOrderBookRows(bids),
            BuildDepthFillPath(asks, false),
            BuildDepthLinePath(asks, false),
            BuildDepthFillPath(bids, true),
            BuildDepthLinePath(bids, true));
    }

    private static OrderBookRow[] BuildOrderBookRows(IReadOnlyList<OrderBookLevel> levels)
    {
        var maxQuantity = levels.Count == 0 ? 0m : levels.Max(level => level.Quantity);
        var total = 0m;

        return levels
            .Take(5)
            .Select(level =>
            {
                total += level.Quantity;
                var depth = CalculateDepth(level.Quantity, maxQuantity);

                return new OrderBookRow(
                    FormatPrice(level.Price),
                    FormatQuantity(level.Quantity),
                    FormatQuantity(total),
                    depth,
                    $"width: {depth}%");
            })
            .ToArray();
    }

    private static TradeRow[] BuildTradeRows(IReadOnlyList<Trade> trades) =>
        trades
            .OrderByDescending(trade => trade.ExecutedAt)
            .Take(8)
            .Select(trade => new TradeRow(
                trade.ExecutedAt.ToLocalTime().ToString("HH:mm:ss"),
                FormatPrice(trade.Price),
                FormatQuantity(trade.Quantity),
                FormatTradeParticipants(trade.BuyerAgentName, trade.SellerAgentName),
                GetTradeClass(trade)))
            .ToArray();

    private SpreadData BuildSpreadData(SimulationTickResult? tickResult)
    {
        var snapshot = tickResult?.Snapshot;
        if (snapshot?.BestBid is null || snapshot.BestAsk is null)
        {
            return new SpreadData("bi bi-dash", FormatMoney(snapshot?.LastPrice ?? DemoStartPrice), "Спред недоступен");
        }

        var spread = snapshot.BestAsk.Value - snapshot.BestBid.Value;
        var mid = (snapshot.BestAsk.Value + snapshot.BestBid.Value) / 2m;
        var spreadPercent = mid == 0m ? 0m : spread / mid * 100m;

        return new SpreadData(
            spread <= 0m ? "bi bi-caret-left-fill" : "bi bi-arrows-collapse",
            FormatMoney(snapshot.LastPrice),
            $"Спред {FormatPrice(spread)} ₽ ({spreadPercent:0.00}%)");
    }

    private StatusStripData BuildStatusStripData(SimulationTickResult? tickResult)
    {
        var snapshot = tickResult?.Snapshot;
        var prices = snapshot?.RecentPrices.Count > 0
            ? snapshot.RecentPrices
            : [DemoStartPrice];
        var low = prices.Min();
        var high = prices.Max();
        var last = snapshot?.LastPrice ?? DemoStartPrice;
        var rangePosition = high == low ? 50 : (int)Math.Round((last - low) / (high - low) * 100m);
        var spread = BuildSpreadData(tickResult);
        var bidDepth = tickResult?.OrderBook.Bids.Sum(level => level.Quantity) ?? 0m;
        var askDepth = tickResult?.OrderBook.Asks.Sum(level => level.Quantity) ?? 0m;
        var totalDepth = bidDepth + askDepth;
        var liquidity = GetLiquidity(tickResult, totalDepth);
        var elapsed = DateTimeOffset.Now - startedAt;

        return new StatusStripData(
            elapsed.ToString(@"hh\:mm\:ss"),
            FormatQuantity(seenTradeIds.Count),
            FormatQuantity(tickResult?.Agents.Count ?? 0),
            $"{FormatMoney(low)} - {FormatMoney(high)}",
            $"left: {Math.Clamp(rangePosition, 0, 100)}%",
            liquidity.Label,
            liquidity.ClassName,
            $"{spread.Detail}; глубина {FormatQuantity(totalDepth)} шт.");
    }

    private static ClockData BuildClockData()
    {
        var now = DateTimeOffset.Now;
        return new ClockData(now.ToString("HH:mm:ss"), $"{now.Day} {GetRussianMonthName(now.Month)} {now.Year}");
    }

    private static string FormatNullableMoney(decimal? value) => value is null ? "-" : FormatMoney(value.Value);

    private static string FormatMoney(decimal value) => $"{value:F2} ₽";

    private static string FormatPrice(decimal value) => value.ToString("F2");

    private static string FormatQuantity(decimal value) => value % 1m == 0m
        ? value.ToString("0")
        : value.ToString("0.##");

    private static int CalculateDepth(decimal quantity, decimal maxQuantity)
    {
        if (maxQuantity <= 0m)
        {
            return 0;
        }

        var depth = (int)Math.Ceiling((double)(quantity / maxQuantity * 100m));
        return Math.Clamp(depth, 8, 100);
    }

    private static string GetChangeClass(IReadOnlyList<decimal> values)
    {
        if (values.Count < 2)
        {
            return "positive";
        }

        return values[^1] >= values[0] ? "positive" : "negative";
    }

    private static string BuildSparkline(IReadOnlyList<decimal> values)
    {
        if (values.Count == 0)
        {
            return "";
        }

        return string.Join(" ", BuildChartPoints(values, 6, 94, 5, 36)
            .Select(point => $"{FormatSvgNumber(point.X)},{FormatSvgNumber(point.Y)}"));
    }

    private static string BuildArea(IReadOnlyList<decimal> values)
    {
        var points = BuildSparkline(values);
        if (string.IsNullOrWhiteSpace(points))
        {
            return "";
        }

        var firstX = FormatSvgNumber(6);
        var lastX = FormatSvgNumber(94);
        return $"{firstX},42 {points} {lastX},42";
    }

    private static BarRect[] BuildVolumeBars(IReadOnlyList<decimal> values)
    {
        const int barCount = 9;
        const double width = 7;
        var source = values.Count == 0 ? [0m] : values.TakeLast(barCount).ToArray();
        var maxValue = Math.Max(source.Max(), 1m);
        var bars = new BarRect[barCount];
        var padCount = barCount - source.Length;

        for (var index = 0; index < barCount; index++)
        {
            var value = index < padCount ? 0m : source[index - padCount];
            var height = 6 + (double)(value / maxValue) * 30;
            var x = 4 + index * 10;
            bars[index] = new BarRect(x, 38 - height, width, height);
        }

        return bars;
    }

    private static Point[] BuildChartPoints(IReadOnlyList<decimal> values, double minX, double maxX, double minY, double
maxY)
    {
        var source = values.Count == 0 ? [0m] : values.ToArray();
        var minValue = source.Min();
        var maxValue = source.Max();
        var range = maxValue - minValue;
        var width = maxX - minX;
        var height = maxY - minY;

        if (source.Length == 1)
        {
            return [new Point((minX + maxX) / 2, (minY + maxY) / 2)];
        }

        return source
            .Select((value, index) =>
            {
                var x = minX + width * index / (source.Length - 1);
                var ratio = range == 0m ? 0.5 : (double)((value - minValue) / range);
                var y = maxY - height * ratio;
                return new Point(x, y);
            })
            .ToArray();
    }

    private static string BuildDepthFillPath(IReadOnlyList<OrderBookLevel> levels, bool isBid)
    {
        var linePath = BuildDepthLinePath(levels, isBid);
        return isBid
            ? $"{linePath} V125 H300 Z"
            : $"{linePath} V125 H0 Z";
    }

    private static string BuildDepthLinePath(IReadOnlyList<OrderBookLevel> levels, bool isBid)
    {
        if (levels.Count == 0)
        {
            return isBid ? "M300 0 H300" : "M0 0 H0";
        }

        var rows = levels.Take(5).ToArray();
        var rowHeight = 125d / rows.Length;
        var maxTotal = rows.Sum(level => level.Quantity);
        var cumulative = 0m;
        var segments = new List<string>();

        for (var index = 0; index < rows.Length; index++)
        {
            cumulative += rows[index].Quantity;
            var ratio = maxTotal == 0m ? 0d : (double)(cumulative / maxTotal);
            var x = isBid ? 286 - ratio * 226 : 14 + ratio * 226;
            var y = index * rowHeight + rowHeight / 2;

            if (index == 0)
            {
                segments.Add($"M{FormatSvgNumber(isBid ? 286 : 14)} {FormatSvgNumber(y)} L{FormatSvgNumber(x)} {FormatSvgNumber(y)}");
            }
            else
            {
                segments.Add($"L{FormatSvgNumber(x)} {FormatSvgNumber(y)}");
            }
        }

        return string.Join(" ", segments);
    }

    private static string GetTradeClass(Trade trade)
    {
        if (string.Equals(trade.BuyerAgentName, "MarketMaker", StringComparison.Ordinal))
        {
            return "sell";
        }

        return "buy";
    }

    private static string FormatTradeParticipants(string buyer, string seller) =>
        $"{FormatAgentName(buyer)} / {FormatAgentName(seller)}";

    private static string FormatAgentName(string agentName)
    {
        if (string.IsNullOrWhiteSpace(agentName))
        {
            return "-";
        }

        var compactName = agentName switch
        {
            "TrendFollowing" => "Trend",
            "CounterTrend" => "Counter",
            "MarketMaker" => "Maker",
            _ => null
        };

        if (compactName is not null)
        {
            return compactName;
        }

        var builder = new System.Text.StringBuilder(agentName.Length + 4);

        for (var index = 0; index < agentName.Length; index++)
        {
            var current = agentName[index];
            if (index > 0 &&
                char.IsUpper(current) &&
                (char.IsLower(agentName[index - 1]) ||
                 (index + 1 < agentName.Length && char.IsLower(agentName[index + 1]))))
            {
                builder.Append(' ');
            }

            builder.Append(current);
        }

        return builder.ToString();
    }

    private static (string Label, string ClassName) GetLiquidity(SimulationTickResult? tickResult, decimal totalDepth)
    {
        if (tickResult?.Snapshot.BestBid is null || tickResult.Snapshot.BestAsk is null)
        {
            return ("Нет данных", "");
        }

        var mid = (tickResult.Snapshot.BestBid.Value + tickResult.Snapshot.BestAsk.Value) / 2m;
        var spreadPercent = mid == 0m ? 100m : (tickResult.Snapshot.BestAsk.Value - tickResult.Snapshot.BestBid.Value) / mid *
100m;

        if (spreadPercent <= 0.5m && totalDepth >= 10m)
        {
            return ("Высокая", "positive");
        }

        if (spreadPercent <= 2m && totalDepth >= 4m)
        {
            return ("Средняя", "");
        }

        return ("Низкая", "negative");
    }

