    protected override async Task OnInitializedAsync()
    {
        SimulationRunner.OnTick += HandleTick;
        NewsFeed.Changed += HandleNewsFeedChanged;
        latestTick = SimulationRunner.Current;
        if (latestTick is not null)
        {
            PrimeFromSnapshot(latestTick, DateTimeOffset.Now);
            LoadPersistedCandles(selectedTimeframe, forceScrollToRealtime: true);
        }

        await EnsureSimulationAsync();
