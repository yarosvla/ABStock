    private sealed class AggregatedCandle
    {
        public AggregatedCandle(DateTimeOffset timestamp, decimal open, decimal high, decimal low, decimal close)
        {
            Timestamp = timestamp;
            Open = open;
            High = high;
            Low = low;
            Close = close;
        }

        public DateTimeOffset Timestamp { get; set; }
        public decimal Open { get; set; }
        public decimal High { get; set; }
        public decimal Low { get; set; }
        public decimal Close { get; set; }
    }

    private sealed class TimeframeSeriesState
    {
        public TimeframeSeriesState(TimeframeDefinition definition)
        {
            Definition = definition;
        }

        public TimeframeDefinition Definition { get; }
        public List<AggregatedCandle> Candles { get; } = [];
    }

    private sealed record BarRect(double X, double Y, double Width, double Height);
    private sealed record Point(double X, double Y);
}
