@page "/trading"
@layout CreateAssetLayout
@rendermode InteractiveServer
@using ABStock.Application.MarketHistory
@using ABStock.Application.Simulation.Diagnostics
@using ABStock.Application.Simulation
@using ABStock.Shared
@using ABStock.UI.Services
@using Microsoft.AspNetCore.Hosting
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Hosting
@implements IDisposable
@implements IAsyncDisposable
@inject ISimulationRunner SimulationRunner
@inject IMarketCandleReader CandleReader
@inject IServiceProvider Services
@inject IWebHostEnvironment Environment
@inject IJSRuntime JS
@inject IActiveAssetContext ActiveAssetContext
@inject ISimulationHistoryReader SimulationHistoryReader

<PageTitle>Торги</PageTitle>

<div class="trading-shell">
    <TopNavigation ActivePage="Trading" ShowClock="true" />

    <main class="trading-main">
        <header class="page-heading">
            <div>
                <p class="breadcrumbs">
                    <a href="/create-asset">Создание актива</a>
                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                    <span>Торги</span>
                </p>
                <h1>Экран торгов</h1>
                <p>Следите за ценой, ликвидностью и последними сделками по активу @CurrentAsset.Draft.Name</p>
            </div>
        </header>

        <section class="trading-grid" aria-label="Рабочее место трейдера">
            <div class="market-workspace">
                <aside class="left-column">
                    <section class="glass-card asset-card" aria-labelledby="asset-title">
                        <div class="asset-head">
                            <span class="asset-emblem" aria-hidden="true">
                                <i class="bi @AssetIconClass"></i>
                            </span>
                            <div>
                                <h2 id="asset-title">@CurrentAsset.Draft.Name</h2>
                                <div class="asset-meta">
                                    <span>@CurrentAsset.Symbol</span>
                                    <span>@GetAssetTypeLabel(CurrentAsset.Draft.AssetType)</span>
                                    <span>@CurrentAsset.Draft.Industry</span>
                                </div>
                                <p class="asset-state">
                                    <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                                    @(CurrentAsset.IsFallback ? "Демо-контекст" : "Актив синхронизирован")
                                </p>
                            </div>
                        </div>
                        <p class="asset-description">@CurrentAsset.Profile.Description</p>
                    </section>

                    <section class="glass-card parameter-card" aria-labelledby="parameters-title">
                        <h2 id="parameters-title">Параметры актива</h2>
                        <dl class="parameter-list">
                            @foreach (var parameter in AssetParameters)
                            {
                                <div>
                                    <dt>@parameter.Label</dt>
                                    <dd class="@parameter.ValueClass">@parameter.Value</dd>
                                </div>
                            }
                        </dl>
                    </section>
                </aside>

                <section class="center-column">
                    <div class="metrics-strip" aria-label="Ключевые рыночные показатели">
                        @foreach (var metric in MarketMetrics)
                        {
                            <article class="glass-card metric-card @metric.Accent">
                                <span>@metric.Label</span>
                                <strong>@metric.Value</strong>
                                <small>@metric.Detail</small>
                                @if (metric.Accent == "volume")
                                {
                                    <svg class="volume-bars" viewBox="0 0 96 42" aria-hidden="true">
                                        @foreach (var bar in metric.Bars)
                                        {
                                            <rect x="@bar.X" y="@bar.Y" width="@bar.Width" height="@bar.Height" rx="2" />
                                        }
                                    </svg>
                                }
                                else
                                {
                                    <svg class="sparkline-chart" viewBox="0 0 96 42" aria-hidden="true">
                                        <polygon points="@metric.Projection" />
                                        <polyline points="@metric.Sparkline" />
                                    </svg>
                                }
                            </article>
                        }
                    </div>

                    @{
                        var chartData = ChartSummary;
                    }
                    <section class="glass-card chart-card" aria-labelledby="chart-title">
                        <div class="chart-toolbar">
                            <div class="chart-topline">
                                <div class="timeframe-row" aria-label="Таймфрейм">
                                    @foreach (var item in Timeframes)
                                    {
                                        <button class="@(item.Key == selectedTimeframe ? "active" : null)" type="button"
                                                @onclick="() => SelectTimeframe(item.Key)">@item.Label</button>
                                    }
                                </div>
                                <span class="market-active"><i class="bi bi-record-circle"
                                                                   aria-hidden="true"></i>@chartData.MarketState</span>
                            </div>

                            <div class="chart-header">
                                <h2 id="chart-title">@CurrentAsset.Draft.Name · @selectedTimeframe · @CurrentAsset.Symbol</h2>
                                <dl>
                                    <div>
                                        <dt>ОТКР</dt>
                                        <dd>@chartData.Open</dd>
                                    </div>
                                    <div>
                                        <dt>МАКС</dt>
                                        <dd>@chartData.High</dd>
                                    </div>
                                    <div>
                                        <dt>МИН</dt>
                                        <dd>@chartData.Low</dd>
                                    </div>
                                    <div>
                                        <dt>ЗАКР</dt>
                                        <dd>@chartData.Close</dd>
                                    </div>
                                    <div>
                                        <dt></dt>
                                        <dd class="@chartData.ChangeClass">@chartData.Change</dd>
                                    </div>
                                </dl>
                            </div>
                        </div>

                        <div class="chart-stage-shell">
                            <button class="chart-live-reset" type="button" hidden>
                                <i class="bi bi-broadcast-pin" aria-hidden="true"></i>
                                Live
                            </button>
                            <div class="chart-stage"
                                 @ref="chartViewport"
                                 tabindex="0"
                                 aria-label="Свечной график цены @CurrentAsset.Draft.Name">
                                <div class="chart-surface" role="img" aria-label="Биржевой график цены @CurrentAsset.Draft.Name"></div>
                                <div class="chart-hover-legend" aria-live="polite">
                                    <span class="chart-hover-time" data-role="time">Нет данных</span>
                                    <div class="chart-hover-values">
                                        <span><small>O</small><strong data-role="open">-</strong></span>
                                        <span><small>H</small><strong data-role="high">-</strong></span>
                                        <span><small>L</small><strong data-role="low">-</strong></span>
                                        <span><small>C</small><strong data-role="close">-</strong></span>
                                    </div>
                                </div>
                                <div class="chart-empty-state">Нет данных</div>
                            </div>
                        </div>

                        <footer class="chart-footer">
                            <a class="chart-attribution"
                               href="https://www.tradingview.com/"
                               target="_blank"
                               rel="noreferrer noopener">
                                TradingView Lightweight Charts™ · Copyright (c) 2025 TradingView, Inc.
                            </a>
                            <span>@chartData.UpdatedAt</span>
                        </footer>
                    </section>
                </section>

                <aside class="right-column">
                    @{
                        var orderBook = OrderBookData;
                        var spread = Spread;
                    }
                    <section class="glass-card order-book" aria-labelledby="book-title">
                        <div class="panel-heading">
                            <div class="book-title-block">
                                <h2 id="book-title">Стакан</h2>
                                <p>Лучшие цены и глубина рынка</p>
                            </div>
                            <div class="book-spread-meta">
                                <strong>@spread.Value</strong>
                                <small>@spread.Detail</small>
                            </div>
                        </div>
                        <div class="book-head">
                            <span class="book-cell-price">Цена (₽)</span>
                            <span class="book-cell-volume">Объём (шт.)</span>
                            <span class="book-cell-total">Сумма (шт.)</span>
                        </div>

                        <div class="book-side sells">
                            @foreach (var row in orderBook.Asks)
                            {
                                <div class="book-row @(row.IsEmpty ? "empty" : null)">
                                    <span class="book-row-depth" style="@row.DepthStyle"></span>
                                    <strong class="book-cell-price">@row.Price</strong>
                                    <span class="book-cell-volume">@row.Volume</span>
                                    <span class="book-cell-total">@row.Total</span>
                                </div>
                            }
                        </div>

                        <div class="book-side buys">
                            @foreach (var row in orderBook.Bids)
                            {
                                <div class="book-row @(row.IsEmpty ? "empty" : null)">
                                    <span class="book-row-depth" style="@row.DepthStyle"></span>
                                    <strong class="book-cell-price">@row.Price</strong>
                                    <span class="book-cell-volume">@row.Volume</span>
                                    <span class="book-cell-total">@row.Total</span>
                                </div>
                            }
                        </div>
                    </section>

                    <section class="glass-card trades-card" aria-labelledby="trades-title">
                        <h2 id="trades-title">Последние сделки</h2>
                        <div class="trade-head">
                            <span>Время</span>
                            <span>Цена (₽)</span>
                            <span>Объём (шт.)</span>
                            <span>Контрагенты</span>
                        </div>
                        <div class="trade-list">
                            @foreach (var trade in RecentTrades)
                            {
                                <div class="trade-row @trade.SideClass">
                                    <span>@trade.Time</span>
                                    <strong>@trade.Price</strong>
                                    <span>@trade.Volume</span>
                                    <div class="trade-participants" title="@($"{trade.Buyer} / {trade.Seller}")">
                                        <span>@trade.Buyer</span>
                                        <i class="bi bi-arrow-left-right" aria-hidden="true"></i>
                                        <span>@trade.Seller</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </section>
                </aside>

                @{
                    var status = Status;
                }
                <section class="glass-card status-strip" aria-label="Показатели рынка">
                    <div class="status-metric">
                        <small>С момента запуска</small>
                        <strong class="positive">@status.Elapsed</strong>
                    </div>
                    <div class="status-metric">
                        <small>Количество сделок</small>
                        <strong>@status.TradeCount</strong>
                    </div>
                    <div class="status-metric">
                        <small>Участников</small>
                        <strong>@status.Participants</strong>
                    </div>
                    <div class="status-metric status-range">
                        <small>Дневной диапазон</small>
                        <strong>@status.Range</strong>
                        <div class="range-track" aria-hidden="true">
                            <span></span>
                            <i style="@status.RangeMarkerStyle"></i>
                        </div>
                    </div>
                    <div class="status-metric status-liquidity">
                        <small>Ликвидность</small>
                        <strong class="@status.LiquidityClass">@status.Liquidity</strong>
                        <span>@status.LiquidityDetail</span>
                    </div>

                    <a class="portfolio-button status-cta" href="/news">
                        <i class="bi bi-newspaper" aria-hidden="true"></i>
                        <div>
                            <strong>Добавить новость</strong>
                            <span>Передать live-сигнал в симуляцию</span>
                        </div>
                    </a>
                </section>

                @if (DebugControl is not null)
                {
                    <details class="glass-card debug-accordion">
                        <summary class="debug-summary">
                            <span>
                                <strong id="debug-title">Debug</strong>
                                <small>Dev-only инструменты и сценарии</small>
                            </span>
                            <em>@(string.IsNullOrWhiteSpace(debugMessage) ? "Закрыто" : debugMessage)</em>
                        </summary>

                        <div class="debug-panel">
                            <div class="debug-grid">
                                <div class="debug-group">
                                    <label>
                                        Участник
                                        <input @bind="debugAgentName" />
                                    </label>
                                    <label>
                                        Сторона
                                        <select @bind="debugOrderSide">
                                            <option value="@OrderSide.Buy">Buy</option>
                                            <option value="@OrderSide.Sell">Sell</option>
                                        </select>
                                    </label>
                                    <label>
                                        Тип
                                        <select @bind="debugOrderType">
                                            <option value="@OrderType.Limit">Limit</option>
                                            <option value="@OrderType.Market">Market</option>
                                        </select>
                                    </label>
                                    <label>
                                        Цена
                                        <input type="number" step="0.01" disabled="@(debugOrderType == OrderType.Market)" @bind="debugOrderPrice" />
                                    </label>
                                    <label>
                                        Кол-во
                                        <input type="number" step="0.01" min="0.01" @bind="debugOrderQuantity" />
                                    </label>
                                    <button type="button" @onclick="SubmitDebugOrder">Добавить заявку</button>
                                </div>

                                <div class="debug-group">
                                    <label>
                                        Агент
                                        <select @bind="debugAgentType">
                                            <option value="@AgentType.MarketMaker">MarketMaker</option>
                                            <option value="@AgentType.TrendFollowing">TrendFollowing</option>
                                            <option value="@AgentType.CounterTrend">CounterTrend</option>
                                            <option value="@AgentType.NewsDriven">NewsDriven</option>
                                        </select>
                                    </label>
                                    <label>
                                        Cash
                                        <input type="number" step="100" min="0" @bind="debugAgentCash" />
                                    </label>
                                    <label>
                                        Position
                                        <input type="number" step="1" min="0" @bind="debugAgentPosition" />
                                    </label>
                                    <button type="button" @onclick="AddDebugAgent">Добавить агента</button>
                                </div>
                            </div>

                            <div class="debug-scenarios">
                                <div class="debug-scenarios-head">
                                    <strong>Сценарии рынка</strong>
                                    <span>Быстрые пресеты для красивого движения графика и проверки стакана</span>
                                </div>
                                <div class="debug-scenario-buttons">
                                    <button type="button"
                                            class="scenario-button bullish"
                                            disabled="@isRunningDebugScenario"
                                            @onclick="RunBullishScenarioAsync">
                                        <i class="bi bi-graph-up-arrow" aria-hidden="true"></i>
                                        <span>Рост</span>
                                    </button>
                                    <button type="button"
                                            class="scenario-button bearish"
                                            disabled="@isRunningDebugScenario"
                                            @onclick="RunSelloffScenarioAsync">
                                        <i class="bi bi-graph-down-arrow" aria-hidden="true"></i>
                                        <span>Sell-off</span>
                                    </button>
                                    <button type="button"
                                            class="scenario-button reversal"
                                            disabled="@isRunningDebugScenario"
                                            @onclick="RunReversalScenarioAsync">
                                        <i class="bi bi-arrow-left-right" aria-hidden="true"></i>
                                        <span>Разворот</span>
                                    </button>
                                    <button type="button"
                                            class="scenario-button stop"
                                            disabled="@(!isRunningDebugScenario)"
                                            @onclick="StopDebugScenario">
                                        <i class="bi bi-stop-circle" aria-hidden="true"></i>
                                        <span>Стоп</span>
                                    </button>
                                </div>
                            </div>

                            <div class="debug-agents">
                                <div class="debug-agents-head">
                                    <span>Имя</span>
                                    <span>Тип</span>
                                    <span>Cash</span>
                                    <span>Position</span>
                                    <span>Value</span>
                                </div>
                                @foreach (var agent in latestTick?.Agents ?? [])
                                {
                                    <div class="debug-agent-row">
                                        <strong>@agent.Name</strong>
                                        <span>@agent.Type</span>
                                        <span>@FormatMoney(agent.Cash)</span>
                                        <span>@FormatQuantity(agent.Position)</span>
                                        <span>@FormatMoney(agent.PortfolioValue)</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </details>
                }
            </div>
        </section>
                </main>
            </div>

@code {
    private static readonly TimeframeDefinition[] Timeframes =
    [
        new("10s", "10s", TimeSpan.FromSeconds(10)),
        new("30s", "30s", TimeSpan.FromSeconds(30)),
        new("1m", "1m", TimeSpan.FromMinutes(1)),
        new("5m", "5m", TimeSpan.FromMinutes(5)),
        new("15m", "15m", TimeSpan.FromMinutes(15)),
        new("1h", "1h", TimeSpan.FromHours(1))
    ];

    private static readonly IReadOnlyDictionary<string, TimeframeDefinition> TimeframesByKey =
        Timeframes.ToDictionary(item => item.Key, StringComparer.Ordinal);

    private static readonly DebugScenarioSupportAgent[] ScenarioSupportAgents =
    [
        new("scenario-maker-boost", AgentType.MarketMaker, 240_000m, 220m),
        new("scenario-trend-boost-a", AgentType.TrendFollowing, 220_000m, 140m),
        new("scenario-trend-boost-b", AgentType.TrendFollowing, 200_000m, 120m)
    ];

    private const decimal DemoStartPrice = 124.35m;
    private const int MetricHistoryLimit = 72;
    private const int VisibleOrderBookDepth = 50;

    private ActiveAssetView CurrentAsset => ActiveAssetContext.GetView();
    private string AssetIconClass => GetAssetIconClass(CurrentAsset.Draft.AssetType);
    private MarketMetric[] MarketMetrics => BuildMarketMetrics(latestTick);

    private OrderBookViewData OrderBookData => BuildOrderBookData(latestTick?.OrderBook);

    private SpreadData Spread => BuildSpreadData(latestTick);

    private StatusStripData Status => BuildStatusStripData(latestTick);

    private TradeRow[] RecentTrades => BuildTradeRows(tradeHistory);

    private ISimulationDebugControl? DebugControl =>
        Environment.IsDevelopment()
            ? Services.GetService<ISimulationDebugControl>()
            : null;

    private ChartSummaryData ChartSummary => BuildChartSummaryData(GetSelectedTimeframeState(), latestTick, lastChartUpdate);
    private AssetParameter[] AssetParameters => BuildAssetParameters();

    private string selectedTimeframe = "30s";
    private SimulationTickResult? latestTick;
    private DateTimeOffset lastChartUpdate = DateTimeOffset.Now;
    private DateTimeOffset runStartedAt = DateTimeOffset.Now;
    private ElementReference chartViewport;
    private IJSObjectReference? tradingChartModule;
    private bool isChartRegistered;
    private bool metricsPrimed;
    private bool chartStatePrimed;
    private ChartSyncPayload? pendingChartSync;
    private decimal previousVolume;
    private readonly HashSet<Guid> seenTradeIds = [];
    private readonly HashSet<Guid> processedTradeIds = [];
    private readonly Dictionary<string, TimeframeSeriesState> timeframeSeriesStates = CreateTimeframeSeriesStates();
    private readonly List<decimal> priceMetricHistory = [];
    private readonly List<decimal> bidMetricHistory = [];
    private readonly List<decimal> askMetricHistory = [];
    private readonly List<decimal> volumeMetricHistory = [];
    private readonly List<Trade> tradeHistory = [];
    private readonly HashSet<string> activeScenarioSupportAgentKeys = [];
    private readonly HashSet<string> loadedHistoryTimeframes = [];
    private SimulationRunSummary? currentRunSummary;
    private Guid observedRunId = Guid.Empty;
    private string debugAgentName = "Manual";
    private OrderSide debugOrderSide = OrderSide.Buy;
    private OrderType debugOrderType = OrderType.Limit;
    private decimal? debugOrderPrice = DemoStartPrice;
    private decimal debugOrderQuantity = 1m;
    private AgentType debugAgentType = AgentType.TrendFollowing;
    private decimal debugAgentCash = 100_000m;
    private decimal debugAgentPosition = 10m;
    private string? debugMessage;
    private bool isRunningDebugScenario;
    private CancellationTokenSource? debugScenarioCts;

    private TimeframeSeriesState GetSelectedTimeframeState() => timeframeSeriesStates[selectedTimeframe];

    private void SelectTimeframe(string timeframe)
    {
        selectedTimeframe = timeframe;
        LoadPersistedCandles(timeframe, forceScrollToRealtime: true);
        pendingChartSync = BuildFullChartSyncPayload(forceScrollToRealtime: true);
    }

    protected override async Task OnInitializedAsync()
    {
        SimulationRunner.OnTick += HandleTick;
        latestTick = SimulationRunner.Current;
        if (latestTick is not null)
        {
            PrimeFromSnapshot(latestTick, DateTimeOffset.Now);
            LoadPersistedCandles(selectedTimeframe, forceScrollToRealtime: true);
        }

        await EnsureSimulationAsync();
    }

    private async Task EnsureSimulationAsync()
    {
        // Load the summary for the currently running singleton simulation first, so the
        // match check below sees the real asset name/type instead of falling back to
        // CurrentAsset.IsFallback on a freshly-created component (which would needlessly
        // restart an already-matching run on re-navigation).
        UpdateRunSummary();

        if (SimulationRunner.IsRunning && SimulationMatchesCurrentAsset())
        {
            UpdateRunSummary();
            return;
        }

        if (SimulationRunner.IsRunning)
        {
            await SimulationRunner.StopAsync();
            ResetViewState();
        }

        await SimulationRunner.StartAsync(CreateDemoConfig(CurrentAsset));
        UpdateRunSummary();
    }

    private void HandleTick(SimulationTickResult tickResult)
    {
        _ = InvokeAsync(() =>
        {
            ApplyTick(tickResult);
            StateHasChanged();
        });
    }

    private void ApplyTick(SimulationTickResult tickResult)
    {
        var receivedAt = DateTimeOffset.Now;
        latestTick = tickResult;
        lastChartUpdate = receivedAt;
        UpdateRunSummary();
        UpdateMetricHistory(tickResult);
        UpdateChartSeries(tickResult, receivedAt);
        LoadPersistedCandles(selectedTimeframe);
        _ = TrySyncChartAsync();
    }

    private async Task TrySyncChartAsync()
    {
        if (pendingChartSync is null)
        {
            return;
        }

        try
        {
            var modulePath = Assets["Components/Pages/Trading.razor.js"];
            if (!modulePath.StartsWith("./", StringComparison.Ordinal) &&
                !modulePath.StartsWith("/", StringComparison.Ordinal) &&
                !modulePath.StartsWith("http", StringComparison.OrdinalIgnoreCase))
            {
                modulePath = $"./{modulePath}";
            }

            tradingChartModule ??= await JS.InvokeAsync<IJSObjectReference>("import", modulePath);

            if (!isChartRegistered)
            {
                await tradingChartModule.InvokeVoidAsync("register", chartViewport);
                isChartRegistered = true;
            }

            var payload = pendingChartSync;
            await tradingChartModule.InvokeVoidAsync("sync", chartViewport, payload);
            pendingChartSync = null;
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
            // ElementReference is not ready yet; OnAfterRenderAsync will sync.
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (pendingChartSync is not null)
        {
            await TrySyncChartAsync();
        }
    }

    private static Dictionary<string, TimeframeSeriesState> CreateTimeframeSeriesStates() =>
        Timeframes.ToDictionary(item => item.Key, item => new TimeframeSeriesState(item), StringComparer.Ordinal);

    private void PrimeFromSnapshot(SimulationTickResult tickResult, DateTimeOffset receivedAt)
    {
        PrimeMetricHistory(tickResult);
        PrimeChartSeries(tickResult, receivedAt);
    }

    private void PrimeMetricHistory(SimulationTickResult tickResult)
    {
        if (metricsPrimed)
        {
            return;
        }

        priceMetricHistory.Clear();
        bidMetricHistory.Clear();
        askMetricHistory.Clear();
        volumeMetricHistory.Clear();

        var snapshot = tickResult.Snapshot;
        var prices = snapshot.RecentPrices.Count > 0
            ? snapshot.RecentPrices
            : [snapshot.LastPrice];

        foreach (var price in prices.TakeLast(MetricHistoryLimit))
        {
            AppendMetricValue(priceMetricHistory, price);
        }

        var bestBid = snapshot.BestBid ?? snapshot.LastPrice;
        var bestAsk = snapshot.BestAsk ?? snapshot.LastPrice;
        var historySeedCount = Math.Clamp(Math.Min(prices.Count, 12), 1, 12);
        for (var index = 0; index < historySeedCount; index++)
        {
            AppendMetricValue(bidMetricHistory, bestBid);
            AppendMetricValue(askMetricHistory, bestAsk);
        }

        tradeHistory.Clear();
        var seededTrades = snapshot.RecentTrades
            .OrderBy(trade => trade.ExecutedAt)
            .ToArray();

        if (seededTrades.Length == 0)
        {
            AppendMetricValue(volumeMetricHistory, 0m);
        }
        else
        {
            foreach (var trade in seededTrades)
            {
                if (!seenTradeIds.Add(trade.Id))
                {
                    continue;
                }

                tradeHistory.Add(trade);
                AppendMetricValue(volumeMetricHistory, trade.Quantity);
            }
        }

        previousVolume = snapshot.Volume;
        metricsPrimed = true;
    }

    private void PrimeChartSeries(SimulationTickResult tickResult, DateTimeOffset receivedAt)
    {
        if (chartStatePrimed)
        {
            return;
        }

        var bootstrapEvents = BuildBootstrapEvents(tickResult.Snapshot, receivedAt);
        if (bootstrapEvents.Count == 0)
        {
            ApplyLiveEventToAllTimeframes(new LivePriceEvent(GetFallbackEventTimestamp(tickResult.Snapshot, receivedAt), tickResult.Snapshot.LastPrice));
        }
        else
        {
            foreach (var liveEvent in bootstrapEvents)
            {
                ApplyLiveEventToAllTimeframes(liveEvent);
            }
        }

        foreach (var trade in tickResult.Snapshot.RecentTrades)
        {
            processedTradeIds.Add(trade.Id);
        }

        chartStatePrimed = true;
        pendingChartSync = BuildFullChartSyncPayload(forceScrollToRealtime: true);
    }

    private void UpdateChartSeries(SimulationTickResult tickResult, DateTimeOffset receivedAt)
    {
        if (!chartStatePrimed)
        {
            PrimeChartSeries(tickResult, receivedAt);
            return;
        }

        var snapshot = tickResult.Snapshot;
        var liveEvents = snapshot.RecentTrades
            .Where(trade => processedTradeIds.Add(trade.Id))
            .OrderBy(trade => trade.ExecutedAt)
            .Select(trade => new LivePriceEvent(trade.ExecutedAt, trade.Price))
            .ToArray();

        if (liveEvents.Length == 0)
        {
            var selectedState = GetSelectedTimeframeState();
            if (selectedState.Candles.Count == 0 ||
                selectedState.Candles[^1].Close != snapshot.LastPrice)
            {
                liveEvents =
                [
                    new LivePriceEvent(GetFallbackEventTimestamp(snapshot, receivedAt), snapshot.LastPrice)
                ];
            }
        }

        if (liveEvents.Length == 0)
        {
            return;
        }

        var selectedStateChanged = false;
        var createdBarsForSelectedTimeframe = 0;

        foreach (var liveEvent in liveEvents)
        {
            foreach (var timeframe in Timeframes)
            {
                var result = AppendLiveEvent(timeframeSeriesStates[timeframe.Key], liveEvent);
                if (!result.Changed || timeframe.Key != selectedTimeframe)
                {
                    continue;
                }

                selectedStateChanged = true;
                if (result.CreatedNewBar)
                {
                    createdBarsForSelectedTimeframe++;
                }
            }
        }

        if (!selectedStateChanged)
        {
            return;
        }

        var selectedSeries = GetSelectedTimeframeState();
        pendingChartSync = createdBarsForSelectedTimeframe > 1
            ? BuildFullChartSyncPayload(forceScrollToRealtime: false)
            : BuildIncrementalChartSyncPayload(selectedSeries.Candles[^1], forceScrollToRealtime: false);
    }

