        };

    private static Microsoft.AspNetCore.Components.MarkupString SvgText(double x, double y, string text, string anchor =
"start")
    {
        var markup = string.Format(
            System.Globalization.CultureInfo.InvariantCulture,
            "<text x=\"{0:0.##}\" y=\"{1:0.##}\" text-anchor=\"{2}\" fill=\"#8EA0BA\" font-size=\"12\" font-weight=\"560\">{3}</text>",
            x,
            y,
            System.Net.WebUtility.HtmlEncode(anchor),
            System.Net.WebUtility.HtmlEncode(text));

        return new Microsoft.AspNetCore.Components.MarkupString(markup);
    }

