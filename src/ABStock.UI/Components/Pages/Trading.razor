    private static PriceChartData BuildPriceChartData(
        SimulationTickResult? tickResult,
        string timeframe,
        DateTimeOffset updatedAt)
    {
        var prices = tickResult?.Snapshot.RecentPrices.Count > 0
            ? tickResult.Snapshot.RecentPrices.ToArray()
            : [DemoStartPrice];

        var groups = BuildPriceGroups(prices, GetTimeframeGroupSize(timeframe));
        var rangeLow = groups.Min(group => group.Low);
        var rangeHigh = groups.Max(group => group.High);
        var padding = Math.Max((rangeHigh - rangeLow) * 0.12m, 0.05m);
        var minPrice = rangeLow - padding;
        var maxPrice = rangeHigh + padding;

        if (minPrice == maxPrice)
        {
            minPrice -= 0.05m;
            maxPrice += 0.05m;
        }

        var candleStep = GetTimeframeCandleStep(timeframe);
        var plotRight = GetChartPlotRight(groups.Length, candleStep);
        var candles = BuildCandlePoints(groups, minPrice, maxPrice, candleStep);
        var firstPrice = prices[0];
        var lastPrice = tickResult?.Snapshot.LastPrice ?? prices[^1];
        var change = lastPrice - firstPrice;
        var percent = firstPrice == 0m ? 0m : change / firstPrice * 100m;
        var changeClass = change >= 0m ? "positive" : "negative";
        var sign = change >= 0m ? "+" : "";
        var lastPriceY = ScalePrice(lastPrice, minPrice, maxPrice);
        var priceTagX = Math.Clamp(plotRight - 66, ChartPlotLeft + 8, ChartPlotRight - 66);

        return new PriceChartData(
            candles,
            BuildPriceLabels(minPrice, maxPrice),
            BuildTickLabels(candles, tickResult?.Tick ?? 0),
            BuildGridX(timeframe),
            plotRight,
            FormatPrice(groups[0].Open),
            FormatPrice(groups.Max(group => group.High)),
            FormatPrice(groups.Min(group => group.Low)),
            FormatPrice(lastPrice),
            $"{sign}{FormatPrice(change)} ({sign}{percent:0.00}%)",
            changeClass,
            FormatPrice(lastPrice),
            lastPriceY,
            priceTagX,
            Math.Clamp(lastPriceY - 11, ChartPlotTop, ChartPlotBottom - 22),
            priceTagX + 10,
            Math.Clamp(lastPriceY + 4, ChartPlotTop + 15, ChartPlotBottom - 7),
            tickResult is null ? "Ожидание первого тика" : $"Рынок активен · тик {tickResult.Tick}",
            $"Обновлено {updatedAt.ToLocalTime():HH:mm:ss}");
    }

    private static PriceGroup[] BuildPriceGroups(IReadOnlyList<decimal> prices, int groupSize)
    {
        var groups = new List<PriceGroup>();

        for (var index = 0; index < prices.Count; index += groupSize)
        {
            var chunk = prices.Skip(index).Take(groupSize).ToArray();
            groups.Add(new PriceGroup(
                chunk[0],
                chunk.Max(),
                chunk.Min(),
                chunk[^1]));
        }

        return groups.ToArray();
    }

    private static CandlePoint[] BuildCandlePoints(
        IReadOnlyList<PriceGroup> groups,
        decimal minPrice,
        decimal maxPrice,
        double candleStep)
    {
        var bodyWidth = Math.Clamp(candleStep * 0.44, 5, 13);

        return groups
            .Select((group, index) =>
            {
                var x = ChartPlotLeft + candleStep * index;
                var openY = ScalePrice(group.Open, minPrice, maxPrice);
                var closeY = ScalePrice(group.Close, minPrice, maxPrice);
                var bodyHeight = Math.Max(5, Math.Abs(openY - closeY));

                return new CandlePoint(
                    x,
                    ScalePrice(group.High, minPrice, maxPrice),
                    ScalePrice(group.Low, minPrice, maxPrice),
                    x - bodyWidth / 2,
                    Math.Min(openY, closeY),
                    bodyWidth,
                    bodyHeight,
                    group.Close >= group.Open);
            })
            .ToArray();
    }

    private static AxisLabel[] BuildPriceLabels(decimal minPrice, decimal maxPrice)
    {
        const int labelCount = 6;
        var labels = new AxisLabel[labelCount];

        for (var index = 0; index < labelCount; index++)
        {
            var ratio = labelCount == 1 ? 0 : (double)index / (labelCount - 1);
            var price = maxPrice - (maxPrice - minPrice) * (decimal)ratio;
            var y = ChartPlotTop + ChartPlotHeight * ratio;
            labels[index] = new AxisLabel(0, y, FormatPrice(price));
        }

        return labels;
    }

    private static AxisLabel[] BuildTickLabels(IReadOnlyList<CandlePoint> candles, int latestTick)
    {
        if (candles.Count == 0)
        {
            return [];
        }

        var labelCount = Math.Min(6, candles.Count);
        var indexes = new List<int>(labelCount);

        for (var index = 0; index < labelCount; index++)
        {
            var ratio = labelCount == 1 ? 0 : (double)index / (labelCount - 1);
            var candleIndex = (int)Math.Round((candles.Count - 1) * ratio);
            if (!indexes.Contains(candleIndex))
            {
                indexes.Add(candleIndex);
            }
        }

        return indexes
            .Select(index =>
            {
                var relativeTick = Math.Max(0, candles.Count - 1 - index);
                return new AxisLabel(candles[index].X, 0, $"t-{relativeTick}");
            })
            .ToArray();
    }

    private static double[] BuildGridX(string timeframe)
    {
        var lineCount = GetTimeframeGridLineCount(timeframe);
        var lines = new double[lineCount];

        for (var index = 0; index < lineCount; index++)
        {
            var ratio = lineCount == 1 ? 0 : (double)index / (lineCount - 1);
            lines[index] = ChartPlotLeft + (ChartPlotRight - ChartPlotLeft) * ratio;
        }

        return lines;
    }

    private static double GetChartPlotRight(int candleCount, double candleStep)
    {
        var width = Math.Max(0, candleCount - 1) * candleStep;
        return Math.Clamp(ChartPlotLeft + width, ChartPlotLeft + 116, ChartPlotRight);
    }

    private static double ScalePrice(decimal price, decimal minPrice, decimal maxPrice)
    {
        var ratio = (double)((price - minPrice) / (maxPrice - minPrice));
        return ChartPlotBottom - ChartPlotHeight * ratio;
    }

