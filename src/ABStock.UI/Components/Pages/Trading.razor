    private static OrderBookViewData BuildOrderBookData(OrderBookSnapshot? orderBook)
    {
        var asks = GetVisibleOrderBookLevels(orderBook?.Asks ?? [], reverse: true, isAsk: true);
        var bids = GetVisibleOrderBookLevels(orderBook?.Bids ?? [], reverse: false, isAsk: false);

        // Асксы перевёрнуты по убыванию — лучший в конце; биды по убыванию — лучший первый.
        var bestAsk = asks.Length == 0 ? (decimal?)null : asks[^1].Price;
        var bestBid = bids.Length == 0 ? (decimal?)null : bids[0].Price;

        return new OrderBookViewData(
            bestBid,
            bestAsk,
            BuildOrderBookRows(asks),
            BuildOrderBookRows(bids));
    }

    private static OrderBookLevel[] GetVisibleOrderBookLevels(
        IReadOnlyList<OrderBookLevel> levels,
        bool reverse,
        bool isAsk)
    {
        var visibleLevels = OrderBookDisplay.Aggregate(levels, isAsk).Take(VisibleOrderBookDepth).ToArray();
        if (reverse)
        {
            Array.Reverse(visibleLevels);
        }

        return visibleLevels;
    }

    private static OrderBookRow[] BuildOrderBookRows(IReadOnlyList<OrderBookLevel> levels)
    {
        var maxQuantity = levels.Count == 0 ? 0m : levels.Max(level => level.Quantity);
        var rows = levels
            .Select(level =>
            {
                var depth = CalculateDepth(level.Quantity, maxQuantity);

                return new OrderBookRow(
                    FormatPrice(level.Price),
                    level.Quantity.ToString("N1"),
                    level.OrdersCount.ToString(),
                    depth,
                    $"width: {depth}%;",
                    false);
            })
            .ToList();

        if (rows.Count == 0)
        {
            rows.Add(new OrderBookRow("—", "—", "—", 0, "width: 0%;", true));
        }

        return rows.ToArray();
    }

    private static TradeRow[] BuildTradeRows(IReadOnlyList<Trade> trades) =>
        trades
            .OrderByDescending(trade => trade.ExecutedAt)
            .Take(50)
            .Select(trade => new TradeRow(
                trade.ExecutedAt.ToLocalTime().ToString("HH:mm:ss"),
                FormatPrice(trade.Price),
                trade.Quantity.ToString("N1"),
                FormatAgentName(trade.BuyerAgentName),
                FormatAgentName(trade.SellerAgentName),
                GetTradeClass(trade)))
            .ToArray();

    private SpreadData BuildSpreadData(SimulationTickResult? tickResult)
    {
        var snapshot = tickResult?.Snapshot;
        if (snapshot?.BestBid is null || snapshot.BestAsk is null)
        {
            return new SpreadData("— / —", "Спред недоступен");
        }

        var spread = snapshot.BestAsk.Value - snapshot.BestBid.Value;
        var mid = (snapshot.BestAsk.Value + snapshot.BestBid.Value) / 2m;
        var spreadPercent = mid == 0m ? 0m : spread / mid * 100m;

        return new SpreadData(
            $"{FormatMoney(snapshot.BestBid.Value)} / {FormatMoney(snapshot.BestAsk.Value)}",
            $"Спред {FormatPrice(spread)} ₽ ({spreadPercent:0.00}%)");
    }

    private StatusStripData BuildStatusStripData(SimulationTickResult? tickResult)
    {
        var snapshot = tickResult?.Snapshot;
        var prices = snapshot?.RecentPrices.Count > 0
            ? snapshot.RecentPrices
            : [DemoStartPrice];
        var low = prices.Min();
        var high = prices.Max();
        var last = snapshot?.LastPrice ?? DemoStartPrice;
        var rangePosition = high == low ? 50 : (int)Math.Round((last - low) / (high - low) * 100m);
        var spread = BuildSpreadData(tickResult);
        var bidDepth = tickResult?.OrderBook.Bids.Sum(level => level.Quantity) ?? 0m;
        var askDepth = tickResult?.OrderBook.Asks.Sum(level => level.Quantity) ?? 0m;
        var totalDepth = bidDepth + askDepth;
        var liquidity = GetLiquidity(tickResult, totalDepth);
        var elapsed = DateTimeOffset.Now - runStartedAt;

        return new StatusStripData(
            elapsed.ToString(@"hh\:mm\:ss"),
            FormatQuantity(seenTradeIds.Count),
            FormatQuantity(tickResult?.Agents.Count ?? 0),
            $"{FormatMoney(low)} - {FormatMoney(high)}",
            $"left: {Math.Clamp(rangePosition, 0, 100)}%",
            liquidity.Label,
            liquidity.ClassName,
            $"{spread.Detail}; глубина {FormatQuantity(totalDepth)} шт.");
    }

    private static string FormatNullableMoney(decimal? value) => value is null ? "-" : FormatMoney(value.Value);

    private static string FormatMoney(decimal value) => $"{value:F2} ₽";

    private static string FormatPrice(decimal value) => value.ToString("F2");

    private static string FormatQuantity(decimal value) => value % 1m == 0m
        ? value.ToString("0")
        : value.ToString("0.##");

    private static int CalculateDepth(decimal quantity, decimal maxQuantity)
    {
        if (maxQuantity <= 0m)
        {
            return 0;
        }

        var depth = (int)Math.Ceiling((double)(quantity / maxQuantity * 100m));
        return Math.Clamp(depth, 8, 100);
    }

    private static string GetChangeClass(IReadOnlyList<decimal> values)
    {
        if (values.Count < 2)
        {
            return "positive";
        }

        return values[^1] >= values[0] ? "positive" : "negative";
    }

    private static string BuildSparkline(IReadOnlyList<decimal> values)
    {
        if (values.Count == 0)
        {
            return "";
        }

        return string.Join(" ", BuildChartPoints(values, 6, 94, 12, 30)
            .Select(point => $"{FormatSvgNumber(point.X)},{FormatSvgNumber(point.Y)}"));
    }

    private static string BuildArea(IReadOnlyList<decimal> values)
    {
        var points = BuildSparkline(values);
        if (string.IsNullOrWhiteSpace(points))
        {
            return "";
        }

        var firstX = FormatSvgNumber(6);
        var lastX = FormatSvgNumber(94);
        return $"{firstX},42 {points} {lastX},42";
    }

    private static BarRect[] BuildVolumeBars(IReadOnlyList<decimal> values)
    {
        const int barCount = 9;
        const double width = 7;
        var source = values.Count == 0 ? [0m] : values.TakeLast(barCount).ToArray();
        var maxValue = Math.Max(source.Max(), 1m);
        var bars = new BarRect[barCount];
        var padCount = barCount - source.Length;

        for (var index = 0; index < barCount; index++)
        {
            var value = index < padCount ? 0m : source[index - padCount];
            var height = 6 + (double)(value / maxValue) * 30;
            var x = 4 + index * 10;
            bars[index] = new BarRect(x, 38 - height, width, height);
        }

        return bars;
    }

    private static Point[] BuildChartPoints(IReadOnlyList<decimal> values, double minX, double maxX, double minY, double
maxY)
    {
        var source = values.Count == 0 ? [0m] : values.ToArray();
        var average = source.Average(value => value);
        var maxDeviation = source.Max(value => Math.Abs(value - average));
        var range = maxDeviation * 2m;
        var width = maxX - minX;
        var height = maxY - minY;

        if (source.Length == 1)
        {
            return [new Point((minX + maxX) / 2, (minY + maxY) / 2)];
        }

        return source
            .Select((value, index) =>
            {
                var x = minX + width * index / (source.Length - 1);
                var ratio = range == 0m ? 0.5 : 0.5 + (double)((value - average) / range);
                ratio = Math.Clamp(ratio, 0.18, 0.82);
                var y = maxY - height * ratio;
                return new Point(x, y);
            })
            .ToArray();
    }

    private static string GetTradeClass(Trade trade)
    {
        if (trade.BuyerAgentName.Contains("MarketMaker", StringComparison.Ordinal))
        {
            return "sell";
        }

        return "buy";
    }

    private static string FormatAgentName(string agentName)
    {
        if (string.IsNullOrWhiteSpace(agentName))
        {
            return "-";
        }

        var normalized = agentName.Trim();
        var compactName = normalized switch
        {
            "TrendFollowing" => "Trend",
            "CounterTrend" => "Counter",
            "MarketMaker" => "Maker",
            "NewsDriven" => "News",
            _ => null
        };

        if (compactName is not null)
        {
            return compactName;
        }

        if (normalized.Contains("TrendFollowing", StringComparison.Ordinal))
        {
            return normalized.Replace("TrendFollowing", "Trend", StringComparison.Ordinal);
        }

        if (normalized.Contains("CounterTrend", StringComparison.Ordinal))
        {
            return normalized.Replace("CounterTrend", "Counter", StringComparison.Ordinal);
        }

        if (normalized.Contains("MarketMaker", StringComparison.Ordinal))
        {
            return normalized.Replace("MarketMaker", "Maker", StringComparison.Ordinal);
        }

        if (normalized.Contains("NewsDriven", StringComparison.Ordinal))
        {
            return normalized.Replace("NewsDriven", "News", StringComparison.Ordinal);
        }

        var builder = new System.Text.StringBuilder(normalized.Length + 4);

        for (var index = 0; index < normalized.Length; index++)
        {
            var current = normalized[index];
            if (index > 0 &&
                char.IsUpper(current) &&
                (char.IsLower(normalized[index - 1]) ||
                 (index + 1 < normalized.Length && char.IsLower(normalized[index + 1]))))
            {
                builder.Append(' ');
            }

            builder.Append(current);
        }

        return builder.ToString();
    }

    private static string GetAssetTypeLabel(AssetType assetType) =>
        assetType switch
        {
            AssetType.Stock => "Акция",
            AssetType.Bond => "Облигация",
            AssetType.Commodity => "Товар",
            AssetType.Crypto => "Криптоактив",
            _ => assetType.ToString()
        };

    private static (string Label, string ClassName) GetLiquidity(SimulationTickResult? tickResult, decimal totalDepth)
    {
        if (tickResult?.Snapshot.BestBid is null || tickResult.Snapshot.BestAsk is null)
        {
            return ("Нет данных", "");
        }

        var mid = (tickResult.Snapshot.BestBid.Value + tickResult.Snapshot.BestAsk.Value) / 2m;
        var spreadPercent = mid == 0m ? 100m : (tickResult.Snapshot.BestAsk.Value - tickResult.Snapshot.BestBid.Value) / mid *
100m;

        if (spreadPercent <= 0.5m && totalDepth >= 10m)
        {
            return ("Высокая", "positive");
        }

        if (spreadPercent <= 2m && totalDepth >= 4m)
        {
            return ("Средняя", "");
        }

        return ("Низкая", "negative");
    }

    private static string FormatSvgNumber(double value) =>
        value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private void HandleNewsFeedChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        SimulationRunner.OnTick -= HandleTick;
        NewsFeed.Changed -= HandleNewsFeedChanged;
        debugScenarioCts?.Cancel();
    }

    public async ValueTask DisposeAsync()
    {
        SimulationRunner.OnTick -= HandleTick;
        NewsFeed.Changed -= HandleNewsFeedChanged;
        debugScenarioCts?.Cancel();

        if (tradingChartModule is null)
        {
            return;
        }

        try
        {
            if (isChartRegistered)
            {
                await tradingChartModule.InvokeVoidAsync("dispose", chartViewport);
            }

            await tradingChartModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

