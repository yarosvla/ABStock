@page "/trading"
@rendermode InteractiveServer
@using ABStock.Application.MarketHistory
@using ABStock.Application.Simulation
@using ABStock.Shared
@using ABStock.UI.Services
@using static ABStock.UI.Services.NumberFormat
@implements IDisposable
@implements IAsyncDisposable
@inject ISimulationRunner SimulationRunner
@inject IMarketCandleReader CandleReader
@inject IJSRuntime JS
@inject IUserPreferences Preferences
@inject IActiveAssetContext ActiveAssetContext
@inject ISessionNewsFeed NewsFeed
@inject ISimulationHistoryReader SimulationHistoryReader
@inject IAgentEquityHistory EquityHistory

<PageTitle>Торги</PageTitle>

@{
    // Локальные хелперы разметки. Бизнес-логика и форматирование живут в @code —
    // здесь только сопоставление значения с токеном оформления.
    var isRunning = SimulationRunner.IsRunning;
    var snapshot = latestTick?.Snapshot;
    var chart = ChartSummary;
    var book = OrderBookData;
    var spread = Spread;
    var status = Status;
    var trades = RecentTrades;
    var agents = SessionAgents;
    var isStale = latestTick is not null && (DateTimeOffset.Now - lastChartUpdate).TotalSeconds > 5;
    var startBlocked = !IsCompositionValid;

    static string Tone(string? changeClass) => changeClass switch
    {
        "positive" => "up",
        "negative" => "down",
        _ => "flat"
    };

    static string AgentTone(AgentType type) => type switch
    {
        AgentType.TrendFollowing => "agent-trend",
        AgentType.CounterTrend => "agent-counter",
        AgentType.MarketMaker => "agent-mm",
        AgentType.NewsDriven => "agent-news",
        _ => "muted"
    };

    static string NameTone(string agentName) =>
        agentName.Contains("Trend", StringComparison.Ordinal) &&
        !agentName.Contains("Counter", StringComparison.Ordinal) ? "agent-trend"
        : agentName.Contains("Counter", StringComparison.Ordinal) ? "agent-counter"
        : agentName.Contains("Maker", StringComparison.Ordinal) ? "agent-mm"
        : agentName.Contains("News", StringComparison.Ordinal) ? "agent-news"
        : "muted";

    static string Kind(AgentType type) => type switch
    {
        AgentType.TrendFollowing => "трендовая стратегия",
        AgentType.CounterTrend => "контр-трендовая стратегия",
        AgentType.MarketMaker => "маркет-мейкинг",
        AgentType.NewsDriven => "новостная стратегия",
        _ => "стратегия"
    };

    // Разрядность, знак, тон и счётная форма — общие: Services/NumberFormat.
    // Раньше страница объявляла свои копии Money0, Count0, Sign, Pnl2,
    // Position0, DeltaTone и Plural, дословно совпадавшие с общими. Две копии
    // одного правила расходятся при первой же правке — ровно так разошёлся
    // .tone-flat (пункт 99 docs/ui-backlog.md).
    //
    // ActionLabel и ActionTone убраны вместе с ними: слово действия теперь даёт
    // AgentRoster, и он различает «держит спред» и «ждёт», а ActionTone был
    // мёртв — .agents__why-act перебивает тон специфичностью.
}

<div class="app-bg" aria-hidden="true"><div class="app-bg__noise"></div></div>

<div class="trading-shell">
    <TopNavigation ActivePage="Trading" ShowClock="true" />

    <main class="trading-page">

        @* ── Крошки · Активы › Актив › Раздел (раздел 13) ───────────────────── *@
        <Breadcrumbs Items="@(new Crumb[]
                     {
                         new("Активы", Href: "/create-asset"),
                         new(CurrentAsset.Draft.Name, IsAsset: true),
                         new("Торги")
                     })" />

        @* ── PageHeader: H1 + одна строка контекста · до двух действий ───────── *@
        <PageHead Title="Торги">
            <Context>
                @if (isRunning)
                {
                    <text>Сессия идёт <span class="num-sm">@status.Elapsed</span> · агентов в работе <span class="num-sm">@agents.Count</span></text>
                }
                else
                {
                    <text>Сессия остановлена · состав агентов задаётся до запуска</text>
                }
            </Context>
            <Actions>
                @* «Добавить новость» — только при идущей сессии: новость вводится
                   «в любой момент ПОСЛЕ старта» (раздел 16.3), а при остановленных
                   торгах вводить её некуда. Артборд 03 показывает одно действие. *@
                @if (isRunning)
                {
                    <AppButton Variant="secondary" Icon="plus" Href="/news">Добавить новость</AppButton>
                    <AppButton Variant="primary" OnClick="SimulationRunner.StopAsync">Остановить торги</AppButton>
                }
                else
                {
                    <AppButton Variant="primary" Icon="play"
                               Disabled="startBlocked"
                               OnClick="EnsureSimulationAsync">Запустить торги</AppButton>
                }
            </Actions>
        </PageHead>

        @* ── Рабочая область: рельс 280 · центр · рельс 340 ──────────────────── *@
        <div class="workspace">

            @* ─────────── ЛЕВЫЙ РЕЛЬС ─────────── *@
            <div class="rail rail--left">
                @* После остановки левый рельс меняется по артборду 03: профиль актива
                   и итоги закончившейся сессии вместо счётчиков идущей. Раздел 13
                   закрепил за левым рельсом хронологию, и она остаётся ниже — панель
                   «События сессии» никуда не уходит. *@
                @if (isRunning)
                {
                    <Panel Title="Сессия" Class="rise rise-1">
                        <MetaContent><span class="num-sm">@CurrentAsset.Symbol</span></MetaContent>
                        <ChildContent>
                            <dl class="kv">
                                <div class="kv__row">
                                    <dt>Сделок</dt>
                                    <dd class="num-sm">@Count0(SessionTradeCount)</dd>
                                </div>
                                <div class="kv__row">
                                    <dt>Шаг симуляции</dt>
                                    <dd class="num-sm">@(SessionTick is { } tick ? Count0(tick) : "—")</dd>
                                </div>
                                <div class="kv__row">
                                    <dt>Новостей</dt>
                                    <dd class="num-sm">@Count0(NewsFeed.Entries.Count)</dd>
                                </div>
                            </dl>
                        </ChildContent>
                    </Panel>
                }
                else
                {
                    <Panel Title="Актив" Class="rise rise-1">
                        <MetaContent>один в сессии</MetaContent>
                        <ChildContent>
                            <dl class="kv">
                                <div class="kv__row">
                                    <dt>Название</dt>
                                    <dd>@CurrentAsset.Draft.Name</dd>
                                </div>
                                <div class="kv__row">
                                    <dt>Тикер</dt>
                                    <dd class="num-sm">@CurrentAsset.Symbol</dd>
                                </div>
                                <div class="kv__row">
                                    <dt>Сектор</dt>
                                    <dd>@(string.IsNullOrWhiteSpace(CurrentAsset.Draft.Industry) ? "—" : CurrentAsset.Draft.Industry)</dd>
                                </div>
                                <div class="kv__row">
                                    <dt>Чувствительность к новостям</dt>
                                    <dd>@SensitivityScale.Word(CurrentAsset.Profile.NewsSensitivity)</dd>
                                </div>
                            </dl>
                            @* «Стартовая цена» из артборда 03 здесь НЕ показана: на этом же
                               экране она стоит в строке показателей как «откр», и раздел 9.0
                               называет такой дубль поимённо — «цена открытия — строке
                               показателей, а не панели сессии». *@
                            <p class="rail__note">Профиль задан при создании актива и в сессии не меняется</p>
                        </ChildContent>
                    </Panel>

                    <Panel Title="Завершённая сессия" Class="rise rise-1">
                        <MetaContent>итоги</MetaContent>
                        <ChildContent>
                            <dl class="kv">
                                <div class="kv__row">
                                    <dt>Длительность</dt>
                                    <dd class="num-sm">@SessionDuration</dd>
                                </div>
                                <div class="kv__row">
                                    <dt>Сделок</dt>
                                    <dd class="num-sm">@Count0(SessionTradeCount)</dd>
                                </div>
                                <div class="kv__row">
                                    <dt>Шаг симуляции</dt>
                                    <dd class="num-sm">@(SessionTick is { } tick ? Count0(tick) : "—")</dd>
                                </div>
                                <div class="kv__row">
                                    <dt>Новостей</dt>
                                    <dd class="num-sm">@Count0(NewsFeed.Entries.Count)</dd>
                                </div>
                            </dl>
                        </ChildContent>
                    </Panel>
                }

                <Panel Title="События сессии" Class="rise rise-2" Flush="true">
                    <MetaContent><span class="num-sm">@Count0(NewsFeed.Entries.Count)</span></MetaContent>
                    <ChildContent>
                        @if (NewsFeed.Entries.Count > 0)
                        {
                            <div class="events">
                                @foreach (var entry in NewsFeed.Entries)
                                {
                                    <NewsEventRow At="entry.At" Text="@entry.Text"
                                                  Polarity="entry.Polarity" ImpactScore="entry.ImpactScore" />
                                }
                            </div>
                        }
                        else
                        {
                            @* Два текста, а не один: при остановленных торгах рынок
                               никуда не идёт, агентов в работе ноль и ждать сигнала
                               некому. Пункт 19 docs/ui-backlog.md, раздел 14. *@
                            @if (isRunning)
                            {
                                <EmptyState IconName="news"
                                            Title="Новостей ещё не было"
                                            Description="Рынок идёт на решениях трендового, контр-трендового агентов и маркет-мейкера. Новостной агент ждёт сигнала.">
                                    <Action>
                                        <AppButton Variant="secondary" Icon="plus" Href="/news">Добавить новость</AppButton>
                                    </Action>
                                </EmptyState>
                            }
                            else
                            {
                                <EmptyState IconName="news"
                                            Title="Новостей не было"
                                            Description="Новость вводится во время сессии: сигналу нужен рынок, который на него отреагирует." />
                            }
                        }
                    </ChildContent>
                </Panel>
            </div>

            @* ─────────── ЦЕНТР ─────────── *@
            <div class="center">

                @* Одна главная метрика + компактная строка показателей (раздел 9.1) *@
                <section class="quote rise rise-1" aria-label="Текущая цена и показатели">
                    <div class="quote__price">
                        <div class="num-hero @(isStale ? "is-stale" : null)">@chart.Close <span class="unit">₽</span></div>
                        <div class="quote__delta tone-@Tone(chart.ChangeClass)">
                            <span class="num-sm">
                                @(chart.ChangeClass == "positive" ? "↗" : chart.ChangeClass == "negative" ? "↘" : "·") @chart.Change
                            </span>
                            @if (isStale)
                            {
                                <span class="quote__stale">нет обновлений</span>
                            }
                            else if (!isRunning && SessionTick is not null)
                            {
                                @* Артборд 03 подписывает герой-число словами. «закр» отдельной
                                   метрикой в строку не добавлен: он равен герою, а раздел 9.0
                                   запрещает показывать одну метрику дважды на экране. *@
                                <span class="quote__stale">цена закрытия</span>
                            }
                        </div>
                    </div>

                    <div class="strip">
                        <div class="strip__item"><span class="strip__label">откр</span><span class="num-sm">@chart.Open</span></div>
                        <span class="strip__sep strip--optional" aria-hidden="true"></span>
                        <div class="strip__item strip--optional"><span class="strip__label">макс</span><span class="num-sm">@chart.High</span></div>
                        <span class="strip__sep strip--optional" aria-hidden="true"></span>
                        <div class="strip__item strip--optional"><span class="strip__label">мин</span><span class="num-sm">@chart.Low</span></div>
                        <span class="strip__sep" aria-hidden="true"></span>
                        @* Объём известен только из снимка рынка. После остановки снимка нет, а
                               в сводке прогона объём не хранится — значит «—», а не ноль:
                               раздел 10, «Нет данных — —. Не „0“, не „N/A“». *@
                        <div class="strip__item"><span class="strip__label">объём</span><span class="num-sm">@(snapshot is { } s ? Count0(s.Volume) : "—")</span></div>
                        @if (TradesPerMinute is { } rate)
                        {
                            <span class="strip__sep" aria-hidden="true"></span>
                            <div class="strip__item"><span class="strip__label">сделок в минуту</span><span class="num-sm">@Count0(rate)</span></div>
                        }
                    </div>
                </section>

                @* Главная панель экрана — график *@
                <Panel Class="chart-panel rise rise-2" Flush="true">
                    <Head>
                        <div class="chart-panel__id">
                            <h2>@CurrentAsset.Draft.Name</h2>
                            <span class="chip num-sm">@CurrentAsset.Symbol</span>
                            <StatusDot Tone="@(isRunning ? "up" : "muted")" Live="isRunning">@(isRunning ? "Торги активны" : "Торги остановлены")</StatusDot>
                        </div>
                        <Segmented TValue="string"
                                   Label="Таймфрейм"
                                   Items="@(Timeframes.All.Select(t => new SegmentedItem<string>(t.Key, t.Label)).ToArray())"
                                   Value="@selectedTimeframe"
                                   ValueChanged="SelectTimeframe" />
                    </Head>
                    <ChildContent>
                        <div class="chart-body">
                            <div class="chart-stage" @ref="chartViewport" tabindex="0"
                                 aria-label="Свечной график цены @CurrentAsset.Draft.Name">
                                <div class="chart-surface" role="img"
                                     aria-label="Биржевой график цены @CurrentAsset.Draft.Name"></div>

                                <div class="chart-hover-legend glass" aria-live="polite">
                                    <span class="chart-hover-time num-xs" data-role="time">Нет данных</span>
                                    <div class="chart-hover-values">
                                        <span><small>откр</small><strong class="num-sm" data-role="open">—</strong></span>
                                        <span><small>макс</small><strong class="num-sm" data-role="high">—</strong></span>
                                        <span><small>мин</small><strong class="num-sm" data-role="low">—</strong></span>
                                        <span><small>закр</small><strong class="num-sm" data-role="close">—</strong></span>
                                    </div>
                                </div>

                                <button class="chart-live-reset" type="button" hidden>
                                    <Icon Name="activity" Size="14" />
                                    <span>К текущей цене</span>
                                </button>

                                <div class="chart-empty-state">Нет данных</div>
                            </div>

                            <footer class="chart-foot">
                                <a class="chart-foot__credit" href="https://www.tradingview.com/"
                                   target="_blank" rel="noreferrer noopener">
                                    TradingView Lightweight Charts™ · Copyright (c) 2025 TradingView, Inc.
                                </a>
                                <span class="num-xs">@chart.UpdatedAt</span>
                            </footer>
                        </div>
                    </ChildContent>
                </Panel>

                @* Торги остановлены — состав задаётся до старта (артборд 03, раздел 16.1) *@
                @if (!isRunning)
                {
                    <Panel Title="Состав агентов перед запуском" Class="rise rise-3" Flush="true">
                        <MetaContent>четыре типа стратегий</MetaContent>
                        <ChildContent>
                            <div class="compose-wrap">
                                <table class="compose">
                                    <thead>
                                        <tr>
                                            <th scope="col" class="label compose__c-type">Тип</th>
                                            <th scope="col" class="label compose__c-count">Количество</th>
                                            <th scope="col" class="label compose__c-cap">Капитал агента, ₽</th>
                                            <th scope="col" class="label compose__c-total">Всего капитала</th>
                                            <th scope="col" class="label compose__c-why">Поведение</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in agentComposition)
                                        {
                                            var isOff = row.Count == 0;
                                            var capitalError = HasCapitalError(row);
                                            var typeLabel = AgentDisplay.GetTypeLabel(row.Type);
                                            var lessLabel = "Убрать агента: " + typeLabel;
                                            var moreLabel = "Добавить агента: " + typeLabel;
                                            var capitalLabel = "Капитал агента: " + typeLabel;
                                            var countLabel = "Количество агентов: " + typeLabel;
                                            var rowClass = isOff ? "is-off" : null;
                                            var capitalCellClass = capitalError ? "is-error" : null;
                                            <tr class="@rowClass">
                                                <th scope="row" class="compose__c-type">
                                                    <span class="compose__cell">
                                                        <StatusDot Tone="@AgentTone(row.Type)" />
                                                        <span class="compose__type-name">@typeLabel</span>
                                                    </span>
                                                </th>
                                                <td class="compose__c-count">
                                                    <NumberStepper Value="row.Count"
                                                                   ValueChanged="@(value => ChangeAgentCount(row, (value ?? row.Count) - row.Count))"
                                                                   Min="0" Max="MaxAgentsPerType"
                                                                   Class="compose__stepper"
                                                                   Label="@countLabel"
                                                                   DecrementLabel="@lessLabel"
                                                                   IncrementLabel="@moreLabel" />
                                                </td>
                                                <td class="compose__c-cap @capitalCellClass">
                                                    <NumberStepper Value="@((int)row.Capital)"
                                                                   ValueChanged="@(value => { row.Capital = value ?? 0m; })"
                                                                   Min="0" Max="null" Step="1000"
                                                                   Editable="true" Fill="true"
                                                                   Class="compose__capital"
                                                                   Label="@capitalLabel"
                                                                   DecrementLabel="@("Уменьшить капитал: " + typeLabel)"
                                                                   IncrementLabel="@("Увеличить капитал: " + typeLabel)" />
                                                    @if (capitalError)
                                                    {
                                                        <span class="field__error">
                                                            <Icon Name="alert" Size="14" />
                                                            <span>Капитал должен быть больше нуля</span>
                                                        </span>
                                                    }
                                                </td>
                                                <td class="compose__c-total num-sm">@Money0(row.TotalCapital)</td>
                                                <td class="compose__c-why" title="@row.Behaviour">@row.Behaviour</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <th scope="row" class="compose__c-type">Итого</th>
                                            <td class="compose__c-count num-sm">@TotalAgentCount</td>
                                            <td class="compose__c-cap"></td>
                                            <td class="compose__c-total num-sm">@Money0(TotalCompositionCapital)</td>
                                            @* Примечание стоит в колонке «Поведение» итоговой строки — так в
                                               артборде 03. Предупреждения валидации туда не уезжают: они не
                                               про колонку, а про весь состав, и остаются строкой под таблицей. *@
                                            <td class="compose__c-why">
                                                @if (TotalAgentCount >= MinTotalAgents && TotalAgentCount <= MaxTotalAgents)
                                                {
                                                    <text>Новостной агент активируется после первой новости в сессии</text>
                                                }
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>

                                @* Строка относится ко всему составу, а не к колонке,
                                   поэтому стоит под таблицей, а не в ячейке подвала. *@
                                @if (TotalAgentCount < MinTotalAgents || TotalAgentCount > MaxTotalAgents)
                                {
                                    <p class="compose__note">
                                        <span class="compose__warn">
                                            <Icon Name="alert" Size="14" />
                                            <span>
                                                @(TotalAgentCount < MinTotalAgents
                                                    ? "Нужен хотя бы один агент"
                                                    : $"Не больше {MaxTotalAgents} агентов в сессии")
                                            </span>
                                        </span>
                                    </p>
                                }
                            </div>
                        </ChildContent>
                    </Panel>
                }

                @* Агенты: действие и объяснение — то, ради чего выбрана эта компоновка.

                   Только пока торги идут. После остановки центр занимает таблица
                   состава, готовящая следующий запуск, и вместе они не помещаются
                   в 1080 — а раздел 9.8 требует, чтобы экран помещался. Артборд 03
                   показывает после остановки состав, график сессии и счётчики, но не
                   разбор по агентам: он живёт на «Агентах», которые остановку
                   переживают (коммит 3fe4516). *@
                @if (isRunning && agents.Count > 0)
                {
                <Panel Title="Агенты" Class="rise rise-3" Flush="true">
                    <MetaContent>
                        @if (isRunning)
                        {
                            <text>@agents.Count в работе · @chart.UpdatedAt.ToLowerInvariant()</text>
                        }
                        else
                        {
                            <text>@agents.Count @Plural(agents.Count, "агент", "агента", "агентов") · сессия завершена</text>
                        }
                    </MetaContent>
                    <ChildContent>
                        @if (agents.Count == 0)
                        {
                            <div class="agents__skeleton">
                                @for (var i = 0; i < 4; i++)
                                {
                                    <div class="agents__skeleton-row">
                                        <Skeleton Width="160px" Height="14px" />
                                        <Skeleton Width="88px" Height="12px" />
                                        <Skeleton Width="72px" Height="12px" />
                                        <Skeleton Width="220px" Height="12px" />
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            @* Таблица строится тем же построителем, что и на «Агентах»
                               (Services/AgentRoster): раньше страница группировала
                               агентов сама и рисовала строку группы всегда, включая
                               «×1» — четыре строки «Маркет-мейкер ×1» подряд при
                               четырёх агентах. Раздел 9.8: группа из одного экземпляра
                               строки группы не получает, единственный экземпляр
                               выводится обычной строкой. Пункт 10 docs/ui-backlog.md.

                               «Торги» показывают только верхний уровень — строку типа:
                               агрегат, когда экземпляров несколько, и сам экземпляр,
                               когда он один. Разбор по экземплярам живёт на «Агентах»,
                               и дублировать его здесь незачем (раздел 9.0). *@
                            var roster = AgentRoster.Build(agents, SessionDecisions);
                            var rows = roster.Rows
                                .Where(row => row.Kind == AgentRowKind.Group || row.ShowTypeDot)
                                .ToArray();

                            <div class="agents-wrap">
                            <table class="agents">
                                <thead>
                                    <tr>
                                        <th scope="col" class="label agents__c-name">Агент</th>
                                        <th scope="col" class="label agents__c-num">Деньги</th>
                                        <th scope="col" class="label agents__c-num">Позиция</th>
                                        <th scope="col" class="label agents__c-num">P/L</th>
                                        <th scope="col" class="label agents__c-why">Действие и объяснение</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in rows)
                                    {
                                        <tr @key="row.Title">
                                            <th scope="row" class="agents__c-name">
                                                <span class="agents__cell">
                                                <StatusDot Tone="@AgentTone(row.Type)" />
                                                <span class="agents__name">
                                                    <span class="agents__title">@row.Title</span>
                                                    <span class="agents__kind">@Kind(row.Type)</span>
                                                </span>
                                                </span>
                                            </th>
                                            <td class="agents__c-num num-sm">@Money0(row.Cash)</td>
                                            <td class="agents__c-num num-sm @DeltaTone(row.Position)">@Position0(row.Position)</td>
                                            <td class="agents__c-num num-sm @DeltaTone(row.Pnl)">@Pnl2(row.Pnl)</td>
                                            <td class="agents__c-why">
                                                @if (row.Action is null && row.Explanation is null)
                                                {
                                                    <span class="nodata">—</span>
                                                }
                                                else
                                                {
                                                    <span class="agents__why">
                                                        @if (row.Action is not null)
                                                        {
                                                            <span class="agents__why-act">@row.Action</span>
                                                        }
                                                        @if (row.Explanation is not null)
                                                        {
                                                            <span class="agents__why-reason" title="@row.Explanation">@row.Explanation</span>
                                                        }
                                                    </span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <th scope="row" class="agents__c-name">Итого · @roster.AgentCount @Plural(roster.AgentCount, "агент", "агента", "агентов")</th>
                                        <td class="agents__c-num num-sm">@Money0(roster.TotalCash)</td>
                                        <td class="agents__c-num num-sm @DeltaTone(roster.TotalPosition)">@Position0(roster.TotalPosition)</td>
                                        <td class="agents__c-num num-sm @DeltaTone(roster.TotalPnl)">@Pnl2(roster.TotalPnl)</td>
                                        @* Текстовая колонка итоговой строки пуста: раздел 9.8
                                           запрещает служебное перечисление в колонке
                                           «объяснение», а число агентов уже стоит в
                                           заголовке строки. Пункт 11 docs/ui-backlog.md. *@
                                        <td class="agents__c-why"></td>
                                    </tr>
                                </tfoot>
                            </table>
                            </div>
                        }
                    </ChildContent>
                </Panel>

                }
            </div>

            @* ─────────── ПРАВЫЙ РЕЛЬС ─────────── *@
            <div class="rail rail--right">

                <Panel Title="Стакан заявок" Class="rise rise-2" Flush="true">
                    <MetaContent>
                        @* Шаг агрегации уровней: цены в стакане округляются именно по нему
                           (раздел 11), и до сих пор он на экране не назывался нигде. *@
                        @if (BookStep is { } step)
                        {
                            <text>шаг <span class="num-sm">@FormatPrice(step)</span></text>
                        }
                    </MetaContent>
                    <ChildContent>
                        @if (!isRunning && latestTick is null)
                        {
                            @* Кнопки запуска здесь нет: она стоит в шапке страницы, экран
                               помещается целиком, и раздел 17 запрещает дублировать
                               основное действие сверху и снизу. Пункт 18. *@
                            <EmptyState IconName="book"
                                        Title="Заявок нет"
                                        Description="Торги остановлены — агенты сняли открытые заявки. Стакан наполнится после запуска сессии." />
                        }
                        else
                        {
                            <div class="book">
                                <div class="book__head">
                                    <span class="label">Цена</span>
                                    <span class="label book__c-vol">Объём</span>
                                    <span class="label book__c-orders">Заявок</span>
                                </div>

                                <div class="book__side">
                                    @foreach (var row in book.Asks.TakeLast(7))
                                    {
                                        <div class="book__row @(row.IsEmpty ? "is-empty" : null)">
                                            <span class="book__bar book__bar--ask" style="@row.DepthStyle" aria-hidden="true"></span>
                                            <span class="num-sm book__c-price tone-down">@row.Price</span>
                                            <span class="num-sm book__c-vol">@row.Volume</span>
                                            <span class="num-sm book__c-orders">@row.Orders</span>
                                        </div>
                                    }
                                </div>

                                @* Спред и мид считаются по ОТОБРАЖАЕМЫМ ценам стакана,
                                   иначе строка спреда противоречит строкам над и под ней. *@
                                <div class="book__spread">
                                    <span>спред <span class="num-sm">@(book.BestAsk is { } ba && book.BestBid is { } bb ? FormatPrice(ba - bb) : "—") ₽</span></span>
                                    <span>мид <span class="num-sm">@(book.BestAsk is { } ma && book.BestBid is { } mb ? FormatPrice((ma + mb) / 2m) : "—") ₽</span></span>
                                </div>

                                <div class="book__side">
                                    @foreach (var row in book.Bids.Take(7))
                                    {
                                        <div class="book__row @(row.IsEmpty ? "is-empty" : null)">
                                            <span class="book__bar book__bar--bid" style="@row.DepthStyle" aria-hidden="true"></span>
                                            <span class="num-sm book__c-price tone-up">@row.Price</span>
                                            <span class="num-sm book__c-vol">@row.Volume</span>
                                            <span class="num-sm book__c-orders">@row.Orders</span>
                                        </div>
                                    }
                                </div>

                                @* Лучшие цены обеих сторон — подвал стакана (артборды 01–03).
                                   Раздел 9.0: bid и ask принадлежат стакану, и это их место. *@
                                <div class="book__best hairline-top">
                                    <span>лучший bid <span class="num-sm tone-up">@(book.BestBid is { } bb2 ? FormatPrice(bb2) : "—")</span></span>
                                    <span>ask <span class="num-sm tone-down">@(book.BestAsk is { } ba2 ? FormatPrice(ba2) : "—")</span></span>
                                </div>
                            </div>
                        }
                    </ChildContent>
                </Panel>

                <Panel Title="Лента сделок" Class="tape-panel rise rise-3" Flush="true">
                    <MetaContent>
                        @if (trades.Length > 0)
                        {
                            <text>последние <span class="num-sm">@trades.Length</span></text>
                        }
                        else if (!isRunning && SessionTick is not null)
                        {
                            <text>сессия завершена</text>
                        }
                    </MetaContent>
                    <ChildContent>
                        @if (trades.Length == 0)
                        {
                            @* Пустое состояние у ленты было единственным, которого не
                               существовало: при пустом списке оставались заголовок,
                               мета «нет сделок» и легенда четырёх типов агентов над
                               пустым прямоугольником в четыреста пикселей высотой.
                               Пункт 22 docs/ui-backlog.md, раздел 14. *@
                            @if (isRunning)
                            {
                                <EmptyState IconName="activity"
                                            Title="Сделок пока нет"
                                            Description="Агенты выставили заявки — сделка появится, как только цены сойдутся." />
                            }
                            else
                            {
                                <EmptyState IconName="activity"
                                            Title="Лента пуста"
                                            Description="Здесь идут сделки текущей сессии. Сделки закончившейся сохранены и видны на странице агента." />
                            }
                        }
                        else
                        {
                        <div class="tape">
                            <div class="tape__list">
                                @foreach (var trade in trades)
                                {
                                    <div class="tape__row" title="@trade.Buyer ← @trade.Seller">
                                        <span class="num-xs tape__time">@trade.Time</span>
                                        <span class="num-sm @(trade.SideClass == "buy" ? "tone-up" : "tone-down")">
                                            @(trade.SideClass == "buy" ? "↗" : "↘") @trade.Price
                                        </span>
                                        <span class="num-sm tape__qty">@trade.Volume</span>
                                        <span class="tape__pair">
                                            <StatusDot Tone="@NameTone(trade.Buyer)" />
                                            <span class="num-xs tape__arrow">←</span>
                                            <StatusDot Tone="@NameTone(trade.Seller)" />
                                        </span>
                                    </div>
                                }
                            </div>

                            <div class="tape__legend">
                                <StatusDot Tone="agent-trend">Трендовый</StatusDot>
                                <StatusDot Tone="agent-counter">Контр-тренд</StatusDot>
                                <StatusDot Tone="agent-mm">Маркет-мейкер</StatusDot>
                                <StatusDot Tone="agent-news">Новостной</StatusDot>
                            </div>
                        </div>
                        }
                    </ChildContent>
                </Panel>
            </div>
        </div>
    </main>
</div>

@code {
    // Список таймфреймов переехал в Services/Timeframes: тот же список
    // рисуется на «Профиле» в настройке «таймфрейм по умолчанию», и два
    // списка подписей разошлись бы при первой же правке.
    private static readonly IReadOnlyDictionary<string, TimeframeOption> TimeframesByKey =
        Timeframes.All.ToDictionary(item => item.Key, StringComparer.Ordinal);

    private const decimal DemoStartPrice = 124.35m;
    private const int MetricHistoryLimit = 72;
    private const int VisibleOrderBookDepth = 50;

    private ActiveAssetView CurrentAsset => ActiveAssetContext.GetView();
    private OrderBookViewData OrderBookData => BuildOrderBookData(latestTick?.OrderBook);

    private SpreadData Spread => BuildSpreadData(latestTick);

    private StatusStripData Status => BuildStatusStripData(latestTick);

    private TradeRow[] RecentTrades => BuildTradeRows(tradeHistory);

    private ChartSummaryData ChartSummary => BuildChartSummaryData(GetSelectedTimeframeState(), latestTick, lastChartUpdate);
    // Значение по умолчанию совпадает с дефолтом настройки: пока настройки
    // не прочитаны, на экране ровно то, что было здесь до её появления.
    private string selectedTimeframe = Timeframes.DefaultKey;
    private SimulationTickResult? latestTick;
    private DateTimeOffset lastChartUpdate = DateTimeOffset.Now;
    private DateTimeOffset runStartedAt = DateTimeOffset.Now;
    private ElementReference chartViewport;
    private IJSObjectReference? tradingChartModule;
    private bool isChartRegistered;
    private bool tradeHistoryPrimed;
    private bool chartStatePrimed;
    private ChartSyncPayload? pendingChartSync;
    private readonly HashSet<Guid> seenTradeIds = [];
    private readonly HashSet<Guid> processedTradeIds = [];
    private readonly Dictionary<string, TimeframeSeriesState> timeframeSeriesStates = CreateTimeframeSeriesStates();
    private readonly List<Trade> tradeHistory = [];
    private readonly HashSet<string> loadedHistoryTimeframes = [];
    private SimulationRunSummary? currentRunSummary;
    private Guid observedRunId = Guid.Empty;
    private DateTimeOffset lastSummaryRead = DateTimeOffset.MinValue;

    /// <summary>Как часто перечитывается сводка прогона — как на «Агентах».</summary>
    private static readonly TimeSpan SummaryRefreshInterval = TimeSpan.FromSeconds(1);

    /// <summary>
    /// Состав сессии: из текущего тика, а когда тиков больше нет — из истории
    /// прогона. Пункт 13 docs/ui-backlog.md: после остановки страница
    /// показывала «Сделок 0», «Шаг симуляции —» и пустую таблицу, хотя сессия
    /// только что шла и в ней были сделки.
    /// </summary>
    private IReadOnlyList<AgentSnapshot> SessionAgents =>
        latestTick?.Agents is { Count: > 0 } agents ? agents : EquityHistory.LastAgents;

    private IReadOnlyList<AgentDecision> SessionDecisions =>
        latestTick?.Agents is { Count: > 0 } ? latestTick.Decisions ?? [] : EquityHistory.LastDecisions;

    /// <summary>
    /// Сделок за сессию — из сводки прогона, а не из локального счётчика
    /// страницы: seenTradeIds считает только то, что увидел ЭТОТ экземпляр
    /// компонента, и обнуляется при каждом заходе на страницу. Тот же источник,
    /// что у «Агентов», — иначе две страницы называли бы разные числа.
    /// </summary>
    private int SessionTradeCount => currentRunSummary?.TradeCount ?? seenTradeIds.Count;

    /// <summary>
    /// Сделок в минуту за сессию. Шаг симуляции — секунда, значит число тиков
    /// это секунды прогона. Пока тиков меньше минуты, показывать нечего:
    /// «120 сделок в минуту» на десяти секундах — экстраполяция, а не измерение.
    /// </summary>
    private decimal? TradesPerMinute => currentRunSummary is { TickCount: >= 60 } summary
        ? Math.Round(summary.TradeCount * 60m / summary.TickCount, 0, MidpointRounding.AwayFromZero)
        : null;

    /// <summary>Шаг агрегации уровней стакана — разница соседних отображаемых цен.</summary>
    private decimal? BookStep
    {
        get
        {
            var prices = latestTick?.OrderBook.Asks
                .Select(level => level.Price)
                .OrderBy(price => price)
                .ToArray() ?? [];

            if (prices.Length < 2)
            {
                return null;
            }

            var steps = prices.Zip(prices.Skip(1), (a, b) => b - a).Where(step => step > 0m).ToArray();
            return steps.Length == 0 ? null : steps.Min();
        }
    }

    /// <summary>Шаг симуляции: из тика, после остановки — из сводки прогона.</summary>
    private int? SessionTick => latestTick?.Tick ?? currentRunSummary?.TickCount;

    /// <summary>
    /// Длительность закончившейся сессии. Времени окончания в сводке прогона
    /// нет, но шаг симуляции — ровно секунда (CreateSessionConfig), поэтому
    /// число тиков и есть длительность в секундах. Выдумывать её из разницы
    /// «сейчас минус старт» нельзя: страницу могли открыть через час.
    /// </summary>
    private string SessionDuration => currentRunSummary is { TickCount: > 0 } summary
        ? TimeSpan.FromSeconds(summary.TickCount).ToString(@"hh\:mm\:ss")
        : "—";

    private TimeframeSeriesState GetSelectedTimeframeState() => timeframeSeriesStates[selectedTimeframe];

    private void SelectTimeframe(string timeframe)
    {
        selectedTimeframe = timeframe;
        LoadPersistedCandles(timeframe, forceScrollToRealtime: true);
        pendingChartSync = BuildFullChartSyncPayload(forceScrollToRealtime: true);
    }

    protected override void OnInitialized()
    {
        SimulationRunner.OnTick += HandleTick;
        NewsFeed.Changed += HandleNewsFeedChanged;
        latestTick = SimulationRunner.Current;
        if (latestTick is not null)
        {
            PrimeFromSnapshot(latestTick, DateTimeOffset.Now);
        }

        // Свечи грузятся и когда тика нет: заход на страницу после остановки —
        // это разбор закончившейся сессии, и график в нём главная панель.
        LoadPersistedCandles(selectedTimeframe, forceScrollToRealtime: true);

        // Заход на страницу торги НЕ запускает. Раньше отсюда вызывался
        // EnsureSimulationAsync, и переход по ссылке сам стартовал сессию: из-за
        // этого «торги не запущены» и «торги остановлены» на этой странице были
        // ненаблюдаемы, кнопка «Запустить торги» — недостижима, а кнопка
        // остановки бессмысленна, потому что любой возврат запускал прогон
        // заново. Запуск — явное действие человека, и живёт оно в одном месте:
        // в кнопке ниже.
        UpdateRunSummary();
    }

    private async Task EnsureSimulationAsync()
    {
        // Load the summary for the currently running singleton simulation first, so the
        // match check below sees the real asset name/type instead of falling back to
        // CurrentAsset.IsFallback on a freshly-created component (which would needlessly
        // restart an already-matching run on re-navigation).
        UpdateRunSummary();

        if (SimulationRunner.IsRunning && SimulationMatchesCurrentAsset())
        {
            UpdateRunSummary();
            return;
        }

        if (SimulationRunner.IsRunning)
        {
            await SimulationRunner.StopAsync();
        }

        // Новый запуск — новый период. Счётчики страницы обнуляются вместе с биржей.
        // Раньше сброс происходил только при замене ИДУЩЕЙ симуляции, поэтому после
        // «остановить → запустить» рядом оказывались метрики разных запусков: биржа
        // считала объём с нуля, а сделки, свечи и лента оставались от прошлого прогона.
        ResetViewState();

        await SimulationRunner.StartAsync(CreateSessionConfig(CurrentAsset));
        UpdateRunSummary();
    }

    private void HandleTick(SimulationTickResult tickResult)
    {
        _ = InvokeAsync(() =>
        {
            ApplyTick(tickResult);
            StateHasChanged();
        });
    }

    private void ApplyTick(SimulationTickResult tickResult)
    {
        var receivedAt = DateTimeOffset.Now;
        latestTick = tickResult;
        lastChartUpdate = receivedAt;
        UpdateRunSummary();
        SyncCompositionFromRun(tickResult);
        UpdateTradeHistory(tickResult);
        UpdateChartSeries(tickResult, receivedAt);
        LoadPersistedCandles(selectedTimeframe);
        _ = TrySyncChartAsync();
    }

    private async Task TrySyncChartAsync()
    {
        if (pendingChartSync is null)
        {
            return;
        }

        try
        {
            var modulePath = Assets["Components/Pages/Trading.razor.js"];
            if (!modulePath.StartsWith("./", StringComparison.Ordinal) &&
                !modulePath.StartsWith("/", StringComparison.Ordinal) &&
                !modulePath.StartsWith("http", StringComparison.OrdinalIgnoreCase))
            {
                modulePath = $"./{modulePath}";
            }

            tradingChartModule ??= await JS.InvokeAsync<IJSObjectReference>("import", modulePath);

            if (!isChartRegistered)
            {
                await tradingChartModule.InvokeVoidAsync("register", chartViewport);
                isChartRegistered = true;
            }

            var payload = pendingChartSync;
            await tradingChartModule.InvokeVoidAsync("sync", chartViewport, payload);
            pendingChartSync = null;
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
            // ElementReference is not ready yet; OnAfterRenderAsync will sync.
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ApplyPreferredTimeframeAsync();
        }

        if (pendingChartSync is not null)
        {
            await TrySyncChartAsync();
        }
    }

    /// <summary>
    /// Таймфрейм по умолчанию с «Профиля». Применяется после первой
    /// отрисовки, а не в OnInitialized: настройка лежит в localStorage, а до
    /// первой отрисовки JS-интеропа в Blazor Server не существует.
    ///
    /// EnsureLoadedAsync идемпотентен — макет вызывает его же, и кто из двоих
    /// успел первым, неважно.
    /// </summary>
    private async Task ApplyPreferredTimeframeAsync()
    {
        await Preferences.EnsureLoadedAsync();

        var preferred = Preferences.DefaultTimeframe;

        if (preferred == selectedTimeframe)
        {
            return;
        }

        SelectTimeframe(preferred);
        StateHasChanged();
    }

    private static Dictionary<string, TimeframeSeriesState> CreateTimeframeSeriesStates() =>
        Timeframes.All.ToDictionary(item => item.Key, item => new TimeframeSeriesState(item), StringComparer.Ordinal);

    private void PrimeFromSnapshot(SimulationTickResult tickResult, DateTimeOffset receivedAt)
    {
        PrimeTradeHistory(tickResult);
        PrimeChartSeries(tickResult, receivedAt);
    }

    private void PrimeTradeHistory(SimulationTickResult tickResult)
    {
        if (tradeHistoryPrimed)
        {
            return;
        }

        tradeHistory.Clear();
        var seededTrades = tickResult.Snapshot.RecentTrades
            .OrderBy(trade => trade.ExecutedAt)
            .ToArray();

        foreach (var trade in seededTrades)
        {
            if (!seenTradeIds.Add(trade.Id))
            {
                continue;
            }

            tradeHistory.Add(trade);
        }

        tradeHistoryPrimed = true;
    }

    private void PrimeChartSeries(SimulationTickResult tickResult, DateTimeOffset receivedAt)
    {
        if (chartStatePrimed)
        {
            return;
        }

        var bootstrapEvents = BuildBootstrapEvents(tickResult.Snapshot, receivedAt);
        if (bootstrapEvents.Count == 0)
        {
            ApplyLiveEventToAllTimeframes(new LivePriceEvent(GetFallbackEventTimestamp(tickResult.Snapshot, receivedAt), tickResult.Snapshot.LastPrice));
        }
        else
        {
            foreach (var liveEvent in bootstrapEvents)
            {
                ApplyLiveEventToAllTimeframes(liveEvent);
            }
        }

        foreach (var trade in tickResult.Snapshot.RecentTrades)
        {
            processedTradeIds.Add(trade.Id);
        }

        chartStatePrimed = true;
        pendingChartSync = BuildFullChartSyncPayload(forceScrollToRealtime: true);
    }

    private void UpdateChartSeries(SimulationTickResult tickResult, DateTimeOffset receivedAt)
    {
        if (!chartStatePrimed)
        {
            PrimeChartSeries(tickResult, receivedAt);
            return;
        }

        var snapshot = tickResult.Snapshot;
        var liveEvents = snapshot.RecentTrades
            .Where(trade => processedTradeIds.Add(trade.Id))
            .OrderBy(trade => trade.ExecutedAt)
            .Select(trade => new LivePriceEvent(trade.ExecutedAt, trade.Price))
            .ToArray();

        if (liveEvents.Length == 0)
        {
            var selectedState = GetSelectedTimeframeState();
            if (selectedState.Candles.Count == 0 ||
                selectedState.Candles[^1].Close != snapshot.LastPrice)
            {
                liveEvents =
                [
                    new LivePriceEvent(GetFallbackEventTimestamp(snapshot, receivedAt), snapshot.LastPrice)
                ];
            }
        }

        if (liveEvents.Length == 0)
        {
            return;
        }

        var selectedStateChanged = false;
        var createdBarsForSelectedTimeframe = 0;

        foreach (var liveEvent in liveEvents)
        {
            foreach (var timeframe in Timeframes.All)
            {
                var result = AppendLiveEvent(timeframeSeriesStates[timeframe.Key], liveEvent);
                if (!result.Changed || timeframe.Key != selectedTimeframe)
                {
                    continue;
                }

                selectedStateChanged = true;
                if (result.CreatedNewBar)
                {
                    createdBarsForSelectedTimeframe++;
                }
            }
        }

        if (!selectedStateChanged)
        {
            return;
        }

        var selectedSeries = GetSelectedTimeframeState();
        pendingChartSync = createdBarsForSelectedTimeframe > 1
            ? BuildFullChartSyncPayload(forceScrollToRealtime: false)
            : BuildIncrementalChartSyncPayload(selectedSeries.Candles[^1], forceScrollToRealtime: false);
    }

    private void ResetViewState()
    {
        latestTick = null;
        currentRunSummary = null;
        observedRunId = Guid.Empty;
        runStartedAt = DateTimeOffset.Now;
        lastChartUpdate = DateTimeOffset.Now;
        chartStatePrimed = false;
        tradeHistoryPrimed = false;
        pendingChartSync = null;
        tradeHistory.Clear();
        seenTradeIds.Clear();
        processedTradeIds.Clear();
        loadedHistoryTimeframes.Clear();

        foreach (var state in timeframeSeriesStates.Values)
        {
            state.Candles.Clear();
        }
    }

    private void UpdateRunSummary()
    {
        // Прогон закончился — раннер обнулил CurrentRunId, и спрашивать сводку
        // стало не у кого. Идентификатор берётся из истории прогона: она знает,
        // какому прогону принадлежит её состав, и переживает остановку. Тем же
        // приёмом это решено на «Агентах» (коммит 3fe4516).
        var runId = SimulationRunner.CurrentRunId;
        if (runId == Guid.Empty)
        {
            runId = EquityHistory.RunId;
        }

        if (runId == Guid.Empty)
        {
            currentRunSummary = null;
            observedRunId = Guid.Empty;
            return;
        }

        // Время старта в сводке неизменно, а число сделок и тиков растёт:
        // кешировать её на весь прогон нельзя, счётчики замрут на значении
        // первого тика.
        var now = DateTimeOffset.Now;

        if (observedRunId == runId
            && currentRunSummary is not null
            && now - lastSummaryRead < SummaryRefreshInterval)
        {
            runStartedAt = currentRunSummary.StartedAt.ToLocalTime();
            return;
        }

        currentRunSummary = SimulationHistoryReader.GetRun(runId);
        observedRunId = runId;
        lastSummaryRead = now;

        if (currentRunSummary is not null)
        {
            runStartedAt = currentRunSummary.StartedAt.ToLocalTime();
        }
    }

    private bool SimulationMatchesCurrentAsset()
    {
        if (currentRunSummary is null)
        {
            return CurrentAsset.IsFallback;
        }

        return string.Equals(currentRunSummary.AssetName, CurrentAsset.Draft.Name, StringComparison.Ordinal) &&
               currentRunSummary.AssetType == CurrentAsset.Draft.AssetType;
    }

    private const int MaxAgentsPerType = 8;
    private const int MinTotalAgents = 1;
    private const int MaxTotalAgents = 32;

    // Значения по умолчанию — ровно те, что были зашиты в конфиг до появления
    // формы, чтобы поведение без вмешательства пользователя не изменилось.
    // Стартовая позиция задаётся типом и в UI не выводится: её изменение
    // поехало бы в базу расчёта P/L.
    private readonly AgentCompositionRow[] agentComposition =
    [
        new(AgentType.TrendFollowing, 110_000m, 60m, "идёт за импульсом по двум средним"),
        new(AgentType.CounterTrend, 110_000m, 60m, "торгует откаты к средней"),
        new(AgentType.MarketMaker, 140_000m, 160m, "держит заявки по обе стороны"),
        new(AgentType.NewsDriven, 105_000m, 55m, "ждёт первую новость, до неё неактивен")
    ];

    private Guid syncedCompositionRunId = Guid.Empty;

    private int TotalAgentCount => agentComposition.Sum(row => row.Count);

    private decimal TotalCompositionCapital => agentComposition.Sum(row => row.TotalCapital);

    // Ноль агентов типа — допустимо, поэтому капитал проверяется только у тех
    // строк, которые реально попадут в сессию.
    private static bool HasCapitalError(AgentCompositionRow row) => row.Count > 0 && row.Capital <= 0m;

    private bool IsCompositionValid =>
        TotalAgentCount >= MinTotalAgents &&
        TotalAgentCount <= MaxTotalAgents &&
        agentComposition.All(row => row.Count >= 0 && row.Count <= MaxAgentsPerType && !HasCapitalError(row));

    private void ChangeAgentCount(AgentCompositionRow row, int delta) =>
        row.Count = Math.Clamp(row.Count + delta, 0, MaxAgentsPerType);

    /// <summary>
    /// Приводит форму к составу, которым реально идёт сессия: после перезагрузки
    /// страницы посреди прогона форма иначе показывала бы значения по умолчанию,
    /// а не то, чем торгуют на экране.
    /// </summary>
    private void SyncCompositionFromRun(SimulationTickResult tickResult)
    {
        var runId = SimulationRunner.CurrentRunId;
        if (runId == Guid.Empty || syncedCompositionRunId == runId)
        {
            return;
        }

        syncedCompositionRunId = runId;

        foreach (var row in agentComposition)
        {
            var live = tickResult.Agents.Where(agent => agent.Type == row.Type).ToArray();
            row.Count = live.Length;

            if (live.Length > 0)
            {
                row.Capital = Math.Round(live[0].InitialCash, 0, MidpointRounding.AwayFromZero);
            }
        }
    }

    private SimulationConfig CreateSessionConfig(ActiveAssetView asset) =>
        new(
            asset.Draft.Name,
            asset.Profile.Description,
            asset.Draft.AssetType,
            CalculateStartPrice(asset),
            TimeSpan.FromSeconds(1),
            agentComposition
                .Where(row => row.Count > 0)
                .SelectMany(row => Enumerable.Repeat(
                    new AgentSpec(row.Type, row.Capital, row.DefaultPosition),
                    row.Count))
                .ToArray());

    private sealed class AgentCompositionRow(
        AgentType type,
        decimal capital,
        decimal defaultPosition,
        string behaviour)
    {
        public AgentType Type { get; } = type;
        public decimal DefaultPosition { get; } = defaultPosition;
        public string Behaviour { get; } = behaviour;

        public int Count { get; set; } = 1;
        public decimal Capital { get; set; } = capital;

        public decimal TotalCapital => Count * Capital;
    }

    private static decimal CalculateStartPrice(ActiveAssetView asset)
    {
        if (asset.IsFallback)
        {
            return DemoStartPrice;
        }

        var basePrice = asset.Draft.AssetType switch
        {
            AssetType.Stock => 96m,
            AssetType.Bond => 101m,
            AssetType.Commodity => 88m,
            AssetType.Crypto => 72m,
            _ => DemoStartPrice
        };

        var adjusted = basePrice
            + asset.Draft.GrowthPotential * 0.42m
            + (asset.Draft.IncludeGovernmentSupport ? 4m : 0m)
            + asset.Profile.NewsSensitivity * 10m;

        return Math.Round(adjusted / 0.05m, MidpointRounding.AwayFromZero) * 0.05m;
    }

    private void UpdateTradeHistory(SimulationTickResult tickResult)
    {
        if (!tradeHistoryPrimed)
        {
            PrimeTradeHistory(tickResult);
            return;
        }

        var newTrades = tickResult.Snapshot.RecentTrades
            .Where(trade => seenTradeIds.Add(trade.Id))
            .OrderBy(trade => trade.ExecutedAt)
            .ToArray();

        foreach (var trade in newTrades)
        {
            tradeHistory.Add(trade);
        }
    }

    private static List<LivePriceEvent> BuildBootstrapEvents(MarketSnapshot snapshot, DateTimeOffset receivedAt)
    {
        var trades = snapshot.RecentTrades
            .OrderBy(trade => trade.ExecutedAt)
            .Select(trade => new LivePriceEvent(trade.ExecutedAt, trade.Price))
            .ToList();

        if (trades.Count > 0)
        {
            return trades;
        }

        var prices = snapshot.RecentPrices.TakeLast(MetricHistoryLimit).ToArray();
        if (prices.Length == 0)
        {
            return [];
        }

        var anchor = GetFallbackEventTimestamp(snapshot, receivedAt);
        var start = anchor - TimeSpan.FromSeconds(Math.Max(0, prices.Length - 1));
        var events = new List<LivePriceEvent>(prices.Length);

        for (var index = 0; index < prices.Length; index++)
        {
            events.Add(new LivePriceEvent(start.AddSeconds(index), prices[index]));
        }

        return events;
    }

    private static DateTimeOffset GetFallbackEventTimestamp(MarketSnapshot snapshot, DateTimeOffset receivedAt)
    {
        var latestTradeTime = snapshot.RecentTrades.Count == 0
            ? (DateTimeOffset?)null
            : snapshot.RecentTrades.MaxBy(trade => trade.ExecutedAt)?.ExecutedAt;

        return latestTradeTime ?? receivedAt;
    }

    private void ApplyLiveEventToAllTimeframes(LivePriceEvent liveEvent)
    {
        foreach (var timeframe in Timeframes.All)
        {
            AppendLiveEvent(timeframeSeriesStates[timeframe.Key], liveEvent);
        }
    }

    private static TimeframeAppendResult AppendLiveEvent(TimeframeSeriesState state, LivePriceEvent liveEvent)
    {
        var timestamp = AlignToTimeframe(liveEvent.Timestamp, state.Definition.Duration);
        var candles = state.Candles;
        var price = liveEvent.Price;

        if (candles.Count == 0)
        {
            candles.Add(new AggregatedCandle(timestamp, price, price, price, price));
            return new TimeframeAppendResult(true, true);
        }

        var lastCandle = candles[^1];
        if (lastCandle.Timestamp == timestamp)
        {
            var updated = false;

            if (price != lastCandle.Close)
            {
                lastCandle.Close = price;
                updated = true;
            }

            if (price > lastCandle.High)
            {
                lastCandle.High = price;
                updated = true;
            }

            if (price < lastCandle.Low)
            {
                lastCandle.Low = price;
                updated = true;
            }

            return new TimeframeAppendResult(updated, false);
        }

        if (timestamp > lastCandle.Timestamp)
        {
            candles.Add(new AggregatedCandle(timestamp, price, price, price, price));
            return new TimeframeAppendResult(true, true);
        }

        var existingCandle = candles.FirstOrDefault(candle => candle.Timestamp == timestamp);
        if (existingCandle is not null)
        {
            var updated = false;

            if (price != existingCandle.Close)
            {
                existingCandle.Close = price;
                updated = true;
            }

            if (price > existingCandle.High)
            {
                existingCandle.High = price;
                updated = true;
            }

            if (price < existingCandle.Low)
            {
                existingCandle.Low = price;
                updated = true;
            }

            return new TimeframeAppendResult(updated, false);
        }

        var insertIndex = candles.FindIndex(candle => candle.Timestamp > timestamp);
        if (insertIndex < 0)
        {
            candles.Add(new AggregatedCandle(timestamp, price, price, price, price));
        }
        else
        {
            candles.Insert(insertIndex, new AggregatedCandle(timestamp, price, price, price, price));
        }

        return new TimeframeAppendResult(true, false);
    }

    private static DateTimeOffset AlignToTimeframe(DateTimeOffset timestamp, TimeSpan duration)
    {
        var seconds = Math.Max(1L, (long)duration.TotalSeconds);
        var unixSeconds = timestamp.ToUnixTimeSeconds();
        var remainder = unixSeconds % seconds;
        if (remainder < 0)
        {
            remainder += seconds;
        }

        return DateTimeOffset.FromUnixTimeSeconds(unixSeconds - remainder);
    }

    private ChartSyncPayload BuildFullChartSyncPayload(bool forceScrollToRealtime)
    {
        var state = GetSelectedTimeframeState();
        return new ChartSyncPayload(
            "setData",
            state.Definition.Key,
            forceScrollToRealtime,
            state.Candles.Select(ToChartCandlePoint).ToArray(),
            null);
    }

    private ChartSyncPayload BuildIncrementalChartSyncPayload(AggregatedCandle candle, bool forceScrollToRealtime)
    {
        return new ChartSyncPayload(
            "update",
            selectedTimeframe,
            forceScrollToRealtime,
            null,
            ToChartCandlePoint(candle));
    }

    private static ChartSummaryData BuildChartSummaryData(
        TimeframeSeriesState state,
        SimulationTickResult? tickResult,
        DateTimeOffset updatedAt)
    {
        var fallbackPrice = tickResult?.Snapshot.LastPrice ?? DemoStartPrice;
        if (state.Candles.Count == 0)
        {
            var fallbackText = FormatPrice(fallbackPrice);
            return new ChartSummaryData(
                fallbackText,
                fallbackText,
                fallbackText,
                fallbackText,
                "+0.00 (0.00%)",
                "neutral",
                tickResult is null ? "Торги не запущены" : "Торги запущены",
                "Ожидание данных");
        }

        var sessionOpen = state.Candles[0].Open;
        var sessionClose = state.Candles[^1].Close;
        var sessionHigh = state.Candles.Max(candle => candle.High);
        var sessionLow = state.Candles.Min(candle => candle.Low);
        var change = sessionClose - sessionOpen;
        var percent = sessionOpen == 0m ? 0m : change / sessionOpen * 100m;
        var sign = change > 0m ? "+" : change < 0m ? "" : "";
        var changeClass = change > 0m ? "positive" : change < 0m ? "negative" : "neutral";

        return new ChartSummaryData(
            FormatPrice(sessionOpen),
            FormatPrice(sessionHigh),
            FormatPrice(sessionLow),
            FormatPrice(sessionClose),
            $"{sign}{FormatPrice(change)} ({sign}{percent:0.00}%)",
            changeClass,
            tickResult is null ? "Торги не запущены" : "Торги запущены",
            $"Обновлено {updatedAt.ToLocalTime():HH:mm:ss}");
    }

    private static ChartCandlePoint ToChartCandlePoint(AggregatedCandle candle)
    {
        var isUp = candle.Close > candle.Open;
        var isDown = candle.Close < candle.Open;

        return new ChartCandlePoint(
            candle.Timestamp.ToUnixTimeSeconds(),
            candle.Open,
            candle.High,
            candle.Low,
            candle.Close,
            isUp ? "#36D98A" : isDown ? "#FF6B5F" : "#B7C2D5",
            isUp ? "#36D98A" : isDown ? "#FF6B5F" : "#A1B2CC",
            isUp ? "#65F1AB" : isDown ? "#FF8A80" : "#D0D9E6");
    }

    private void LoadPersistedCandles(string timeframeKey, bool forceScrollToRealtime = false)
    {
        if (!TimeframesByKey.TryGetValue(timeframeKey, out var timeframe))
        {
            return;
        }

        // После остановки CurrentRunId обнулён, но свечи закончившегося прогона
        // никуда не делись — график обязан показывать разбор сессии, а не
        // «Нет данных» (пункт 13 docs/ui-backlog.md).
        var runId = SimulationRunner.CurrentRunId;
        if (runId == Guid.Empty)
        {
            runId = EquityHistory.RunId;
        }

        if (runId == Guid.Empty)
        {
            return;
        }

        if (!forceScrollToRealtime && loadedHistoryTimeframes.Contains(timeframeKey))
        {
            return;
        }

        var persistedCandles = CandleReader
            .GetCandles(runId, timeframe.Duration, GetPersistedCandleLimit(timeframeKey))
            .Select(candle => new AggregatedCandle(
                candle.StartedAt,
                candle.Open,
                candle.High,
                candle.Low,
                candle.Close))
            .ToArray();

        if (persistedCandles.Length == 0)
        {
            return;
        }

        loadedHistoryTimeframes.Add(timeframeKey);
        MergeExternalCandles(timeframeKey, persistedCandles, forceScrollToRealtime);
    }

    private static int GetPersistedCandleLimit(string timeframeKey) =>
        timeframeKey switch
        {
            "10s" => 180,
            "30s" => 180,
            "1m" => 180,
            "5m" => 144,
            "15m" => 96,
            "1h" => 72,
            _ => 180
        };

    private void MergeExternalCandles(string timeframeKey, IEnumerable<AggregatedCandle> candles, bool forceScrollToRealtime = false)
    {
        if (!TimeframesByKey.ContainsKey(timeframeKey))
        {
            return;
        }

        var state = timeframeSeriesStates[timeframeKey];
        var selectedTimeframeChanged = false;

        foreach (var candle in candles.OrderBy(item => item.Timestamp))
        {
            var changed = UpsertAggregatedCandle(state, candle);
            selectedTimeframeChanged |= changed && timeframeKey == selectedTimeframe;
        }

        if (selectedTimeframeChanged)
        {
            pendingChartSync = BuildFullChartSyncPayload(forceScrollToRealtime);
        }
    }

    private static bool UpsertAggregatedCandle(TimeframeSeriesState state, AggregatedCandle candle)
    {
        var timestamp = AlignToTimeframe(candle.Timestamp, state.Definition.Duration);
        var existingIndex = state.Candles.FindIndex(item => item.Timestamp == timestamp);
        if (existingIndex >= 0)
        {
            var existing = state.Candles[existingIndex];
            var changed = existing.Open != candle.Open ||
                          existing.High != candle.High ||
                          existing.Low != candle.Low ||
                          existing.Close != candle.Close;

            existing.Open = candle.Open;
            existing.High = candle.High;
            existing.Low = candle.Low;
            existing.Close = candle.Close;
            return changed;
        }

        var insertIndex = state.Candles.FindIndex(item => item.Timestamp > timestamp);
        var normalized = new AggregatedCandle(timestamp, candle.Open, candle.High, candle.Low, candle.Close);
        if (insertIndex < 0)
        {
            state.Candles.Add(normalized);
        }
        else
        {
            state.Candles.Insert(insertIndex, normalized);
        }

        return true;
    }

    private static OrderBookViewData BuildOrderBookData(OrderBookSnapshot? orderBook)
    {
        var asks = GetVisibleOrderBookLevels(orderBook?.Asks ?? [], reverse: true, isAsk: true);
        var bids = GetVisibleOrderBookLevels(orderBook?.Bids ?? [], reverse: false, isAsk: false);

        // Асксы перевёрнуты по убыванию — лучший в конце; биды по убыванию — лучший первый.
        var bestAsk = asks.Length == 0 ? (decimal?)null : asks[^1].Price;
        var bestBid = bids.Length == 0 ? (decimal?)null : bids[0].Price;

        return new OrderBookViewData(
            bestBid,
            bestAsk,
            BuildOrderBookRows(asks),
            BuildOrderBookRows(bids));
    }

    private static OrderBookLevel[] GetVisibleOrderBookLevels(
        IReadOnlyList<OrderBookLevel> levels,
        bool reverse,
        bool isAsk)
    {
        var visibleLevels = OrderBookDisplay.Aggregate(levels, isAsk).Take(VisibleOrderBookDepth).ToArray();
        if (reverse)
        {
            Array.Reverse(visibleLevels);
        }

        return visibleLevels;
    }

    private static OrderBookRow[] BuildOrderBookRows(IReadOnlyList<OrderBookLevel> levels)
    {
        var maxQuantity = levels.Count == 0 ? 0m : levels.Max(level => level.Quantity);
        var rows = levels
            .Select(level =>
            {
                var depth = CalculateDepth(level.Quantity, maxQuantity);

                return new OrderBookRow(
                    FormatPrice(level.Price),
                    level.Quantity.ToString("N1"),
                    level.OrdersCount.ToString(),
                    depth,
                    $"width: {depth}%;",
                    false);
            })
            .ToList();

        if (rows.Count == 0)
        {
            rows.Add(new OrderBookRow("—", "—", "—", 0, "width: 0%;", true));
        }

        return rows.ToArray();
    }

    private static TradeRow[] BuildTradeRows(IReadOnlyList<Trade> trades) =>
        trades
            .OrderByDescending(trade => trade.ExecutedAt)
            .Take(50)
            .Select(trade => new TradeRow(
                trade.ExecutedAt.ToLocalTime().ToString("HH:mm:ss"),
                FormatPrice(trade.Price),
                trade.Quantity.ToString("N1"),
                FormatAgentName(trade.BuyerAgentName),
                FormatAgentName(trade.SellerAgentName),
                GetTradeClass(trade)))
            .ToArray();

    private SpreadData BuildSpreadData(SimulationTickResult? tickResult)
    {
        var snapshot = tickResult?.Snapshot;
        if (snapshot?.BestBid is null || snapshot.BestAsk is null)
        {
            return new SpreadData("— / —", "Спред недоступен");
        }

        var spread = snapshot.BestAsk.Value - snapshot.BestBid.Value;
        var mid = (snapshot.BestAsk.Value + snapshot.BestBid.Value) / 2m;
        var spreadPercent = mid == 0m ? 0m : spread / mid * 100m;

        return new SpreadData(
            $"{FormatMoney(snapshot.BestBid.Value)} / {FormatMoney(snapshot.BestAsk.Value)}",
            $"Спред {FormatPrice(spread)} ₽ ({spreadPercent:0.00}%)");
    }

    private StatusStripData BuildStatusStripData(SimulationTickResult? tickResult)
    {
        var snapshot = tickResult?.Snapshot;
        var prices = snapshot?.RecentPrices.Count > 0
            ? snapshot.RecentPrices
            : [DemoStartPrice];
        var low = prices.Min();
        var high = prices.Max();
        var last = snapshot?.LastPrice ?? DemoStartPrice;
        var rangePosition = high == low ? 50 : (int)Math.Round((last - low) / (high - low) * 100m);
        var spread = BuildSpreadData(tickResult);
        var bidDepth = tickResult?.OrderBook.Bids.Sum(level => level.Quantity) ?? 0m;
        var askDepth = tickResult?.OrderBook.Asks.Sum(level => level.Quantity) ?? 0m;
        var totalDepth = bidDepth + askDepth;
        var liquidity = GetLiquidity(tickResult, totalDepth);
        var elapsed = DateTimeOffset.Now - runStartedAt;

        return new StatusStripData(
            elapsed.ToString(@"hh\:mm\:ss"),
            FormatQuantity(seenTradeIds.Count),
            FormatQuantity(tickResult?.Agents.Count ?? 0),
            $"{FormatMoney(low)} - {FormatMoney(high)}",
            $"left: {Math.Clamp(rangePosition, 0, 100)}%",
            liquidity.Label,
            liquidity.ClassName,
            $"{spread.Detail}; глубина {FormatQuantity(totalDepth)} шт.");
    }

    private static string FormatMoney(decimal value) => $"{value:F2} ₽";

    private static string FormatPrice(decimal value) => value.ToString("F2");

    private static string FormatQuantity(decimal value) => value % 1m == 0m
        ? value.ToString("0")
        : value.ToString("0.##");

    private static int CalculateDepth(decimal quantity, decimal maxQuantity)
    {
        if (maxQuantity <= 0m)
        {
            return 0;
        }

        var depth = (int)Math.Ceiling((double)(quantity / maxQuantity * 100m));
        return Math.Clamp(depth, 8, 100);
    }

    private static string GetTradeClass(Trade trade)
    {
        if (trade.BuyerAgentName.Contains("MarketMaker", StringComparison.Ordinal))
        {
            return "sell";
        }

        return "buy";
    }

    private static string FormatAgentName(string agentName)
    {
        if (string.IsNullOrWhiteSpace(agentName))
        {
            return "-";
        }

        var normalized = agentName.Trim();
        var compactName = normalized switch
        {
            "TrendFollowing" => "Trend",
            "CounterTrend" => "Counter",
            "MarketMaker" => "Maker",
            "NewsDriven" => "News",
            _ => null
        };

        if (compactName is not null)
        {
            return compactName;
        }

        if (normalized.Contains("TrendFollowing", StringComparison.Ordinal))
        {
            return normalized.Replace("TrendFollowing", "Trend", StringComparison.Ordinal);
        }

        if (normalized.Contains("CounterTrend", StringComparison.Ordinal))
        {
            return normalized.Replace("CounterTrend", "Counter", StringComparison.Ordinal);
        }

        if (normalized.Contains("MarketMaker", StringComparison.Ordinal))
        {
            return normalized.Replace("MarketMaker", "Maker", StringComparison.Ordinal);
        }

        if (normalized.Contains("NewsDriven", StringComparison.Ordinal))
        {
            return normalized.Replace("NewsDriven", "News", StringComparison.Ordinal);
        }

        var builder = new System.Text.StringBuilder(normalized.Length + 4);

        for (var index = 0; index < normalized.Length; index++)
        {
            var current = normalized[index];
            if (index > 0 &&
                char.IsUpper(current) &&
                (char.IsLower(normalized[index - 1]) ||
                 (index + 1 < normalized.Length && char.IsLower(normalized[index + 1]))))
            {
                builder.Append(' ');
            }

            builder.Append(current);
        }

        return builder.ToString();
    }

    private static (string Label, string ClassName) GetLiquidity(SimulationTickResult? tickResult, decimal totalDepth)
    {
        if (tickResult?.Snapshot.BestBid is null || tickResult.Snapshot.BestAsk is null)
        {
            return ("Нет данных", "");
        }

        var mid = (tickResult.Snapshot.BestBid.Value + tickResult.Snapshot.BestAsk.Value) / 2m;
        var spreadPercent = mid == 0m ? 100m : (tickResult.Snapshot.BestAsk.Value - tickResult.Snapshot.BestBid.Value) / mid *
100m;

        if (spreadPercent <= 0.5m && totalDepth >= 10m)
        {
            return ("Высокая", "positive");
        }

        if (spreadPercent <= 2m && totalDepth >= 4m)
        {
            return ("Средняя", "");
        }

        return ("Низкая", "negative");
    }

    private void HandleNewsFeedChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        SimulationRunner.OnTick -= HandleTick;
        NewsFeed.Changed -= HandleNewsFeedChanged;
    }

    public async ValueTask DisposeAsync()
    {
        SimulationRunner.OnTick -= HandleTick;
        NewsFeed.Changed -= HandleNewsFeedChanged;

        if (tradingChartModule is null)
        {
            return;
        }

        try
        {
            if (isChartRegistered)
            {
                await tradingChartModule.InvokeVoidAsync("dispose", chartViewport);
            }

            await tradingChartModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

