    private void StopDebugScenario()
    {
        debugScenarioCts?.Cancel();
    }

    private async Task RunDebugScenarioAsync(
        string scenarioLabel,
        IReadOnlyList<DebugScenarioStep> steps,
        IReadOnlyList<DebugScenarioSupportAgent>? supportAgents = null)
    {
        var debugControl = DebugControl;
        if (debugControl is null || steps.Count == 0 || isRunningDebugScenario)
        {
            return;
        }

        isRunningDebugScenario = true;
        debugScenarioCts = new CancellationTokenSource();
        var token = debugScenarioCts.Token;
        var totalTrades = 0;
        var acceptedOrders = 0;
        var rejectedOrders = 0;
        var activatedSupportAgents = ActivateScenarioSupportAgents(debugControl, supportAgents);

        debugMessage = activatedSupportAgents > 0
            ? $"{scenarioLabel}: сценарий запущен, усилители рынка {activatedSupportAgents}"
            : $"{scenarioLabel}: сценарий запущен";
        await InvokeAsync(StateHasChanged);

        try
        {
            for (var index = 0; index < steps.Count; index++)
            {
                token.ThrowIfCancellationRequested();

                var step = steps[index];
                var result = SubmitDebugScenarioOrder(
                    debugControl,
                    scenarioLabel,
                    index + 1,
                    step.Side,
                    step.Quantity);

                totalTrades += result.Trades.Count;
                acceptedOrders += result.AcceptedOrders.Count;
                rejectedOrders += result.RejectedOrders.Count;

                debugMessage = $"{scenarioLabel}: шаг {index + 1}/{steps.Count}, сделок {totalTrades}";
                await InvokeAsync(StateHasChanged);

                if (index < steps.Count - 1)
                {
                    await Task.Delay(step.DelayMs, token);
                }
            }

            debugMessage = $"{scenarioLabel}: завершён, принято {acceptedOrders}, сделок {totalTrades}, отказов {rejectedOrders}";
        }
        catch (OperationCanceledException)
        {
            debugMessage = $"{scenarioLabel}: сценарий остановлен";
        }
        catch (Exception exception)
        {
            debugMessage = exception.Message;
        }
        finally
        {
            isRunningDebugScenario = false;
            debugScenarioCts?.Dispose();
            debugScenarioCts = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static SubmitResult SubmitDebugScenarioOrder(
        ISimulationDebugControl debugControl,
        string scenarioLabel,
        int stepIndex,
        OrderSide side,
        decimal quantity)
    {
        return debugControl.SubmitOrder(new SimulationDebugOrderRequest(
            $"{scenarioLabel}-{stepIndex:00}",
            side,
            OrderType.Market,
            null,
            quantity));
    }

    private int ActivateScenarioSupportAgents(
        ISimulationDebugControl debugControl,
        IReadOnlyList<DebugScenarioSupportAgent>? supportAgents)
    {
        if (supportAgents is not { Count: > 0 })
        {
            return 0;
        }

        var activated = 0;

        foreach (var supportAgent in supportAgents)
        {
            if (!activeScenarioSupportAgentKeys.Add(supportAgent.Key))
            {
                continue;
            }

            debugControl.AddAgent(new AgentSpec(supportAgent.Type, supportAgent.Cash, supportAgent.Position));
            activated++;
        }

        return activated;
    }

    private void ResetViewState()
    {
        latestTick = null;
        currentRunSummary = null;
        observedRunId = Guid.Empty;
        runStartedAt = DateTimeOffset.Now;
        lastChartUpdate = DateTimeOffset.Now;
        chartStatePrimed = false;
        metricsPrimed = false;
        previousVolume = 0m;
        pendingChartSync = null;
        priceMetricHistory.Clear();
        bidMetricHistory.Clear();
        askMetricHistory.Clear();
        volumeMetricHistory.Clear();
        tradeHistory.Clear();
        seenTradeIds.Clear();
        processedTradeIds.Clear();
        loadedHistoryTimeframes.Clear();
        activeScenarioSupportAgentKeys.Clear();

        foreach (var state in timeframeSeriesStates.Values)
        {
            state.Candles.Clear();
        }
    }

    private void UpdateRunSummary()
    {
        var runId = SimulationRunner.CurrentRunId;
        if (runId == Guid.Empty)
        {
            currentRunSummary = null;
            observedRunId = Guid.Empty;
            return;
        }

        if (observedRunId == runId && currentRunSummary is not null)
        {
            runStartedAt = currentRunSummary.StartedAt.ToLocalTime();
            return;
        }

        currentRunSummary = SimulationHistoryReader.GetRun(runId);
        observedRunId = runId;

        if (currentRunSummary is not null)
        {
            runStartedAt = currentRunSummary.StartedAt.ToLocalTime();
        }
    }

    private bool SimulationMatchesCurrentAsset()
    {
        if (currentRunSummary is null)
        {
            return CurrentAsset.IsFallback;
        }

        return string.Equals(currentRunSummary.AssetName, CurrentAsset.Draft.Name, StringComparison.Ordinal) &&
               currentRunSummary.AssetType == CurrentAsset.Draft.AssetType;
    }

    private const int MaxAgentsPerType = 8;
    private const int MinTotalAgents = 1;
    private const int MaxTotalAgents = 32;

    // Значения по умолчанию — ровно те, что были зашиты в конфиг до появления
    // формы, чтобы поведение без вмешательства пользователя не изменилось.
    // Стартовая позиция задаётся типом и в UI не выводится: её изменение
    // поехало бы в базу расчёта P/L.
    private readonly AgentCompositionRow[] agentComposition =
    [
        new(AgentType.TrendFollowing, 110_000m, 60m, "идёт за импульсом по двум средним"),
        new(AgentType.CounterTrend, 110_000m, 60m, "торгует откаты к средней"),
        new(AgentType.MarketMaker, 140_000m, 160m, "держит заявки по обе стороны"),
        new(AgentType.NewsDriven, 105_000m, 55m, "ждёт первую новость, до неё неактивен")
    ];

    private Guid syncedCompositionRunId = Guid.Empty;

    private int TotalAgentCount => agentComposition.Sum(row => row.Count);

    private decimal TotalCompositionCapital => agentComposition.Sum(row => row.TotalCapital);

    // Ноль агентов типа — допустимо, поэтому капитал проверяется только у тех
    // строк, которые реально попадут в сессию.
    private static bool HasCapitalError(AgentCompositionRow row) => row.Count > 0 && row.Capital <= 0m;

    private bool IsCompositionValid =>
        TotalAgentCount >= MinTotalAgents &&
        TotalAgentCount <= MaxTotalAgents &&
        agentComposition.All(row => row.Count >= 0 && row.Count <= MaxAgentsPerType && !HasCapitalError(row));

    private void ChangeAgentCount(AgentCompositionRow row, int delta) =>
        row.Count = Math.Clamp(row.Count + delta, 0, MaxAgentsPerType);

    /// <summary>
    /// Приводит форму к составу, которым реально идёт сессия: после перезагрузки
    /// страницы посреди прогона форма иначе показывала бы значения по умолчанию,
    /// а не то, чем торгуют на экране.
    /// </summary>
    private void SyncCompositionFromRun(SimulationTickResult tickResult)
    {
        var runId = SimulationRunner.CurrentRunId;
        if (runId == Guid.Empty || syncedCompositionRunId == runId)
        {
            return;
        }

        syncedCompositionRunId = runId;

        foreach (var row in agentComposition)
        {
            var live = tickResult.Agents.Where(agent => agent.Type == row.Type).ToArray();
            row.Count = live.Length;

            if (live.Length > 0)
            {
                row.Capital = Math.Round(live[0].InitialCash, 0, MidpointRounding.AwayFromZero);
            }
        }
    }

    private SimulationConfig CreateSessionConfig(ActiveAssetView asset) =>
        new(
            asset.Draft.Name,
            asset.Profile.Description,
            asset.Draft.AssetType,
            CalculateStartPrice(asset),
            TimeSpan.FromSeconds(1),
            agentComposition
                .Where(row => row.Count > 0)
                .SelectMany(row => Enumerable.Repeat(
                    new AgentSpec(row.Type, row.Capital, row.DefaultPosition),
                    row.Count))
                .ToArray());

    private sealed class AgentCompositionRow(
        AgentType type,
        decimal capital,
        decimal defaultPosition,
        string behaviour)
    {
        public AgentType Type { get; } = type;
        public decimal DefaultPosition { get; } = defaultPosition;
        public string Behaviour { get; } = behaviour;

        public int Count { get; set; } = 1;
        public decimal Capital { get; set; } = capital;

        public decimal TotalCapital => Count * Capital;
    }

    private static decimal CalculateStartPrice(ActiveAssetView asset)
    {
        if (asset.IsFallback)
        {
            return DemoStartPrice;
        }

        var basePrice = asset.Draft.AssetType switch
        {
            AssetType.Stock => 96m,
            AssetType.Bond => 101m,
            AssetType.Commodity => 88m,
            AssetType.Crypto => 72m,
            _ => DemoStartPrice
        };

        var adjusted = basePrice
            + asset.Draft.GrowthPotential * 0.42m
            + (asset.Draft.IncludeGovernmentSupport ? 4m : 0m)
            + asset.Profile.NewsSensitivity * 10m;

        return Math.Round(adjusted / 0.05m, MidpointRounding.AwayFromZero) * 0.05m;
    }

    private void UpdateMetricHistory(SimulationTickResult tickResult)
    {
        if (!metricsPrimed)
        {
            PrimeMetricHistory(tickResult);
            return;
        }

        var snapshot = tickResult.Snapshot;
        AppendMetricValue(priceMetricHistory, snapshot.LastPrice);
        AppendMetricValue(bidMetricHistory, snapshot.BestBid ?? snapshot.LastPrice);
        AppendMetricValue(askMetricHistory, snapshot.BestAsk ?? snapshot.LastPrice);

        var newTrades = snapshot.RecentTrades
            .Where(trade => seenTradeIds.Add(trade.Id))
            .OrderBy(trade => trade.ExecutedAt)
            .ToArray();

        if (newTrades.Length == 0)
        {
            var volumeDelta = Math.Max(0m, snapshot.Volume - previousVolume);
            AppendMetricValue(volumeMetricHistory, volumeDelta);
        }
        else
        {
            foreach (var trade in newTrades)
            {
                tradeHistory.Add(trade);
                AppendMetricValue(volumeMetricHistory, trade.Quantity);
            }
        }

        previousVolume = snapshot.Volume;
    }

    private static void AppendMetricValue(List<decimal> values, decimal value)
    {
        values.Add(value);
        if (values.Count > MetricHistoryLimit)
        {
            values.RemoveRange(0, values.Count - MetricHistoryLimit);
        }
    }

    private static List<LivePriceEvent> BuildBootstrapEvents(MarketSnapshot snapshot, DateTimeOffset receivedAt)
    {
        var trades = snapshot.RecentTrades
            .OrderBy(trade => trade.ExecutedAt)
            .Select(trade => new LivePriceEvent(trade.ExecutedAt, trade.Price))
            .ToList();

        if (trades.Count > 0)
        {
            return trades;
        }

        var prices = snapshot.RecentPrices.TakeLast(MetricHistoryLimit).ToArray();
        if (prices.Length == 0)
        {
            return [];
        }

        var anchor = GetFallbackEventTimestamp(snapshot, receivedAt);
        var start = anchor - TimeSpan.FromSeconds(Math.Max(0, prices.Length - 1));
        var events = new List<LivePriceEvent>(prices.Length);

        for (var index = 0; index < prices.Length; index++)
        {
            events.Add(new LivePriceEvent(start.AddSeconds(index), prices[index]));
        }

        return events;
    }

    private static DateTimeOffset GetFallbackEventTimestamp(MarketSnapshot snapshot, DateTimeOffset receivedAt)
    {
        var latestTradeTime = snapshot.RecentTrades.Count == 0
            ? (DateTimeOffset?)null
            : snapshot.RecentTrades.MaxBy(trade => trade.ExecutedAt)?.ExecutedAt;

        return latestTradeTime ?? receivedAt;
    }

    private void ApplyLiveEventToAllTimeframes(LivePriceEvent liveEvent)
    {
        foreach (var timeframe in Timeframes)
        {
            AppendLiveEvent(timeframeSeriesStates[timeframe.Key], liveEvent);
        }
    }

    private static TimeframeAppendResult AppendLiveEvent(TimeframeSeriesState state, LivePriceEvent liveEvent)
    {
        var timestamp = AlignToTimeframe(liveEvent.Timestamp, state.Definition.Duration);
        var candles = state.Candles;
        var price = liveEvent.Price;

        if (candles.Count == 0)
        {
            candles.Add(new AggregatedCandle(timestamp, price, price, price, price));
            return new TimeframeAppendResult(true, true);
        }

        var lastCandle = candles[^1];
        if (lastCandle.Timestamp == timestamp)
        {
            var updated = false;

            if (price != lastCandle.Close)
            {
                lastCandle.Close = price;
                updated = true;
            }

            if (price > lastCandle.High)
            {
                lastCandle.High = price;
                updated = true;
            }

            if (price < lastCandle.Low)
            {
                lastCandle.Low = price;
                updated = true;
            }

            return new TimeframeAppendResult(updated, false);
        }

        if (timestamp > lastCandle.Timestamp)
        {
            candles.Add(new AggregatedCandle(timestamp, price, price, price, price));
            return new TimeframeAppendResult(true, true);
        }

        var existingCandle = candles.FirstOrDefault(candle => candle.Timestamp == timestamp);
        if (existingCandle is not null)
        {
            var updated = false;

            if (price != existingCandle.Close)
            {
                existingCandle.Close = price;
                updated = true;
            }

            if (price > existingCandle.High)
            {
                existingCandle.High = price;
                updated = true;
            }

            if (price < existingCandle.Low)
            {
                existingCandle.Low = price;
                updated = true;
            }

            return new TimeframeAppendResult(updated, false);
        }

        var insertIndex = candles.FindIndex(candle => candle.Timestamp > timestamp);
        if (insertIndex < 0)
        {
            candles.Add(new AggregatedCandle(timestamp, price, price, price, price));
        }
        else
        {
            candles.Insert(insertIndex, new AggregatedCandle(timestamp, price, price, price, price));
        }

        return new TimeframeAppendResult(true, false);
    }

    private static DateTimeOffset AlignToTimeframe(DateTimeOffset timestamp, TimeSpan duration)
    {
        var seconds = Math.Max(1L, (long)duration.TotalSeconds);
        var unixSeconds = timestamp.ToUnixTimeSeconds();
        var remainder = unixSeconds % seconds;
        if (remainder < 0)
        {
            remainder += seconds;
        }

        return DateTimeOffset.FromUnixTimeSeconds(unixSeconds - remainder);
    }

