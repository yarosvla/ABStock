    private async Task RunDebugScenarioAsync(
        string scenarioLabel,
        IReadOnlyList<DebugScenarioStep> steps,
        IReadOnlyList<DebugScenarioSupportAgent>? supportAgents = null)
    {
        var debugControl = DebugControl;
        if (debugControl is null || steps.Count == 0 || isRunningDebugScenario)
        {
            return;
        }

        isRunningDebugScenario = true;
        debugScenarioCts = new CancellationTokenSource();
        var token = debugScenarioCts.Token;
        var totalTrades = 0;
        var acceptedOrders = 0;
        var rejectedOrders = 0;
        var activatedSupportAgents = ActivateScenarioSupportAgents(debugControl, supportAgents);

        debugMessage = activatedSupportAgents > 0
            ? $"{scenarioLabel}: сценарий запущен, усилители рынка {activatedSupportAgents}"
            : $"{scenarioLabel}: сценарий запущен";
        await InvokeAsync(StateHasChanged);

        try
        {
            for (var index = 0; index < steps.Count; index++)
            {
                token.ThrowIfCancellationRequested();

                var step = steps[index];
                var result = SubmitDebugScenarioOrder(
                    debugControl,
                    scenarioLabel,
                    index + 1,
                    step.Side,
                    step.Quantity);

                totalTrades += result.Trades.Count;
                acceptedOrders += result.AcceptedOrders.Count;
                rejectedOrders += result.RejectedOrders.Count;

                debugMessage = $"{scenarioLabel}: шаг {index + 1}/{steps.Count}, сделок {totalTrades}";
                await InvokeAsync(StateHasChanged);

                if (index < steps.Count - 1)
                {
                    await Task.Delay(step.DelayMs, token);
                }
            }

            debugMessage = $"{scenarioLabel}: завершён, принято {acceptedOrders}, сделок {totalTrades}, отказов {rejectedOrders}";
        }
        catch (OperationCanceledException)
        {
            debugMessage = $"{scenarioLabel}: сценарий остановлен";
        }
        catch (Exception exception)
        {
            debugMessage = exception.Message;
        }
        finally
        {
            isRunningDebugScenario = false;
            debugScenarioCts?.Dispose();
            debugScenarioCts = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static SubmitResult SubmitDebugScenarioOrder(
        ISimulationDebugControl debugControl,
        string scenarioLabel,
        int stepIndex,
        OrderSide side,
        decimal quantity)
    {
        return debugControl.SubmitOrder(new SimulationDebugOrderRequest(
            $"{scenarioLabel}-{stepIndex:00}",
            side,
            OrderType.Market,
            null,
            quantity));
    }

    private int ActivateScenarioSupportAgents(
        ISimulationDebugControl debugControl,
        IReadOnlyList<DebugScenarioSupportAgent>? supportAgents)
    {
        if (supportAgents is not { Count: > 0 })
        {
            return 0;
        }

        var activated = 0;

        foreach (var supportAgent in supportAgents)
        {
            if (!activeScenarioSupportAgentKeys.Add(supportAgent.Key))
            {
                continue;
            }

            debugControl.AddAgent(new AgentSpec(supportAgent.Type, supportAgent.Cash, supportAgent.Position));
            activated++;
        }

        return activated;
    }

