    private sealed record TradeRow(string Time, string Price, string Volume, string Buyer, string Seller, string SideClass);
    private sealed record ChartSummaryData(
        string Open,
        string High,
        string Low,
        string Close,
        string Change,
        string ChangeClass,
        string MarketState,
        string UpdatedAt);
    private sealed record ChartSyncPayload(
        string Action,
        string Timeframe,
        bool ForceScrollToRealtime,
        IReadOnlyList<ChartCandlePoint>? Data,
        ChartCandlePoint? Candle);
    private sealed record ChartCandlePoint(
        long Time,
        decimal Open,
        decimal High,
        decimal Low,
        decimal Close,
        string Color,
        string BorderColor,
        string WickColor);
    private sealed record LivePriceEvent(DateTimeOffset Timestamp, decimal Price);
    private sealed record TimeframeAppendResult(bool Changed, bool CreatedNewBar);
    private sealed class AggregatedCandle
    {
        public AggregatedCandle(DateTimeOffset timestamp, decimal open, decimal high, decimal low, decimal close)
        {
            Timestamp = timestamp;
            Open = open;
            High = high;
            Low = low;
            Close = close;
        }

        public DateTimeOffset Timestamp { get; set; }
        public decimal Open { get; set; }
        public decimal High { get; set; }
        public decimal Low { get; set; }
        public decimal Close { get; set; }
    }

    private sealed class TimeframeSeriesState
    {
        public TimeframeSeriesState(TimeframeOption definition)
        {
            Definition = definition;
        }

        public TimeframeOption Definition { get; }
        public List<AggregatedCandle> Candles { get; } = [];
    }

}
