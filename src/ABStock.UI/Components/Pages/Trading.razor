@page "/trading"
@layout CreateAssetLayout
@rendermode InteractiveServer
@using ABStock.Application.Simulation
@using ABStock.Shared
@implements IDisposable
@inject ISimulationRunner SimulationRunner

<PageTitle>Торги</PageTitle>

<div class="trading-shell">
    <nav class="top-navigation" aria-label="Основная навигация">
        <a class="brand" href="/create-asset" aria-label="ABStock">
            <span class="brand-mark" aria-hidden="true">
                <img src="images/abstock-logo.png" alt="" />
            </span>
            <span class="brand-name">ABStock</span>
        </a>

        <div class="nav-links" aria-label="Разделы">
            <a href="/create-asset">Создание актива</a>
            <a class="active" href="/trading">Торги</a>
            <a href="#news-screen">Новости</a>
            <a href="#agents-screen">Агенты</a>
            <a href="#profile-screen">Профиль</a>
        </div>

        <div class="nav-actions">
            <span class="market-status"><span aria-hidden="true"></span>Торги запущены</span>
            <span class="clock-chip"><i class="bi bi-clock" aria-hidden="true"></i>15:42:18</span>
            <span class="date-chip">23 мая 2025</span>
            <button class="icon-button" type="button" aria-label="Уведомления">
                <i class="bi bi-bell" aria-hidden="true"></i>
                <span class="notification-badge">3</span>
            </button>
            <button class="icon-button" type="button" aria-label="Настройки">
                <i class="bi bi-gear" aria-hidden="true"></i>
            </button>
            <button class="avatar-button" type="button" aria-label="Профиль пользователя">АК</button>
        </div>
    </nav>

    <main class="trading-main">
        <header class="page-heading">
            <div>
                <p class="breadcrumbs">
                    <a href="/create-asset">Создание актива</a>
                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                    <span>Торги</span>
                </p>
                <h1>Экран торгов</h1>
                <p>Торги по активу запущены. Следите за ценой, ликвидностью и последними сделками</p>
            </div>
        </header>

        <section class="trading-grid" aria-label="Рабочее место трейдера">
            <aside class="left-column">
                <section class="glass-card asset-card" aria-labelledby="asset-title">
                    <div class="asset-head">
                        <span class="asset-emblem" aria-hidden="true">
                            <i class="bi bi-lightning-charge-fill"></i>
                        </span>
                        <div>
                            <h2 id="asset-title">КвантЭнерго</h2>
                            <div class="asset-meta">
                                <span>KZEN</span>
                                <span>Акция</span>
                                <span>Энергетика</span>
                            </div>
                            <p class="asset-state"><i class="bi bi-check-circle-fill" aria-hidden="true"></i>Актив создан</p>
                        </div>
                    </div>
                    <p class="asset-description">Инновационная энергетическая компания, разрабатывающая и внедряющая системы накопления энергии нового поколения на основе квантовых технологий.</p>
                </section>

                <section class="glass-card parameter-card" aria-labelledby="parameters-title">
                    <h2 id="parameters-title">Параметры актива</h2>
                    <dl class="parameter-list">
                        @foreach (var parameter in AssetParameters)
                        {
                            <div>
                                <dt>@parameter.Label</dt>
                                <dd class="@parameter.ValueClass">@parameter.Value</dd>
                            </div>
                        }
                    </dl>
                </section>
            </aside>

            <section class="center-column">
                <div class="metrics-strip" aria-label="Ключевые рыночные показатели">
                    @foreach (var metric in MarketMetrics)
                    {
                        <article class="glass-card metric-card @metric.Accent">
                            <span>@metric.Label</span>
                            <strong>@metric.Value</strong>
                            <small>@metric.Detail</small>
                            @if (metric.Accent == "volume")
                            {
                                <svg class="volume-bars" viewBox="0 0 96 42" aria-hidden="true">
                                    <rect x="4" y="28" width="7" height="10" rx="2" />
                                    <rect x="14" y="22" width="7" height="16" rx="2" />
                                    <rect x="24" y="16" width="7" height="22" rx="2" />
                                    <rect x="34" y="10" width="7" height="28" rx="2" />
                                    <rect x="44" y="18" width="7" height="20" rx="2" />
                                    <rect x="54" y="24" width="7" height="14" rx="2" />
                                    <rect x="64" y="20" width="7" height="18" rx="2" />
                                    <rect x="74" y="24" width="7" height="14" rx="2" />
                                    <rect x="84" y="26" width="7" height="12" rx="2" />
                                </svg>
                            }
                            else
                            {
                                <svg class="sparkline-chart" viewBox="0 0 96 42" aria-hidden="true">
                                    <polygon points="@metric.Projection" />
                                    <polyline points="@metric.Sparkline" />
                                </svg>
                            }
                        </article>
                    }
                </div>

                <section class="glass-card chart-card" aria-labelledby="chart-title">
                    <div class="chart-toolbar">
                        <div class="tool-icons" aria-hidden="true">
                            <i class="bi bi-crosshair"></i>
                            <i class="bi bi-slash-lg"></i>
                            <i class="bi bi-sliders"></i>
                            <i class="bi bi-brush"></i>
                            <i class="bi bi-type"></i>
                            <i class="bi bi-bounding-box"></i>
                            <i class="bi bi-emoji-smile"></i>
                            <i class="bi bi-rulers"></i>
                            <i class="bi bi-search"></i>
                            <i class="bi bi-magnet"></i>
                            <i class="bi bi-lock"></i>
                        </div>

                        <div class="chart-topline">
                            <div class="timeframe-row" aria-label="Таймфрейм">
                                @foreach (var item in Timeframes)
                                {
                                    <button class="@(item == selectedTimeframe ? "active" : null)" type="button" @onclick="() => SelectTimeframe(item)">@item</button>
                                }
                                <button type="button"><i class="bi bi-graph-up" aria-hidden="true"></i> Индикаторы</button>
                                <button type="button"><i class="bi bi-gear" aria-hidden="true"></i> Настройки</button>
                            </div>
                            <span class="market-active"><i class="bi bi-record-circle" aria-hidden="true"></i>Рынок активен</span>
                        </div>

                        <div class="chart-header">
                            <h2 id="chart-title">КвантЭнерго · @selectedTimeframe · ABStock</h2>
                            <dl>
                                <div><dt>ОТКР</dt><dd>124.22</dd></div>
                                <div><dt>МАКС</dt><dd>124.45</dd></div>
                                <div><dt>МИН</dt><dd>124.18</dd></div>
                                <div><dt>ЗАКР</dt><dd>124.35</dd></div>
                                <div><dt></dt><dd class="positive">+0.13 (+0.10%)</dd></div>
                            </dl>
                        </div>
                    </div>

                    <div class="chart-stage">
                        <svg class="price-chart" viewBox="0 0 960 430" role="img" aria-label="Свечной график цены КвантЭнерго">
                            <defs>
                                <linearGradient id="chartFill" x1="0" x2="0" y1="0" y2="1">
                                    <stop offset="0" stop-color="#142238" />
                                    <stop offset="1" stop-color="#0A1220" />
                                </linearGradient>
                            </defs>
                            <rect width="960" height="430" fill="url(#chartFill)" />

                            @foreach (var x in GridX)
                            {
                                <line class="grid-line" x1="@x" y1="18" x2="@x" y2="346" />
                            }
                            @foreach (var y in GridY)
                            {
                                <line class="grid-line" x1="20" y1="@y" x2="918" y2="@y" />
                            }

                            <line class="price-marker-line" x1="20" y1="112" x2="918" y2="112" />
                            <text class="volume-label" x="34" y="76">Объём (SMA, 9) <tspan>32.14K</tspan></text>
                            <polyline class="indicator-line ma-fast" points="20,258 120,240 220,224 320,204 420,176 520,148 620,121 720,112 820,126 918,118" />
                            <polyline class="indicator-line ma-slow" points="20,300 120,284 220,270 320,250 420,226 520,204 620,180 720,158 820,150 918,140" />
                            <polyline class="indicator-line vwap-line" points="20,282 140,268 260,254 380,236 500,218 620,198 740,184 860,172 918,164" />

                            @foreach (var candle in Candles)
                            {
                                <g class="candle @(candle.IsUp ? "up" : "down")">
                                    <line x1="@candle.X" y1="@candle.HighY" x2="@candle.X" y2="@candle.LowY" />
                                    <rect x="@(candle.X - 4)" y="@Math.Min(candle.OpenY, candle.CloseY)" width="8" height="@Math.Max(5, Math.Abs(candle.OpenY - candle.CloseY))" rx="1" />
                                    <rect class="volume" x="@(candle.X - 4)" y="@GetVolumeY(candle.Volume)" width="8" height="@candle.Volume" rx="1" />
                                </g>
                            }

                            <g class="axis-labels">
                                <text x="924" y="58">125.00</text>
                                <text x="924" y="112">124.35</text>
                                <text x="924" y="139">124.00</text>
                                <text x="924" y="193">123.50</text>
                                <text x="924" y="247">123.00</text>
                                <text x="924" y="301">122.50</text>
                                <text x="924" y="343">122.00</text>
                                <text x="34" y="377">10:00</text>
                                <text x="152" y="377">11:00</text>
                                <text x="270" y="377">12:00</text>
                                <text x="388" y="377">13:00</text>
                                <text x="506" y="377">14:00</text>
                                <text x="624" y="377">15:00</text>
                                <text x="742" y="377">16:00</text>
                                <text x="858" y="377">17:00</text>
                            </g>

                            <g class="price-tag">
                                <rect x="900" y="102" width="52" height="20" rx="3" />
                                <text x="908" y="116">124.35</text>
                            </g>
                            <g class="volume-tag">
                                <rect x="900" y="328" width="52" height="20" rx="3" />
                                <text x="908" y="342">32.14K</text>
                            </g>
                        </svg>
                    </div>

                    <footer class="chart-footer">
                        <span>15:42:18 (UTC+3)</span>
                    </footer>
                </section>
            </section>

            <aside class="right-column">
                <section class="glass-card order-book" aria-labelledby="book-title">
                    <h2 id="book-title">Книга заявок</h2>
                    <div class="book-head">
                        <span>Цена (₽)</span>
                        <span>Объём (шт.)</span>
                        <span>Сумма (шт.)</span>
                    </div>

                    <div class="book-side sells">
                        <svg class="book-depth-shape ask-depth" viewBox="0 0 300 125" preserveAspectRatio="none" aria-hidden="true">
                            <path d="M0 0 H220 V22 H210 V44 H238 V64 H252 V84 H276 V125 H0 Z" />
                            <path class="depth-line" d="M220 0 V22 H210 V44 H238 V64 H252 V84 H276 V125" />
                        </svg>
                        @foreach (var row in SellOrders)
                        {
                            <div class="book-row">
                                <strong>@row.Price</strong>
                                <span>@row.Volume</span>
                                <span>@row.Total</span>
                            </div>
                        }
                    </div>

                    <div class="spread-row">
                        <i class="bi bi-caret-left-fill" aria-hidden="true"></i>
                        <strong>124.35 ₽</strong>
                        <span>+4.65 ₽ (+3.88%)</span>
                    </div>

                    <div class="book-side buys">
                        <svg class="book-depth-shape bid-depth" viewBox="0 0 300 125" preserveAspectRatio="none" aria-hidden="true">
                            <path d="M300 0 H132 V22 H112 V44 H92 V64 H118 V86 H72 V125 H300 Z" />
                            <path class="depth-line" d="M132 0 V22 H112 V44 H92 V64 H118 V86 H72 V125" />
                        </svg>
                        @foreach (var row in BuyOrders)
                        {
                            <div class="book-row">
                                <strong>@row.Price</strong>
                                <span>@row.Volume</span>
                                <span>@row.Total</span>
                            </div>
                        }
                    </div>
                </section>

                <section class="glass-card trades-card" aria-labelledby="trades-title">
                    <h2 id="trades-title">Последние сделки</h2>
                    <div class="trade-head">
                        <span>Время</span>
                        <span>Цена (₽)</span>
                        <span>Объём (шт.)</span>
                        <span>Сторона</span>
                    </div>
                    @foreach (var trade in RecentTrades)
                    {
                        <div class="trade-row @trade.SideClass">
                            <span>@trade.Time</span>
                            <strong>@trade.Price</strong>
                            <span>@trade.Volume</span>
                            <em>@trade.Side</em>
                        </div>
                    }
                </section>
            </aside>
        </section>

        <section class="glass-card status-strip" aria-label="Статус рынка">
            <div class="status-primary">
                <span aria-hidden="true"><i class="bi bi-broadcast-pin"></i></span>
                <div>
                    <small>Статус рынка</small>
                    <strong>Торги запущены</strong>
                </div>
            </div>

            <div class="status-metric">
                <small>С момента запуска</small>
                <strong class="positive">00:18:42</strong>
            </div>
            <div class="status-metric">
                <small>Количество сделок</small>
                <strong>3 214</strong>
            </div>
            <div class="status-metric">
                <small>Участников</small>
                <strong>86</strong>
            </div>
            <div class="status-metric status-range">
                <small>Дневной диапазон</small>
                <strong>119.20 ₽ — 124.80 ₽</strong>
                <div class="range-track" aria-hidden="true">
                    <span></span>
                    <i></i>
                </div>
            </div>
            <div class="status-metric">
                <small>Ликвидность</small>
                <strong class="positive">Высокая</strong>
                <span>Спред 0.10 ₽ (0.08%)</span>
            </div>

            <button class="portfolio-button" type="button">
                <i class="bi bi-briefcase" aria-hidden="true"></i>
                <span>Открыть портфель</span>
            </button>
        </section>
    </main>
</div>

