    /// <summary>
    /// Агенты, свёрнутые по стратегиям, глазами этого актива. Решения
    /// соседних рынков нужны, чтобы стратегия, которая здесь ждёт, сказала,
    /// чем занята: «торгуют KVAN».
    /// </summary>
    private IReadOnlyList<StrategyRow> Strategies
    {
        get
        {
            if (Asset is not { } asset || Market is not { } market)
            {
                return [];
            }

            var elsewhere = Markets.Markets
                .Where(other => other.AssetId != asset.Id)
                .Select(other => (Asset: Registry.Find(other.AssetId), other.Last.Decisions))
                .Where(item => item.Asset is not null)
                .ToDictionary(item => item.Asset!.Symbol, item => item.Decisions);

            return StrategyTable.Build(asset.Id, asset.Symbol, market.LastPrice,
                market.Last.Accounts, market.Last.Decisions, elsewhere);
        }
    }

    /// <summary>Доля на дорожке 0–20 %: больше пятой части портфеля в одном активе не бывает.</summary>
    private static string ShareWidth(decimal share) =>
        (Math.Clamp(share / 20m, 0m, 1m) * 100m).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + "%";

    private string PageContext
    {
        get
        {
            var trading = Markets.Markets.Count;

            if (Markets.IsRunning && Markets.StartedAt is { } started)
            {
                return Market is null
                    ? "Торги идут · актив вступает в них"
                    : $"Торги · сессия открыта в {started:HH:mm} · в торгах {trading} {Plural(trading, "актив", "актива", "активов")}";
            }

            if (Markets.HasSession && Markets.StartedAt is { } from)
            {
                return Market is null
                    ? "Торги остановлены · актив в сессии не участвовал"
                    : $"Торги остановлены · сессия {from:HH:mm}–{(Markets.EndedAt ?? from):HH:mm}";
            }

            return "Торги не запущены · состав агентов — на «Активах»";
        }
    }

    /// <summary>
    /// Сделок за сессию — из сводки прогона, а не из локального счётчика
    /// страницы: seenTradeIds считает только то, что увидел ЭТОТ экземпляр
    /// компонента, и обнуляется при каждом заходе на страницу. Тот же источник,
    /// что у «Агентов», — иначе две страницы называли бы разные числа.
    /// </summary>
    private int SessionTradeCount => currentRunSummary?.TradeCount ?? seenTradeIds.Count;

    /// <summary>
    /// Сделок в минуту за сессию. Шаг симуляции — секунда, значит число тиков
    /// это секунды прогона. Пока тиков меньше минуты, показывать нечего:
    /// «120 сделок в минуту» на десяти секундах — экстраполяция, а не измерение.
    /// </summary>
    private decimal? TradesPerMinute => currentRunSummary is { TickCount: >= 60 } summary
        ? Math.Round(summary.TradeCount * 60m / summary.TickCount, 0, MidpointRounding.AwayFromZero)
        : null;

    /// <summary>
    /// Шаг агрегации уровней стакана — разница соседних ОТОБРАЖАЕМЫХ цен.
    /// Раньше шаг считался по сырым ценам заявок: разница между ними бывает
    /// меньше копейки, и шапка показывала «шаг 0,00» над стаканом, где
    /// соседние уровни отстоят на 0,04. Уровни берутся после той же
    /// агрегации, что и строки стакана, каждая сторона отдельно: зазор между
    /// лучшим бидом и лучшим аском — спред, а не шаг.
    /// </summary>
    private decimal? BookStep
    {
        get
        {
            if (latestTick is null)
            {
                return null;
            }

            var steps = new[]
                {
                    GetVisibleOrderBookLevels(latestTick.OrderBook.Asks, reverse: false, isAsk: true),
                    GetVisibleOrderBookLevels(latestTick.OrderBook.Bids, reverse: false, isAsk: false)
                }
                .SelectMany(levels =>
                {
                    var prices = levels.Select(level => level.Price).Distinct().OrderBy(price => price).ToArray();
                    return prices.Zip(prices.Skip(1), (a, b) => b - a);
                })
                .Where(step => step > 0m)
                .ToArray();

            return steps.Length == 0 ? null : steps.Min();
        }
    }

    /// <summary>Время открытия сессии — из сводки прогона.</summary>
    private string SessionOpenedAt => currentRunSummary is { } summary
        ? summary.StartedAt.ToLocalTime().ToString("HH:mm")
        : "—";

    /// <summary>Шаг симуляции: из тика, после остановки — из сводки прогона.</summary>
    private int? SessionTick => latestTick?.Tick ?? currentRunSummary?.TickCount;

    /// <summary>
    /// Длительность закончившейся сессии для панели итогов. Тот же расчёт, что
    /// у чипа (<see cref="SessionClock"/>), но прочерк вместо нулей: в панели
    /// итогов «00:00:00» означало бы сессию нулевой длины, а не её отсутствие
    /// (раздел 10).
    /// </summary>
    private string SessionDuration => currentRunSummary is { TickCount: > 0 }
        ? SessionClock.Format(running: false, currentRunSummary) ?? "—"
        : "—";

    private TimeframeSeriesState GetSelectedTimeframeState() => timeframeSeriesStates[selectedTimeframe];

    private void SelectTimeframe(string timeframe)
    {
        selectedTimeframe = timeframe;
        LoadPersistedCandles(timeframe, forceScrollToRealtime: true);
        pendingChartSync = BuildFullChartSyncPayload(forceScrollToRealtime: true);
    }

    protected override void OnInitialized()
    {
        Markets.Changed += HandleMarketsChanged;
        Events.Changed += HandleEventsChanged;
        Registry.Changed += HandleEventsChanged;

        // Заход на страницу торги не запускает: запуск — явное действие
        // человека, и живёт оно в кнопке.
    }

    /// <summary>
    /// Свитчер меняет только адрес, и Blazor переиспользует тот же компонент:
    /// смену актива надо поймать здесь, иначе на экране GLEN остались бы
    /// свечи и лента KVAN.
    /// </summary>
    protected override void OnParametersSet()
    {
        var assetId = Asset?.Id ?? Guid.Empty;

        if (assetId == shownAssetId)
        {
            return;
        }

        shownAssetId = assetId;
        ResetViewState();
        appliedTick = -1;
        shownRunId = RunId;
        selectedNewsAt = null;

        if (Market?.Last is { } tick)
        {
            latestTick = tick;
            appliedTick = tick.Tick;
            PrimeFromSnapshot(tick, DateTimeOffset.Now);
        }

        // Свечи грузятся и без тика: заход после остановки — разбор сессии.
        LoadPersistedCandles(selectedTimeframe, forceScrollToRealtime: true);
        pendingChartSync = BuildFullChartSyncPayload(forceScrollToRealtime: true);
        UpdateRunSummary();
    }

    private async Task StartAsync()
    {
        if (isBusy || !Composition.IsValid || Registry.Assets.Count == 0)
        {
            return;
        }

        isBusy = true;

        try
        {
            await Markets.StartAsync(Composition.ToSpecs());
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task StopAsync()
    {
        if (isBusy)
        {
            return;
        }

        isBusy = true;

        try
        {
            await Markets.StopAsync();
        }
        finally
        {
            isBusy = false;
        }
    }

    /// <summary>
    /// Шаг сессии отработан по всем рынкам. Странице нужен тик своего актива;
    /// новый прогон этого рынка (новая сессия) начинает экран с нуля.
    /// </summary>
    private void HandleMarketsChanged()
    {
        _ = InvokeAsync(() =>
        {
            if (RunId != shownRunId)
            {
                ResetViewState();
                appliedTick = -1;
                shownRunId = RunId;
                pendingChartSync = BuildFullChartSyncPayload(forceScrollToRealtime: true);
            }

            if (Market?.Last is { } tick && tick.Tick != appliedTick)
            {
                ApplyTick(tick);
            }

            StateHasChanged();
        });
    }

    private void ApplyTick(SimulationTickResult tickResult)
    {
        var receivedAt = DateTimeOffset.Now;
        latestTick = tickResult;
        appliedTick = tickResult.Tick;
        lastChartUpdate = receivedAt;
        UpdateRunSummary();
        UpdateTradeHistory(tickResult);
        UpdateChartSeries(tickResult, receivedAt);
        LoadPersistedCandles(selectedTimeframe);
        _ = TrySyncChartAsync();
    }

    private async Task TrySyncChartAsync()
    {
        if (pendingChartSync is null)
        {
            return;
        }

        try
        {
            var modulePath = Assets["Components/Pages/Trading.razor.js"];
            if (!modulePath.StartsWith("./", StringComparison.Ordinal) &&
                !modulePath.StartsWith("/", StringComparison.Ordinal) &&
                !modulePath.StartsWith("http", StringComparison.OrdinalIgnoreCase))
            {
                modulePath = $"./{modulePath}";
            }

            tradingChartModule ??= await JS.InvokeAsync<IJSObjectReference>("import", modulePath);

            if (!isChartRegistered)
            {
                await tradingChartModule.InvokeVoidAsync("register", chartViewport);
                isChartRegistered = true;
            }

            var payload = pendingChartSync;
            await tradingChartModule.InvokeVoidAsync("sync", chartViewport, payload);
            pendingChartSync = null;

            await SyncChartSessionStateAsync();
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
            // ElementReference is not ready yet; OnAfterRenderAsync will sync.
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ApplyPreferredTimeframeAsync();
            await ResolveSymbolAsync();
        }

        if (pendingChartSync is not null)
        {
            await TrySyncChartAsync();
        }
        else
        {
            await SyncChartSessionStateAsync();
        }
    }

    /// <summary>
    /// Адрес без тикера открывает последний выбранный актив; адрес с тикером
    /// делает его последним выбранным (DESIGN.md 13). Выбор живёт в браузере,
    /// поэтому читается только после первой отрисовки.
    /// </summary>
    private async Task ResolveSymbolAsync()
    {
        if (Asset is { } asset)
        {
            await Selected.RememberAsync(asset.Symbol);
            return;
        }

        var trading = Markets.Markets
            .Select(market => Registry.Find(market.AssetId)?.Symbol)
            .OfType<string>()
            .ToArray();
        var symbol = await Selected.ResolveAsync(Registry.Assets, trading);

        if (symbol is not null)
        {
            Navigation.NavigateTo($"/trading/{symbol}", replace: true);
        }
    }

    private bool? chartSessionActive;

    /// <summary>
    /// Остановленные торги гасят свечи (раздел 19: в белой теме до 58 %, в
    /// графите токен равен 1 и вид не меняется). Отдельным вызовом, а не полем
    /// данных: после остановки тиков нет, и синхронизации данных не будет.
    /// Кнопка «Остановить торги» перерисовывает страницу, так что сюда
    /// попадаем после каждой смены состояния.
    /// </summary>
    private async Task SyncChartSessionStateAsync()
    {
        var active = Markets.IsRunning;

        if (!isChartRegistered || tradingChartModule is null || chartSessionActive == active)
        {
            return;
        }

        try
        {
            await tradingChartModule.InvokeVoidAsync("setSessionActive", chartViewport, active);
            chartSessionActive = active;
        }
        catch (JSDisconnectedException)
        {
        }
    }

    /// <summary>
    /// Таймфрейм по умолчанию с «Профиля». Применяется после первой
    /// отрисовки, а не в OnInitialized: настройка лежит в localStorage, а до
    /// первой отрисовки JS-интеропа в Blazor Server не существует.
    ///
    /// EnsureLoadedAsync идемпотентен — макет вызывает его же, и кто из двоих
    /// успел первым, неважно.
    /// </summary>
    private async Task ApplyPreferredTimeframeAsync()
    {
        await Preferences.EnsureLoadedAsync();

        var preferred = Preferences.DefaultTimeframe;

        if (preferred == selectedTimeframe)
        {
            return;
        }

        SelectTimeframe(preferred);
        StateHasChanged();
    }

    private static Dictionary<string, TimeframeSeriesState> CreateTimeframeSeriesStates() =>
        Timeframes.All.ToDictionary(item => item.Key, item => new TimeframeSeriesState(item), StringComparer.Ordinal);

    private void PrimeFromSnapshot(SimulationTickResult tickResult, DateTimeOffset receivedAt)
    {
        PrimeTradeHistory(tickResult);
        PrimeChartSeries(tickResult, receivedAt);
    }

    private void PrimeTradeHistory(SimulationTickResult tickResult)
    {
        if (tradeHistoryPrimed)
        {
            return;
        }

        tradeHistory.Clear();
        var seededTrades = tickResult.Snapshot.RecentTrades
            .OrderBy(trade => trade.ExecutedAt)
            .ToArray();

        foreach (var trade in seededTrades)
        {
            if (!seenTradeIds.Add(trade.Id))
            {
                continue;
            }

            tradeHistory.Add(trade);
        }

        tradeHistoryPrimed = true;
    }

    private void PrimeChartSeries(SimulationTickResult tickResult, DateTimeOffset receivedAt)
    {
        if (chartStatePrimed)
        {
            return;
        }

        var bootstrapEvents = BuildBootstrapEvents(tickResult.Snapshot, receivedAt);
        if (bootstrapEvents.Count == 0)
        {
            ApplyLiveEventToAllTimeframes(new LivePriceEvent(GetFallbackEventTimestamp(tickResult.Snapshot, receivedAt), tickResult.Snapshot.LastPrice));
        }
        else
        {
            foreach (var liveEvent in bootstrapEvents)
            {
                ApplyLiveEventToAllTimeframes(liveEvent);
            }
        }

        foreach (var trade in tickResult.Snapshot.RecentTrades)
        {
            processedTradeIds.Add(trade.Id);
        }

        chartStatePrimed = true;
        pendingChartSync = BuildFullChartSyncPayload(forceScrollToRealtime: true);
    }

    private void UpdateChartSeries(SimulationTickResult tickResult, DateTimeOffset receivedAt)
    {
        if (!chartStatePrimed)
        {
            PrimeChartSeries(tickResult, receivedAt);
            return;
        }

        var snapshot = tickResult.Snapshot;
        var liveEvents = snapshot.RecentTrades
            .Where(trade => processedTradeIds.Add(trade.Id))
            .OrderBy(trade => trade.ExecutedAt)
            .Select(trade => new LivePriceEvent(trade.ExecutedAt, trade.Price, trade.Quantity))
            .ToArray();

        if (liveEvents.Length == 0)
        {
            var selectedState = GetSelectedTimeframeState();
            if (selectedState.Candles.Count == 0 ||
                selectedState.Candles[^1].Close != snapshot.LastPrice)
            {
                liveEvents =
                [
                    new LivePriceEvent(GetFallbackEventTimestamp(snapshot, receivedAt), snapshot.LastPrice)
                ];
            }
        }

        if (liveEvents.Length == 0)
        {
            return;
        }

        var selectedStateChanged = false;
        var createdBarsForSelectedTimeframe = 0;

        foreach (var liveEvent in liveEvents)
        {
            foreach (var timeframe in Timeframes.All)
            {
                var result = AppendLiveEvent(timeframeSeriesStates[timeframe.Key], liveEvent);
                if (!result.Changed || timeframe.Key != selectedTimeframe)
                {
                    continue;
                }

                selectedStateChanged = true;
                if (result.CreatedNewBar)
                {
                    createdBarsForSelectedTimeframe++;
                }
            }
        }

        if (!selectedStateChanged)
        {
            return;
        }

        var selectedSeries = GetSelectedTimeframeState();
        pendingChartSync = createdBarsForSelectedTimeframe > 1
            ? BuildFullChartSyncPayload(forceScrollToRealtime: false)
            : BuildIncrementalChartSyncPayload(selectedSeries.Candles[^1], forceScrollToRealtime: false);
    }

    private void ResetViewState()
    {
        latestTick = null;
        currentRunSummary = null;
        observedRunId = Guid.Empty;
        lastChartUpdate = DateTimeOffset.Now;
        chartStatePrimed = false;
        tradeHistoryPrimed = false;
        pendingChartSync = null;
        tradeHistory.Clear();
        seenTradeIds.Clear();
        processedTradeIds.Clear();
        loadedHistoryTimeframes.Clear();

        foreach (var state in timeframeSeriesStates.Values)
        {
            state.Candles.Clear();
        }
    }

    private void UpdateRunSummary()
    {
        // Прогон закончился — раннер обнулил CurrentRunId, и спрашивать сводку
        // стало не у кого. Идентификатор берётся из истории прогона: она знает,
        // какому прогону принадлежит её состав, и переживает остановку. Тем же
        // приёмом это решено на «Агентах» (коммит 3fe4516).
        var runId = RunId;

        if (runId == Guid.Empty)
        {
            currentRunSummary = null;
            observedRunId = Guid.Empty;
            return;
        }

        // Время старта в сводке неизменно, а число сделок и тиков растёт:
        // кешировать её на весь прогон нельзя, счётчики замрут на значении
        // первого тика.
        var now = DateTimeOffset.Now;

        if (observedRunId == runId
            && currentRunSummary is not null
            && now - lastSummaryRead < SummaryRefreshInterval)
        {
            return;
        }

        currentRunSummary = SimulationHistoryReader.GetRun(runId);
        observedRunId = runId;
        lastSummaryRead = now;

    }

    private void UpdateTradeHistory(SimulationTickResult tickResult)
    {
        if (!tradeHistoryPrimed)
        {
            PrimeTradeHistory(tickResult);
            return;
        }

        var newTrades = tickResult.Snapshot.RecentTrades
            .Where(trade => seenTradeIds.Add(trade.Id))
            .OrderBy(trade => trade.ExecutedAt)
            .ToArray();

        foreach (var trade in newTrades)
        {
            tradeHistory.Add(trade);
        }
    }

    private static List<LivePriceEvent> BuildBootstrapEvents(MarketSnapshot snapshot, DateTimeOffset receivedAt)
    {
        var trades = snapshot.RecentTrades
            .OrderBy(trade => trade.ExecutedAt)
            .Select(trade => new LivePriceEvent(trade.ExecutedAt, trade.Price, trade.Quantity))
            .ToList();

        if (trades.Count > 0)
        {
            return trades;
        }

        var prices = snapshot.RecentPrices.TakeLast(MetricHistoryLimit).ToArray();
        if (prices.Length == 0)
        {
            return [];
        }

        var anchor = GetFallbackEventTimestamp(snapshot, receivedAt);
        var start = anchor - TimeSpan.FromSeconds(Math.Max(0, prices.Length - 1));
        var events = new List<LivePriceEvent>(prices.Length);

        for (var index = 0; index < prices.Length; index++)
        {
            events.Add(new LivePriceEvent(start.AddSeconds(index), prices[index]));
        }

        return events;
    }

    private static DateTimeOffset GetFallbackEventTimestamp(MarketSnapshot snapshot, DateTimeOffset receivedAt)
    {
        var latestTradeTime = snapshot.RecentTrades.Count == 0
            ? (DateTimeOffset?)null
            : snapshot.RecentTrades.MaxBy(trade => trade.ExecutedAt)?.ExecutedAt;

        return latestTradeTime ?? receivedAt;
    }

    private void ApplyLiveEventToAllTimeframes(LivePriceEvent liveEvent)
    {
        foreach (var timeframe in Timeframes.All)
        {
            AppendLiveEvent(timeframeSeriesStates[timeframe.Key], liveEvent);
        }
    }

    private static TimeframeAppendResult AppendLiveEvent(TimeframeSeriesState state, LivePriceEvent liveEvent)
    {
        var timestamp = AlignToTimeframe(liveEvent.Timestamp, state.Definition.Duration);
        var candles = state.Candles;
        var price = liveEvent.Price;

        if (candles.Count == 0)
        {
            candles.Add(new AggregatedCandle(timestamp, price, price, price, price, liveEvent.Quantity));
            return new TimeframeAppendResult(true, true);
        }

        var lastCandle = candles[^1];
        if (lastCandle.Timestamp == timestamp)
        {
            var updated = false;

            if (liveEvent.Quantity > 0m)
            {
                lastCandle.Volume += liveEvent.Quantity;
                updated = true;
            }

            if (price != lastCandle.Close)
            {
                lastCandle.Close = price;
                updated = true;
            }

            if (price > lastCandle.High)
            {
                lastCandle.High = price;
                updated = true;
            }

            if (price < lastCandle.Low)
            {
                lastCandle.Low = price;
                updated = true;
            }

            return new TimeframeAppendResult(updated, false);
        }

        if (timestamp > lastCandle.Timestamp)
        {
            candles.Add(new AggregatedCandle(timestamp, price, price, price, price, liveEvent.Quantity));
            return new TimeframeAppendResult(true, true);
        }

        var existingCandle = candles.FirstOrDefault(candle => candle.Timestamp == timestamp);
        if (existingCandle is not null)
        {
            var updated = false;

            if (liveEvent.Quantity > 0m)
            {
                existingCandle.Volume += liveEvent.Quantity;
                updated = true;
            }

            if (price != existingCandle.Close)
            {
                existingCandle.Close = price;
                updated = true;
            }

            if (price > existingCandle.High)
            {
                existingCandle.High = price;
                updated = true;
            }

            if (price < existingCandle.Low)
            {
                existingCandle.Low = price;
                updated = true;
            }

            return new TimeframeAppendResult(updated, false);
        }

        var insertIndex = candles.FindIndex(candle => candle.Timestamp > timestamp);
        var created = new AggregatedCandle(timestamp, price, price, price, price, liveEvent.Quantity);
        if (insertIndex < 0)
        {
            candles.Add(created);
        }
        else
        {
            candles.Insert(insertIndex, created);
        }

        return new TimeframeAppendResult(true, false);
    }

    private static DateTimeOffset AlignToTimeframe(DateTimeOffset timestamp, TimeSpan duration)
    {
        var seconds = Math.Max(1L, (long)duration.TotalSeconds);
        var unixSeconds = timestamp.ToUnixTimeSeconds();
        var remainder = unixSeconds % seconds;
        if (remainder < 0)
        {
            remainder += seconds;
        }

        return DateTimeOffset.FromUnixTimeSeconds(unixSeconds - remainder);
    }

    private ChartSyncPayload BuildFullChartSyncPayload(bool forceScrollToRealtime)
    {
        var state = GetSelectedTimeframeState();
        return new ChartSyncPayload(
            "setData",
            state.Definition.Key,
            forceScrollToRealtime,
            state.Candles.Select(ToChartCandlePoint).ToArray(),
            null,
            BuildChartMarkers(state));
    }

    /// <summary>
    /// Отметки на графике: момент каждой новости сессии и сделки новостного
    /// агента (артборд 02, раздел 11 — «маркеры сделок агента цветом агента»).
    ///
    /// Сделки прорежены: не больше одной отметки на свечу. Без прореживания
    /// сотни сделок складываются в решётку точек, под которой свечей не видно
    /// вовсе — ровно это видно на детальной агента (пункт 77).
    ///
    /// Число маркеров новостей равно числу событий в списке — раздел 10.1
    /// требует этого прямо.
    /// </summary>
    private IReadOnlyList<ChartMarker> BuildChartMarkers(TimeframeSeriesState state)
    {
        if (state.Candles.Count == 0)
        {
            return [];
        }

        var interval = state.Definition.Duration;
        var first = state.Candles[0].Timestamp;
        var last = state.Candles[^1].Timestamp;

        var markers = new List<ChartMarker>();

        foreach (var entry in Events.News)
        {
            var slot = AlignToTimeframe(entry.At, interval);
            if (slot < first || slot > last)
            {
                continue;
            }

            markers.Add(new ChartMarker(
                slot.ToUnixTimeSeconds(),
                "aboveBar",
                "arrowDown",
                "--chart-news-marker",
                entry.Fan?.For(Asset?.Symbol)?.Strength is { } impact ? Fixed2(impact) : "не задет"));
        }

        var seenSlots = new HashSet<long>();

        foreach (var trade in tradeHistory)
        {
            if (!IsNewsAgent(trade.BuyerAgentName) && !IsNewsAgent(trade.SellerAgentName))
            {
                continue;
            }

            var slot = AlignToTimeframe(trade.ExecutedAt, interval);
            if (slot < first || slot > last || !seenSlots.Add(slot.ToUnixTimeSeconds()))
            {
                continue;
            }

            markers.Add(new ChartMarker(
                slot.ToUnixTimeSeconds(),
                "belowBar",
                "circle",
                "--agent-news",
                string.Empty));
        }

        return markers.OrderBy(marker => marker.Time).ToArray();
    }

    private static bool IsNewsAgent(string agentName) =>
        agentName.Contains("News", StringComparison.Ordinal);

    private static string Fixed2(decimal value) => value.ToString("F2");

    // ── Разбор выбранной новости (раздел 9.19) ──────────────────────────────

    private DateTimeOffset? selectedNewsAt;

    /// <summary>
    /// Какая новость разобрана в полосе. По умолчанию — свежая: человек,
    /// открывший «Торги» после новости, приходит смотреть именно её.
    /// </summary>
    private DateTimeOffset? SelectedNewsAt =>
        selectedNewsAt is { } chosen && Events.News.Any(entry => entry.At == chosen)
            ? chosen
            : Events.News.FirstOrDefault()?.At;

    private SessionEvent? SelectedNews =>
        SelectedNewsAt is { } at ? Events.News.FirstOrDefault(entry => entry.At == at) : null;

    private void SelectNews(DateTimeOffset at) => selectedNewsAt = at;

    private void HandleNewsKey(KeyboardEventArgs args, DateTimeOffset at)
    {
        if (args.Key is "Enter" or " ")
        {
            SelectNews(at);
        }
    }

    private ChartSyncPayload BuildIncrementalChartSyncPayload(AggregatedCandle candle, bool forceScrollToRealtime)
    {
        return new ChartSyncPayload(
            "update",
            selectedTimeframe,
            forceScrollToRealtime,
            null,
            ToChartCandlePoint(candle));
    }

    private static ChartSummaryData BuildChartSummaryData(
        TimeframeSeriesState state,
        SimulationTickResult? tickResult,
        DateTimeOffset updatedAt)
    {
        // Пока свечей нет, показывать нечего: цена, дельта и границы сессии —
        // прочерки. Раньше здесь стояла демо-цена и литерал «+0.00 (0.00%)» с
        // точками вместо запятых и плюсом у нуля (пункты 14, 15 и 36).
        if (state.Candles.Count == 0)
        {
            return new ChartSummaryData("—", "—", "—", "—", "—", "—", "neutral", "—");
        }

        var sessionOpen = state.Candles[0].Open;
        var sessionClose = state.Candles[^1].Close;
        var sessionHigh = state.Candles.Max(candle => candle.High);
        var sessionLow = state.Candles.Min(candle => candle.Low);
        var change = sessionClose - sessionOpen;
        var percent = sessionOpen == 0m ? 0m : change / sessionOpen * 100m;
        var changeClass = change > 0m ? "positive" : change < 0m ? "negative" : "neutral";

        // Знак ставит Sign(): минус там U+2212, а не дефис из культуры, и ноль
        // остаётся без знака (раздел 10). Абсолютная часть и процент — двумя
        // строками, как в артбордах 01, 02 и 05, а не одной строкой в скобках.
        return new ChartSummaryData(
            FormatPrice(sessionOpen),
            FormatPrice(sessionHigh),
            FormatPrice(sessionLow),
            FormatPrice(sessionClose),
            $"{Sign(change)}{FormatPrice(Math.Abs(change))} ₽",
            $"{Sign(percent)}{Math.Abs(percent):0.00} %",
            changeClass,
            $"Обновлено {updatedAt.ToLocalTime():HH:mm:ss}");
    }

    /// <summary>
    /// Точка ряда для графика. Цвета здесь больше нет: она задаётся темой
    /// серии в Trading.razor.js по разделу 11, а страница возила семь
    /// литеральных hex, которые normalizePoint всё равно выбрасывал. Три из
    /// них были неоновыми и пришли из доредизайнового app.css (пункт 37).
    /// </summary>
    private static ChartCandlePoint ToChartCandlePoint(AggregatedCandle candle) =>
        new(
            candle.Timestamp.ToUnixTimeSeconds(),
            candle.Open,
            candle.High,
            candle.Low,
            candle.Close,
            candle.Volume);

    private void LoadPersistedCandles(string timeframeKey, bool forceScrollToRealtime = false)
    {
        if (!TimeframesByKey.TryGetValue(timeframeKey, out var timeframe))
        {
            return;
        }

        // После остановки CurrentRunId обнулён, но свечи закончившегося прогона
        // никуда не делись — график обязан показывать разбор сессии, а не
        // «Нет данных» (пункт 13 docs/ui-backlog.md).
        var runId = RunId;

        if (runId == Guid.Empty)
        {
            return;
        }

        if (!forceScrollToRealtime && loadedHistoryTimeframes.Contains(timeframeKey))
        {
            return;
        }

        var persistedCandles = CandleReader
            .GetCandles(runId, timeframe.Duration, GetPersistedCandleLimit(timeframeKey))
            .Select(candle => new AggregatedCandle(
                candle.StartedAt,
                candle.Open,
                candle.High,
                candle.Low,
                candle.Close,
                candle.Volume))
            .ToArray();

        if (persistedCandles.Length == 0)
        {
            return;
        }

        loadedHistoryTimeframes.Add(timeframeKey);
        MergeExternalCandles(timeframeKey, persistedCandles, forceScrollToRealtime);
    }

    private static int GetPersistedCandleLimit(string timeframeKey) =>
        timeframeKey switch
        {
            "10s" => 180,
            "30s" => 180,
            "1m" => 180,
            "5m" => 144,
            "15m" => 96,
            "1h" => 72,
            _ => 180
        };

    private void MergeExternalCandles(string timeframeKey, IEnumerable<AggregatedCandle> candles, bool forceScrollToRealtime = false)
    {
        if (!TimeframesByKey.ContainsKey(timeframeKey))
        {
            return;
        }

        var state = timeframeSeriesStates[timeframeKey];
        var selectedTimeframeChanged = false;

        foreach (var candle in candles.OrderBy(item => item.Timestamp))
        {
            var changed = UpsertAggregatedCandle(state, candle);
            selectedTimeframeChanged |= changed && timeframeKey == selectedTimeframe;
        }

        if (selectedTimeframeChanged)
        {
            pendingChartSync = BuildFullChartSyncPayload(forceScrollToRealtime);
        }
    }

    private static bool UpsertAggregatedCandle(TimeframeSeriesState state, AggregatedCandle candle)
    {
        var timestamp = AlignToTimeframe(candle.Timestamp, state.Definition.Duration);
        var existingIndex = state.Candles.FindIndex(item => item.Timestamp == timestamp);
        if (existingIndex >= 0)
        {
            var existing = state.Candles[existingIndex];
            var changed = existing.Open != candle.Open ||
                          existing.High != candle.High ||
                          existing.Low != candle.Low ||
                          existing.Close != candle.Close;

            existing.Open = candle.Open;
            existing.High = candle.High;
            existing.Low = candle.Low;
            existing.Close = candle.Close;
            // Объём из хранилища авторитетнее живого накопления: биржа считает
            // его по всем сделкам свечи, а страница — только по тем, что успела
            // увидеть с момента открытия.
            existing.Volume = candle.Volume;
            return changed;
        }

        var insertIndex = state.Candles.FindIndex(item => item.Timestamp > timestamp);
        var normalized = new AggregatedCandle(timestamp, candle.Open, candle.High, candle.Low, candle.Close, candle.Volume);
        if (insertIndex < 0)
        {
            state.Candles.Add(normalized);
        }
        else
        {
            state.Candles.Insert(insertIndex, normalized);
        }

        return true;
    }

    private static OrderBookViewData BuildOrderBookData(OrderBookSnapshot? orderBook)
    {
        var asks = GetVisibleOrderBookLevels(orderBook?.Asks ?? [], reverse: true, isAsk: true);
        var bids = GetVisibleOrderBookLevels(orderBook?.Bids ?? [], reverse: false, isAsk: false);

        // Асксы перевёрнуты по убыванию — лучший в конце; биды по убыванию — лучший первый.
        var bestAsk = asks.Length == 0 ? (decimal?)null : asks[^1].Price;
        var bestBid = bids.Length == 0 ? (decimal?)null : bids[0].Price;

        return new OrderBookViewData(
            bestBid,
            bestAsk,
            BuildOrderBookRows(asks),
            BuildOrderBookRows(bids));
    }

    private static OrderBookLevel[] GetVisibleOrderBookLevels(
        IReadOnlyList<OrderBookLevel> levels,
        bool reverse,
        bool isAsk)
    {
        var visibleLevels = OrderBookDisplay.Aggregate(levels, isAsk).Take(VisibleOrderBookDepth).ToArray();
        if (reverse)
        {
            Array.Reverse(visibleLevels);
        }

        return visibleLevels;
    }

    private static OrderBookRow[] BuildOrderBookRows(IReadOnlyList<OrderBookLevel> levels)
    {
        var maxQuantity = levels.Count == 0 ? 0m : levels.Max(level => level.Quantity);
        var rows = levels
            .Select(level =>
            {
                var depth = CalculateDepth(level.Quantity, maxQuantity);

                return new OrderBookRow(
                    FormatPrice(level.Price),
                    level.Quantity.ToString("N1"),
                    level.OrdersCount.ToString(),
                    depth,
                    $"width: {depth}%;",
                    false);
            })
            .ToList();

        if (rows.Count == 0)
        {
            rows.Add(new OrderBookRow("—", "—", "—", 0, "width: 0%;", true));
        }

        return rows.ToArray();
    }

    private static TradeRow[] BuildTradeRows(IReadOnlyList<Trade> trades) =>
        trades
            .OrderByDescending(trade => trade.ExecutedAt)
            .Take(50)
            .Select(trade => new TradeRow(
                trade.ExecutedAt.ToLocalTime().ToString("HH:mm:ss"),
                FormatPrice(trade.Price),
                trade.Quantity.ToString("N1"),
                FormatAgentName(trade.BuyerAgentName),
                FormatAgentName(trade.SellerAgentName),
                GetTradeClass(trade)))
            .ToArray();

    private static string FormatPrice(decimal value) => value.ToString("F2");

    private static string FormatQuantity(decimal value) => value % 1m == 0m
        ? value.ToString("0")
        : value.ToString("0.##");

    private static int CalculateDepth(decimal quantity, decimal maxQuantity)
    {
        if (maxQuantity <= 0m)
        {
            return 0;
        }

        var depth = (int)Math.Ceiling((double)(quantity / maxQuantity * 100m));
        return Math.Clamp(depth, 8, 100);
    }

    private static string GetTradeClass(Trade trade)
    {
        if (trade.BuyerAgentName.Contains("MarketMaker", StringComparison.Ordinal))
        {
            return "sell";
        }

        return "buy";
    }

    private static string FormatAgentName(string agentName)
    {
        if (string.IsNullOrWhiteSpace(agentName))
        {
            return "-";
        }

        var normalized = agentName.Trim();
        var compactName = normalized switch
        {
            "TrendFollowing" => "Trend",
            "CounterTrend" => "Counter",
            "MarketMaker" => "Maker",
            "NewsDriven" => "News",
            _ => null
        };

        if (compactName is not null)
        {
            return compactName;
        }

        if (normalized.Contains("TrendFollowing", StringComparison.Ordinal))
        {
            return normalized.Replace("TrendFollowing", "Trend", StringComparison.Ordinal);
        }

        if (normalized.Contains("CounterTrend", StringComparison.Ordinal))
        {
            return normalized.Replace("CounterTrend", "Counter", StringComparison.Ordinal);
        }

        if (normalized.Contains("MarketMaker", StringComparison.Ordinal))
        {
            return normalized.Replace("MarketMaker", "Maker", StringComparison.Ordinal);
        }

        if (normalized.Contains("NewsDriven", StringComparison.Ordinal))
        {
            return normalized.Replace("NewsDriven", "News", StringComparison.Ordinal);
        }

        var builder = new System.Text.StringBuilder(normalized.Length + 4);

        for (var index = 0; index < normalized.Length; index++)
        {
            var current = normalized[index];
            if (index > 0 &&
                char.IsUpper(current) &&
                (char.IsLower(normalized[index - 1]) ||
                 (index + 1 < normalized.Length && char.IsLower(normalized[index + 1]))))
            {
                builder.Append(' ');
            }

            builder.Append(current);
        }

        return builder.ToString();
    }

    private void HandleEventsChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Markets.Changed -= HandleMarketsChanged;
        Events.Changed -= HandleEventsChanged;
        Registry.Changed -= HandleEventsChanged;
    }

    public async ValueTask DisposeAsync()
    {
        Markets.Changed -= HandleMarketsChanged;
        Events.Changed -= HandleEventsChanged;
        Registry.Changed -= HandleEventsChanged;

        if (tradingChartModule is null)
        {
            return;
        }

        try
        {
            if (isChartRegistered)
            {
                await tradingChartModule.InvokeVoidAsync("dispose", chartViewport);
            }

            await tradingChartModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

