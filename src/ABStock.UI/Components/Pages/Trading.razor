@page "/trading"
@page "/trading/{Symbol}"
@rendermode InteractiveServer
@using ABStock.Application.MarketHistory
@using ABStock.Application.Simulation
@using ABStock.Shared
@using ABStock.UI.Services
@using Microsoft.AspNetCore.Components.Web
@using static ABStock.UI.Services.NumberFormat
@implements IDisposable
@implements IAsyncDisposable
@inject IAssetRegistry Registry
@inject ISessionMarkets Markets
@inject ISessionEvents Events
@inject IAgentComposition Composition
@inject ISelectedAsset Selected
@inject NavigationManager Navigation
@inject IMarketCandleReader CandleReader
@inject IJSRuntime JS
@inject IUserPreferences Preferences
@inject ISimulationHistoryReader SimulationHistoryReader

<PageTitle>@(Asset is { } titled ? $"Торги {titled.Symbol}" : "Торги")</PageTitle>

@{
    var asset = Asset;
    var isRunning = Markets.IsRunning;
    var market = Market;
    var snapshot = latestTick?.Snapshot;
    var chart = ChartSummary;
    var book = OrderBookData;
    var trades = RecentTrades;
    var isStale = isRunning && latestTick is not null && (DateTimeOffset.Now - lastChartUpdate).TotalSeconds > 5;

    static string Tone(string? changeClass) => changeClass switch
    {
        "positive" => "up",
        "negative" => "down",
        _ => "flat"
    };

    static string NameTone(string agentName) =>
        agentName.Contains("Trend", StringComparison.Ordinal) &&
        !agentName.Contains("Counter", StringComparison.Ordinal) ? "agent-trend"
        : agentName.Contains("Counter", StringComparison.Ordinal) ? "agent-counter"
        : agentName.Contains("Maker", StringComparison.Ordinal) ? "agent-mm"
        : agentName.Contains("News", StringComparison.Ordinal) ? "agent-news"
        : "muted";
}

<div class="app-bg" aria-hidden="true"><div class="app-bg__noise"></div></div>

<div class="trading-shell">
    <TopNavigation ActivePage="Trading" ShowClock="true" />

    <main class="trading-page @(isRunning ? null : "is-stopped")">

        @if (asset is null)
        {
            @* Адрес без тикера или с тикером, которого нет: страница либо
               перенаправит на выбранный актив, либо объяснит, что торговать
               нечем. Пока выбор читается из браузера — ничего не мигает. *@
            <Breadcrumbs Items="@(new Crumb[] { new("Активы", Href: "/assets"), new("Торги") })" />
            <PageHead Title="Торги" />

            @if (Registry.Assets.Count == 0)
            {
                <Panel Class="rise rise-1">
                    <EmptyState IconName="plus" Title="Торговать пока нечем"
                                Description="Торги идут по активам сессии. Создайте первый актив — и запустите торги на «Активах».">
                        <Action>
                            <AppButton Variant="primary" Href="/assets/new">Создать актив</AppButton>
                        </Action>
                    </EmptyState>
                </Panel>
            }
        }
        else
        {
            @* ── Крошки: Активы › актив со свитчером › Торги (раздел 13) ── *@
            <Breadcrumbs Items="@(new Crumb[]
                         {
                             new("Активы", Href: "/assets"),
                             new(asset.Name, IsAsset: true, Symbol: asset.Symbol),
                             new("Торги")
                         })">
                <Aside>
                    <SessionChip Running="isRunning" Elapsed="@Elapsed" />
                </Aside>
            </Breadcrumbs>

            @* Заголовок экрана — актив: при переключении меняется крупное, а не мелкое. *@
            <PageHead>
                <TitleContent>
                    <span class="trading-title">
                        <h1>@asset.Name</h1>
                        <Ticker Symbol="@asset.Symbol" Large="true" />
                    </span>
                </TitleContent>
                <Context>@PageContext</Context>
                <Actions>
                    @if (isRunning)
                    {
                        <AppButton Variant="secondary" Icon="plus" Href="/news">Добавить новость</AppButton>
                        <AppButton Variant="primary" Icon="square" OnClick="StopAsync" Loading="isBusy">Остановить торги</AppButton>
                    }
                    else
                    {
                        <AppButton Variant="primary" Icon="play" OnClick="StartAsync" Loading="isBusy"
                                   Disabled="@(!Composition.IsValid)">Запустить торги</AppButton>
                    }
                </Actions>
            </PageHead>

            <div class="workspace">

                @* ─────────── ЛЕВЫЙ РЕЛЬС — только хронология (раздел 13) ─────────── *@
                <Panel Title="События сессии" Class="events-panel rise rise-1" Flush="true">
                    <MetaContent><span class="num-sm">@Count0(Events.Entries.Count)</span></MetaContent>
                    <ChildContent>
                        @if (Events.Entries.Count > 0)
                        {
                            <div class="events">
                                @foreach (var entry in Events.Entries)
                                {
                                    if (entry.Kind == SessionEventKind.News)
                                    {
                                        var isCurrent = entry.At == SelectedNews?.At;
                                        <div class="events__row" role="button" tabindex="0"
                                             aria-pressed="@(isCurrent ? "true" : "false")"
                                             @onclick="() => SelectNews(entry.At)"
                                             @onkeydown="@(args => HandleNewsKey(args, entry.At))">
                                            <SessionEventRow Event="entry" FocusSymbol="@asset.Symbol" Current="isCurrent" />
                                        </div>
                                    }
                                    else
                                    {
                                        <SessionEventRow Event="entry" />
                                    }
                                }
                            </div>
                        }
                        else if (isRunning)
                        {
                            <EmptyState IconName="news"
                                        Title="Событий пока нет"
                                        Description="Здесь появятся новости и заметные сделки агентов." />
                        }
                        else
                        {
                            <EmptyState IconName="news"
                                        Title="Сессии ещё не было"
                                        Description="Хронология начнётся с запуска торгов." />
                        }
                    </ChildContent>
                </Panel>

                @* ─────────── ЦЕНТР — цена и график, главный объект экрана ─────────── *@
                <div class="center">
                    <section class="quote rise rise-1" aria-label="Текущая цена и показатели">
                        <div class="quote__price">
                            <div class="num-hero @(isStale ? "is-stale" : null)">@chart.Close <span class="unit">₽</span></div>
                            <div class="quote__delta tone-@Tone(chart.ChangeClass)">
                                @if (market is not null)
                                {
                                    <span class="num-sm">@(market.Change > 0 ? "↗" : market.Change < 0 ? "↘" : "·") @Sign(market.Change)@Price2(Math.Abs(market.Change)) ₽</span>
                                    <span class="num-sm quote__percent">@Sign(market.ChangePercent)@Percent2(Math.Abs(market.ChangePercent)) %</span>
                                }
                                @if (isStale)
                                {
                                    <span class="quote__stale">нет обновлений</span>
                                }
                                else if (!isRunning && market is not null)
                                {
                                    <span class="quote__stale">цена закрытия</span>
                                }
                            </div>
                        </div>

                        @* Объём и сделки — по этому активу: их место в строке у цены (ревью Т-2). *@
                        <div class="strip">
                            <div class="strip__item"><span class="strip__label">объём</span><span class="num-sm">@(snapshot is { } s ? Count0(s.Volume) : "—")</span><span class="strip__label">шт</span></div>
                            <span class="strip__sep" aria-hidden="true"></span>
                            <div class="strip__item"><span class="strip__label">сделок</span><span class="num-sm">@(market is null ? "—" : Count0(SessionTradeCount))</span></div>
                        </div>
                    </section>

                    <Panel Class="chart-panel rise rise-2" Flush="true">
                        <Head>
                            <div class="strip">
                                <div class="strip__item"><span class="strip__label">откр</span><span class="num-sm">@chart.Open</span></div>
                                <span class="strip__sep" aria-hidden="true"></span>
                                <div class="strip__item"><span class="strip__label">макс</span><span class="num-sm">@chart.High</span></div>
                                <span class="strip__sep" aria-hidden="true"></span>
                                <div class="strip__item"><span class="strip__label">мин</span><span class="num-sm">@chart.Low</span></div>
                            </div>
                            <Segmented TValue="string"
                                       Label="Таймфрейм"
                                       Items="@(Timeframes.All.Select(t => new SegmentedItem<string>(t.Key, t.Label)).ToArray())"
                                       Value="@selectedTimeframe"
                                       ValueChanged="SelectTimeframe" />
                        </Head>
                        <ChildContent>
                            <div class="chart-body">
                                <div class="chart-stage" @ref="chartViewport" tabindex="0"
                                     aria-label="Свечной график цены @asset.Name">
                                    <div class="chart-surface" role="img"
                                         aria-label="Биржевой график цены @asset.Name"></div>

                                    <div class="chart-hover-legend glass" aria-live="polite">
                                        <span class="chart-hover-time num-xs" data-role="time">Нет данных</span>
                                        <div class="chart-hover-values">
                                            <span><small>откр</small><strong class="num-sm" data-role="open">—</strong></span>
                                            <span><small>макс</small><strong class="num-sm" data-role="high">—</strong></span>
                                            <span><small>мин</small><strong class="num-sm" data-role="low">—</strong></span>
                                            <span><small>закр</small><strong class="num-sm" data-role="close">—</strong></span>
                                        </div>
                                    </div>

                                    <button class="chart-live-reset" type="button" hidden>
                                        <Icon Name="activity" Size="14" />
                                        <span>К текущей цене</span>
                                    </button>

                                    <div class="chart-empty-state">Нет данных</div>
                                </div>

                                <footer class="chart-foot">
                                    <a class="chart-foot__credit" href="https://www.tradingview.com/"
                                       target="_blank" rel="noreferrer noopener">
                                        TradingView Lightweight Charts™ · Copyright (c) 2025 TradingView, Inc.
                                    </a>
                                    <span class="num-xs">@chart.UpdatedAt</span>
                                </footer>
                            </div>
                        </ChildContent>
                    </Panel>
                </div>

                @* ─────────── Полоса связи — сразу под графиком (раздел 9.19) ───────────
                   Цепочка для ЭТОГО актива. Если новостные агенты торговали
                   другим активом, цепочка честно обрывается разрывом: стрелка
                   утверждала бы, что новость двинула эту цену. *@
                @if (SelectedNews is { Fan: { } fan } news)
                {
                    var here = fan.For(asset.Symbol);
                    var lead = fan.Lead;
                    var reaction = Events.ReactionTo(news);
                    var reactedHere = reaction?.Symbol == asset.Symbol;

                    <CausalityStrip Class="causal-strip rise rise-3" Label="Как новость сдвинула цену">
                        <CausalityStep Label="@($"Новость · {news.At:HH:mm}")" Weight="1.4"
                                       Value="@news.Text" Truncate="true"
                                       Note="@($"введена вами · разобрана по {fan.Assets.Count(row => row.WasAnalyzed)} {Plural(fan.Assets.Count(row => row.WasAnalyzed), "активу", "активам", "активам")}")" />

                        <CausalityStep Label="Тональность">
                            <span><Badge Tone="@Badge.ForPolarity(fan.Polarity)">@Badge.LabelOf(fan.Polarity)</Badge></span>
                            <span class="ui-causality__note">уверенность модели <span class="num-xs">@fan.Confidence.ToString("F2")</span></span>
                        </CausalityStep>

                        <CausalityStep Label="@($"Сила для {asset.Symbol}")">
                            @if (here?.Strength is { } impact)
                            {
                                <span class="nowrap">
                                    <span class="num-lg">@impact.ToString("F2")</span>
                                    <span class="ui-causality__note">@ImpactScale.Word(impact) · @(here.Direction > 0 ? "вверх" : "вниз")</span>
                                </span>
                            }
                            else
                            {
                                <span class="ui-causality__value">не задет</span>
                            }
                            @if (lead is not null && lead.Symbol != asset.Symbol)
                            {
                                <span class="ui-causality__note">@lead.Symbol задет сильнее — <span class="num-xs">@lead.Strength?.ToString("F2")</span></span>
                            }
                        </CausalityStep>

                        <CausalityStep Label="Новостные" Weight="1.2">
                            @if (reaction is null)
                            {
                                <span class="ui-causality__value">пока не ответили</span>
                            }
                            else if (reactedHere)
                            {
                                <span class="ui-causality__value causal-agents"><StatusDot Tone="agent-news" />@(reaction.Action == TradeAction.Buy ? "покупают" : "продают") @asset.Symbol</span>
                            }
                            else
                            {
                                <span class="ui-causality__value causal-agents"><StatusDot Tone="agent-news" />торговали @reaction.Symbol, не @asset.Symbol</span>
                                <a class="ui-causality__note causal-link" href="@($"/trading/{reaction.Symbol}")">цепочка @reaction.Symbol →</a>
                            }
                        </CausalityStep>

                        <CausalityStep Label="@($"Цена {asset.Symbol}")" Break="@(!reactedHere)">
                            <span class="num-lg">@(market is null ? "—" : Price2(market.LastPrice))</span>
                            @if (market is not null && news.PricesAtNews?.TryGetValue(asset.Symbol, out var from) == true)
                            {
                                var percent = from == 0m ? 0m : (market.LastPrice - from) / from * 100m;
                                <span class="ui-causality__note">
                                    с <span class="num-xs">@Price2(from)</span> ·
                                    <span class="num-xs @DeltaTone(percent)">@Sign(percent)@Percent2(Math.Abs(percent)) %</span>@(reactedHere ? null : " · движение не новостное")
                                </span>
                            }
                        </CausalityStep>
                    </CausalityStrip>
                }

                @* ─────────── Агенты, свёрнутые по стратегиям ─────────── *@
                @if (market is not null && Strategies.Count > 0)
                {
                    var rows = Strategies;
                    var totals = StrategyTable.Totals(rows);

                    <Panel Class="strategies-panel rise rise-3" Flush="true">
                        <Head>
                            <span class="strategies__title">
                                <h2>Агенты</h2>
                                <span class="caption">
                                    <span class="num-xs">@rows.Count</span> @Plural(rows.Count, "стратегия", "стратегии", "стратегий") ·
                                    <span class="num-xs">@rows.Sum(row => row.Count)</span> @Plural(rows.Sum(row => row.Count), "экземпляр", "экземпляра", "экземпляров")
                                </span>
                            </span>
                            <span class="ui-panel__meta">позиция и доля — в @asset.Symbol</span>
                        </Head>
                        <ChildContent>
                            <div class="strategies" role="table" aria-label="Агенты по стратегиям">
                                <div class="strategies__row strategies__row--head" role="row">
                                    <span class="label" role="columnheader">Стратегия</span>
                                    <span class="label right" role="columnheader">@asset.Symbol, шт · за сессию</span>
                                    <span class="label" role="columnheader" title="Доля актива в портфеле стратегии, шкала от 0 до 20 %">Доля @asset.Symbol</span>
                                    <span class="label right strategies__sep" role="columnheader">P/L портфеля, ₽</span>
                                    <span class="label" role="columnheader">Действие и объяснение</span>
                                </div>
                                @foreach (var row in rows)
                                {
                                    <div class="strategies__row" role="row">
                                        <span class="strategies__name" role="cell">
                                            <StatusDot Tone="@AgentDisplay.GetTypeTone(row.Type)" />
                                            @AgentDisplay.GetTypeLabel(row.Type)
                                            @if (row.Count > 1)
                                            {
                                                <span class="num-xs t3">×@row.Count</span>
                                            }
                                        </span>
                                        <span class="right nowrap" role="cell">
                                            <span class="num-md t1">@Count0(row.Position)</span>
                                            <span class="num-xs @DeltaTone(row.PositionChange)">@Position0(row.PositionChange)</span>
                                        </span>
                                        <span class="strategies__share" role="cell">
                                            <span class="strategies__track"><span class="strategies__fill" style="width:@ShareWidth(row.Share)"></span></span>
                                            <span class="num-sm t2">@row.Share.ToString("0.0") %</span>
                                        </span>
                                        <span class="num-sm right strategies__sep @DeltaTone(row.Pnl)" role="cell">@Pnl2(row.Pnl)</span>
                                        <span class="strategies__why" role="cell">
                                            @if (row.Action is null)
                                            {
                                                <span class="nodata">—</span>
                                            }
                                            else
                                            {
                                                <span class="strategies__act @(row.TradesElsewhere ? "t2" : null)">@row.Action</span>
                                                @if (row.Explanation is not null)
                                                {
                                                    <span class="strategies__reason" title="@row.Explanation">@row.Explanation</span>
                                                }
                                            }
                                        </span>
                                    </div>
                                }
                                <div class="strategies__row strategies__row--foot" role="row">
                                    <span role="cell">Итого</span>
                                    <span class="right nowrap" role="cell">
                                        <span class="num-sm t1">@Count0(totals.Position)</span>
                                        <span class="num-xs t3">@Position0(totals.PositionChange)</span>
                                    </span>
                                    <span class="caption" role="cell">@(totals.PositionChange == 0m ? "рынок замкнут" : null)</span>
                                    <span class="num-sm right strategies__sep @DeltaTone(totals.Pnl)" role="cell">@Pnl2(totals.Pnl)</span>
                                    <a class="caption strategies__more" href="/agents" role="cell">каждый экземпляр — на «Агентах» →</a>
                                </div>
                            </div>
                        </ChildContent>
                    </Panel>
                }

                @* ─────────── ПРАВЫЙ РЕЛЬС — состояние на сейчас ─────────── *@
                <div class="rail rail--right">
                    <Panel Title="Стакан заявок" Class="rise rise-2" Flush="true">
                        <MetaContent>
                            @if (BookStep is { } step)
                            {
                                <text>шаг <span class="num-sm">@FormatPrice(step)</span></text>
                            }
                        </MetaContent>
                        <ChildContent>
                            @if (latestTick is null)
                            {
                                <EmptyState IconName="book"
                                            Title="Заявок нет"
                                            Description="Стакан наполнится после запуска торгов." />
                            }
                            else
                            {
                                <div class="book">
                                    <div class="book__head">
                                        <span class="label">Цена</span>
                                        <span class="label book__c-vol">Объём</span>
                                        <span class="label book__c-orders">Заявок</span>
                                    </div>

                                    <div class="book__side">
                                        @foreach (var row in book.Asks.TakeLast(7))
                                        {
                                            <div class="book__row @(row.IsEmpty ? "is-empty" : null)">
                                                <span class="book__bar book__bar--ask" style="@row.DepthStyle" aria-hidden="true"></span>
                                                <span class="num-sm book__c-price tone-down">@row.Price</span>
                                                <span class="num-sm book__c-vol">@row.Volume</span>
                                                <span class="num-sm book__c-orders">@row.Orders</span>
                                            </div>
                                        }
                                    </div>

                                    <div class="book__spread">
                                        <span>спред <span class="num-sm">@(book.BestAsk is { } ba && book.BestBid is { } bb ? FormatPrice(ba - bb) : "—") ₽</span></span>
                                        <span>мид <span class="num-sm">@(book.BestAsk is { } ma && book.BestBid is { } mb ? FormatPrice((ma + mb) / 2m) : "—") ₽</span></span>
                                    </div>

                                    <div class="book__side">
                                        @foreach (var row in book.Bids.Take(7))
                                        {
                                            <div class="book__row @(row.IsEmpty ? "is-empty" : null)">
                                                <span class="book__bar book__bar--bid" style="@row.DepthStyle" aria-hidden="true"></span>
                                                <span class="num-sm book__c-price tone-up">@row.Price</span>
                                                <span class="num-sm book__c-vol">@row.Volume</span>
                                                <span class="num-sm book__c-orders">@row.Orders</span>
                                            </div>
                                        }
                                    </div>

                                    <div class="book__best hairline-top">
                                        <span>лучший bid <span class="num-sm tone-up">@(book.BestBid is { } bb2 ? FormatPrice(bb2) : "—")</span></span>
                                        <span>ask <span class="num-sm tone-down">@(book.BestAsk is { } ba2 ? FormatPrice(ba2) : "—")</span></span>
                                    </div>
                                </div>
                            }
                        </ChildContent>
                    </Panel>

                    <Panel Title="Лента сделок" Class="tape-panel rise rise-3" Flush="true">
                        <MetaContent>покупатель ← продавец</MetaContent>
                        <ChildContent>
                            @if (trades.Length == 0)
                            {
                                <EmptyState IconName="activity"
                                            Title="@(isRunning ? "Сделок пока нет" : "Лента пуста")"
                                            Description="@(isRunning ? "Агенты выставили заявки — сделка появится, как только цены сойдутся." : "Здесь идут сделки по этому активу во время торгов.")" />
                            }
                            else
                            {
                                <div class="tape">
                                    <div class="tape__list">
                                        @foreach (var trade in trades)
                                        {
                                            <div class="tape__row" title="@trade.Buyer ← @trade.Seller">
                                                <span class="num-xs tape__time">@trade.Time</span>
                                                <span class="num-sm tape__price @(trade.SideClass == "buy" ? "tone-up" : "tone-down")">
                                                    @(trade.SideClass == "buy" ? "↗" : "↘") @trade.Price
                                                </span>
                                                <span class="num-sm tape__qty">@trade.Volume</span>
                                                <span class="tape__pair">
                                                    <StatusDot Tone="@NameTone(trade.Buyer)" />
                                                    <span class="num-xs tape__arrow">←</span>
                                                    <StatusDot Tone="@NameTone(trade.Seller)" />
                                                </span>
                                            </div>
                                        }
                                    </div>

                                    <div class="tape__legend">
                                        <StatusDot Tone="agent-trend">Трендовый</StatusDot>
                                        <StatusDot Tone="agent-counter">Контр-тренд</StatusDot>
                                        <StatusDot Tone="agent-mm">Маркет-мейкер</StatusDot>
                                        <StatusDot Tone="agent-news">Новостной</StatusDot>
                                    </div>
                                </div>
                            }
                        </ChildContent>
                    </Panel>
                </div>
            </div>
        }
    </main>
</div>

@code {
    // Список таймфреймов переехал в Services/Timeframes: тот же список
    // рисуется на «Профиле» в настройке «таймфрейм по умолчанию», и два
    // списка подписей разошлись бы при первой же правке.
    private static readonly IReadOnlyDictionary<string, TimeframeOption> TimeframesByKey =
        Timeframes.All.ToDictionary(item => item.Key, StringComparer.Ordinal);

    private const int MetricHistoryLimit = 72;
    private const int VisibleOrderBookDepth = 50;

    /// <summary>Тикер из адреса: <c>/trading/GLEN</c>. Пусто — открыть последний выбранный.</summary>
    [Parameter] public string? Symbol { get; set; }

    private SessionAsset? Asset => Registry.Find(Symbol);

    /// <summary>Рынок актива в сессии — идущей или только что остановленной.</summary>
    private AssetMarket? Market => Asset is { } asset ? Markets.Market(asset.Id) : null;

    /// <summary>Прогон рынка этого актива: по нему читаются свечи и сводка.</summary>
    private Guid RunId => Market?.RunId ?? Guid.Empty;

    private Guid shownAssetId;
    private Guid shownRunId;
    private int appliedTick = -1;
    private bool isBusy;
    private OrderBookViewData OrderBookData => BuildOrderBookData(latestTick?.OrderBook);

