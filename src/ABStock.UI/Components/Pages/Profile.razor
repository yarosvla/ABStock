@page "/profile"
@layout CreateAssetLayout
@rendermode InteractiveServer
@using ABStock.Application.MarketHistory
@using ABStock.Application.Simulation
@using ABStock.Shared
@using ABStock.UI.Services
@implements IDisposable
@inject ISimulationHistoryReader SimulationHistoryReader
@inject IActiveAssetContext ActiveAssetContext
@inject ISimulationRunner SimulationRunner

<PageTitle>Профиль</PageTitle>

<div class="profile-shell">
    <TopNavigation ActivePage="Profile" ShowClock="true" />

    <main class="profile-main">
        <header class="page-heading">
            <div>
                <p class="breadcrumbs">
                    <a href="/create-asset">Создание актива</a>
                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                    <span>Профиль</span>
                </p>
                <h1>Профиль</h1>
                <p>Рабочие настройки, история симуляций и текущий контекст актива @CurrentAsset.Draft.Name</p>
            </div>
        </header>

        <section class="profile-grid" aria-label="Профиль ABStock">
            <aside class="profile-sidebar">
                <section class="glass-card identity-card" aria-labelledby="identity-title">
                    <span class="profile-avatar" aria-hidden="true">@AvatarInitials</span>
                    @if (isEditingName)
                    {
                        <div class="name-edit">
                            <input type="text" @bind="userName" @bind:event="oninput" @onkeyup="HandleNameKey" autofocus />
                            <button @onclick="SaveName"><i class="bi bi-check2"></i></button>
                        </div>
                    }
                    else
                    {
                        <h2 id="identity-title">@userName <button class="edit-name-btn" @onclick="EditName" aria-label="Редактировать имя"><i class="bi bi-pencil"></i></button></h2>
                    }
                    <p>Оператор симуляции · ABStock</p>
                    <div class="identity-tags">
                        <span>@CurrentAsset.Symbol</span>
                        <span>@GetAssetTypeLabel(CurrentAsset.Draft.AssetType)</span>
                    </div>
                </section>

                <section class="glass-card security-card" aria-labelledby="security-title">
                    <div class="panel-heading">
                        <h2 id="security-title">Безопасность</h2>
                        <span>локально</span>
                    </div>
                    @foreach (var item in SecurityItems)
                    {
                        <div class="security-row">
                            <i class="bi @item.Icon" aria-hidden="true"></i>
                            <span>@item.Label</span>
                            <strong class="@item.ClassName">@item.Value</strong>
                        </div>
                    }
                </section>

                <section class="glass-card notification-card" aria-labelledby="notifications-title">
                    <div class="panel-heading">
                        <h2 id="notifications-title">Уведомления</h2>
                        <span>3 канала</span>
                    </div>
                    @foreach (var item in NotificationItems)
                    {
                        <div class="notification-row">
                            <span>@item.Label</span>
                            <strong class="@item.ClassName">@item.Value</strong>
                        </div>
                    }
                </section>
            </aside>

            <section class="profile-content">
                <section class="profile-metrics" aria-label="Статистика профиля">
                    @foreach (var metric in ProfileMetrics)
                    {
                        <article class="glass-card profile-metric @metric.ClassName">
                            <span>@metric.Label</span>
                            <strong>@metric.Value</strong>
                            <small>@metric.Detail</small>
                        </article>
                    }
                </section>

                <section class="glass-card preferences-card" aria-labelledby="preferences-title">
                    <div class="panel-heading">
                        <h2 id="preferences-title">Торговые предпочтения</h2>
                        <span>демо-набор</span>
                    </div>
                    <div class="preference-grid">
                        @foreach (var preference in TradingPreferences)
                        {
                            <article>
                                <i class="bi @preference.Icon" aria-hidden="true"></i>
                                <span>@preference.Label</span>
                                <strong>@preference.Value</strong>
                            </article>
                        }
                    </div>
                </section>

                <section class="glass-card settings-card" aria-labelledby="settings-title">
                    <div class="panel-heading">
                        <h2 id="settings-title">Настройки интерфейса</h2>
                        <span>без сохранения</span>
                    </div>
                    <div class="settings-list interactive-settings">
                        <label class="setting-toggle">
                            <span>
                                <i class="bi bi-speedometer2" aria-hidden="true"></i> Компактный режим
                            </span>
                            <div class="toggle-switch @(IsCompactMode ? "active" : "")">
                                <input type="checkbox" @bind="IsCompactMode" />
                                <i></i>
                            </div>
                        </label>
                        <label class="setting-toggle">
                            <span>
                                <i class="bi bi-bell-fill" aria-hidden="true"></i> Звуковые уведомления
                            </span>
                            <div class="toggle-switch @(SoundEnabled ? "active" : "")">
                                <input type="checkbox" @bind="SoundEnabled" />
                                <i></i>
                            </div>
                        </label>
                    </div>
                </section>
            </section>

            <aside class="profile-activity">
                <section class="glass-card activity-card" aria-labelledby="activity-title">
                    <div class="panel-heading">
                        <h2 id="activity-title">Активность</h2>
                        <span>сегодня</span>
                    </div>
                    <div class="activity-list">
                        @if (ActivityItems.Count == 0)
                        {
                            <article>
                                <time>—</time>
                                <div>
                                    <strong>История пока пуста</strong>
                                    <span>После запуска симуляций и сделок здесь появятся реальные события.</span>
                                </div>
                            </article>
                        }
                        else
                        {
                            @foreach (var item in ActivityItems)
                            {
                                <article>
                                    <time>@item.Time</time>
                                    <div>
                                        <strong>@item.Title</strong>
                                        <span>@item.Detail</span>
                                    </div>
                                </article>
                            }
                        }
                    </div>
                </section>
            </aside>
        </section>
    </main>
</div>

@code {
    private const int HistoryRefreshTickInterval = 5;

    private SimulationHistoryOverview historyOverview = new(0, 0, 0, 0, []);
    private int ticksSinceHistoryRefresh;
    private ActiveAssetView CurrentAsset => ActiveAssetContext.GetView();
    private ProfileMetric[] ProfileMetrics => BuildProfileMetrics();
    private ProfilePreference[] TradingPreferences => BuildTradingPreferences();
    private IReadOnlyList<ActivityItem> ActivityItems => BuildActivityItems();

    private bool IsCompactMode { get; set; } = true;
    private bool SoundEnabled { get; set; } = false;

    private string userName = "Алексей Ковалёв";
    private bool isEditingName = false;

    protected override void OnInitialized()
    {
        LoadHistory();
        SimulationRunner.OnTick += HandleSimulationTick;
    }

    private void LoadHistory()
    {
        historyOverview = SimulationHistoryReader.GetOverview(10);
    }

    private void HandleSimulationTick(SimulationTickResult tickResult)
    {
        // GetOverview issues several aggregate queries; refresh periodically instead of
        // on every tick to avoid hammering the database for each open Profile circuit.
        if (++ticksSinceHistoryRefresh < HistoryRefreshTickInterval)
        {
            return;
        }

        ticksSinceHistoryRefresh = 0;
        _ = InvokeAsync(() =>
        {
            LoadHistory();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        SimulationRunner.OnTick -= HandleSimulationTick;
    }

    private string AvatarInitials
    {
        get
        {
            var parts = userName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length == 0) return "АК";
            if (parts.Length == 1) return parts[0][..Math.Min(2, parts[0].Length)].ToUpper();
            return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
        }
    }

    private void EditName() => isEditingName = true;
    private void SaveName() => isEditingName = false;
    private void HandleNameKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            SaveName();
    }

    private static SecurityItem[] SecurityItems =>
    [
        new("bi-hdd-network", "Среда", "локальная", "positive"),
        new("bi-shield-check", "История", "persisted", "positive"),
        new("bi-person-lock", "Авторизация", "демо", "")
    ];

    private static NotificationItem[] NotificationItems =>
    [
        new("Сделки и исполнение", "включено", "positive"),
        new("Новости по активу", "включено", "positive"),
        new("Системные события", "тихо", "")
    ];

    private ProfileMetric[] BuildProfileMetrics() =>
    [
        new("Сессий", historyOverview.RunCount.ToString(), "persisted runs", historyOverview.RunCount > 0 ? "positive" : string.Empty),
        new("Активов создано", historyOverview.DistinctAssetCount.ToString(), $"текущий: {CurrentAsset.Symbol}", historyOverview.DistinctAssetCount > 0 ? "positive" : string.Empty),
        new("Тестовых сделок", historyOverview.TotalTradeCount.ToString("N0"), "persisted history", historyOverview.TotalTradeCount > 0 ? "positive" : string.Empty),
        new("Тиков рынка", historyOverview.TotalTickCount.ToString("N0"), "история симуляций", historyOverview.TotalTickCount > 0 ? "positive" : string.Empty)
    ];

    private ProfilePreference[] BuildTradingPreferences() =>
    [
        new("bi-currency-exchange", "Валюта", "RUB"),
        new("bi-clock-history", "Горизонт", "интрадей"),
        new("bi-bar-chart", "График", "свечи"),
        new("bi-list-columns", "Стакан", "8 уровней"),
        new("bi-robot", "Агенты", "4 стратегии"),
        new("bi-newspaper", "Актив", CurrentAsset.Symbol)
    ];

    private IReadOnlyList<ActivityItem> BuildActivityItems() =>
        historyOverview.RecentActivity
            .Select(item => new ActivityItem(
                item.OccurredAt.ToLocalTime().ToString("HH:mm"),
                item.Title,
                item.Detail))
            .ToArray();

    private static string GetAssetTypeLabel(AssetType assetType) => assetType switch
    {
        AssetType.Stock => "Акция",
        AssetType.Bond => "Облигация",
        AssetType.Commodity => "Товар",
        AssetType.Crypto => "Криптоактив",
        _ => assetType.ToString()
    };

    private sealed record ProfileMetric(string Label, string Value, string Detail, string ClassName);
    private sealed record ProfilePreference(string Icon, string Label, string Value);
    private sealed record SecurityItem(string Icon, string Label, string Value, string ClassName);
    private sealed record ActivityItem(string Time, string Title, string Detail);
    private sealed record NotificationItem(string Label, string Value, string ClassName);
}
