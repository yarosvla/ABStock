@page "/news"
@rendermode InteractiveServer
@using System.Globalization
@using System.Text
@using ABStock.Application.MarketHistory
@using ABStock.Shared
@using ABStock.UI.Services
@using static ABStock.UI.Services.NumberFormat
@implements IDisposable
@inject INewsDesk NewsDesk
@inject IAssetRegistry Registry
@inject ISessionMarkets Markets
@inject ISessionEvents Events
@inject IMarketCandleReader CandleReader
@inject IAgentStatisticsReader AgentStatistics

<PageTitle>Новости</PageTitle>

@{
    var isRunning = Markets.IsRunning;
    var news = SelectedNews;
    var showComposer = isRunning && (isComposing || Events.News.Count == 0) && !isAnalyzing;
}

<div class="app-bg" aria-hidden="true"><div class="app-bg__noise"></div></div>

<div class="news-shell">
    <TopNavigation ActivePage="News" ShowClock="true" />

    <main class="news-page">
        @* Новости общие на все активы — актива в пути нет (раздел 13). *@
        <Breadcrumbs Items="@(new Crumb[] { new("Активы", Href: "/assets"), new("Новости") })">
            <Aside>
                <SessionChip Running="isRunning" Elapsed="@SessionClock.Format(Markets)" />
            </Aside>
        </Breadcrumbs>

        <PageHead Title="Новости">
            <Context>
                Каждая новость разбирается сразу по всем активам в торгах ·
                новостей в сессии <span class="num-sm">@Events.News.Count</span>
            </Context>
            <Actions>
                @if (isRunning && !showComposer && !isAnalyzing)
                {
                    <AppButton Variant="primary" Icon="plus" OnClick="OpenComposer">Добавить новость</AppButton>
                }
            </Actions>
        </PageHead>

        <div class="news-layout">
            @* ─────────── Левый рельс — та же хронология, что на «Торгах» ─────────── *@
            <Panel Title="События сессии" Class="news-events rise rise-1" Flush="true">
                <MetaContent><span class="num-sm">@Count0(Events.Entries.Count)</span></MetaContent>
                <ChildContent>
                    @if (Events.Entries.Count > 0)
                    {
                        <div class="events">
                            @foreach (var entry in Events.Entries)
                            {
                                if (entry.Kind == SessionEventKind.News)
                                {
                                    var isCurrent = entry.At == news?.At;
                                    <div class="events__row" role="button" tabindex="0"
                                         aria-pressed="@(isCurrent ? "true" : "false")"
                                         @onclick="() => SelectNews(entry)"
                                         @onkeydown="@(args => HandleNewsKey(args, entry))">
                                        <SessionEventRow Event="entry" Current="isCurrent" />
                                    </div>
                                }
                                else
                                {
                                    <SessionEventRow Event="entry" />
                                }
                            }
                        </div>
                    }
                    else
                    {
                        <EmptyState IconName="news" Title="Событий пока нет"
                                    Description="Здесь копится хронология сессии: новости, запуск торгов, заметные сделки агентов." />
                    }
                </ChildContent>
            </Panel>

            <div class="news-main">
                @if (!isRunning && Events.News.Count == 0)
                {
                    <Panel Class="rise rise-2">
                        <EmptyState IconName="news" Title="Новость вводить некуда"
                                    Description="Новость разбирается по активам в торгах: сигналу нужен рынок, который на него отреагирует.">
                            <Action>
                                <AppButton Variant="primary" Href="/assets">Перейти к активам</AppButton>
                            </Action>
                        </EmptyState>
                    </Panel>
                }

                @if (showComposer)
                {
                    <Panel Title="Новая новость" Class="rise rise-2">
                        <MetaContent>
                            разберётся по <span class="num-sm">@TradingCount</span> @Plural(TradingCount, "активу", "активам", "активам") в торгах
                        </MetaContent>
                        <ChildContent>
                            <div class="composer">
                                <textarea class="composer__field @(HasLengthError ? "is-error" : null)"
                                          rows="5"
                                          maxlength="@INewsDesk.MaxLength"
                                          aria-label="Текст новости"
                                          aria-invalid="@(HasLengthError ? "true" : null)"
                                          placeholder="Что произошло. Обычный текст: сообщение, заголовок новости, фрагмент отчёта."
                                          @bind="newsText"
                                          @bind:event="oninput"></textarea>

                                <div class="composer__foot">
                                    @if (HasLengthError)
                                    {
                                        <p class="composer__error">
                                            <Icon Name="alert" Size="14" />
                                            Нужно не меньше <span class="num-sm">@INewsDesk.MinLength</span> символов — введено <span class="num-sm">@TrimmedLength</span>
                                        </p>
                                    }
                                    else
                                    {
                                        <p class="composer__hint">Тональность считается один раз, сила влияния — по профилю каждого актива</p>
                                    }

                                    <div class="composer__actions">
                                        <span class="composer__count num-sm">@TrimmedLength / @INewsDesk.MaxLength</span>
                                        @if (Events.News.Count > 0)
                                        {
                                            <AppButton Variant="ghost" OnClick="CloseComposer">Отмена</AppButton>
                                        }
                                        <AppButton Variant="primary" Disabled="@(!CanAnalyze)" OnClick="AnalyzeAsync">Разобрать по активам</AppButton>
                                    </div>
                                </div>
                            </div>
                        </ChildContent>
                    </Panel>
                }

                @if (isAnalyzing)
                {
                    <Panel Title="Влияние новости по активам" Class="rise rise-2">
                        <MetaContent>разбор по профилям</MetaContent>
                        <ChildContent>
                            <div class="news-loading">
                                @for (var i = 0; i < Math.Max(1, TradingCount); i++)
                                {
                                    <div class="news-loading__row">
                                        <Skeleton Width="180px" Height="28px" />
                                        <Skeleton Height="12px" />
                                        <Skeleton Width="80px" Height="14px" />
                                    </div>
                                }
                            </div>
                        </ChildContent>
                    </Panel>
                }

                @if (errorMessage is not null)
                {
                    <Panel Class="rise rise-2" Flush="true">
                        <div class="error-bar">
                            <span class="error-bar__text"><Icon Name="alert" Size="16" />@errorMessage</span>
                            <AppButton Variant="secondary" Size="26" OnClick="AnalyzeAsync">Повторить разбор</AppButton>
                        </div>
                        <p class="error-foot">Текст сохранён в поле ввода. Торги идут дальше — не разобрана только эта новость.</p>
                    </Panel>
                }

                @* Главный объект экрана: новость веером расходится по активам. *@
                @if (news?.Fan is { } fan && !showComposer)
                {
                    var selected = SelectedSymbolFor(fan);
                    var row = fan.For(selected);
                    var asset = Registry.Find(selected);

                    <Panel Class="rise rise-2" Flush="true">
                        <Head>
                            <span class="news-title">
                                <h2>Влияние новости по активам</h2>
                                <span class="caption num-xs">@news.At.ToString("HH:mm")</span>
                            </span>
                            <span class="ui-panel__meta">строка выбирает актив · толщина связи — сила влияния</span>
                        </Head>
                        <ChildContent>
                            <ImpactFan News="news"
                                       SelectedSymbol="@selected"
                                       SelectedSymbolChanged="SelectAsset"
                                       FindAsset="Registry.Find"
                                       CurrentPrice="CurrentPrice" />
                        </ChildContent>
                    </Panel>

                    <div class="news-pair">
                        @* ── Разбор выбранного актива: формула одной строкой ── *@
                        <Panel Flush="true" Class="rise rise-3">
                            <Head>
                                <span class="news-title"><h2>Разбор</h2>@if (selected is not null) { <Ticker Symbol="@selected" /> }</span>
                                <span class="ui-panel__meta">выбранная строка веера</span>
                            </Head>
                            <ChildContent>
                                @if (row is null || !row.WasAnalyzed)
                                {
                                    <p class="news-note">Актив не был в торгах — новость по нему не разбиралась.</p>
                                }
                                else if (!row.IsHit)
                                {
                                    <p class="news-note">Ни один пункт профиля @selected не совпал с новостью — сигнала нет, и агенты этот актив по ней не торгуют.</p>
                                }
                                else
                                {
                                    var signal = row.Signal!;
                                    var sensitivity = asset?.Profile.NewsSensitivity ?? 0m;
                                    var factorsSum = sensitivity == 0m ? 0m : signal.ImpactScore / sensitivity;

                                    @* Формула — та, что считает модуль новостей: вклады сработавших
                                       факторов, умноженные на чувствительность актива. *@
                                    <div class="formula">
                                        <span class="formula__term"><span class="num-lg">@Signed2(factorsSum)</span><span class="caption">вклад сработавших факторов</span></span>
                                        <span class="formula__op">×</span>
                                        <span class="formula__term"><span class="num-lg">@sensitivity.ToString("F2")</span><span class="caption">чувствительность @selected</span></span>
                                        <span class="formula__op">=</span>
                                        <span class="formula__term formula__term--result"><span class="num-lg">@Signed2(signal.ImpactScore)</span><span class="caption">сила влияния</span></span>
                                    </div>
                                    <div class="factors-head">
                                        <span class="label">Сработавшие факторы профиля</span>
                                        <span class="caption"><span class="num-xs">@signal.Factors.Count</span> из <span class="num-xs">@(asset?.Profile.Factors.Count ?? 0)</span></span>
                                    </div>
                                    @foreach (var factor in signal.Factors)
                                    {
                                        var contribution = Contribution(signal, factor, factorsSum);
                                        <div class="factor">
                                            <Badge Tone="@(contribution >= 0m ? "up" : "down")">@(factor.Kind == NewsFactorKind.Positive ? "позитивный" : "негативный")</Badge>
                                            <span class="factor__text">
                                                <span class="factor__name">@factor.Text</span>
                                                <span class="caption">
                                                    близость <span class="num-xs">@factor.Similarity.ToString("F2")</span> ·
                                                    вес <span class="num-xs">@factor.Importance.ToString("F2")</span> ·
                                                    вклад <span class="num-xs @DeltaTone(contribution)">@Signed2(contribution)</span>
                                                </span>
                                            </span>
                                        </div>
                                    }
                                }
                            </ChildContent>
                        </Panel>

                        @* ── Реакция рынка: что стало с ценой и кто действовал ── *@
                        <Panel Flush="true" Class="rise rise-3">
                            <Head>
                                <span class="news-title"><h2>Реакция рынка</h2>@if (selected is not null) { <Ticker Symbol="@selected" /> }</span>
                                <span class="ui-panel__meta">@ReactionPeriod · отметка — новость</span>
                            </Head>
                            <ChildContent>
                                @if (Reaction(news, selected) is { } reaction)
                                {
                                    <div class="reaction">
                                        <div class="reaction__head">
                                            <span class="num-md t3">@Price2(reaction.From) →</span>
                                            <span class="num-lg">@Price2(reaction.To)</span>
                                            <span class="num-sm @DeltaTone(reaction.To - reaction.From)">@Sign(reaction.Percent)@Percent2(Math.Abs(reaction.Percent)) %</span>
                                            <span class="caption">после новости</span>
                                        </div>
                                        @if (reaction.Before.Length + reaction.After.Length > 1)
                                        {
                                            <div class="reaction__plot">
                                                <svg width="100%" height="96" viewBox="0 0 400 96" preserveAspectRatio="none" aria-label="Цена @selected за сессию, отметка новости">
                                                    <path class="reaction__open" d="@reaction.OpenPath" vector-effect="non-scaling-stroke" />
                                                    <path class="reaction__news" d="@reaction.NewsPath" vector-effect="non-scaling-stroke" />
                                                    <path class="reaction__line reaction__line--@reaction.BeforeTone" d="@reaction.Before" vector-effect="non-scaling-stroke" />
                                                    <path class="reaction__line reaction__line--@reaction.AfterTone" d="@reaction.After" vector-effect="non-scaling-stroke" />
                                                </svg>
                                                <span class="reaction__label" style="left:@reaction.NewsLeft">новость</span>
                                            </div>
                                            <div class="reaction__axis num-xs">
                                                <span>@reaction.Start.ToString("HH:mm")</span>
                                                <span>@news.At.ToString("HH:mm")</span>
                                                <span>@reaction.End.ToString("HH:mm")</span>
                                            </div>
                                        }
                                    </div>
                                    @foreach (var trade in NewsAgentTrades(news, selected))
                                    {
                                        <div class="factor">
                                            <span class="agent-name"><StatusDot Tone="agent-news" />@trade.Agent</span>
                                            <span class="factor__text">
                                                <span class="factor__name">@(trade.Side == OrderSide.Buy ? "купил" : "продал") @Quantity1(trade.Quantity) шт @selected</span>
                                                <span class="caption">средняя <span class="num-xs t2">@Price2(trade.AveragePrice)</span> · через <span class="num-xs">@trade.Delay</span> с после сигнала</span>
                                            </span>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <p class="news-note">Цена на момент новости неизвестна — актив не торговался.</p>
                                }
                            </ChildContent>
                        </Panel>
                    </div>
                }
            </div>
        </div>
    </main>
</div>

@code {
    /// <summary>Окно, в котором сделки новостных агентов считаются ответом на новость.</summary>
    private static readonly TimeSpan ReactionWindow = TimeSpan.FromSeconds(30);

    private string newsText = string.Empty;
    private bool isComposing;
    private bool isAnalyzing;
    private string? errorMessage;
    private DateTimeOffset? selectedNewsAt;
    private string? selectedSymbol;

    private int TrimmedLength => newsText.Trim().Length;

    private bool HasLengthError => TrimmedLength > 0 && TrimmedLength < INewsDesk.MinLength;

    private bool CanAnalyze => !isAnalyzing && Markets.IsRunning && TrimmedLength >= INewsDesk.MinLength;

    private int TradingCount => Registry.Assets.Count(asset => Markets.Trades(asset.Id));

    /// <summary>Какая новость разобрана. По умолчанию — свежая: за ней и приходят.</summary>
    private SessionEvent? SelectedNews =>
        Events.News.FirstOrDefault(entry => entry.At == selectedNewsAt) ?? Events.News.FirstOrDefault();

    /// <summary>Строка веера по умолчанию — самый задетый актив.</summary>
    private string? SelectedSymbolFor(NewsFan fan) =>
        selectedSymbol is not null && fan.For(selectedSymbol) is not null
            ? fan.For(selectedSymbol)!.Symbol
            : fan.Lead?.Symbol ?? fan.Assets.FirstOrDefault(row => row.WasAnalyzed)?.Symbol;

    protected override void OnInitialized()
    {
        Markets.Changed += HandleChanged;
        Events.Changed += HandleChanged;
    }

    private void HandleChanged() => _ = InvokeAsync(StateHasChanged);

    private void OpenComposer()
    {
        isComposing = true;
        errorMessage = null;
    }

    private void CloseComposer() => isComposing = false;

    private void SelectNews(SessionEvent entry)
    {
        selectedNewsAt = entry.At;
        selectedSymbol = null;
        isComposing = false;
    }

    private void HandleNewsKey(KeyboardEventArgs args, SessionEvent entry)
    {
        if (args.Key is "Enter" or " ")
        {
            SelectNews(entry);
        }
    }

    private void SelectAsset(string symbol) => selectedSymbol = symbol;

    private async Task AnalyzeAsync()
    {
        if (!CanAnalyze)
        {
            return;
        }

        isAnalyzing = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            var entry = await NewsDesk.AnalyzeAsync(newsText);
            selectedNewsAt = entry.At;
            selectedSymbol = null;
            newsText = string.Empty;
            isComposing = false;
        }
        catch (Exception exception)
        {
            errorMessage = $"Разбор не выполнен — {exception.Message}";
        }
        finally
        {
            isAnalyzing = false;
        }
    }

    private decimal? CurrentPrice(string symbol) =>
        Registry.Find(symbol) is { } asset ? Markets.Market(asset.Id)?.LastPrice : null;

    /// <summary>
    /// Вклад одного фактора. Модуль новостей отдаёт сумму и близость с весом
    /// каждого фактора, но не тональность отдельно: она восстанавливается из
    /// суммы — одна на все факторы, ведь текст один.
    /// </summary>
    private static decimal Contribution(NewsSignal signal, NewsFactorMatch factor, decimal factorsSum)
    {
        var weights = signal.Factors.Sum(item => Signed(item) * item.Similarity * item.Importance);
        var tone = weights == 0m ? 0m : factorsSum / weights;
        return tone * Signed(factor) * factor.Similarity * factor.Importance;
    }

    private static decimal Signed(NewsFactorMatch factor) => factor.Kind == NewsFactorKind.Positive ? 1m : -1m;

    private static string Signed2(decimal value) => Sign(value) + Math.Abs(value).ToString("F2");

    private string ReactionPeriod =>
        Markets.StartedAt is { } started
            ? $"{started:HH:mm}–{(Markets.EndedAt ?? DateTimeOffset.Now):HH:mm}"
            : "—";

    // ── Реакция рынка ───────────────────────────────────────────────────────

    private sealed record ReactionView(
        decimal From, decimal To, decimal Percent,
        string Before, string After, string BeforeTone, string AfterTone,
        string OpenPath, string NewsPath, string NewsLeft,
        DateTimeOffset Start, DateTimeOffset End);

    /// <summary>
    /// Ход цены выбранного актива за сессию с отметкой новости — по свечам
    /// его прогона, теми же, что на графике «Торгов».
    /// </summary>
    private ReactionView? Reaction(SessionEvent news, string? symbol)
    {
        if (symbol is null
            || Registry.Find(symbol) is not { } asset
            || Markets.Market(asset.Id) is not { } market
            || news.PricesAtNews?.TryGetValue(symbol, out var from) != true)
        {
            return null;
        }

        var candles = CandleReader.GetCandles(market.RunId, TimeSpan.FromSeconds(10), 360);
        var points = candles.Select(candle => (Time: candle.StartedAt.ToLocalTime(), Price: candle.Close)).ToList();
        points.Add((DateTimeOffset.Now, market.LastPrice));

        var start = points[0].Time;
        var end = points[^1].Time;
        var span = Math.Max(1d, (end - start).TotalSeconds);
        var low = points.Min(point => point.Price) - 0.05m;
        var high = points.Max(point => point.Price) + 0.05m;

        string X(DateTimeOffset time) => F((decimal)((time - start).TotalSeconds / span * 400d));
        string Y(decimal price) => F(8m + (high - price) / Math.Max(0.01m, high - low) * 80m);

        string Path(IEnumerable<(DateTimeOffset Time, decimal Price)> part)
        {
            var path = new StringBuilder();
            foreach (var (time, price) in part)
            {
                path.Append(path.Length == 0 ? 'M' : 'L').Append(X(time)).Append(' ').Append(Y(price));
            }

            return path.ToString();
        }

        (DateTimeOffset Time, decimal Price) atNews = (news.At, from);
        var before = points.Where(point => point.Time <= news.At).Append(atNews).ToArray();
        var after = points.Where(point => point.Time > news.At).Prepend(atNews).ToArray();
        var tone = (decimal a, decimal b) => b > a ? "up" : b < a ? "down" : "flat";
        var newsX = X(news.At);

        return new ReactionView(
            from, market.LastPrice, from == 0m ? 0m : (market.LastPrice - from) / from * 100m,
            Path(before), Path(after),
            tone(before[0].Price, from), tone(from, market.LastPrice),
            $"M0 {Y(market.Open)}H400", $"M{newsX} 0V96",
            F((decimal)((news.At - start).TotalSeconds / span * 100d)) + "%",
            start, end);
    }

    private sealed record AgentTrade(string Agent, OrderSide Side, decimal Quantity, decimal AveragePrice, int Delay);

    /// <summary>
    /// Что сделали новостные агенты в этом активе сразу после новости — по их
    /// сделкам из истории прогона, а не по догадке.
    /// </summary>
    private IEnumerable<AgentTrade> NewsAgentTrades(SessionEvent news, string? symbol)
    {
        if (symbol is null || Registry.Find(symbol) is not { } asset || Markets.Market(asset.Id) is not { } market)
        {
            yield break;
        }

        var names = AgentDisplay.BuildInstanceNames(market.Last.Agents);

        foreach (var agent in market.Last.Agents.Where(agent => agent.Type == AgentType.NewsDriven))
        {
            var trades = AgentStatistics.GetReport(market.RunId, agent.Name)?.Trades
                .Where(trade => trade.ExecutedAt >= news.At && trade.ExecutedAt <= news.At + ReactionWindow)
                .ToArray() ?? [];

            if (trades.Length == 0)
            {
                continue;
            }

            var side = trades[0].Side;
            var same = trades.Where(trade => trade.Side == side).ToArray();
            var quantity = same.Sum(trade => trade.Quantity);
            var average = quantity == 0m ? 0m : same.Sum(trade => trade.Price * trade.Quantity) / quantity;

            yield return new AgentTrade(
                names.GetValueOrDefault(agent.Name, agent.Name),
                side,
                quantity,
                average,
                (int)Math.Max(0, Math.Round((same[0].ExecutedAt - news.At).TotalSeconds)));
        }
    }

    private static string F(decimal value) => value.ToString("0.#", CultureInfo.InvariantCulture);

    public void Dispose()
    {
        Markets.Changed -= HandleChanged;
        Events.Changed -= HandleChanged;
    }
}
