@page "/news"
@rendermode InteractiveServer
@using ABStock.AI.Models
@using ABStock.AI.Services
@using ABStock.Application.Simulation
@using ABStock.Shared
@using ABStock.UI.Services
@implements IDisposable
@inject INewsProcessingService NewsProcessingService
@inject ISimulationRunner SimulationRunner
@inject IActiveAssetContext ActiveAssetContext
@inject ISessionNewsFeed NewsFeed

<PageTitle>Новости</PageTitle>

@{
    // Локальные хелперы разметки: сопоставление значения с токеном оформления.
    // Форматирование и бизнес-логика живут в @code.
    var asset = CurrentAsset;
    var profile = asset.Profile;
    var isRunning = SimulationRunner.IsRunning;
    var snapshot = latestMarket?.Snapshot;
    var entries = NewsFeed.Entries;
    var hasResult = signal is not null;
}

<div class="app-bg" aria-hidden="true"><div class="app-bg__noise"></div></div>

<div class="news-shell">
    <TopNavigation ActivePage="News" ShowClock="true" />

    <main class="news-page">

        @* ── Крошки · Активы › Актив › Раздел (раздел 13) ───────────────────── *@
        <Breadcrumbs Items="@(new Crumb[]
                     {
                         new("Активы", Href: "/create-asset"),
                         new(asset.Draft.Name, IsAsset: true),
                         new("Новости")
                     })" />

        @* ── PageHeader: H1 + одна строка контекста · до двух действий ───────── *@
        <PageHead Title="Новости">
            <Context>
                @if (analyzedAt is not null && errorMessage is null)
                {
                    <text>Сигнал рассчитан в <span class="num-sm">@analyzedAt.Value.ToString("HH:mm:ss")</span></text>
                }
                else
                {
                    <text>Текст новости превращается в сигнал, на который реагирует новостной агент</text>
                }
                <text> · </text><span class="num-sm">@asset.Symbol</span>
                <text> · новостей в сессии </text><span class="num-sm">@entries.Count</span>
            </Context>
            <Actions>
                @if (isRunning && (hasResult || errorMessage is not null))
                {
                    <AppButton Variant="primary" OnClick="StartNewEntry">Новая новость</AppButton>
                }
            </Actions>
        </PageHead>

        @* ── Полоса связи — одна на экран (раздел 9.19) ──────────────────────
             До анализа во всех шести шагах прочерк: формула появляется
             только после расчёта. *@
        <CausalityStrip Class="rise rise-1" Label="Как новость превращается в сигнал и в цену">

            <CausalityStep Label="Новость" Weight="1.1">
                @if (isAnalyzing)
                {
                    <Skeleton Width="60%" Height="13px" />
                }
                else if (analyzedAt is null)
                {
                    <span class="strip__idle">не введена</span>
                }
                else
                {
                    <span class="strip__value num-sm">@analyzedAt.Value.ToString("HH:mm")</span>
                    <span class="ui-causality__note"><span class="num-sm">@AnalyzedLength</span> символов · текст ниже</span>
                }
            </CausalityStep>

            <CausalityStep Label="Тональность и уверенность" Weight="1">
                @if (isAnalyzing)
                {
                    <Skeleton Width="96px" Height="20px" Radius="var(--r-pill)" />
                }
                else if (signal is null)
                {
                    <span class="strip__dash num-sm">—</span>
                }
                else
                {
                    <span class="badge badge--@PolarityTone">@PolarityName</span>
                    <span class="ui-causality__note">уверенность <span class="num-sm num-sm--bright">@Fixed2(signal.Confidence)</span></span>
                }
            </CausalityStep>

            <CausalityStep Label="Совпадение с профилем" Weight="1.1">
                @if (isAnalyzing)
                {
                    <Skeleton Width="56%" Height="14px" />
                }
                else if (signal is null)
                {
                    <span class="strip__dash num-sm">—</span>
                }
                else
                {
                    <span class="strip__value num">@Fixed2(signal.MatchScore)</span>
                    <span class="ui-causality__note">
                        вес <span class="num-sm">@MatchedCount</span> совпавших пунктов профиля из <span class="num-sm">@ProfileItemCount</span>
                    </span>
                }
            </CausalityStep>

            <CausalityStep Label="Сила влияния" Weight="1.4">
                @if (isAnalyzing)
                {
                    <Skeleton Width="62px" Height="24px" />
                }
                else if (signal is null)
                {
                    <span class="strip__dash num-sm">—</span>
                }
                else
                {
                    <span class="strip__impact num-lg">@Fixed2(signal.ImpactScore)</span>
                    <span class="ui-causality__note">уверенность × чувствительность актива × совпадение по теме</span>
                }
            </CausalityStep>

            <CausalityStep Label="Новостной агент" Weight="1.2">
                @if (isAnalyzing)
                {
                    <Skeleton Width="78%" Height="13px" />
                }
                else if (signal is null)
                {
                    <span class="strip__dash num-sm">—</span>
                }
                else if (agentDecision is null)
                {
                    <span class="strip__idle">ждёт ближайшего шага симуляции</span>
                }
                else
                {
                    <span class="strip__agent">
                        <StatusDot Tone="agent-news" />
                        @AgentActionName
                    </span>
                }
            </CausalityStep>

            <CausalityStep Label="Сдвиг цены" Weight="1">
                @if (isAnalyzing)
                {
                    <Skeleton Width="84%" Height="14px" />
                }
                else if (signal is null || priceBefore is null)
                {
                    <span class="strip__dash num-sm">—</span>
                }
                else if (priceAfter is null)
                {
                    <span class="strip__idle">цена ещё не пересчитана</span>
                }
                else if (PriceUnchanged)
                {
                    <span class="strip__value num-sm">без изменения</span>
                    <span class="ui-causality__note">цена <span class="num-sm">@Money(priceAfter.Value)</span></span>
                }
                else
                {
                    <span class="strip__value num-sm"><span class="strip__was">@Fixed2(priceBefore.Value)</span> → @Fixed2(priceAfter.Value)</span>
                    <span class="ui-causality__note tone-@PriceTone">@PriceDeltaLabel</span>
                }
            </CausalityStep>

        </CausalityStrip>

        @* ── Рабочая область: рельс 280 · центр · рельс 340 ──────────────────── *@
        <div class="workspace">

            @* ─────────── ЛЕВЫЙ РЕЛЬС · хронология событий сессии ─────────── *@
            <div class="rail rail--left">
                <Panel Title="История сессии" Class="rise rise-2" Flush="true">
                    <MetaContent>
                        @if (entries.Count > 0)
                        {
                            <span class="num-sm">@entries.Count</span>
                        }
                    </MetaContent>
                    <ChildContent>
                        @if (entries.Count > 0)
                        {
                            <div class="events">
                                @foreach (var entry in entries)
                                {
                                    <NewsEventRow At="entry.At" Text="@entry.Text"
                                                  Polarity="entry.Polarity" ImpactScore="entry.ImpactScore"
                                                  Current="@IsCurrentEntry(entry)" />
                                }
                            </div>
                        }
                        else
                        {
                            <EmptyState IconName="news"
                                        Title="Новостей ещё не было"
                                        Description="Здесь копится хронология сессии: время, тональность и сила влияния каждой новости." />
                        }
                    </ChildContent>
                </Panel>
            </div>

            @* ─────────── ЦЕНТР · разбор ─────────── *@
            <div class="center">

                @* Решение новостного агента живёт под полосой связи во всех
                   состояниях: шаг полосы несёт короткое действие, развёрнутое
                   объяснение — здесь. До появления новости агент неактивен, и
                   это состояние показывается, а не прячется (раздел 16.4). *@
                @if (isRunning)
                {
                    <Panel Quiet="true" Class="rise rise-2">
                        <div class="agent-line">
                            <span class="label agent-line__label">Новостной агент</span>
                            <StatusDot Tone="agent-news" />
                            <span class="agent-line__name">@NewsAgentName</span>
                            <span class="agent-line__state">@AgentStateText</span>
                            @if (NewsAgent is not null)
                            {
                                <span class="agent-line__metric">деньги <span class="num-sm">@Count0(NewsAgent.Cash)</span></span>
                                <span class="agent-line__metric">позиция <span class="num-sm">@Position0(NewsAgent.Position)</span></span>
                            }
                        </div>
                    </Panel>
                }

                @if (!isRunning)
                {
                    @* Состояние: торги не запущены. Новость появляется только
                       после старта — сигналу нужен рынок, который отреагирует. *@
                    <Panel Class="rise rise-3">
                        <EmptyState IconName="news"
                                    Title="Новость вводить некуда"
                                    Description="Новости появляются только после старта торгов: сигналу нужен рынок, который на него отреагирует.">
                            <Action>
                                <AppButton Variant="primary" Href="/trading">Перейти к торгам</AppButton>
                            </Action>
                        </EmptyState>
                    </Panel>
                }
                else if (isAnalyzing)
                {
                    @* Состояние: анализ идёт. Скелетоны по форме будущего разбора. *@
                    <Panel Class="rise rise-3" Title="Разбор новости">
                        <MetaContent><Skeleton Width="96px" Height="10px" /></MetaContent>
                        <ChildContent>
                            <div class="loading">
                                <div class="loading__block">
                                    <span class="label">Текст новости</span>
                                    <Skeleton Height="13px" />
                                    <Skeleton Width="82%" Height="13px" />
                                </div>
                                <div class="loading__block hairline-top">
                                    <span class="label">Сила влияния</span>
                                    <Skeleton Height="26px" />
                                    <div class="loading__row">
                                        <Skeleton Width="56px" Height="10px" />
                                        <Skeleton Width="56px" Height="10px" />
                                    </div>
                                </div>
                                <div class="loading__block hairline-top">
                                    <span class="label">Сработавшие факторы профиля</span>
                                    <Skeleton Height="14px" />
                                    <Skeleton Width="88%" Height="14px" />
                                    <Skeleton Width="64%" Height="14px" />
                                </div>
                            </div>
                        </ChildContent>
                    </Panel>
                }
                else if (errorMessage is not null)
                {
                    @* Состояние: анализ не выполнен. Текст новости сохранён,
                       полоса связи выше стоит с прочерками, торги идут дальше. *@
                    <Panel Class="rise rise-3 news-error" Flush="true">
                        <div class="error-bar">
                            <span class="error-bar__text"><Icon Name="alert" Size="16" />@errorMessage</span>
                            <AppButton Variant="secondary" Size="26" OnClick="RetryAsync">Повторить анализ</AppButton>
                        </div>
                        <div class="error-body">
                            <div class="news-text__head">
                                <span class="label">Текст новости</span>
                                <span class="news-text__meta">сохранён · <span class="num-sm">@AnalyzedLength</span> символов</span>
                            </div>
                            <p class="news-text__body">@analyzedText</p>
                        </div>
                        <p class="error-foot hairline-top">Торги идут, цена продолжает обновляться — сигнал не рассчитан только по этой новости.</p>
                    </Panel>
                }
                else if (signal is null)
                {
                    @* Состояние: ввод. *@
                    <Panel Title="Новая новость" Class="rise rise-3">
                        <MetaContent>
                            <text>от <span class="num-sm">@MinNewsLength</span> до <span class="num-sm">@MaxNewsLength</span> символов</text>
                        </MetaContent>
                        <ChildContent>
                            <div class="composer">
                                <textarea id="news-text"
                                          class="composer__field @(HasLengthError ? "is-error" : null)"
                                          rows="6"
                                          maxlength="@MaxNewsLength"
                                          aria-label="Текст новости"
                                          aria-invalid="@(HasLengthError ? "true" : null)"
                                          placeholder="Что произошло с компанией. Обычный текст: сообщение, заголовок новости, фрагмент отчёта."
                                          @bind="newsText"
                                          @bind:event="oninput"></textarea>

                                <div class="composer__foot">
                                    @if (HasLengthError)
                                    {
                                        <p class="composer__error">
                                            <Icon Name="alert" Size="14" />
                                            Нужно не меньше <span class="num-sm">@MinNewsLength</span> символов — введено <span class="num-sm">@TrimmedLength</span>
                                        </p>
                                    }
                                    else if (CanAnalyze)
                                    {
                                        <p class="composer__hint">Текст готов к анализу</p>
                                    }
                                    else
                                    {
                                        <p class="composer__hint">Кнопка станет доступна после <span class="num-sm">@MinNewsLength</span> символов</p>
                                    }

                                    <div class="composer__actions">
                                        <span class="composer__count num-sm">@TrimmedLength / @MaxNewsLength</span>
                                        <AppButton Variant="primary" Disabled="@(!CanAnalyze)" OnClick="AnalyzeAsync">Проанализировать</AppButton>
                                    </div>
                                </div>
                            </div>
                        </ChildContent>
                    </Panel>

                }
                else
                {
                    @* Состояние: разбор готов. *@
                    <Panel Class="rise rise-3">
                        <div class="news-text__head">
                            <span class="label">Текст новости</span>
                            <span class="news-text__meta">
                                введена пользователем <span class="num-sm">@analyzedAt!.Value.ToString("HH:mm")</span> ·
                                <span class="num-sm">@AnalyzedLength</span> символов
                            </span>
                        </div>
                        <p class="news-text__body">@analyzedText</p>
                    </Panel>

                    <Panel Title="Сила влияния" Class="rise rise-4">
                        <MetaContent>
                            <text>типичное значение около <span class="num-sm">@Fixed2(TypicalImpact)</span></text>
                        </MetaContent>
                        <ChildContent>
                            <ZoneScale Value="signal.ImpactScore"
                                       Min="ImpactMin" Max="ImpactMax"
                                       Zones="ImpactZones"
                                       Note="@ImpactNote" />
                        </ChildContent>
                    </Panel>

                    @* Сработавшие факторы. Список формулировок и фрагментов
                       совпадения анализатор пока не возвращает — из
                       AspectMatchResult приходят только количества, поэтому
                       здесь честная сводка, а не выдуманные строки. *@
                    <Panel Title="Сработавшие факторы профиля" Class="rise rise-5" Flush="true">
                        <MetaContent>
                            <text>профиль собран на «Создании актива»</text>
                        </MetaContent>
                        <ChildContent>
                            @if (MatchedFactors.Count > 0)
                            {
                                <div class="factors">
                                    @foreach (var factor in MatchedFactors)
                                    {
                                        <div class="factor">
                                            <span class="badge badge--@factor.Tone factor__kind">@factor.KindName</span>
                                            <span class="factor__text" title="@factor.Text">@factor.Text</span>
                                            <span class="factor__excerpt">совпало с «@factor.Excerpt»</span>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="factors-summary">
                                    <div class="factors-summary__counts">
                                        <span class="factors-summary__count">позитивных <span class="num-sm">@signal.PositiveMatches</span></span>
                                        <span class="factors-summary__count">негативных <span class="num-sm">@signal.NegativeMatches</span></span>
                                        <span class="factors-summary__count">рисков <span class="num-sm">@signal.RiskMatches</span></span>
                                    </div>
                                    <p class="factors-summary__note">
                                        Какие именно формулировки профиля сработали и с каким фрагментом новости
                                        они совпали, анализатор пока не сообщает — из разбора приходят только
                                        количества.
                                    </p>
                                </div>
                            }
                        </ChildContent>
                    </Panel>

                    <Panel Title="Объяснение модели" Class="rise rise-6">
                        <p class="explanation">@signal.Explanation</p>
                    </Panel>
                }
            </div>

            @* ─────────── ПРАВЫЙ РЕЛЬС · состояние на сейчас ─────────── *@
            <div class="rail rail--right">
                <Panel Title="Профиль актива" Class="rise rise-3">
                    <MetaContent><text>по нему сопоставляется новость</text></MetaContent>
                    <ChildContent>
                        <div class="profile">
                            <ZoneScale Value="profile.NewsSensitivity"
                                       Min="SensitivityMin" Max="SensitivityMax"
                                       Zones="SensitivityZones"
                                       Label="Чувствительность к новостям"
                                       Note="@SensitivityName"
                                       Compact="true" />

                            <section class="profile__block hairline-top">
                                <div class="profile__head">
                                    <span class="label">Факторы профиля</span>
                                </div>
                                <BalanceBar Positive="profile.PositiveFactors.Count"
                                            Negative="profile.NegativeFactors.Count"
                                            PositiveLabel="позитивных"
                                            NegativeLabel="негативных" />

                                @* Риск — не встречная величина, в полосу баланса он не входит.
                                   Своя дорожка того же веса под полосой: геометрия общая,
                                   заливки нет — видно, что это условие, а не факт. *@
                                <div class="risks">
                                    <span class="risks__count num-sm">@profile.Risks.Count</span>
                                    <span class="risks__label">@RiskWord</span>
                                    <span class="risks__hint">условия, а не факты</span>
                                </div>
                            </section>

                            <section class="profile__block hairline-top">
                                <span class="label">Ключевые слова</span>
                                <div class="profile__chips">
                                    @foreach (var keyword in profile.Keywords)
                                    {
                                        <span class="chip">@keyword</span>
                                    }
                                </div>
                            </section>
                        </div>
                    </ChildContent>
                </Panel>

                <Panel Quiet="true" Class="rise rise-4">
                    <div class="market">
                        <span class="label">@MarketTitle</span>
                        <dl class="kv">
                            <div class="kv__row">
                                <dt>цена</dt>
                                <dd class="num-sm">@(snapshot is null ? "—" : Money(snapshot.LastPrice))</dd>
                            </div>
                            <div class="kv__row">
                                <dt>спред</dt>
                                <dd class="num-sm">@SpreadLabel</dd>
                            </div>
                            <div class="kv__row">
                                <dt>объём за сессию</dt>
                                <dd class="num-sm">@(snapshot is null ? "—" : Count0(snapshot.Volume))</dd>
                            </div>
                        </dl>
                    </div>
                </Panel>
            </div>
        </div>
    </main>
</div>

@code {
    private const int MinNewsLength = 24;
    private const int MaxNewsLength = 2000;

    // Шкала силы влияния — из бизнес-логики (раздел 10.1), а не из текущих
    // значений: типичный ImpactScore около 1,30. Заглушки анализаторов дают
    // сегодня величины около 0,2, и маркер честно стоит в начале шкалы.
    private const decimal ImpactMin = 0.30m;
    private const decimal ImpactMax = 2.50m;
    private const decimal TypicalImpact = 1.30m;

    private const decimal SensitivityMin = 0.45m;
    private const decimal SensitivityMax = 0.95m;

    private static readonly ZoneScale.Zone[] ImpactZones =
    [
        new("слабая", 0.90m),
        new("умеренная", 1.60m),
        new("сильная", ImpactMax)
    ];

    private static readonly ZoneScale.Zone[] SensitivityZones =
    [
        new("низкая", 0.60m),
        new("средняя", 0.75m),
        new("высокая", SensitivityMax)
    ];

    private string newsText = string.Empty;
    private string? analyzedText;
    private DateTimeOffset? analyzedAt;
    private NewsSignal? signal;
    private string? errorMessage;
    private bool isAnalyzing;

    private SimulationTickResult? latestMarket;

    // Реакция новостного агента. Сигнал забирается ближайшим шагом симуляции
    // и больше не повторяется, поэтому решение и цену надо поймать на том
    // самом шаге — дальше агент снова отвечает «новостей не было».
    private bool awaitingReaction;
    private AgentDecision? agentDecision;
    private decimal? priceBefore;
    private decimal? priceAfter;

    private ActiveAssetView CurrentAsset => ActiveAssetContext.GetView();

    private int TrimmedLength => newsText.Trim().Length;
    private bool CanAnalyze => TrimmedLength >= MinNewsLength;
    private bool HasLengthError => TrimmedLength > 0 && TrimmedLength < MinNewsLength;
    private int AnalyzedLength => analyzedText?.Length ?? 0;

    private int MatchedCount =>
        signal is null ? 0 : signal.PositiveMatches + signal.NegativeMatches + signal.RiskMatches;

    private int ProfileItemCount =>
        CurrentAsset.Profile.PositiveFactors.Count +
        CurrentAsset.Profile.NegativeFactors.Count +
        CurrentAsset.Profile.Risks.Count;

    private string PolarityName => signal?.Polarity switch
    {
        SignalPolarity.Positive => "Позитивная",
        SignalPolarity.Negative => "Негативная",
        _ => "Нейтральная"
    };

    private string PolarityTone => signal?.Polarity switch
    {
        SignalPolarity.Positive => "up",
        SignalPolarity.Negative => "down",
        _ => "warn"
    };

    private string ImpactNote =>
        signal is null ? string.Empty
        : signal.ImpactScore < ImpactZones[0].To ? "слабая"
        : signal.ImpactScore < ImpactZones[1].To ? "умеренная"
        : "сильная";

    private string SensitivityName
    {
        get
        {
            var value = CurrentAsset.Profile.NewsSensitivity;
            return value < SensitivityZones[0].To ? "низкая"
                : value < SensitivityZones[1].To ? "средняя"
                : "высокая";
        }
    }

    private string RiskWord => CurrentAsset.Profile.Risks.Count switch
    {
        1 => "риск",
        >= 2 and <= 4 => "риска",
        _ => "рисков"
    };

    private AgentSnapshot? NewsAgent =>
        latestMarket?.Agents.FirstOrDefault(agent => agent.Type == AgentType.NewsDriven);

    private string NewsAgentName
    {
        get
        {
            var count = latestMarket?.Agents.Count(agent => agent.Type == AgentType.NewsDriven) ?? 0;
            // Раздел 10.1: если строка представляет несколько экземпляров типа,
            // это должно быть видно.
            return count > 1 ? $"Новостной ×{count}" : "Новостной";
        }
    }

    /// <summary>
    /// Что написать в строке агента: после разбора — его собственное объяснение
    /// решения (раздел 1.3, объяснимость), до разбора — чего он ждёт.
    /// </summary>
    private string AgentStateText
    {
        get
        {
            if (agentDecision is not null)
            {
                return agentDecision.Explanation;
            }

            if (signal is not null)
            {
                return "сигнал передан — решение будет на ближайшем шаге симуляции";
            }

            return NewsFeed.Entries.Count == 0
                ? "ждёт сигнала — новостей после старта сессии не было"
                : "ждёт следующую новость";
        }
    }

    private string MarketTitle => signal is null ? "Рынок на сейчас" : "Рынок на момент сигнала";

    private string SpreadLabel
    {
        get
        {
            var snapshot = latestMarket?.Snapshot;
            return snapshot?.BestBid is null || snapshot.BestAsk is null
                ? "—"
                : Money(snapshot.BestAsk.Value - snapshot.BestBid.Value);
        }
    }

    /// <summary>После округления до копеек цена не изменилась — раздел 10 запрещает «A → A».</summary>
    private bool PriceUnchanged =>
        priceBefore is not null && priceAfter is not null &&
        Round2(priceBefore.Value) == Round2(priceAfter.Value);

    private string PriceTone
    {
        get
        {
            if (priceBefore is null || priceAfter is null)
            {
                return "flat";
            }

            var delta = Round2(priceAfter.Value) - Round2(priceBefore.Value);
            return delta > 0m ? "up" : delta < 0m ? "down" : "flat";
        }
    }

    private string PriceDeltaLabel
    {
        get
        {
            if (priceBefore is null || priceAfter is null)
            {
                return "—";
            }

            var before = Round2(priceBefore.Value);
            var delta = Round2(priceAfter.Value) - before;
            var percent = before == 0m ? 0m : delta / before * 100m;
            var arrow = delta > 0m ? "↗" : "↘";

            return $"{arrow} {Sign(delta)}{Fixed2(Math.Abs(delta))} ₽ · {Sign(percent)}{Fixed2(Math.Abs(percent))} %";
        }
    }

    private string AgentActionName => agentDecision?.Action switch
    {
        TradeAction.Buy => "покупает по рынку",
        TradeAction.Sell => "продаёт по рынку",
        _ => "держит позицию"
    };

    /// <summary>Строка истории, разбор которой открыт на экране.</summary>
    private bool IsCurrentEntry(SessionNewsEntry entry) =>
        signal is not null && analyzedAt is not null && entry.At == analyzedAt.Value;

    /// <summary>
    /// Сработавшие факторы профиля. Список пуст, пока IAspectMatcher не начнёт
    /// возвращать формулировки и фрагменты совпадения: сегодня из анализатора
    /// приходят только количества, и придумывать строки здесь нельзя.
    /// </summary>
    private IReadOnlyList<MatchedFactor> MatchedFactors => [];

    protected override void OnInitialized()
    {
        latestMarket = SimulationRunner.Current;
        SimulationRunner.OnTick += HandleMarketTick;
        NewsFeed.Changed += HandleFeedChanged;
    }

    public void Dispose()
    {
        SimulationRunner.OnTick -= HandleMarketTick;
        NewsFeed.Changed -= HandleFeedChanged;
    }

    private void HandleFeedChanged() => _ = InvokeAsync(StateHasChanged);

    private void HandleMarketTick(SimulationTickResult tickResult)
    {
        _ = InvokeAsync(() =>
        {
            latestMarket = tickResult;

            // Новость забирается ближайшим шагом после отправки — значит, это
            // тот самый шаг, на котором агент её увидел.
            if (awaitingReaction)
            {
                awaitingReaction = false;
                agentDecision = tickResult.Decisions
                    .FirstOrDefault(decision => decision.AgentName.Contains("News", StringComparison.Ordinal));
                priceAfter = tickResult.Snapshot.LastPrice;
            }

            StateHasChanged();
        });
    }

    private async Task AnalyzeAsync()
    {
        if (!CanAnalyze || isAnalyzing)
        {
            return;
        }

        var text = newsText.Trim();

        isAnalyzing = true;
        errorMessage = null;
        agentDecision = null;
        priceBefore = null;
        priceAfter = null;
        awaitingReaction = false;

        try
        {
            await Task.Yield();

            var result = NewsProcessingService.Analyze(new NewsAnalysisRequest
            {
                NewsText = text,
                Profile = CurrentAsset.Profile
            });

            priceBefore = latestMarket?.Snapshot.LastPrice;

            SimulationRunner.SubmitNews(result);
            awaitingReaction = true;

            signal = result;
            analyzedText = text;
            analyzedAt = NewsFeed.Add(text, result).At;
        }
        catch (Exception ex)
        {
            signal = null;
            analyzedText = text;
            analyzedAt = DateTimeOffset.Now;
            errorMessage = $"Анализ не выполнен — {ex.Message}";
        }
        finally
        {
            isAnalyzing = false;
        }
    }

    private async Task RetryAsync()
    {
        newsText = analyzedText ?? string.Empty;
        errorMessage = null;
        await AnalyzeAsync();
    }

    private void StartNewEntry()
    {
        newsText = string.Empty;
        analyzedText = null;
        analyzedAt = null;
        signal = null;
        errorMessage = null;
        agentDecision = null;
        priceBefore = null;
        priceAfter = null;
        awaitingReaction = false;
    }

    private static decimal Round2(decimal value) => Math.Round(value, 2, MidpointRounding.AwayFromZero);

    /// <summary>Цена, спред, сила влияния, уверенность — два знака (раздел 10).</summary>
    private static string Fixed2(decimal value) => value.ToString("F2");

    private static string Money(decimal value) => $"{Fixed2(value)} ₽";

    /// <summary>Объём и деньги агента — ноль знаков.</summary>
    private static string Count0(decimal value) =>
        Math.Round(value, 0, MidpointRounding.AwayFromZero).ToString("N0");

    /// <summary>Позиция может быть отрицательной — знак обязателен (раздел 10).</summary>
    private static string Position0(decimal value) => Sign(value) + Count0(Math.Abs(value));

    private static string Sign(decimal value) => value > 0m ? "+" : value < 0m ? "−" : string.Empty;

    /// <param name="Kind">up · down · warn — бейдж сработавшего фактора окрашен (раздел 3).</param>
    private sealed record MatchedFactor(string Text, string Tone, string KindName, string Excerpt);
}
