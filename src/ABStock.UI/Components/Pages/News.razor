@page "/news"
@layout CreateAssetLayout
@rendermode InteractiveServer
@using System.Globalization
@using ABStock.AI.Models
@using ABStock.AI.Services
@using ABStock.Application.Simulation
@using ABStock.Shared
@using ABStock.UI.Services
@implements IDisposable
@inject INewsProcessingService NewsProcessingService
@inject ISimulationRunner SimulationRunner
@inject IActiveAssetContext ActiveAssetContext

<PageTitle>Новости</PageTitle>

<div class="news-shell">
    <TopNavigation ActivePage="News" ShowClock="true" />

    <main class="trading-main">
        <header class="page-heading">
            <div>
                <p class="breadcrumbs">
                    <a href="/create-asset">Создание актива</a>
                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                    <a href="/trading">Торги</a>
                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                    <span>Новости</span>
                </p>
                <h1>Новости и сигналы</h1>
                <p>Добавляйте события и оценивайте их влияние на @CurrentAsset.Draft.Name, цену и поведение агентов</p>
            </div>
        </header>

        <section class="trading-grid" aria-label="Рабочее место анализа новостей">
            <aside class="left-column">
                <section class="glass-card asset-card" aria-labelledby="asset-title">
                    <div class="asset-head">
                        <span class="asset-emblem" aria-hidden="true">
                            <i class="bi @AssetIconClass"></i>
                        </span>
                        <div>
                            <h2 id="asset-title">@CurrentAsset.Draft.Name</h2>
                            <div class="asset-meta">
                                <span>@CurrentAsset.Symbol</span>
                                <span>@GetAssetTypeLabel(CurrentAsset.Draft.AssetType)</span>
                                <span>@CurrentAsset.Draft.Industry</span>
                            </div>
                            <p class="asset-state"><i class="bi bi-check-circle-fill" aria-hidden="true"></i>@AssetStatusLabel</p>
                        </div>
                    </div>
                    <p class="asset-description">@CurrentAsset.Profile.Description</p>
                </section>

                <section class="glass-card parameter-card news-profile-card" aria-labelledby="profile-title">
                    <div class="panel-title">
                        <h2 id="profile-title">Профиль новости</h2>
                        <span>@NewsSensitivityScore/100</span>
                    </div>
                    <div class="sensitivity-gauge" aria-label="@($"{NewsSensitivityLabel} чувствительность к новостям")">
                        <span style="width: @($"{NewsSensitivityScore}%")"></span>
                    </div>
                    <dl class="compact-list">
                        @foreach (var item in SensitivityRows)
                        {
                            <div>
                                <dt>@item.Label</dt>
                                <dd class="@item.ValueClass">@item.Value</dd>
                            </div>
                        }
                    </dl>
                </section>

                <section class="glass-card trades-card history-card" aria-labelledby="history-title">
                    <div class="panel-title">
                        <h2 id="history-title">История</h2>
                        <span>@NewsHistory.Count</span>
                    </div>
                    <div class="history-list">
                        @foreach (var item in NewsHistory)
                        {
                            <article class="@item.PolarityClass">
                                <time>@item.Time</time>
                                <strong>@item.Title</strong>
                                <small>@item.Detail</small>
                            </article>
                        }
                    </div>
                </section>
            </aside>

            <section class="center-column">
                <div class="metrics-strip" aria-label="Ключевые показатели новости">
                    @foreach (var metric in NewsMetrics)
                    {
                        <article class="glass-card metric-card @metric.Accent">
                            <span>@metric.Label</span>
                            <strong>@metric.Value</strong>
                            <small>@metric.Detail</small>
                        </article>
                    }
                </div>

                <section class="glass-card chart-card input-card" aria-labelledby="input-title">
                    <div class="panel-title">
                        <div>
                            <h2 id="input-title">Ввод новости</h2>
                            <p>Свободный текст без внешних источников: прототип анализирует только введённое событие.</p>
                        </div>
                        <span><i class="bi bi-person-fill" aria-hidden="true"></i> Пользователь</span>
                    </div>

                    <label class="news-field" for="news-text">
                        <span>Текст новости</span>
                        <textarea id="news-text"
                                  @bind="newsText"
                                  @bind:event="oninput"
                                  maxlength="@MaxNewsLength"
                                  placeholder="Например: КвантЭнерго подписала соглашение о поставке систем накопления энергии для федеральной программы модернизации инфраструктуры."></textarea>
                    </label>

                    <div class="input-meta">
                        <p class="@(CanAnalyze ? "ready" : null)">
                            <i class="bi @(CanAnalyze ? "bi-check-circle" : "bi-info-circle")" aria-hidden="true"></i>
                            @(CanAnalyze ? "Текст готов к AI-анализу" : $"Минимум {MinNewsLength} символов для анализа")
                        </p>
                        <span>@newsText.Length / @MaxNewsLength</span>
                    </div>

                    <div class="action-row">
                        <button class="primary-action" type="button" disabled="@(!CanAnalyze || isAnalyzing)" @onclick="AnalyzeNewsAsync">
                            <i class="bi bi-stars" aria-hidden="true"></i>
                            @(isAnalyzing ? "Анализ..." : "Анализировать")
                        </button>
                        <button class="secondary-action" type="button" disabled="@(isAnalyzing || newsText.Length == 0)" @onclick="ClearNews">
                            <i class="bi bi-trash3" aria-hidden="true"></i>
                            Очистить
                        </button>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <div class="error-state" role="alert">
                            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                            <span>@errorMessage</span>
                        </div>
                    }
                </section>

                <section class="glass-card result-card @ResultStateClass" aria-labelledby="result-title">
                    <div class="panel-title">
                        <h2 id="result-title">Результат анализа</h2>
                        <span>@(analysisSignal is null ? "Ожидает ввод" : "AI-сигнал готов")</span>
                    </div>

                    @if (analysisSignal is null)
                    {
                        <div class="empty-result">
                            <span aria-hidden="true"><i class="bi bi-newspaper"></i></span>
                            <strong>Новость ещё не анализировалась</strong>
                            <p>После запуска здесь появятся тональность, уверенность, сила влияния и объяснение модели.</p>
                        </div>
                    }
                    else
                    {
                        <div class="kpi-grid">
                            <article>
                                <span>Тональность</span>
                                <strong>@PolarityLabel</strong>
                                <i class="bi @PolarityIcon" aria-hidden="true"></i>
                            </article>
                            <article>
                                <span>Уверенность</span>
                                <strong>@FormatPercent(analysisSignal.Confidence)</strong>
                                <div class="mini-meter" aria-hidden="true">
                                    <span style="width: @FormatBarWidth(analysisSignal.Confidence)"></span>
                                </div>
                            </article>
                            <article>
                                <span>Сила влияния</span>
                                <strong>@analysisSignal.ImpactScore.ToString("0.00", CultureInfo.InvariantCulture)</strong>
                                <small>@ImpactLabel</small>
                            </article>
                        </div>

                        <div class="explanation-panel">
                            <span>Объяснение</span>
                            <p>@analysisSignal.Explanation</p>
                        </div>

                        <div class="factor-row" aria-label="Ключевые факторы влияния">
                            @foreach (var factor in FactorChips)
                            {
                                <span class="@factor.ClassName">@factor.Label</span>
                            }
                        </div>
                    }
                </section>
            </section>

            <aside class="right-column">
                <section class="glass-card order-book market-card" aria-labelledby="market-title">
                    <div class="panel-title">
                        <h2 id="market-title">Контекст рынка</h2>
                        <span>@MarketContextLabel</span>
                    </div>
                    <div class="price-tile">
                        <span>Текущая цена</span>
                        <strong>@CurrentPriceLabel</strong>
                        <small>@CurrentPriceChangeLabel</small>
                    </div>
                    <dl class="compact-list">
                        @foreach (var item in MarketRows)
                        {
                            <div>
                                <dt>@item.Label</dt>
                                <dd class="@item.ValueClass">@item.Value</dd>
                            </div>
                        }
                    </dl>
                </section>

                <section class="glass-card trades-card trade-signal-card @ResultStateClass" aria-labelledby="signal-title">
                    <div class="panel-title">
                        <h2 id="signal-title">Торговый сигнал</h2>
                        <span>@(signalSubmitted ? "Передан" : "Черновик")</span>
                    </div>

                    @if (analysisSignal is null)
                    {
                        <div class="signal-empty">
                            <i class="bi bi-broadcast-pin" aria-hidden="true"></i>
                            <strong>Сигнал появится после анализа</strong>
                            <p>NewsDrivenAgent получит его на следующем цикле симуляции.</p>
                        </div>
                    }
                    else
                    {
                        <div class="signal-verdict">
                            <span>Рекомендуемое действие</span>
                            <strong>@RecommendedAction</strong>
                            <small>@ExpectedEffect</small>
                        </div>
                        <div class="delivery-note">
                            <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                            <div>
                                <strong>@SignalDeliveryTitle</strong>
                                <span>@LiveAgentStatus</span>
                            </div>
                        </div>
                        <div class="impact-scale" aria-label="Сила влияния">
                            <span>Низкая</span>
                            <div><i style="left: @ImpactPosition"></i></div>
                            <span>Высокая</span>
                        </div>
                    }
                </section>

                <section class="glass-card parameter-card agent-note-card" aria-labelledby="agent-note-title">
                    <div class="panel-title">
                        <h2 id="agent-note-title">NewsDrivenAgent</h2>
                        <span>Live</span>
                    </div>
                    <ul>
                        <li><i class="bi bi-check-circle" aria-hidden="true"></i>Получает `NewsSignal` из UI</li>
                        <li><i class="bi bi-check-circle" aria-hidden="true"></i>Сигнал хранится до следующего тика</li>
                        <li><i class="bi bi-check-circle" aria-hidden="true"></i>На позитиве покупает по рынку, на негативе продаёт при наличии ликвидности и позиции</li>
                    </ul>
                </section>
            </aside>

            <section class="glass-card flow-card" aria-labelledby="flow-title">
                <div class="panel-title">
                    <h2 id="flow-title">Как новость превращается в торговый сигнал</h2>
                    <span>Pipeline</span>
                </div>
                <div class="flow-steps">
                    @foreach (var step in FlowSteps)
                    {
                        <article>
                            <span><i class="bi @step.Icon" aria-hidden="true"></i></span>
                            <strong>@step.Title</strong>
                            <small>@step.Detail</small>
                        </article>
                    }
                </div>
            </section>
        </section>
    </main>
</div>

@code {
    private const int MinNewsLength = 24;
    private const int MaxNewsLength = 2000;

    private string newsText = string.Empty;
    private NewsSignal? analysisSignal;
    private string? errorMessage;
    private bool isAnalyzing;
    private bool signalSubmitted;
    private SimulationTickResult? latestMarket;
    private ActiveAssetView CurrentAsset => ActiveAssetContext.GetView();
    private SimulationTickResult? CurrentMarket => latestMarket;
    private string AssetIconClass => GetAssetIconClass(CurrentAsset.Draft.AssetType);
    private string AssetStatusLabel => CurrentAsset.IsFallback ? "Демо-контекст" : "Актив синхронизирован";
    private int NewsSensitivityScore => (int)Math.Round(CurrentAsset.Profile.NewsSensitivity * 100m, MidpointRounding.AwayFromZero);
    private string NewsSensitivityLabel => NewsSensitivityScore >= 80 ? "Высокая" : NewsSensitivityScore >= 60 ? "Средняя" : "Низкая";
    private string MarketContextLabel => CurrentMarket is null ? "Нет live-торгов" : "Live market";
    private string CurrentPriceLabel => CurrentMarket is null ? "—" : FormatMoney(CurrentMarket.Snapshot.LastPrice);
    private string CurrentPriceChangeLabel => BuildCurrentPriceChangeLabel();
    private IReadOnlyList<DataRow> SensitivityRows => BuildSensitivityRows();
    private IReadOnlyList<DataRow> MarketRows => BuildMarketRows();
    private IReadOnlyList<FactorChip> FactorChips => BuildFactorChips();
    private string LiveAgentStatus => BuildLiveAgentStatus();

    private bool CanAnalyze => newsText.Trim().Length >= MinNewsLength;
    private string ResultStateClass => analysisSignal is null ? string.Empty : PolarityClass;

    private NewsMetric[] NewsMetrics => analysisSignal is null
        ? FallbackNewsMetrics
        : BuildNewsMetrics(analysisSignal);

    private string PolarityClass => analysisSignal?.Polarity switch
    {
        SignalPolarity.Positive => "positive-signal",
        SignalPolarity.Negative => "negative-signal",
        _ => "neutral-signal"
    };

    private string PolarityLabel => analysisSignal?.Polarity switch
    {
        SignalPolarity.Positive => "Позитивная",
        SignalPolarity.Negative => "Негативная",
        _ => "Нейтральная"
    };

    private string PolarityIcon => analysisSignal?.Polarity switch
    {
        SignalPolarity.Positive => "bi-emoji-smile",
        SignalPolarity.Negative => "bi-emoji-frown",
        _ => "bi-dash-circle"
    };

    private string ImpactLabel => analysisSignal?.ImpactScore switch
    {
        null => "Нет данных",
        >= 0.65m => "Высокая",
        >= 0.35m => "Средняя",
        _ => "Низкая"
    };

    private string RecommendedAction => analysisSignal?.Polarity switch
    {
        SignalPolarity.Positive => "Market buy",
        SignalPolarity.Negative => "Market sell",
        _ => "Hold / нейтрально"
    };

    private string ExpectedEffect => analysisSignal?.Polarity switch
    {
        SignalPolarity.Positive => "При наличии ask и свободного кэша агент купит по рынку на следующем тике.",
        SignalPolarity.Negative => "При наличии bid и позиции агент продаст по рынку на следующем тике.",
        _ => "Нейтральная новость не должна смещать поведение NewsDrivenAgent."
    };

    private string ImpactPosition
    {
        get
        {
            var impact = analysisSignal?.ImpactScore ?? 0m;
            return $"{Math.Clamp((double)(impact * 100m), 4d, 96d).ToString("0", CultureInfo.InvariantCulture)}%";
        }
    }

    private IReadOnlyList<NewsHistoryItem> NewsHistory { get; set; } = [];

    private static readonly FlowStep[] FlowSteps =
    [
        new("Текст", "Новость пользователя", "bi-chat-left-text"),
        new("NLP", "Извлечение факторов", "bi-cpu"),
        new("Тональность", "Positive / Neutral / Negative", "bi-emoji-smile"),
        new("Impact", "Сила влияния", "bi-activity"),
        new("NewsDrivenAgent", "Получает сигнал", "bi-robot"),
        new("Рынок", "Заявки и цена", "bi-graph-up-arrow")
    ];

    private static readonly NewsMetric[] FallbackNewsMetrics =
    [
        new("Тональность", "Ожидает", "Введите новость", "neutral"),
        new("Уверенность", "—", "AI-анализ не запущен", "neutral"),
        new("Impact", "—", "Сила влияния неизвестна", "neutral"),
        new("Статус агента", "Готов", "NewsDrivenAgent ожидает live-сигнал", "volume")
    ];

    protected override void OnInitialized()
    {
        newsText = $"{CurrentAsset.Draft.Name} подписала соглашение о поставке решений для сектора «{CurrentAsset.Draft.Industry}», что может усилить спрос и ожидания по будущим контрактам.";
        latestMarket = SimulationRunner.Current;
        SimulationRunner.OnTick += HandleMarketTick;
    }

    private void HandleMarketTick(SimulationTickResult tickResult)
    {
        _ = InvokeAsync(() =>
        {
            latestMarket = tickResult;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        SimulationRunner.OnTick -= HandleMarketTick;
    }

    private string SignalDeliveryTitle => !signalSubmitted
        ? "Сигнал не отправлен"
        : SimulationRunner.IsRunning
            ? "Сигнал передан в симуляцию"
            : "Сигнал поставлен в очередь";

    private async Task AnalyzeNewsAsync()
    {
        if (!CanAnalyze)
        {
            return;
        }

        isAnalyzing = true;
        errorMessage = null;
        signalSubmitted = false;

        try
        {
            await Task.Yield();

            var signal = NewsProcessingService.Analyze(new NewsAnalysisRequest
            {
                NewsText = newsText.Trim(),
                Profile = CurrentAsset.Profile
            });

            analysisSignal = signal;
            SimulationRunner.SubmitNews(signal);
            signalSubmitted = true;
            AddHistoryItem(signal);
        }
        catch (Exception ex)
        {
            errorMessage = $"Не удалось выполнить анализ новости: {ex.Message}";
        }
        finally
        {
            isAnalyzing = false;
        }
    }

    private void ClearNews()
    {
        newsText = string.Empty;
        errorMessage = null;
    }

    private void AddHistoryItem(NewsSignal signal)
    {
        var title = newsText.Trim();
        if (title.Length > 44)
        {
            title = $"{title[..44]}...";
        }

        var item = new NewsHistoryItem(
            DateTime.Now.ToString("HH:mm", CultureInfo.InvariantCulture),
            title,
            $"{PolarityLabel}, impact {signal.ImpactScore:0.00}, {RecommendedAction}",
            PolarityClass.Replace("-signal", string.Empty));

        NewsHistory = NewsHistory.Prepend(item).Take(5).ToArray();
    }

    private static string FormatPercent(decimal value) =>
        $"{Math.Round(value * 100m, 0).ToString("0", CultureInfo.InvariantCulture)}%";

    private static string FormatBarWidth(decimal value) =>
        $"{Math.Clamp((double)(value * 100m), 0d, 100d).ToString("0", CultureInfo.InvariantCulture)}%";

    private NewsMetric[] BuildNewsMetrics(NewsSignal signal) =>
    [
        new(
            "Тональность",
            PolarityLabel,
            RecommendedAction,
            signal.Polarity == SignalPolarity.Negative
                ? "negative"
                : signal.Polarity == SignalPolarity.Positive
                    ? "positive"
                    : "neutral"),
        new("Уверенность", FormatPercent(signal.Confidence), "AI-сигнал готов", "positive"),
        new("Impact", signal.ImpactScore.ToString("0.00", CultureInfo.InvariantCulture), ImpactLabel, signal.Polarity == SignalPolarity.Negative ? "negative" : "positive"),
        new("Статус агента", signalSubmitted ? "Передан" : "Черновик", LiveAgentStatus, "volume")
    ];

    private string BuildLiveAgentStatus()
    {
        if (analysisSignal is null)
        {
            return SimulationRunner.IsRunning
                ? "NewsDrivenAgent ждёт следующий сигнал"
                : "Сигнал будет поставлен в очередь после запуска торгов";
        }

        if (!signalSubmitted)
        {
            return "AI-сигнал готов к отправке в симуляцию";
        }

        return SimulationRunner.IsRunning
            ? "NewsDrivenAgent обработает сигнал на следующем тике через market buy/sell"
            : "Сигнал сохранён и будет обработан после старта симуляции";
    }

    private string BuildCurrentPriceChangeLabel()
    {
        var snapshot = CurrentMarket?.Snapshot;
        if (snapshot is null)
        {
            return "Торги ещё не запущены";
        }

        var prices = snapshot.RecentPrices;
        if (prices.Count < 2)
        {
            return "Ждём больше тиков";
        }

        var first = prices[0];
        var last = snapshot.LastPrice;
        var change = last - first;
        var percent = first == 0m ? 0m : change / first * 100m;
        return $"{(change >= 0m ? "+" : string.Empty)}{change:0.00} ₽ ({(percent >= 0m ? "+" : string.Empty)}{percent:0.00}%)";
    }

    private IReadOnlyList<DataRow> BuildSensitivityRows()
    {
        var rows = new List<DataRow>
        {
            new("Чувствительность профиля", NewsSensitivityLabel, NewsSensitivityScore >= 80 ? "positive" : null),
            new("Сектор", CurrentAsset.Draft.Industry, null),
            new("Господдержка", CurrentAsset.Draft.IncludeGovernmentSupport ? "Учитывается" : "Не учитывается", CurrentAsset.Draft.IncludeGovernmentSupport ? "positive" : null),
            new("Ключевой риск", CurrentAsset.Profile.Risks.FirstOrDefault() ?? "Не определён", "warning")
        };

        return rows;
    }

    private IReadOnlyList<DataRow> BuildMarketRows()
    {
        var snapshot = CurrentMarket?.Snapshot;
        if (snapshot is null)
        {
            return
            [
                new("Состояние", "Торги не запущены", "warning"),
                new("Актив", CurrentAsset.Symbol, null),
                new("Цена", "—", null),
                new("Статус агента", "Ожидание", null)
            ];
        }

        return
        [
            new("Лучший bid", snapshot.BestBid is null ? "—" : FormatMoney(snapshot.BestBid.Value), "positive"),
            new("Лучший ask", snapshot.BestAsk is null ? "—" : FormatMoney(snapshot.BestAsk.Value), "negative"),
            new("Объём", $"{snapshot.Volume:0.##} шт.", null),
            new("Последний тик", $"#{CurrentMarket?.Tick ?? 0}", null)
        ];
    }

    private IReadOnlyList<FactorChip> BuildFactorChips()
    {
        var chips = new List<FactorChip>();

        chips.AddRange(CurrentAsset.Profile.Keywords.Take(4).Select(keyword => new FactorChip(keyword, "blue")));

        if (analysisSignal is not null)
        {
            chips.Add(new FactorChip(PolarityLabel, analysisSignal.Polarity == SignalPolarity.Negative ? "orange" : "green"));
            chips.Add(new FactorChip(ImpactLabel, "purple"));
        }

        return chips
            .DistinctBy(chip => chip.Label)
            .Take(6)
            .ToArray();
    }

    private static string GetAssetTypeLabel(AssetType assetType) =>
        assetType switch
        {
            AssetType.Stock => "Акция",
            AssetType.Bond => "Облигация",
            AssetType.Commodity => "Товар",
            AssetType.Crypto => "Криптоактив",
            _ => assetType.ToString()
        };

    private static string GetAssetIconClass(AssetType assetType) =>
        assetType switch
        {
            AssetType.Stock => "bi-graph-up-arrow",
            AssetType.Bond => "bi-receipt",
            AssetType.Commodity => "bi-box-seam",
            AssetType.Crypto => "bi-currency-bitcoin",
            _ => "bi-lightning-charge-fill"
        };

    private static string FormatMoney(decimal value) => $"{value:0.00} ₽";

    private sealed record NewsMetric(string Label, string Value, string Detail, string Accent);
    private sealed record DataRow(string Label, string Value, string? ValueClass);
    private sealed record FactorChip(string Label, string ClassName);
    private sealed record FlowStep(string Title, string Detail, string Icon);
    private sealed record NewsHistoryItem(string Time, string Title, string Detail, string PolarityClass);
}
