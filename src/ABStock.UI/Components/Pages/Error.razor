@page "/Error"
@using System.Diagnostics

@* Страница ошибки. Оболочка та же, что у «не найдена» (раздел 13), и одно
   пустое состояние по 9.15.

   Режим отрисовки статический, @rendermode не задан намеренно: HttpContext
   приходит каскадным параметром, а интерактивному контуру его не передают —
   идентификатор запроса тогда взять неоткуда.

   Активного раздела в шапке нет: страница не принадлежит ни одному из пяти. *@

<PageTitle>Ошибка</PageTitle>

<div class="app-bg" aria-hidden="true"><div class="app-bg__noise"></div></div>

<div class="util-shell">
    <TopNavigation ActivePage="None" />

    <main class="util-page">
        <Panel>
            <ChildContent>
                <EmptyState IconName="alert"
                            Title="Не удалось обработать запрос"
                            Description="Подробности — в логах приложения.">
                    <Action>
                        <AppButton Variant="primary" Href="/">На главную</AppButton>
                    </Action>
                </EmptyState>

                @if (ShowRequestId)
                {
                    @* Идентификатор нужен, чтобы найти запрос в логах, — это
                       единственное, чем страница полезна. *@
                    <p class="error__id">ID запроса <span class="num-sm">@RequestId</span></p>
                }
            </ChildContent>
        </Panel>
    </main>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
