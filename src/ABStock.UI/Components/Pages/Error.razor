@page "/Error"
@layout CreateAssetLayout
@using System.Diagnostics

<PageTitle>Ошибка</PageTitle>

<div class="status-page">
    <section class="status-card">
        <span class="status-emblem" aria-hidden="true">
            <i class="bi bi-exclamation-triangle"></i>
        </span>
        <h1>Не удалось обработать запрос</h1>
        <p class="status-text">Произошла непредвиденная ошибка. Попробуйте повторить действие — подробности доступны в логах приложения.</p>

        @if (ShowRequestId)
        {
            <p class="status-meta">ID запроса: <code>@RequestId</code></p>
        }

        <a class="status-button" href="/create-asset">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            На главную
        </a>
    </section>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
