@page "/agents"
@rendermode InteractiveServer
@using System.Globalization
@using ABStock.Shared
@using ABStock.UI.Services
@using static ABStock.UI.Services.NumberFormat
@implements IDisposable
@implements IAsyncDisposable
@inject ISessionMarkets Markets
@inject ISessionEvents Events
@inject IAssetRegistry Registry
@inject IAgentEquityHistory EquityHistory
@inject IJSRuntime JS

<PageTitle>Агенты</PageTitle>

@{
    var isRunning = Markets.IsRunning;
    var board = Board;
    var hasAgents = board.AgentCount > 0;
    var symbols = board.Changes.Select(change => change.Symbol).ToArray();
}

<div class="app-bg" aria-hidden="true"><div class="app-bg__noise"></div></div>

<div class="agents-shell">
    <TopNavigation ActivePage="Agents" ShowClock="true" />

    <main class="agents-page">
        @* Агенты общие на все активы — актива в пути нет (раздел 13). *@
        <Breadcrumbs Items="@(new Crumb[] { new("Активы", Href: "/assets"), new("Агенты") })">
            <Aside>
                <SessionChip Running="isRunning" Elapsed="@SessionClock.Format(Markets)" />
            </Aside>
        </Breadcrumbs>

        <PageHead Title="Агенты">
            <Context>
                @if (hasAgents)
                {
                    <text>@StrategiesLine(board) · торгуют <span class="num-sm">@symbols.Length</span> @Plural(symbols.Length, "активом", "активами", "активами"), у каждого один кошелёк</text>
                }
                else
                {
                    <text>Торги не запускались · состав агентов задаётся на «Активах»</text>
                }
            </Context>
        </PageHead>

        @if (!hasAgents)
        {
            <Panel Class="rise rise-1">
                <EmptyState IconName="users"
                            Title="Агентов ещё нет"
                            Description="Состав агентов и их капитал задаются на «Активах» перед запуском торгов.">
                    <Action>
                        <AppButton Variant="primary" Href="/assets">Перейти к активам</AppButton>
                    </Action>
                </EmptyState>
            </Panel>
        }
        else
        {
            @* ── Строка показателей: главное число — P/L сессии (раздел 9.1) ── *@
            <section class="metrics rise rise-1" aria-label="Показатели сессии">
                <div class="metrics__hero">
                    <span class="num-hero @DeltaTone(board.Pnl)">@(board.Pnl > 0m ? "↗" : board.Pnl < 0m ? "↘" : "·") @Pnl2(board.Pnl)</span>
                    <span class="metrics__hero-label">P/L сессии, ₽</span>
                </div>
                <span class="metrics__sep" aria-hidden="true"></span>
                <span class="metrics__item" title="@($"Деньги {Money0(board.Cash)} ₽ и бумаги по текущим ценам; на старте — деньги и стартовые бумаги по стартовым ценам")">
                    стоимость портфелей <span class="num-md">@Money0(board.Portfolio)</span> <span class="metrics__unit">₽</span>
                </span>
                <span class="metrics__sep" aria-hidden="true"></span>
                <span class="metrics__item">на старте <span class="num-md">@Money0(board.InitialPortfolio)</span> <span class="metrics__unit">₽</span></span>
                <span class="metrics__sep" aria-hidden="true"></span>
                <span class="metrics__item">в бумагах <span class="num-md">@board.InSecurities.ToString("0.0") %</span></span>
                <span class="metrics__sep" aria-hidden="true"></span>
                <span class="metrics__item">сделок <span class="num-md">@Count0(Markets.Markets.Sum(market => market.TradeCount))</span></span>
            </section>

            <div class="agents-pair">
                @* Время: как менялась стоимость портфеля каждой стратегии (раздел 7.2). *@
                <Panel Title="Стоимость портфеля по стратегиям" Class="equity rise rise-2">
                    <MetaContent>% от старта стратегии</MetaContent>
                    <ChildContent>
                        <div class="equity__body">
                            @if (HasEquityPoints)
                            {
                                <div class="equity__stage" @ref="equityChart" role="img"
                                     aria-label="Стоимость портфеля по стратегиям с начала сессии"></div>
                            }
                            else
                            {
                                <div class="equity__stage equity__stage--empty" aria-busy="true">
                                    <Skeleton Width="100%" Height="100%" />
                                </div>
                            }

                            @* Подписи у концов линий — в своей колонке, поэтому не
                               вылезают за панель (ревью Г-5). Высоту каждой ставит
                               модуль графика по координате последней точки. *@
                            <div class="equity__labels" @ref="equityLabels">
                                @foreach (var item in Legend)
                                {
                                    <span class="equity__label @(hoveredType == item.Type ? "is-active" : null)" data-type="@TypeKey(item.Type)"
                                          @onmouseenter="() => SetHovered(item.Type)"
                                          @onmouseleave="() => SetHovered(null)">
                                        <StatusDot Tone="@AgentDisplay.GetTypeTone(item.Type)" />
                                        <span class="equity__name">@AgentDisplay.GetTypeLabel(item.Type)</span>
                                        <span class="num-sm @DeltaTone(item.Percent - 100m)">@Sign(item.Percent - 100m)@Percent2(Math.Abs(item.Percent - 100m)) %</span>
                                    </span>
                                }
                            </div>
                        </div>
                    </ChildContent>
                </Panel>

                @* Доля: кто какими бумагами владеет. Новое измерение — его нет в таблице (раздел 7.2). *@
                <Panel Title="Кто чем владеет" Class="rise rise-2">
                    <MetaContent>доля актива в бумагах стратегии</MetaContent>
                    <ChildContent>
                        <div class="matrix" style="--matrix-cols:@symbols.Length">
                            <span></span>
                            @foreach (var symbol in symbols)
                            {
                                <span class="matrix__col"><Ticker Symbol="@symbol" /></span>
                            }
                            <span class="matrix__col matrix__col--held">в бумагах</span>

                            @foreach (var row in board.Holdings)
                            {
                                <span class="matrix__name"><StatusDot Tone="@AgentDisplay.GetTypeTone(row.Type)" />@AgentDisplay.GetTypeLabel(row.Type)</span>
                                @foreach (var cell in row.Cells)
                                {
                                    <span class="matrix__cell @(cell.Share >= StrongShare ? "is-strong" : null)" style="--fill:@Mix(cell.Share)">
                                        <span class="num-sm">@cell.Share.ToString("0") %</span>
                                        <span class="matrix__qty">@Count0(cell.Quantity) шт</span>
                                    </span>
                                }
                                <span class="matrix__held">
                                    <span class="num-sm">@row.InSecurities.ToString("0.0") %</span>
                                    <span class="matrix__qty">портфеля</span>
                                </span>
                            }
                        </div>
                    </ChildContent>
                </Panel>
            </div>

            @* ── Таблица: стратегия, под ней экземпляры. Объяснение — у стратегии,
                 у экземпляров только их числа (раздел 9.8). ── *@
            <Panel Class="roster rise rise-3" Flush="true">
                <Head>
                    <h2 class="roster__heading">Агенты в сессии</h2>
                    <span class="ui-panel__meta">позиции — изменение за сессию, в сумме по каждому активу 0</span>
                </Head>
                <ChildContent>
                    <div class="roster__scroll" role="table" aria-label="Агенты в сессии">
                        <div class="grp__row grp__row--head" role="row">
                            <span class="label" role="columnheader">Стратегия · экземпляр</span>
                            <span class="label right" role="columnheader">Деньги, ₽</span>
                            <span class="label right" role="columnheader">Портфель, ₽</span>
                            <span class="label right" role="columnheader">P/L, ₽</span>
                            <span class="label" role="columnheader">Позиции за сессию, шт</span>
                            <span class="label" role="columnheader">Последнее действие и объяснение</span>
                        </div>
                        @foreach (var group in board.Groups)
                        {
                            var single = group.Instances.Count == 1;

                            <div class="grp__row grp__row--group @(hoveredType == group.Type ? "is-typed" : null)" role="row">
                                <span class="grp__name" role="cell">
                                    <StatusDot Tone="@AgentDisplay.GetTypeTone(group.Type)" />
                                    @if (single)
                                    {
                                        @* Группа из одного экземпляра строки группы не получает (9.8). *@
                                        <a class="grp__link" href="/agents/@Uri.EscapeDataString(group.Instances[0].AgentName)">@group.Instances[0].Title</a>
                                    }
                                    else
                                    {
                                        @AgentDisplay.GetTypeLabel(group.Type)<span class="num-xs t3">×@group.Instances.Count</span>
                                    }
                                </span>
                                <span class="num-sm t1 right" role="cell">@Money0(group.Cash)</span>
                                <span class="num-sm t1 right" role="cell">@Money0(group.Portfolio)</span>
                                <span class="num-sm right @DeltaTone(group.Pnl)" role="cell">@Pnl2(group.Pnl)</span>
                                <span class="num-xs t2" role="cell">@ChangesLine(group.Changes)</span>
                                <span class="grp__why" role="cell">
                                    @if (group.Action is null)
                                    {
                                        <span class="nodata">—</span>
                                    }
                                    else
                                    {
                                        <span class="grp__act">@group.Action</span>
                                        @if (group.Explanation is not null)
                                        {
                                            <span class="grp__reason" title="@group.Explanation">@group.Explanation</span>
                                        }
                                    }
                                </span>
                            </div>

                            @if (!single)
                            {
                                @foreach (var item in group.Instances)
                                {
                                    <a class="grp__row grp__row--instance" role="row" href="/agents/@Uri.EscapeDataString(item.AgentName)">
                                        <span class="grp__inst" role="cell">@item.Title</span>
                                        <span class="num-sm t2 right" role="cell">@Money0(item.Cash)</span>
                                        <span class="num-sm t2 right" role="cell">@Money0(item.Portfolio)</span>
                                        <span class="num-sm right @DeltaTone(item.Pnl)" role="cell">@Pnl2(item.Pnl)</span>
                                        <span class="num-xs t3" role="cell">@ChangesLine(item.Changes)</span>
                                        <span class="grp__go" role="cell" aria-hidden="true"><Icon Name="chevron-right" Size="14" /></span>
                                    </a>
                                }
                            }
                        }
                        <div class="grp__row grp__row--foot" role="row">
                            <span role="cell">Итого · <span class="num-xs">@board.AgentCount</span> @Plural(board.AgentCount, "агент", "агента", "агентов")</span>
                            <span class="num-sm t1 right" role="cell">@Money0(board.Cash)</span>
                            <span class="num-sm t1 right" role="cell">@Money0(board.Portfolio)</span>
                            <span class="num-sm right @DeltaTone(board.Pnl)" role="cell">@Pnl2(board.Pnl)</span>
                            <span class="num-xs t2" role="cell">@ChangesLine(board.Changes)</span>
                            <span class="caption" role="cell">@(board.Changes.All(change => change.Change == 0m) ? "бумаги переходят от агента к агенту — рынок замкнут" : null)</span>
                        </div>
                    </div>
                </ChildContent>
            </Panel>
        }
    </main>
</div>

@code {
    /// <summary>С этой доли текст ячейки матрицы светлеет: заливка уже плотная.</summary>
    private const decimal StrongShare = 45m;

    private AgentType? hoveredType;
    private ElementReference equityChart;
    private ElementReference equityLabels;
    private IJSObjectReference? chartModule;
    private bool chartRendered;

    private AgentBoardView Board
    {
        get
        {
            var markets = Markets.Markets
                .Select(market => (Market: market, Asset: Registry.Find(market.AssetId)))
                .Where(item => item.Asset is not null)
                .Select(item => new BoardMarket(item.Market.AssetId, item.Asset!.Symbol, item.Market.LastPrice, item.Market.Last.Decisions))
                .ToArray();

            return AgentBoard.Build(Markets.Accounts, markets);
        }
    }

    private static string StrategiesLine(AgentBoardView board)
    {
        var strategies = board.Groups.Count;
        var counts = board.Groups.Select(group => group.Instances.Count).Distinct().ToArray();

        // «4 стратегии × 2 экземпляра», если экземпляров поровну, иначе общее число.
        return counts.Length == 1
            ? $"{strategies} {Plural(strategies, "стратегия", "стратегии", "стратегий")} × {counts[0]} {Plural(counts[0], "экземпляр", "экземпляра", "экземпляров")}"
            : $"{strategies} {Plural(strategies, "стратегия", "стратегии", "стратегий")} · {board.AgentCount} {Plural(board.AgentCount, "агент", "агента", "агентов")}";
    }

    private static string ChangesLine(IReadOnlyList<PositionChange> changes) =>
        string.Join(" · ", changes.Select(change => $"{change.Symbol} {Position0(change.Change)}"));

    /// <summary>Плотность ячейки — доля, смешанная с --text-1. Только InvariantCulture: значение уезжает в CSS.</summary>
    private static string Mix(decimal share) =>
        Math.Clamp(share * 0.6m, 4m, 60m).ToString("0.#", CultureInfo.InvariantCulture) + "%";

    private IReadOnlyDictionary<AgentType, IReadOnlyList<ChartPoint>> EquitySeries => EquityHistory.Series;

    private bool HasEquityPoints => EquitySeries.Any(pair => pair.Value.Count > 0);

    private LegendItem[] Legend =>
        Markets.Accounts
            .GroupBy(account => account.AgentType)
            .OrderBy(group => group.Key)
            .Select(group =>
            {
                var series = EquitySeries.GetValueOrDefault(group.Key);
                return new LegendItem(group.Key, series is { Count: > 0 } ? series[^1].Value : 100m);
            })
            .ToArray();

    protected override void OnInitialized()
    {
        Markets.Changed += HandleChanged;
        Events.Changed += HandleChanged;
        EquityHistory.Changed += HandleChanged;
    }

    private void HandleChanged() => _ = InvokeAsync(StateHasChanged);

    private void SetHovered(AgentType? type)
    {
        if (hoveredType == type)
        {
            return;
        }

        hoveredType = type;
        _ = PushHighlightAsync();
    }

    private async Task PushHighlightAsync()
    {
        if (chartModule is null || !chartRendered)
        {
            return;
        }

        try
        {
            await chartModule.InvokeVoidAsync("setHighlight", equityChart, TypeKey(hoveredType));
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private static string? TypeKey(AgentType? type) => type switch
    {
        AgentType.TrendFollowing => "trend",
        AgentType.CounterTrend => "counter",
        AgentType.MarketMaker => "mm",
        AgentType.NewsDriven => "news",
        _ => null
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!HasEquityPoints)
        {
            chartRendered = false;
            return;
        }

        try
        {
            chartModule ??= await JS.InvokeAsync<IJSObjectReference>(
                "import", ResolveModulePath("Components/Pages/Agents.razor.js"));

            await chartModule.InvokeVoidAsync("render", equityChart, new
            {
                series = BuildSeriesPayload(),
                // Отметки новостей — те же события, что в хронологии сессии.
                news = Events.News.Select(entry => entry.At.ToUnixTimeSeconds()).ToArray(),
                labels = equityLabels
            });
            chartRendered = true;
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
            chartRendered = false;
        }
    }

    private Dictionary<string, IReadOnlyList<ChartPoint>> BuildSeriesPayload()
    {
        var payload = new Dictionary<string, IReadOnlyList<ChartPoint>>();

        foreach (var (type, points) in EquitySeries)
        {
            if (TypeKey(type) is { } key)
            {
                payload[key] = points;
            }
        }

        return payload;
    }

    private string ResolveModulePath(string asset)
    {
        var path = Assets[asset];

        return path.StartsWith("./", StringComparison.Ordinal)
            || path.StartsWith('/')
            || path.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                ? path
                : $"./{path}";
    }

    public void Dispose()
    {
        Markets.Changed -= HandleChanged;
        Events.Changed -= HandleChanged;
        EquityHistory.Changed -= HandleChanged;
    }

    public async ValueTask DisposeAsync()
    {
        if (chartModule is null)
        {
            return;
        }

        try
        {
            await chartModule.InvokeVoidAsync("dispose", equityChart);
            await chartModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private sealed record LegendItem(AgentType Type, decimal Percent);
}
