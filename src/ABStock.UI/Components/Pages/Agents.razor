@page "/agents"
@layout CreateAssetLayout
@rendermode InteractiveServer
@using ABStock.Application.MarketHistory
@using ABStock.Application.Simulation
@using ABStock.Shared
@using ABStock.UI.Services
@using static ABStock.UI.Services.NumberFormat
@implements IDisposable
@implements IAsyncDisposable
@inject ISimulationRunner SimulationRunner
@inject IActiveAssetContext ActiveAssetContext
@inject IAgentEquityHistory EquityHistory
@inject ISimulationHistoryReader SimulationHistoryReader
@inject IJSRuntime JS

<PageTitle>Агенты</PageTitle>

@{
    var isRunning = SimulationRunner.IsRunning;
    var roster = Roster;
    var hasAgents = roster.AgentCount > 0;
}

<div class="app-bg" aria-hidden="true"><div class="app-bg__noise"></div></div>

<div class="agents-shell">
    <TopNavigation ActivePage="Agents" ShowClock="true" />

    <main class="agents-page">

        @* ── Крошки · статус сессии чипом рядом с путём, а не внутри (раздел 13) ── *@
        <Breadcrumbs Items="@(new Crumb[]
                     {
                         new("Активы", Href: "/create-asset"),
                         new(CurrentAsset.Draft.Name, IsAsset: true),
                         new("Агенты")
                     })">
            <Aside>
                <SessionChip Running="isRunning" Elapsed="@Elapsed" />
            </Aside>
        </Breadcrumbs>

        <PageHead Title="Агенты">
            <Context>
                @if (hasAgents)
                {
                    <text>
                        <span class="num-sm">@roster.AgentCount</span>
                        @Plural(roster.AgentCount, "экземпляр", "экземпляра", "экземпляров") ·
                        <span class="num-sm">@roster.TypeCount</span>
                        @Plural(roster.TypeCount, "тип", "типа", "типов") стратегий
                    </text>
                }
                else
                {
                    <text>@CurrentAsset.Draft.Name · <span class="num-sm">@CurrentAsset.Symbol</span> · торги не запущены</text>
                }
            </Context>
        </PageHead>

        @if (!hasAgents)
        {
            @* Пустое состояние — раздел 14 и 9.15: текст и одно действие. *@
            <Panel Class="rise rise-1">
                <ChildContent>
                    <EmptyState IconName="users"
                                Title="Торги не запущены"
                                Description="Агенты появятся после старта симуляции.">
                        <Action>
                            <AppButton Variant="primary" Href="/trading">Перейти к торгам</AppButton>
                        </Action>
                    </EmptyState>
                </ChildContent>
            </Panel>
        }
        else
        {
            @* ── Строка показателей · одна строка, без переносов (раздел 9.0) ──
                 Главное число — P/L сессии; остальное компактным рядом через
                 тонкие разделители, без коробок (раздел 9.1). *@
            <section class="metrics rise rise-1" aria-label="Показатели сессии">
                <div class="metrics__hero">
                    <span class="num-hero @DeltaTone(roster.TotalPnl)">
                        @(roster.TotalPnl > 0m ? "↗" : roster.TotalPnl < 0m ? "↘" : "·") @Pnl2(roster.TotalPnl)
                    </span>
                    <span class="metrics__hero-label">P/L сессии</span>
                </div>

                <span class="metrics__sep" aria-hidden="true"></span>
                <span class="metrics__item">
                    капитал под управлением
                    <span class="num-md">@Money0(roster.TotalPortfolio)</span>
                    <span class="metrics__unit">₽</span>
                </span>

                <span class="metrics__sep" aria-hidden="true"></span>
                <span class="metrics__item">
                    сделок за сессию <span class="num-md">@Count0(SessionTradeCount)</span>
                </span>

                @* Признак — деньги, отличные от стартовых: они меняются от любой
                   исполненной сделки. Это «торговал за сессию», а не «торгует
                   прямо сейчас», и подпись говорит именно это (раздел 10.1). *@
                <span class="metrics__sep" aria-hidden="true"></span>
                <span class="metrics__item">
                    торговали за сессию
                    <span class="num-md">@roster.TradingCount</span> из
                    <span class="num-md metrics__of">@roster.AgentCount</span>
                </span>
            </section>

            @* ── Визуальный объект страницы (раздел 7.2): измерение, которого
                 нет в таблице, — время. Как менялась стоимость портфеля типа
                 с начала сессии. *@
            <Panel Title="Стоимость портфеля по типам агентов" Class="equity rise rise-2">
                <MetaContent>с начала сессии · процент от стартового портфеля типа</MetaContent>
                <ChildContent>
                    <div class="equity__body">
                        @if (HasEquityPoints)
                        {
                            <div class="equity__stage" @ref="equityChart"
                                 role="img"
                                 aria-label="Стоимость портфеля по типам агентов с начала сессии"></div>
                        }
                        else
                        {
                            @* Тиков ещё нет — скелетон по форме графика, а не
                               пустое поле с осями (раздел 9.16). *@
                            <div class="equity__stage equity__stage--empty" aria-busy="true">
                                <Skeleton Width="100%" Height="100%" />
                            </div>
                        }

                        <div class="legend">
                            @foreach (var item in Legend)
                            {
                                <div class="legend__row @(hoveredType == item.Type ? "is-active" : null)"
                                     @onmouseenter="() => SetHovered(item.Type, fromLegend: true)"
                                     @onmouseleave="() => SetHovered(null, fromLegend: true)">
                                    <StatusDot Tone="@AgentDisplay.GetTypeTone(item.Type)" />
                                    <span class="legend__body">
                                        <span class="legend__head">
                                            <span class="legend__name">@AgentDisplay.GetTypeLabel(item.Type)</span>
                                            <span class="num-md">@Percent2(item.Percent) %</span>
                                        </span>
                                        @if (!item.HasTrades)
                                        {
                                            @* Линия ровно на 100 % — это осмысленный факт,
                                               а не отсутствие данных (раздел 16.4). *@
                                            <span class="legend__note">сделок не было</span>
                                        }
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                </ChildContent>
            </Panel>

            <Panel Title="Агенты в сессии" Class="roster rise rise-3" Flush="true">
                <MetaContent>строка — экземпляр · группы по типу стратегии</MetaContent>
                <ChildContent>
                    <div class="roster__scroll @(roster.Rows.Count > ScrollThreshold ? "is-scrollable" : null)">
                        <table class="roster__table">
                            <thead>
                                <tr>
                                    <th scope="col" class="label roster__c-name">Агент</th>
                                    <th scope="col" class="label roster__c-cash">Деньги, ₽</th>
                                    <th scope="col" class="label roster__c-pos">Позиция, шт.</th>
                                    <th scope="col" class="label roster__c-port">Портфель, ₽</th>
                                    <th scope="col" class="label roster__c-pnl">P/L, ₽</th>
                                    <th scope="col" class="label roster__c-why">Последнее действие и объяснение</th>
                                    <th scope="col" class="roster__c-go"><span class="sr-only">Открыть</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in roster.Rows)
                                {
                                    var isGroup = row.Kind == AgentRowKind.Group;
                                    // Обратная связка: курсор на элементе легенды подсвечивает
                                    // строки своего типа. Наведение на саму строку строк не
                                    // трогает — оно работает по графику (артборд 06).
                                    var typed = hoverFromLegend && hoveredType == row.Type;

                                    <tr class="@(isGroup ? "is-group" : "is-instance") @(typed ? "is-typed" : null)"
                                        @key="row.Title"
                                        @onmouseenter="() => SetHovered(row.ShowTypeDot ? row.Type : null, fromLegend: false)"
                                        @onmouseleave="() => SetHovered(null, fromLegend: false)">

                                        <th scope="row" class="roster__c-name">
                                            <span class="roster__name">
                                                @if (row.ShowTypeDot)
                                                {
                                                    <StatusDot Tone="@AgentDisplay.GetTypeTone(row.Type)" />
                                                }
                                                @if (isGroup)
                                                {
                                                    <span class="roster__title">@row.Title</span>
                                                }
                                                else
                                                {
                                                    @* Ссылка растягивается на всю строку: <tr> ссылкой
                                                       быть не может, а кликаться должна вся строка. *@
                                                    <a class="roster__link"
                                                       href="/agents/@Uri.EscapeDataString(row.AgentName!)">@row.Title</a>
                                                }
                                            </span>
                                        </th>

                                        <td class="roster__c-cash num-sm">@Money0(row.Cash)</td>
                                        <td class="roster__c-pos num-sm @DeltaTone(row.Position)">@Position0(row.Position)</td>
                                        <td class="roster__c-port num-sm">@Money0(row.Portfolio)</td>
                                        <td class="roster__c-pnl num-sm @DeltaTone(row.Pnl)">@Pnl2(row.Pnl)</td>

                                        <td class="roster__c-why">
                                            @if (row.Explanation is null && row.Action is null)
                                            {
                                                @if (!isGroup)
                                                {
                                                    <span class="nodata">—</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="roster__why" title="@RowTitle(row)">
                                                    @if (row.Action is not null)
                                                    {
                                                        <span class="roster__act">@row.Action</span><text> · </text>
                                                    }
                                                    @row.Explanation
                                                </span>
                                            }
                                        </td>

                                        <td class="roster__c-go">
                                            @if (!isGroup)
                                            {
                                                <Icon Name="chevron-right" Size="14" />
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </ChildContent>
            </Panel>
        }
    </main>
</div>

@code {
    /// <summary>Больше пятнадцати строк — включается внутренний скролл (раздел 9.8).</summary>
    private const int ScrollThreshold = 15;

    private SimulationTickResult? latestTick;
    private AgentType? hoveredType;
    private bool hoverFromLegend;

    private ElementReference equityChart;
    private IJSObjectReference? chartModule;
    private bool chartRendered;

    private SimulationRunSummary? runSummary;
    private Guid observedRunId = Guid.Empty;
    private DateTimeOffset lastSummaryRead = DateTimeOffset.MinValue;

    /// <summary>
    /// Как часто перечитывается сводка прогона. Время старта в ней неизменно,
    /// а число сделок растёт — кешировать сводку на весь прогон нельзя, счётчик
    /// замрёт на значении первого тика. Раз в секунду: тики идут чаще, а
    /// GetRun — это два запроса к базе, включая пересчёт сделок.
    /// </summary>
    private static readonly TimeSpan SummaryRefreshInterval = TimeSpan.FromSeconds(1);

    private ActiveAssetView CurrentAsset => ActiveAssetContext.GetView();

    private AgentRosterView Roster =>
        AgentRoster.Build(latestTick?.Agents ?? [], latestTick?.Decisions ?? []);

    /// <summary>
    /// Число сделок за сессию берётся из сводки прогона — там же, откуда его
    /// берут «Торги». Локальный счётчик страницы обнулялся бы при каждом
    /// переходе, и рядом с длительностью сессии стояло бы число за минуту.
    /// </summary>
    private int SessionTradeCount => runSummary?.TradeCount ?? 0;

    private string Elapsed => runSummary is null
        ? "00:00:00"
        : (DateTimeOffset.Now - runSummary.StartedAt.ToLocalTime()).ToString(@"hh\:mm\:ss");

    private IReadOnlyDictionary<AgentType, IReadOnlyList<ChartPoint>> EquitySeries => EquityHistory.Series;

    private bool HasEquityPoints => EquitySeries.Any(pair => pair.Value.Count > 0);

    /// <summary>
    /// Легенда рисуется здесь, а не средствами графика: строка легенды — это
    /// ещё и точка входа в подсветку, а библиотека такой строки не умеет.
    /// Порядок типов тот же, что в таблице.
    /// </summary>
    private LegendItem[] Legend =>
        (latestTick?.Agents ?? [])
            .GroupBy(agent => agent.Type)
            .OrderBy(group => group.Key)
            .Select(group =>
            {
                var series = EquitySeries.GetValueOrDefault(group.Key);
                var percent = series is { Count: > 0 } ? series[^1].Value : 100m;

                return new LegendItem(
                    group.Key,
                    percent,
                    // «Сделок не было» — про сам факт торговли, а не про
                    // ровную линию: линия на 100 % это следствие.
                    group.Any(agent => agent.Cash != agent.InitialCash));
            })
            .ToArray();

    private static string RowTitle(AgentRow row) =>
        row.Action is null ? row.Explanation ?? "" : $"{row.Action} · {row.Explanation}";

    protected override void OnInitialized()
    {
        SimulationRunner.OnTick += HandleTick;
        SimulationRunner.OnStateChanged += HandleStateChanged;
        EquityHistory.Changed += HandleEquityChanged;

        latestTick = SimulationRunner.Current;
        UpdateRunSummary();
    }

    private void HandleTick(SimulationTickResult tickResult) =>
        _ = InvokeAsync(() =>
        {
            latestTick = tickResult;
            UpdateRunSummary();
            StateHasChanged();
        });

    private void HandleStateChanged() => _ = InvokeAsync(StateHasChanged);

    private void HandleEquityChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>
    /// Сводка прогона читается из хранилища — оттуда же, откуда её читают
    /// «Торги», — и обновляется не чаще раза в секунду.
    /// </summary>
    private void UpdateRunSummary()
    {
        var runId = SimulationRunner.CurrentRunId;

        if (runId == Guid.Empty)
        {
            runSummary = null;
            observedRunId = Guid.Empty;
            return;
        }

        var now = DateTimeOffset.Now;

        if (runId == observedRunId
            && runSummary is not null
            && now - lastSummaryRead < SummaryRefreshInterval)
        {
            return;
        }

        runSummary = SimulationHistoryReader.GetRun(runId);
        observedRunId = runId;
        lastSummaryRead = now;
    }

    private void SetHovered(AgentType? type, bool fromLegend)
    {
        if (hoveredType == type && hoverFromLegend == fromLegend)
        {
            return;
        }

        hoveredType = type;
        hoverFromLegend = fromLegend && type is not null;
        _ = PushHighlightAsync();
    }

    private async Task PushHighlightAsync()
    {
        if (chartModule is null || !chartRendered)
        {
            return;
        }

        try
        {
            await chartModule.InvokeVoidAsync("setHighlight", equityChart, TypeKey(hoveredType));
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private static string? TypeKey(AgentType? type) => type switch
    {
        AgentType.TrendFollowing => "trend",
        AgentType.CounterTrend => "counter",
        AgentType.MarketMaker => "mm",
        AgentType.NewsDriven => "news",
        _ => null
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!HasEquityPoints)
        {
            chartRendered = false;
            return;
        }

        try
        {
            chartModule ??= await JS.InvokeAsync<IJSObjectReference>(
                "import", ResolveModulePath("Components/Pages/Agents.razor.js"));

            await chartModule.InvokeVoidAsync("render", equityChart, new { series = BuildSeriesPayload() });
            chartRendered = true;
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
            // Элемент ещё не в разметке — следующая отрисовка повторит попытку.
            chartRendered = false;
        }
    }

    private Dictionary<string, IReadOnlyList<ChartPoint>> BuildSeriesPayload()
    {
        var series = EquitySeries;
        var payload = new Dictionary<string, IReadOnlyList<ChartPoint>>();

        foreach (var (type, points) in series)
        {
            var key = TypeKey(type);
            if (key is not null)
            {
                payload[key] = points;
            }
        }

        return payload;
    }

    private string ResolveModulePath(string asset)
    {
        var path = Assets[asset];

        return path.StartsWith("./", StringComparison.Ordinal)
            || path.StartsWith('/')
            || path.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                ? path
                : $"./{path}";
    }

    public void Dispose()
    {
        SimulationRunner.OnTick -= HandleTick;
        SimulationRunner.OnStateChanged -= HandleStateChanged;
        EquityHistory.Changed -= HandleEquityChanged;
    }

    public async ValueTask DisposeAsync()
    {
        if (chartModule is null)
        {
            return;
        }

        try
        {
            await chartModule.InvokeVoidAsync("dispose", equityChart);
            await chartModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private sealed record LegendItem(AgentType Type, decimal Percent, bool HasTrades);
}
