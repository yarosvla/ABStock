@page "/create-asset"
@layout CreateAssetLayout
@rendermode InteractiveServer
@using ABStock.AI.Models
@using ABStock.AI.Services
@using ABStock.Shared
@using ABStock.UI.Services
@inject IAssetProfileService AssetProfileService
@inject IActiveAssetContext ActiveAssetContext

<PageTitle>Создание актива</PageTitle>

<div class="create-asset-shell">
    <TopNavigation ActivePage="CreateAsset" />

    <main class="create-asset-main @(isProfileGenerated ? "generated" : isGenerating ? "generating" : "draft")">
        <section class="work-stage">
            <header class="stage-header">
                <div class="page-header">
                    <span class="page-kicker">ABStock AI</span>
                    <h1>@PageTitleText</h1>
                    <p>@PageDescriptionText</p>
                </div>

                <section class="workflow-progress" aria-label="Статус создания актива">
                    <div class="workflow-step @(isProfileGenerated || isGenerating ? "done" : "active")">
                        <span aria-hidden="true">@(isProfileGenerated || isGenerating ? "✓" : "1")</span>
                        <strong>Ввод данных</strong>
                    </div>
                    <i aria-hidden="true"></i>
                    <div class="workflow-step @(isProfileGenerated ? "done" : isGenerating ? "active" : null)">
                        <span aria-hidden="true">@(isProfileGenerated ? "✓" : "2")</span>
                        <strong>AI-анализ</strong>
                    </div>
                    <i aria-hidden="true"></i>
                    <div class="workflow-step @(isProfileGenerated ? "active" : null)">
                        <span aria-hidden="true">3</span>
                        <strong>Готово</strong>
                    </div>
                </section>
            </header>

            <section class="workspace-grid @(isProfileGenerated ? "profile-visible review-mode" : isGenerating ? "generating-mode" : "profile-hidden")" aria-label="Создание актива">
                <section class="glass-card form-card @(isProfileGenerated ? "summary-card" : null)" aria-labelledby="form-title">
                    @if (isProfileGenerated)
                    {
                        <div class="profile-params-head">
                            <h2 id="form-title">Параметры профиля</h2>
                            <div class="summary-actions">
                                <button class="secondary-button compact-button" type="button" @onclick="EditParameters">
                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                    Редактировать
                                </button>
                                <button class="secondary-button compact-button" type="button" @onclick="RegenerateProfile">
                                    <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
                                    Перегенерировать
                                </button>
                            </div>
                        </div>

                        <dl class="profile-summary-spec">
                            <div>
                                <dt>Актив</dt>
                                <dd>@DisplayAssetName</dd>
                            </div>
                            <div>
                                <dt>Тип</dt>
                                <dd>@selectedAssetType.Name</dd>
                            </div>
                            <div>
                                <dt>Сектор</dt>
                                <dd>@selectedIndustry</dd>
                            </div>
                            <div>
                                <dt>Регион</dt>
                                <dd>Россия / СНГ</dd>
                            </div>
                            <div>
                                <dt>Валюта</dt>
                                <dd>RUB</dd>
                            </div>
                            <div>
                                <dt>Горизонт</dt>
                                <dd>6-24 мес.</dd>
                            </div>
                        </dl>

                        <div class="summary-description">
                            <strong>Описание (кратко)</strong>
                            <p>@SummaryDescription</p>
                        </div>

                        <button class="read-description-button" type="button" @onclick="ToggleDescriptionExpansion">
                            @(isDescriptionExpanded ? "Скрыть полное описание" : "Читать полное описание")
                            <i class="bi bi-chevron-down" aria-hidden="true"></i>
                        </button>

                        <p class="summary-generated-note">
                            <span aria-hidden="true">i</span>
                            Профиль сгенерирован на основе AI-модели ABStock v1.3
                        </p>
                    }
                    else if (isGenerating)
                    {
                        <div class="card-title-row compact">
                            <div>
                                <h2 id="form-title">Формирование AI-профиля</h2>
                                <p>Модель последовательно оценивает описание, риски и чувствительность к новостям</p>
                            </div>
                            <span class="state-pill">Анализ</span>
                        </div>

                        <div class="generation-panel" style="--progress:@GenerationProgress%">
                            <div class="generation-progress" aria-hidden="true"><span></span></div>
                            <ol class="analysis-stage-list">
                                @for (var i = 0; i < AnalysisStages.Length; i++)
                                {
                                    var stageClass = i < generationStep ? "done" : i == generationStep ? "current" : "pending";
                                    <li class="@stageClass">
                                        <span>@(i < generationStep ? "✓" : i + 1)</span>
                                        <div>
                                            <strong>@AnalysisStages[i]</strong>
                                            <small>@(i == generationStep ? "Выполняется" : i < generationStep ? "Завершено" : "В очереди")</small>
                                        </div>
                                    </li>
                                }
                            </ol>
                            <div class="profile-skeleton" aria-hidden="true">
                                <span></span>
                                <span></span>
                                <span></span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="card-title-row">
                            <div>
                                <span class="demo-badge">Демо-черновик</span>
                                <h2 id="form-title">Параметры актива</h2>
                                <p>Укажите данные для оценки факторов роста, рисков и новостной чувствительности</p>
                            </div>
                            <span class="state-pill">Черновик</span>
                        </div>

                        <div class="asset-form">
                            <div class="field-group asset-type-field">
                                <label id="asset-type-label">Тип актива <span>*</span></label>
                                <div class="asset-type-grid" role="group" aria-labelledby="asset-type-label">
                                    @foreach (var type in AssetTypes)
                                    {
                                        <button class="asset-type-tile @(type.Name == selectedAssetType.Name ? "selected" : null)" type="button" aria-pressed="@(type.Name == selectedAssetType.Name)" @onclick="() => SelectAssetType(type)">
                                            <span class="select-icon" aria-hidden="true">
                                                <i class="bi @type.IconClass"></i>
                                            </span>
                                            <strong>@type.Name</strong>
                                            <small>@type.Description</small>
                                        </button>
                                    }
                                </div>
                            </div>

                            <div class="field-group @(ShowAssetNameValidation ? "has-error" : null)">
                                <label for="asset-name">Название актива <span>*</span></label>
                                <input id="asset-name" type="text" placeholder="Например: КвантЭнерго" @bind="assetName" @bind:event="oninput" @bind:after="SyncDraftState" aria-invalid="@ShowAssetNameValidation" />
                                @if (ShowAssetNameValidation)
                                {
                                    <small class="validation-message">Укажите название актива.</small>
                                }
                            </div>

                            <div class="field-group @(ShowAssetDescriptionValidation ? "has-error" : null)">
                                <label for="asset-description">Описание актива <span>*</span></label>
                                <textarea id="asset-description" placeholder="Опишите бизнес-модель, регион, драйверы роста, ограничения и риски." @bind="assetDescription" @bind:event="oninput" @bind:after="SyncDraftState" aria-invalid="@ShowAssetDescriptionValidation"></textarea>
                                @if (ShowAssetDescriptionValidation)
                                {
                                    <small class="validation-message">Добавьте описание для генерации AI-профиля.</small>
                                }
                                else
                                {
                                    <small class="field-hint">После генерации описание будет сжато в резюме.</small>
                                }
                            </div>

                            <button class="optional-row @(isOptionalOpen ? "open" : null)" type="button" aria-expanded="@isOptionalOpen" @onclick="ToggleOptional">
                                <span class="optional-copy">
                                    <strong>Дополнительные параметры</strong>
                                </span>
                                <i class="bi bi-chevron-down" aria-hidden="true"></i>
                            </button>

                            @if (isOptionalOpen)
                            {
                                <div class="optional-panel">
                                    <div class="field-group compact">
                                        <label id="industry-label">Сектор</label>
                                        <button class="select-control small" type="button" aria-labelledby="industry-label" aria-expanded="@isIndustryOpen" @onclick="ToggleIndustry">
                                            <span>@selectedIndustry</span>
                                            <i class="bi bi-chevron-down chevron @(isIndustryOpen ? "open" : null)" aria-hidden="true"></i>
                                        </button>
                                        @if (isIndustryOpen)
                                        {
                                            <div class="dropdown-panel compact-list" role="listbox" aria-label="Сектор">
                                                @foreach (var industry in Industries)
                                                {
                                                    <button class="dropdown-option text-only @(industry == selectedIndustry ? "selected" : null)" type="button" role="option" @onclick="() => SelectIndustry(industry)">
                                                        <strong>@industry</strong>
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </div>

                                    <label class="toggle-row">
                                        <input type="checkbox" @bind="includeGovernmentSupport" @bind:after="SyncDraftState" />
                                        <span>Учитывать государственную поддержку</span>
                                    </label>

                                    <label class="range-row">
                                        <span>Потенциал роста</span>
                                        <strong>@growthPotential%</strong>
                                        <input type="range" min="0" max="100" step="1" @bind="growthPotential" @bind:after="SyncDraftState" />
                                    </label>
                                </div>
                            }

                            <div class="form-footer">
                                <p class="privacy-note">
                                    <i class="bi bi-lock" aria-hidden="true"></i>
                                    Профиль формируется только по введённым данным и выбранным параметрам.
                                </p>

                                <div class="form-actions">
                                    <button class="secondary-button" type="button" @onclick="ClearForm">
                                        <i class="bi bi-eraser" aria-hidden="true"></i>
                                        Очистить
                                    </button>
                                    <button class="primary-button" type="button" @onclick="GenerateProfile" disabled="@isGenerating">
                                        Сформировать AI-профиль
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </section>

                @if (!isProfileGenerated && !isGenerating)
                {
                    <aside class="glass-card ai-preview-card" aria-label="Предпросмотр AI-профиля">
                        <div class="preview-title-row">
                            <div>
                                <span>ABStock AI Core v2.3</span>
                                <h2>Предпросмотр профиля</h2>
                            </div>
                            <div class="preview-orbit" aria-hidden="true">
                                <i class="bi bi-stars"></i>
                            </div>
                        </div>

                        <dl class="preview-metrics">
                            <div>
                                <dt>Актив</dt>
                                <dd>@DisplayAssetName</dd>
                            </div>
                            <div>
                                <dt>Тип</dt>
                                <dd>@selectedAssetType.Name</dd>
                            </div>
                            <div>
                                <dt>Сектор</dt>
                                <dd>@selectedIndustry</dd>
                            </div>
                            <div>
                                <dt>Источник</dt>
                                <dd>Ввод пользователя</dd>
                            </div>
                        </dl>

                        <div class="preview-readiness" style="--ready:@(CompletedRequiredFields * 50)%">
                            <div>
                                <span>Готовность данных</span>
                                <strong>@(CompletedRequiredFields * 50)%</strong>
                            </div>
                            <span aria-hidden="true"><i></i></span>
                        </div>

                        <section class="preview-summary">
                            <h3>Будущий профиль</h3>
                            <p>@DescriptionPreview</p>
                        </section>

                        <ul class="preview-usage-list" aria-label="Модули использования">
                            <li>
                                <i class="bi bi-graph-up-arrow" aria-hidden="true"></i>
                                <span>Торговые идеи</span>
                            </li>
                            <li>
                                <i class="bi bi-activity" aria-hidden="true"></i>
                                <span>Симуляции</span>
                            </li>
                            <li>
                                <i class="bi bi-shield-check" aria-hidden="true"></i>
                                <span>Риск-анализ</span>
                            </li>
                        </ul>

                        <p class="assistant-warning">В прототипе профиль формируется только по введённому описанию и выбранным параметрам.</p>
                    </aside>
                }

                @if (isProfileGenerated)
                {
                    <aside class="glass-card profile-card profile-redesign" aria-labelledby="profile-title">
                        <div class="card-title-row profile-title-row">
                            <h2 id="profile-title">Профиль актива</h2>
                            <span class="ai-generated-pill">
                                <i class="bi bi-stars" aria-hidden="true"></i>
                                Сгенерировано AI
                            </span>
                        </div>

                        <section class="profile-hero-card" id="profile-overview" aria-label="Сводка AI-профиля">
                            <div class="asset-summary-block">
                                <div class="asset-emblem compact" aria-hidden="true">
                                    <i class="bi @selectedAssetType.IconClass"></i>
                                </div>
                                <div>
                                    <h3>@DisplayAssetName</h3>
                                    <div class="profile-chip-row">
                                        <span>@DisplayAssetTypeName</span>
                                        <span>@selectedIndustry</span>
                                        <span>Россия / СНГ</span>
                                        <span>RUB</span>
                                    </div>
                                </div>
                            </div>

                            <div class="profile-kpi-strip">
                                <div class="kpi-card recommendation">
                                    <span>Рекомендация</span>
                                    <strong class="@RecommendationTextClass">@RecommendationLabel</strong>
                                    <i class="bi bi-graph-up-arrow" aria-hidden="true"></i>
                                </div>
                                <div class="kpi-card risk">
                                    <span>Риск</span>
                                    <strong class="@RiskTextClass">@RiskLevelLabel</strong>
                                    <i class="bi bi-shield-exclamation" aria-hidden="true"></i>
                                </div>
                                <div class="kpi-card horizon">
                                    <span>Горизонт</span>
                                    <strong>6-24 мес.</strong>
                                    <i class="bi bi-calendar-range" aria-hidden="true"></i>
                                </div>
                                <div class="kpi-card confidence">
                                    <span>Уверенность</span>
                                    <strong class="positive-text">@ConfidenceLabel</strong>
                                    <i class="bi bi-bullseye" aria-hidden="true"></i>
                                </div>
                            </div>
                        </section>

                        <section class="profile-dashboard" id="profile-factors" aria-label="Ключевые выводы AI-профиля">
                            <article class="profile-panel growth-panel">
                                <div class="panel-title-row">
                                    <h3>Драйверы роста</h3>
                                    <i class="bi bi-graph-up-arrow moving-panel-icon" aria-hidden="true"></i>
                                </div>
                                <ul class="driver-summary-list">
                                    @foreach (var factor in ProfilePositiveFactors.Take(3))
                                    {
                                        <li>
                                            <span class="signal-dot green-dot"></span>
                                            <strong>@factor.Title</strong>
                                            <em>@factor.Impact</em>
                                        </li>
                                    }
                                </ul>
                                <div class="panel-footline">
                                    <span>Позитивное влияние</span>
                                    <strong>@PositiveImpactLabel</strong>
                                </div>
                            </article>

                            <article class="profile-panel risk-panel">
                                <div class="panel-title-row">
                                    <h3>Ключевые риски</h3>
                                    <i class="bi bi-shield-exclamation moving-panel-icon shield-icon" aria-hidden="true"></i>
                                </div>
                                <ul class="risk-summary-list">
                                    @foreach (var risk in ProfileRiskFactors.Take(3))
                                    {
                                        <li>
                                            <span class="signal-dot red-dot"></span>
                                            <strong>@risk.Title</strong>
                                            <em>@risk.Probability</em>
                                        </li>
                                    }
                                </ul>
                                <div class="panel-footline risk-footline">
                                    <span>Общий уровень риска</span>
                                    <strong>@RiskLevelLabel</strong>
                                </div>
                            </article>

                            <article class="profile-panel sensitivity-panel" id="profile-news">
                                <div class="panel-title-row">
                                    <h3>Чувствительность к новостям</h3>
                                </div>
                                <div class="news-score-layout">
                                    <div class="news-gauge" aria-label="86 из 100, высокая чувствительность">
                                        <svg viewBox="0 0 180 170" aria-hidden="true">
                                            <defs>
                                                <linearGradient id="newsGaugeGradient"
                                                                x1="35" y1="130"
                                                                x2="145" y2="45"
                                                                gradientUnits="userSpaceOnUse">
                                                    <stop stop-color="#55C7FF" />
                                                    <stop offset=".52" stop-color="#7C5CFF" />
                                                    <stop offset="1" stop-color="#36D98A" />
                                                </linearGradient>
                                            </defs>

                                            <path class="news-gauge-track"
                                                  d="M36 126 A62 62 0 1 1 144 126"
                                                  pathLength="100" />

                                            <path class="news-gauge-value"
                                                  d="M36 126 A62 62 0 1 1 144 126"
                                                  pathLength="100" />

                                        </svg>

                                        <div class="news-gauge-score">
                                            <strong>@NewsSensitivityScore</strong>
                                            <span>/100</span>
                                        </div>

                                        <small class="news-gauge-label">@NewsSensitivityLabel</small>
                                    </div>
                                    <ul class="news-sensitivity-list">
                                        @foreach (var driver in ProfileSensitivityDrivers)
                                        {
                                            <li class="@(driver.Level == "Высокая" ? "high" : "medium")">
                                                <span>@driver.Name</span>
                                                <em>@driver.Level</em>
                                            </li>
                                        }
                                    </ul>
                                </div>
                                <a class="sensitivity-link" href="#profile-news">
                                    Подробнее о чувствительности
                                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                </a>
                            </article>
                        </section>

                        <section class="profile-bottom-row" id="profile-actions">
                            <div class="profile-panel tags-panel">
                                <h3>Ключевые теги</h3>
                                <div class="tag-cloud sector-tags">
                                    @foreach (var tag in ProfileTags)
                                    {
                                        <span class="@tag.ClassName">@tag.Label</span>
                                    }
                                </div>
                            </div>
                            <div class="profile-panel conclusion-panel">
                                <h3>Ключевые выводы</h3>
                                <ul>
                                    @foreach (var conclusion in ProfileConclusions)
                                    {
                                        <li>
                                            <i class="bi @conclusion.Icon" aria-hidden="true"></i>
                                            @conclusion.Text
                                        </li>
                                    }
                                </ul>
                            </div>
                        </section>

                        <div class="profile-action-footer">
                            <div class="action-buttons">
                                <a class="primary-action" href="/trading">
                                    <i class="bi bi-play-circle" aria-hidden="true"></i>
                                    Запустить торги
                                </a>
                                <button type="button">
                                    <i class="bi bi-activity" aria-hidden="true"></i>
                                    Запустить симуляцию
                                </button>
                                <button type="button">
                                    <i class="bi bi-star" aria-hidden="true"></i>
                                    Добавить в watchlist
                                </button>
                            </div>
                            <p>Сформировано: @GeneratedAtLabel <i class="bi bi-info-circle" aria-hidden="true"></i></p>
                        </div>
                    </aside>
                }
            </section>
        </section>
    </main>
</div>

@code {
    private readonly AssetTypeOption[] AssetTypes =
    [
        new(AssetType.Stock, "Акция", "Публичная компания", "bi-graph-up-arrow"),
        new(AssetType.Bond, "Облигация", "Долговой инструмент", "bi-receipt"),
        new(AssetType.Commodity, "Товар", "Биржевой актив", "bi-bar-chart-line"),
        new(AssetType.Crypto, "Криптоактив", "Цифровой актив", "bi-currency-bitcoin")
    ];

    private readonly string[] Industries =
    [
        "Энергетика",
        "Технологии",
        "Финансы",
        "Промышленность",
        "Потребительский сектор"
    ];

    private static readonly string[] AnalysisStages =
    [
        "Анализ описания",
        "Определение сектора",
        "Оценка позитивных факторов",
        "Оценка рисков",
        "Расчёт чувствительности к новостям",
        "Формирование тегов"
    ];

    private AssetTypeOption selectedAssetType = default!;
    private string selectedIndustry = "Энергетика";
    private string assetName = ActiveAssetDefaults.DemoDraft.Name;
    private string assetDescription = ActiveAssetDefaults.DemoDraft.Description;
    private bool isAssetTypeOpen;
    private bool isIndustryOpen;
    private bool isOptionalOpen;
    private bool isProfileGenerated;
    private bool isGenerating;
    private bool includeGovernmentSupport = true;
    private int growthPotential = 85;
    private int generationStep = -1;
    private DateTimeOffset? generatedAt;
    private bool wasSubmitted;
    private AssetProfile? generatedProfile;
    private bool isDescriptionExpanded;

    protected override void OnInitialized()
    {
        var draft = ActiveAssetContext.Draft ?? ActiveAssetDefaults.DemoDraft;
        selectedAssetType = ResolveAssetTypeOption(draft.AssetType);
        ApplyDraft(draft);

        if (ActiveAssetContext.Profile is not null)
        {
            generatedProfile = ActiveAssetContext.Profile;
            generatedAt = ActiveAssetContext.UpdatedAt;
            isProfileGenerated = true;
        }
    }

    private AssetProfile CurrentProfile => generatedProfile ?? ActiveAssetDefaults.BuildProfile(BuildDraft());
    private bool CanGenerate => !string.IsNullOrWhiteSpace(assetName) && !string.IsNullOrWhiteSpace(assetDescription);
    private int CompletedRequiredFields => (string.IsNullOrWhiteSpace(assetName) ? 0 : 1) + (string.IsNullOrWhiteSpace(assetDescription) ? 0 : 1);
    private bool ShowAssetNameValidation => wasSubmitted && string.IsNullOrWhiteSpace(assetName);
    private bool ShowAssetDescriptionValidation => wasSubmitted && string.IsNullOrWhiteSpace(assetDescription);
    private string DisplayAssetName => string.IsNullOrWhiteSpace(assetName) ? "Новый актив" : assetName.Trim();
    private string DisplayAssetTypeName => selectedAssetType.Name;
    private int GenerationProgress => isGenerating ? Math.Clamp((generationStep + 1) * 100 / AnalysisStages.Length, 8, 100) : 0;
    private string GeneratedAtLabel => generatedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "не сформировано";
    private string PageTitleText => isProfileGenerated
        ? "AI-профиль готов"
        : isGenerating
            ? "Формируем AI-профиль"
            : "Создание актива";

    private string PageDescriptionText => isProfileGenerated
        ? "Проверьте сгенерированные параметры и переходите к торговым сценариям."
        : isGenerating
            ? "Модель последовательно оценивает описание, риски и чувствительность к новостям."
            : "Опишите актив, уточните параметры и получите профиль с факторами роста, рисками и чувствительностью к новостям.";

    private string DescriptionPreview => BuildDescriptionPreview(maxLength: 180);

    private string SummaryDescription => isDescriptionExpanded
        ? CurrentProfile.Description
        : BuildDescriptionPreview(maxLength: 300);

    private string RecommendationLabel =>
        CurrentProfile.PositiveFactors.Count >= CurrentProfile.NegativeFactors.Count + 2
            ? "позитивная"
            : CurrentProfile.PositiveFactors.Count >= CurrentProfile.NegativeFactors.Count
                ? "нейтрально-позитивная"
                : "сбалансированная";

    private string RecommendationTextClass => RecommendationLabel == "сбалансированная" ? "warning-text" : "positive-text";

    private string RiskLevelLabel =>
        CurrentProfile.Risks.Count + CurrentProfile.NegativeFactors.Count >= 5
            ? "умеренно высокий"
            : CurrentProfile.Risks.Count >= 2
                ? "средний"
                : "контролируемый";

    private string RiskTextClass => RiskLevelLabel == "контролируемый" ? "positive-text" : "warning-text";

    private string ConfidenceLabel => $"{Math.Clamp(64 + growthPotential / 4 + (includeGovernmentSupport ? 3 : 0), 68, 92)}%";

    private int NewsSensitivityScore => (int)Math.Round(CurrentProfile.NewsSensitivity * 100m, MidpointRounding.AwayFromZero);

    private string NewsSensitivityLabel => NewsSensitivityScore switch
    {
        >= 80 => "Высокая",
        >= 60 => "Средняя",
        _ => "Низкая"
    };

    private string PositiveImpactLabel => $"{Math.Clamp(58 + NewsSensitivityScore / 3, 62, 91)}%";

    private IReadOnlyList<FactorInsight> ProfilePositiveFactors =>
        CurrentProfile.PositiveFactors
            .Take(4)
            .Select((factor, index) => new FactorInsight(
                factor,
                BuildPositiveFactorDetail(factor),
                index == 0 ? "Высокое влияние" : index == 1 ? "Среднее влияние" : "Умеренное влияние",
                $"{Math.Clamp(NewsSensitivityScore - index * 6, 54, 94)}%"))
            .ToArray();

    private IReadOnlyList<RiskInsight> ProfileRiskFactors =>
        CurrentProfile.Risks
            .Concat(CurrentProfile.NegativeFactors)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(4)
            .Select((risk, index) => new RiskInsight(
                risk,
                index == 0 ? "Рыночные" : index == 1 ? "Операционные" : "Структурные",
                BuildRiskDetail(risk),
                index == 0 ? "Высокая" : "Средняя",
                index == 0 ? "Высокий" : "Средний"))
            .ToArray();

    private IReadOnlyList<SensitivityDriver> ProfileSensitivityDrivers => BuildSensitivityDrivers();

    private IReadOnlyList<TagChip> ProfileTags => BuildProfileTags();

    private IReadOnlyList<ProfileConclusion> ProfileConclusions => BuildConclusions();

    private string BuildDescriptionPreview(int maxLength)
    {
        var source = isProfileGenerated
            ? CurrentProfile.Description
            : assetDescription;
        var value = string.IsNullOrWhiteSpace(source)
            ? "Описание не заполнено."
            : source.Trim().Replace("\n", " ");

        return value.Length <= maxLength ? value : $"{value[..maxLength]}...";
    }

    private void ToggleAssetType()
    {
        isAssetTypeOpen = !isAssetTypeOpen;
        isIndustryOpen = false;
    }

    private void SelectAssetType(AssetTypeOption type)
    {
        selectedAssetType = type;
        isAssetTypeOpen = false;
        SyncDraftState();
    }

    private void ToggleOptional()
    {
        isOptionalOpen = !isOptionalOpen;
        isAssetTypeOpen = false;
        isIndustryOpen = false;
    }

    private void ToggleIndustry()
    {
        isIndustryOpen = !isIndustryOpen;
        isAssetTypeOpen = false;
    }

    private void SelectIndustry(string industry)
    {
        selectedIndustry = industry;
        isIndustryOpen = false;
        SyncDraftState();
    }

    private async Task GenerateProfile()
    {
        wasSubmitted = true;

        if (!CanGenerate || isGenerating)
        {
            return;
        }

        isGenerating = true;
        isProfileGenerated = false;
        wasSubmitted = false;
        isAssetTypeOpen = false;
        isIndustryOpen = false;
        isOptionalOpen = false;

        for (var i = 0; i < AnalysisStages.Length; i++)
        {
            generationStep = i;
            StateHasChanged();
            await Task.Delay(320);
        }

        var draft = BuildDraft();
        generatedProfile = AssetProfileService.CreateProfile(new AssetProfileRequest
        {
            AssetType = draft.AssetType,
            Name = draft.Name,
            Description = draft.Description,
            Industry = draft.Industry,
            IncludeGovernmentSupport = draft.IncludeGovernmentSupport,
            GrowthPotential = draft.GrowthPotential
        });

        generatedAt = DateTimeOffset.Now;
        generationStep = AnalysisStages.Length;
        isGenerating = false;
        isProfileGenerated = true;
        isDescriptionExpanded = false;
        ActiveAssetContext.SetProfile(draft, generatedProfile);
    }

    private Task RegenerateProfile()
    {
        return GenerateProfile();
    }

    private void EditParameters()
    {
        generatedProfile = null;
        isProfileGenerated = false;
        isGenerating = false;
        wasSubmitted = false;
        generationStep = -1;
        isDescriptionExpanded = false;
        ActiveAssetContext.SetDraft(BuildDraft());
    }

    private void ClearForm()
    {
        selectedAssetType = AssetTypes[0];
        selectedIndustry = "Энергетика";
        assetName = string.Empty;
        assetDescription = string.Empty;
        includeGovernmentSupport = true;
        growthPotential = 85;
        isOptionalOpen = false;
        isAssetTypeOpen = false;
        isIndustryOpen = false;
        isProfileGenerated = false;
        isGenerating = false;
        wasSubmitted = false;
        generationStep = -1;
        generatedAt = null;
        generatedProfile = null;
        isDescriptionExpanded = false;
        ActiveAssetContext.Clear();
    }

    private void ToggleDescriptionExpansion() => isDescriptionExpanded = !isDescriptionExpanded;

    private void ApplyDraft(ActiveAssetDraft draft)
    {
        selectedAssetType = ResolveAssetTypeOption(draft.AssetType);
        selectedIndustry = string.IsNullOrWhiteSpace(draft.Industry) ? Industries[0] : draft.Industry;
        assetName = draft.Name;
        assetDescription = draft.Description;
        includeGovernmentSupport = draft.IncludeGovernmentSupport;
        growthPotential = draft.GrowthPotential;
    }

    private void SyncDraftState()
    {
        if (isGenerating)
        {
            return;
        }

        ActiveAssetContext.SetDraft(BuildDraft());
    }

    private ActiveAssetDraft BuildDraft() =>
        new(
            Name: DisplayAssetName,
            Description: string.IsNullOrWhiteSpace(assetDescription) ? "Описание не заполнено." : assetDescription.Trim(),
            AssetType: selectedAssetType.Type,
            Industry: selectedIndustry,
            IncludeGovernmentSupport: includeGovernmentSupport,
            GrowthPotential: growthPotential);

    private AssetTypeOption ResolveAssetTypeOption(AssetType assetType) =>
        AssetTypes.FirstOrDefault(item => item.Type == assetType) ?? AssetTypes[0];

    private IReadOnlyList<SensitivityDriver> BuildSensitivityDrivers()
    {
        var drivers = new List<SensitivityDriver>
        {
            new("Корпоративные новости", NewsSensitivityScore >= 75 ? "Высокая" : "Средняя"),
            new($"Сектор {selectedIndustry}", NewsSensitivityScore >= 65 ? "Высокая" : "Средняя"),
            new(includeGovernmentSupport ? "Господдержка" : "Рыночный спрос", includeGovernmentSupport ? "Высокая" : "Средняя")
        };

        return drivers
            .DistinctBy(driver => driver.Name)
            .ToArray();
    }

    private IReadOnlyList<TagChip> BuildProfileTags()
    {
        var tags = new List<TagChip>
        {
            new(selectedIndustry, string.Empty),
            new(DisplayAssetTypeName, string.Empty)
        };

        if (includeGovernmentSupport)
        {
            tags.Add(new("Господдержка", "green-tag"));
        }

        if (CurrentProfile.Risks.Count > 0)
        {
            tags.Add(new(CurrentProfile.Risks[0], "risk-tag"));
        }

        if (NewsSensitivityScore >= 70)
        {
            tags.Add(new("Высокая чувствительность", "warning-tag"));
        }

        tags.AddRange(CurrentProfile.Keywords
            .Where(keyword => !string.Equals(keyword, DisplayAssetName, StringComparison.OrdinalIgnoreCase))
            .Take(3)
            .Select(keyword => new TagChip(keyword, string.Empty)));

        return tags
            .DistinctBy(tag => tag.Label)
            .Take(5)
            .ToArray();
    }

    private IReadOnlyList<ProfileConclusion> BuildConclusions()
    {
        var conclusions = new List<ProfileConclusion>();

        if (CurrentProfile.PositiveFactors.Count > 0)
        {
            conclusions.Add(new("bi-bar-chart-line", $"Основной драйвер: {CurrentProfile.PositiveFactors[0]}"));
        }

        if (CurrentProfile.Risks.Count > 0)
        {
            conclusions.Add(new("bi-exclamation-triangle", $"Главный риск: {CurrentProfile.Risks[0]}"));
        }

        conclusions.Add(new("bi-bullseye", $"Профиль: {RiskLevelLabel} риск при рекомендации «{RecommendationLabel}»"));
        return conclusions.Take(3).ToArray();
    }

    private static string BuildPositiveFactorDetail(string factor) =>
        $"{factor}. Фактор учитывается в профиле как один из основных драйверов сценария роста.";

    private static string BuildRiskDetail(string risk) =>
        $"{risk}. Требует мониторинга в ленте новостей, ликвидности и в динамике поведения агентов.";

    private sealed record AssetTypeOption(AssetType Type, string Name, string Description, string IconClass);
    private sealed record FactorInsight(string Title, string Detail, string Impact, string Confidence);
    private sealed record RiskInsight(string Title, string Type, string Detail, string Probability, string Impact);
    private sealed record SensitivityDriver(string Name, string Level);
    private sealed record TagChip(string Label, string ClassName);
    private sealed record ProfileConclusion(string Icon, string Text);
}
