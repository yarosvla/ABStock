@page "/create-asset"
@layout CreateAssetLayout
@rendermode InteractiveServer
@using ABStock.AI.Models
@using ABStock.AI.Services
@using ABStock.Application.Simulation
@using ABStock.Shared
@using ABStock.UI.Services
@inject IAssetProfileService AssetProfileService
@inject IActiveAssetContext ActiveAssetContext
@inject INotificationFeed NotificationFeed
@inject ISimulationRunner SimulationRunner

<PageTitle>Создание актива</PageTitle>

<div class="app-bg" aria-hidden="true"><div class="app-bg__noise"></div></div>

<div class="create-shell">
    <TopNavigation ActivePage="CreateAsset" ShowClock="true" />

    <main class="create-page">

        @* ── Крошки · Активы › Актив › Раздел (раздел 13) ─────────────────────
             Статус актива — чипом рядом с именем, внутри одного элемента пути.
             Между «›» он читался бы как ещё один раздел. *@
        <Breadcrumbs Items="@BuildCrumbs()" />

        @if (profile is null)
        {
            @* ══════════════ Форма и загрузка ══════════════ *@
            <PageHead Title="Создание актива">
                <Context>Опишите компанию словами — система соберёт профиль, по которому рынок будет реагировать на новости.</Context>
            </PageHead>

            @if (isGenerating)
            {
                @* Загрузка — скелетоны по форме будущего профиля (раздел 9.16).
                   Процентов здесь нет: честно посчитать их нельзя ни сейчас,
                   ни когда разбор описания станет асинхронным. *@
                <div class="loading" aria-live="polite" aria-busy="true">
                    <span class="sr-only">Профиль строится</span>

                    <div class="loading__strip panel">
                        <div class="loading__step"><Skeleton Width="62px" Height="9px" /><Skeleton Width="88%" Height="14px" /></div>
                        <span class="loading__arrow" aria-hidden="true">→</span>
                        <div class="loading__step loading__step--wide"><Skeleton Width="140px" Height="9px" /><Skeleton Width="110px" Height="34px" /><Skeleton Height="14px" /></div>
                        <span class="loading__arrow" aria-hidden="true">→</span>
                        <div class="loading__step"><Skeleton Width="96px" Height="9px" /><Skeleton Width="92%" Height="14px" /></div>
                    </div>

                    <div class="loading__balance">
                        <Skeleton Width="120px" Height="9px" />
                        <Skeleton Height="16px" />
                    </div>

                    <div class="loading__factors">
                        <div class="loading__card panel">
                            <Skeleton Width="150px" Height="14px" />
                            <Skeleton Width="92%" Height="12px" />
                            <Skeleton Width="78%" Height="12px" />
                            <Skeleton Width="85%" Height="12px" />
                            <Skeleton Width="66%" Height="12px" />
                        </div>
                        <div class="loading__card panel">
                            <Skeleton Width="168px" Height="14px" />
                            <Skeleton Width="88%" Height="12px" />
                            <Skeleton Width="72%" Height="12px" />
                            <Skeleton Width="80%" Height="12px" />
                        </div>
                    </div>

                    <div class="loading__chips">
                        <Skeleton Width="96px" Height="22px" Radius="var(--r-pill)" />
                        <Skeleton Width="124px" Height="22px" Radius="var(--r-pill)" />
                        <Skeleton Width="88px" Height="22px" Radius="var(--r-pill)" />
                    </div>
                </div>
            }
            else
            {
                <div class="layout">
                    <Panel Class="form rise rise-1" Flush="true">
                        <ChildContent>
                            <section class="field">
                                <div class="field__head">
                                    <span class="field__no">01</span>
                                    <span class="label">Тип актива</span>
                                </div>
                                <div class="types" role="group" aria-label="Тип актива">
                                    @foreach (var type in AssetTypes)
                                    {
                                        var isSelected = type.Type == selectedAssetType;
                                        <button class="type @(isSelected ? "is-selected" : null)" type="button"
                                                aria-pressed="@(isSelected ? "true" : "false")"
                                                @onclick="() => SelectAssetType(type.Type)">
                                            <strong>@type.Name</strong>
                                            <small>@type.Hint</small>
                                        </button>
                                    }
                                </div>
                            </section>

                            <section class="field">
                                <div class="field__head">
                                    <span class="field__no">02</span>
                                    <label class="label" for="asset-name">Название</label>
                                </div>
                                <TextField Id="asset-name"
                                           Value="assetName"
                                           ValueChanged="SetAssetName"
                                           MaxLength="120"
                                           Placeholder="Например, Гелиос Энерго"
                                           Invalid="NameInvalid"
                                           InvalidTone="down"
                                           DescribedBy="@(NameInvalid ? "asset-name-error" : null)" />
                                @if (NameInvalid)
                                {
                                    <span id="asset-name-error" class="field__error">
                                        <Icon Name="alert" Size="14" />
                                        <span>Введите название — из него генерируется тикер</span>
                                    </span>
                                }
                            </section>

                            <section class="field">
                                <div class="field__head field__head--split">
                                    <div class="field__head-main">
                                        <span class="field__no">03</span>
                                        <label class="label" for="asset-description">Описание</label>
                                        <span class="field__hint">главное поле — из него строится профиль</span>
                                    </div>
                                    <span class="field__counter @(DescriptionInvalid ? "is-invalid" : null)">@assetDescription.Length / @MaxDescriptionLength</span>
                                </div>
                                <textarea id="asset-description" class="textarea @(DescriptionInvalid ? "is-invalid" : null)"
                                          maxlength="@MaxDescriptionLength" rows="6"
                                          placeholder="Чем занимается компания, на чём зарабатывает, от чего зависит её выручка. Три-четыре предложения обычным языком."
                                          aria-invalid="@(DescriptionInvalid ? "true" : "false")"
                                          aria-describedby="@(DescriptionInvalid ? "asset-description-error" : null)"
                                          @bind="assetDescription" @bind:event="oninput" @bind:after="TouchForm"></textarea>
                                @if (DescriptionInvalid)
                                {
                                    <span id="asset-description-error" class="field__error">
                                        <Icon Name="alert" Size="14" />
                                        <span>Слишком коротко: нужно не меньше @MinDescriptionLength символов, чтобы собрать факторы и риски</span>
                                    </span>
                                }
                            </section>

                            <section class="field">
                                <div class="field__head">
                                    <span class="field__no">04</span>
                                    <span class="label">Параметры</span>
                                </div>
                                <div class="params">
                                    <div class="param">
                                        <span class="param__label" id="industry-label">Отрасль</span>
                                        <div class="select">
                                            <button class="select__trigger @(selectedIndustry is null ? "is-empty" : null)" type="button"
                                                    aria-labelledby="industry-label"
                                                    aria-expanded="@(isIndustryOpen ? "true" : "false")"
                                                    @onclick="ToggleIndustry">
                                                <span>@(selectedIndustry ?? "Выберите отрасль")</span>
                                                <Icon Name="chevron-down" Size="14" />
                                            </button>
                                            @if (isIndustryOpen)
                                            {
                                                <div class="select__panel glass" role="listbox" aria-label="Отрасль">
                                                    @foreach (var industry in Industries)
                                                    {
                                                        var isChosen = industry == selectedIndustry;
                                                        <button class="select__option @(isChosen ? "is-chosen" : null)" type="button"
                                                                role="option" aria-selected="@(isChosen ? "true" : "false")"
                                                                @onclick="() => SelectIndustry(industry)">
                                                            <span>@industry</span>
                                                            @if (isChosen)
                                                            {
                                                                <Icon Name="check" Size="14" />
                                                            }
                                                        </button>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <div class="param">
                                        <span class="param__label" id="support-label">Государственная поддержка</span>
                                        <div class="param__control">
                                            <Toggle Value="includeGovernmentSupport"
                                                    ValueChanged="SetGovernmentSupport"
                                                    LabelledBy="support-label"
                                                    Text="@(includeGovernmentSupport ? "учитывать" : "не учитывать")" />
                                        </div>
                                    </div>

                                    <div class="param">
                                        <span class="param__label" id="growth-label">Потенциал роста</span>
                                        <div class="param__control">
                                            <NumberStepper Value="growthPotential"
                                                           ValueChanged="SetGrowthPotential"
                                                           Min="0" Max="100" Editable="true"
                                                           Label="Потенциал роста, от 0 до 100"
                                                           DecrementLabel="Уменьшить потенциал роста"
                                                           IncrementLabel="Увеличить потенциал роста" />
                                            <span class="param__range">0 – 100</span>
                                        </div>
                                    </div>
                                </div>
                            </section>

                            <footer class="form__foot hairline-top">
                                <p class="form__note">@SessionNote</p>
                                <div class="form__actions">
                                    <AppButton Variant="ghost" OnClick="ClearForm">Очистить</AppButton>
                                    <AppButton Variant="primary" Disabled="@(!IsValid)" OnClick="RequestProfile">Создать актив</AppButton>
                                </div>
                            </footer>

                            @if (ShowErrors && !IsValid)
                            {
                                <p class="form__verdict hairline-top">Профиль не построен — исправьте @(ErrorCount == 1 ? "одно поле" : "два поля").</p>
                            }
                        </ChildContent>
                    </Panel>

                    <Panel Title="Что получится" Class="promise rise rise-2">
                        <MetaContent><text>профиль актива</text></MetaContent>
                        <ChildContent>
                            <dl class="promise__list">
                                @foreach (var item in ProfilePromise)
                                {
                                    <div class="promise__row">
                                        <dt>@item.Title</dt>
                                        <dd>@item.Text</dd>
                                    </div>
                                }
                            </dl>
                            <p class="promise__foot hairline-top">Чувствительность и факторы участвуют в расчёте силы влияния новости на «Новостях» и определяют поведение новостного агента на «Торгах».</p>
                        </ChildContent>
                    </Panel>
                </div>
            }
        }
        else
        {
            @* ══════════════ Профиль ══════════════ *@
            <PageHead ContextClass="@(IsFallbackProfile ? "is-warn" : null)">
                <TitleContent>
                    <div class="asset">
                        <h1>@profile.Name</h1>
                        <span class="asset__rule" aria-hidden="true"></span>
                        <span class="asset__ticker">@Symbol</span>
                        <span class="chip">@AssetTypeName(profile.AssetType)</span>
                        @if (!string.IsNullOrWhiteSpace(draftIndustry))
                        {
                            <span class="chip">@draftIndustry</span>
                        }
                        @if (includeGovernmentSupport)
                        {
                            <span class="chip">господдержка учтена</span>
                        }
                        <span class="badge badge--@(IsFallbackProfile ? "warn" : "acc")">@SourceBadge</span>
                    </div>
                </TitleContent>
                <Context>@SourceNote</Context>
                <Actions>
                    <AppButton Variant="secondary" OnClick="SecondaryAction">@SecondaryActionLabel</AppButton>
                    <AppButton Variant="primary" Href="/trading">Перейти к торгам</AppButton>
                </Actions>
            </PageHead>

            @* Полоса связи — одна на экран (раздел 9.19) *@
            <CausalityStrip Class="rise rise-1" Label="Как профиль связан с рынком">
                <CausalityStep Label="Описание" Weight="1.1"
                               Value="@DescriptionExcerpt" Truncate="true"
                               Note="@($"{profile.Description.Length} символов")" />

                <CausalityStep Label="Чувствительность к новостям" Weight="1.9">
                    <ZoneScale Value="profile.NewsSensitivity"
                               Min="SensitivityMin" Max="SensitivityMax"
                               Zones="SensitivityZones"
                               Note="@SensitivityNote"
                               Tone="@(IsFallbackProfile ? "warn" : "acc")" />
                </CausalityStep>

                <CausalityStep Label="Сила влияния новости" Weight="1.15"
                               Value="уверенность × чувствительность актива × совпадение по теме"
                               Note="чувствительность — постоянный множитель" />

                <CausalityStep Label="Реакция рынка" Weight="1.15"
                               Value="@MarketReaction" Note="@MarketReactionNote" />
            </CausalityStrip>

            <div class="layout">
                <div class="profile rise rise-2">

                    <section class="balance">
                        <div class="balance__head">
                            <span class="label">Баланс факторов</span>
                            <span class="balance__meta">из описания собрано <span class="num-sm">@TotalFactors</span> @FactorWord</span>
                        </div>
                        <BalanceBar Positive="profile.PositiveFactors.Count" Negative="profile.NegativeFactors.Count" />
                    </section>

                    <div class="factors">
                        <Panel Title="Позитивные факторы" Class="factors__panel" Flush="true">
                            <MetaContent><span class="num-sm">@profile.PositiveFactors.Count</span></MetaContent>
                            <ChildContent>
                                @if (profile.PositiveFactors.Count > 0)
                                {
                                    <ul class="factor-list">
                                        @foreach (var factor in profile.PositiveFactors)
                                        {
                                            <li class="factor"><span class="factor__dot" aria-hidden="true"></span><span class="factor__text" title="@factor">@factor</span></li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <p class="factors__empty">—</p>
                                }
                            </ChildContent>
                        </Panel>

                        <Panel Title="Негативные факторы" Class="factors__panel" Flush="true">
                            <MetaContent><span class="num-sm">@profile.NegativeFactors.Count</span></MetaContent>
                            <ChildContent>
                                @if (profile.NegativeFactors.Count > 0)
                                {
                                    <ul class="factor-list">
                                        @foreach (var factor in profile.NegativeFactors)
                                        {
                                            <li class="factor"><span class="factor__dot" aria-hidden="true"></span><span class="factor__text" title="@factor">@factor</span></li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <p class="factors__empty">—</p>
                                }
                            </ChildContent>
                        </Panel>
                    </div>

                    <section class="aside-row hairline-top">
                        <div class="aside-row__head">
                            <span class="label">Риски</span>
                            <span class="aside-row__hint">условия, а не факты</span>
                        </div>
                        <div class="aside-row__body">
                            @if (profile.Risks.Count > 0)
                            {
                                @foreach (var risk in profile.Risks)
                                {
                                    <span class="risk">@risk</span>
                                }
                            }
                            else
                            {
                                <span class="risk nodata">—</span>
                            }
                        </div>
                    </section>

                    <section class="aside-row aside-row--center hairline-top">
                        <div class="aside-row__head">
                            <span class="label">Ключевые слова</span>
                            <span class="aside-row__hint">сопоставление новости</span>
                        </div>
                        <div class="aside-row__body aside-row__body--chips">
                            @if (profile.Keywords.Count > 0)
                            {
                                @foreach (var keyword in profile.Keywords)
                                {
                                    <span class="chip">@keyword</span>
                                }
                            }
                            else
                            {
                                <span class="nodata">—</span>
                            }
                        </div>
                    </section>
                </div>

                <Panel Title="Исходное описание" Class="source rise rise-3">
                    <MetaContent><text>то, что вы написали</text></MetaContent>
                    <ChildContent>
                        <p class="source__text">@profile.Description</p>
                        <dl class="source__spec hairline-top">
                            <div class="source__row">
                                <dt>Тип актива</dt>
                                <dd>@AssetTypeName(profile.AssetType)</dd>
                            </div>
                            <div class="source__row">
                                <dt>Отрасль</dt>
                                <dd>@(string.IsNullOrWhiteSpace(draftIndustry) ? "—" : draftIndustry)</dd>
                            </div>
                            <div class="source__row">
                                <dt>Государственная поддержка</dt>
                                <dd>@(includeGovernmentSupport ? "учитывается" : "не учитывается")</dd>
                            </div>
                            <div class="source__row">
                                <dt>Потенциал роста</dt>
                                <dd>
                                    @if (growthPotential is { } value)
                                    {
                                        <span class="num">@value</span>
                                    }
                                    else
                                    {
                                        <span class="nodata">—</span>
                                    }
                                </dd>
                            </div>
                        </dl>
                    </ChildContent>
                </Panel>
            </div>

            <p class="page-foot hairline-top">@SavedNote</p>
        }
    </main>
</div>

@* Подтверждение: создание нового актива прервёт торги (раздел 9.12) *@
@if (isConfirmOpen)
{
    <div class="overlay" @onclick="CloseConfirm">
        <div class="confirm glass" role="dialog" aria-modal="true" aria-labelledby="confirm-title"
             tabindex="-1" @ref="confirmDialog" @onkeydown="HandleConfirmKey" @onclick:stopPropagation="true">
            <h2 id="confirm-title">Создать новый актив?</h2>
            <p class="confirm__text">Актив в сессии один. Текущие торги по «@SessionAsset.Draft.Name» остановятся, агенты снимут открытые заявки. История сделок сохранится.</p>
            <div class="confirm__meta">
                <span>открытых заявок <span class="num-sm">@OpenOrdersCount</span></span>
                <span>агентов <span class="num-sm">@SessionAgentsCount</span></span>
                <span>шаг симуляции <span class="num-sm">@SessionTick</span></span>
            </div>
            <div class="confirm__actions">
                <AppButton Variant="ghost" OnClick="CloseConfirm">Отмена</AppButton>
                <AppButton Variant="primary" OnClick="ConfirmAndGenerate">Создать и остановить торги</AppButton>
            </div>
        </div>
    </div>
}

@code {
    private const int MinDescriptionLength = 120;
    private const int MaxDescriptionLength = 1200;

    // Диапазон подписан на экране и размечен зонами: 0,45 · 0,60 · 0,75 · 0,95.
    private const decimal SensitivityMin = 0.45m;
    private const decimal SensitivityMax = 0.95m;

    private static readonly ZoneScale.Zone[] SensitivityZones =
    [
        new("низкая", 0.60m),
        new("средняя", 0.75m),
        new("высокая", SensitivityMax)
    ];

    private static readonly AssetTypeOption[] AssetTypes =
    [
        new(AssetType.Stock, "Акция", "доля в компании"),
        new(AssetType.Bond, "Облигация", "долговая бумага"),
        new(AssetType.Commodity, "Товар", "сырьё и ресурсы"),
        new(AssetType.Crypto, "Криптовалюта", "цифровой актив")
    ];

    private static readonly string[] Industries =
    [
        "Энергетика",
        "Технологии",
        "Финансы",
        "Промышленность",
        "Транспорт",
        "Розничная торговля"
    ];

    // Что появится в профиле. Текст описывает разделы профиля, а не выдумывает
    // их: каждый пункт отрисовывается ниже из AssetProfile.
    private static readonly PromiseItem[] ProfilePromise =
    [
        new("Позитивные и негативные факторы", "Что в описании работает на цену актива, а что против неё."),
        new("Риски", "Условия, при которых оценка актива изменится."),
        new("Чувствительность к новостям", "Число от 0,45 до 0,95: насколько сильно новости двигают цену этого актива."),
        new("Ключевые слова", "По ним новость сопоставляется с активом."),
        new("Тикер", "Система сгенерирует его из названия — вводить не нужно.")
    ];

    private AssetType selectedAssetType = AssetType.Stock;
    private string assetName = string.Empty;
    private string assetDescription = string.Empty;
    private string? selectedIndustry;
    private bool includeGovernmentSupport;
    private int? growthPotential;

    private bool isIndustryOpen;
    private bool isGenerating;
    private bool isConfirmOpen;
    private bool isConfirmFocused;
    private bool isFormTouched;

    private AssetProfile? profile;
    private string draftIndustry = string.Empty;
    private ElementReference confirmDialog;

    protected override void OnInitialized()
    {
        // Черновик пустой, пока пользователь ничего не вводил: в макете форма
        // пустая, а демо-актив сессии живёт отдельно и подписан в крошках.
        if (ActiveAssetContext.Draft is { } draft)
        {
            selectedAssetType = draft.AssetType;
            assetName = draft.Name;
            assetDescription = draft.Description;
            selectedIndustry = string.IsNullOrWhiteSpace(draft.Industry) ? null : draft.Industry;
            includeGovernmentSupport = draft.IncludeGovernmentSupport;

            // Ноль и «не задан» в черновике неразличимы, а нулевой потенциал
            // роста смысла не имеет — читаем ноль как незаполненное поле.
            growthPotential = draft.GrowthPotential > 0 ? draft.GrowthPotential : null;
            draftIndustry = draft.Industry;
            isFormTouched = true;
        }

        if (ActiveAssetContext.Profile is { } saved)
        {
            profile = saved;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Фокус переводится в диалог один раз на открытие: иначе каждый
        // повторный рендер утаскивал бы фокус с кнопок внутри диалога.
        if (isConfirmOpen && !isConfirmFocused)
        {
            isConfirmFocused = true;
            await confirmDialog.FocusAsync();
        }
    }

    // ── Сессия ──────────────────────────────────────────────────────────────

    private ActiveAssetView SessionAsset => ActiveAssetContext.GetView();

    /// <summary>
    /// Актив в крошках показывается, только когда у него есть имя: стёртое поле
    /// названия оставляло в пути пустой элемент «Активы ›  › Создание актива».
    /// </summary>
    private bool HasSessionAsset => !string.IsNullOrWhiteSpace(SessionAsset.Draft.Name);

    private Crumb[] BuildCrumbs() =>
        HasSessionAsset
            ? [
                new("Активы", Href: "/create-asset"),
                new(SessionAsset.Draft.Name,
                    IsAsset: true,
                    ChipText: SessionAsset.IsFallback ? "Демо-контекст" : null),
                new("Создание актива")
              ]
            : [
                new("Активы", Href: "/create-asset"),
                new("Создание актива")
              ];

    private string Symbol => ActiveAssetDefaults.BuildSymbol(profile?.Name ?? assetName);

    private string SessionNote => SessionAsset.IsFallback
        ? $"Демо-контекст: в сессии пример «{SessionAsset.Draft.Name}» — новый актив заменит его."
        : "Актив в сессии один: новый актив заменит текущий.";

    private int OpenOrdersCount
    {
        get
        {
            var book = SimulationRunner.Current?.OrderBook;
            return book is null
                ? 0
                : book.Bids.Sum(level => level.OrdersCount) + book.Asks.Sum(level => level.OrdersCount);
        }
    }

    private int SessionAgentsCount => SimulationRunner.Current?.Agents.Count ?? 0;

    private int SessionTick => SimulationRunner.Current?.Tick ?? 0;

    // ── Валидация ───────────────────────────────────────────────────────────

    private bool NameValid => !string.IsNullOrWhiteSpace(assetName);
    private bool DescriptionValid => assetDescription.Trim().Length >= MinDescriptionLength;
    private bool IsValid => NameValid && DescriptionValid;

    /// <summary>Ошибки показываются, как только пользователь начал заполнять форму.</summary>
    private bool ShowErrors => isFormTouched;

    private bool NameInvalid => ShowErrors && !NameValid;
    private bool DescriptionInvalid => ShowErrors && !DescriptionValid;
    private int ErrorCount => (NameValid ? 0 : 1) + (DescriptionValid ? 0 : 1);

    // ── Профиль на экране ───────────────────────────────────────────────────

    private bool IsFallbackProfile => profile?.Source == ProfileSource.Fallback;

    private string SourceBadge => IsFallbackProfile ? "Запасной алгоритм" : "Профиль построен AI";

    private string SourceNote => IsFallbackProfile
        ? "Языковая модель была недоступна: профиль собран по ключевым словам описания и отрасли, текст не анализировался."
        : $"Профиль построен по описанию · тикер сгенерирован системой · {(ActiveAssetContext.UpdatedAt ?? DateTimeOffset.Now).ToLocalTime():d MMMM yyyy, HH:mm:ss}";

    /// <summary>
    /// Одно действие — одна формулировка (раздел 17). «Изменить описание» и
    /// «Построить профиль заново» — одна кнопка: в обычном профиле пользователь
    /// правит текст, в запасном — повторяет разбор того же текста.
    /// </summary>
    private string SecondaryActionLabel => IsFallbackProfile ? "Построить профиль заново" : "Изменить описание";

    private Task SecondaryAction() => IsFallbackProfile ? RebuildProfile() : RunEditDescription();

    private string SavedNote => IsFallbackProfile
        ? "Описание можно проанализировать заново, когда модель ответит."
        : "Профиль сохранён. Актив в сессии один — торги пойдут по нему.";

    private int TotalFactors => (profile?.PositiveFactors.Count ?? 0) + (profile?.NegativeFactors.Count ?? 0);

    private string FactorWord => (TotalFactors % 100 is >= 11 and <= 14) switch
    {
        true => "факторов",
        false => (TotalFactors % 10) switch
        {
            1 => "фактор",
            2 or 3 or 4 => "фактора",
            _ => "факторов"
        }
    };

    private string DescriptionExcerpt => profile?.Description ?? string.Empty;

    private string SensitivityZoneName
    {
        get
        {
            var value = profile?.NewsSensitivity ?? SensitivityMin;

            foreach (var zone in SensitivityZones)
            {
                if (value < zone.To)
                {
                    return zone.Name;
                }
            }

            return SensitivityZones[^1].Name;
        }
    }

    private string SensitivityNote => IsFallbackProfile
        ? $"{SensitivityZoneName} · значение по отрасли"
        : SensitivityZoneName;

    private string MarketReaction => SensitivityZoneName switch
    {
        "высокая" => "Новость по теме двигает цену сильнее среднего",
        "средняя" => "Новость по теме двигает цену на среднюю величину",
        _ => "Новость по теме двигает цену слабее среднего"
    };

    private string MarketReactionNote => SensitivityZoneName switch
    {
        "высокая" => "новостной агент на «Торгах» реагирует активнее",
        "средняя" => "новостной агент на «Торгах» реагирует умеренно",
        _ => "новостной агент на «Торгах» реагирует сдержаннее"
    };

    private static string AssetTypeName(AssetType assetType) =>
        AssetTypes.First(option => option.Type == assetType).Name;

    // ── Действия формы ──────────────────────────────────────────────────────

    private void TouchForm()
    {
        isFormTouched = true;
        SyncDraft();
    }

    private void SelectAssetType(AssetType assetType)
    {
        selectedAssetType = assetType;
        isIndustryOpen = false;
        SyncDraft();
    }

    private void ToggleIndustry() => isIndustryOpen = !isIndustryOpen;

    private void SelectIndustry(string industry)
    {
        selectedIndustry = industry;
        isIndustryOpen = false;
        SyncDraft();
    }

    private void SetGrowthPotential(int? value)
    {
        growthPotential = value;
        SyncDraft();
    }

    private void SetGovernmentSupport(bool value)
    {
        includeGovernmentSupport = value;
        SyncDraft();
    }

    private void SetAssetName(string value)
    {
        assetName = value;
        TouchForm();
    }

    private void ClearForm()
    {
        selectedAssetType = AssetType.Stock;
        assetName = string.Empty;
        assetDescription = string.Empty;
        selectedIndustry = null;
        includeGovernmentSupport = false;
        growthPotential = null;
        isIndustryOpen = false;
        isFormTouched = false;
        profile = null;
        draftIndustry = string.Empty;
        ActiveAssetContext.Clear();
    }

    private Task RunEditDescription()
    {
        EditDescription();
        return Task.CompletedTask;
    }

    private void EditDescription()
    {
        profile = null;
        isIndustryOpen = false;
        ActiveAssetContext.SetDraft(BuildDraft());
    }

    private Task RebuildProfile()
    {
        profile = null;
        return GenerateProfileAsync();
    }

    /// <summary>
    /// Актив в сессии один: если торги идут, новый актив их прервёт, и это
    /// подтверждается явно.
    /// </summary>
    private Task RequestProfile()
    {
        if (!IsValid)
        {
            isFormTouched = true;
            return Task.CompletedTask;
        }

        if (SimulationRunner.IsRunning)
        {
            isConfirmOpen = true;
            isConfirmFocused = false;
            return Task.CompletedTask;
        }

        return GenerateProfileAsync();
    }

    private void CloseConfirm()
    {
        isConfirmOpen = false;
        isConfirmFocused = false;
    }

    private Task HandleConfirmKey(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            CloseConfirm();
        }

        return Task.CompletedTask;
    }

    private async Task ConfirmAndGenerate()
    {
        CloseConfirm();
        await SimulationRunner.StopAsync();
        await GenerateProfileAsync();
    }

    /// <summary>
    /// Состояние загрузки остаётся: разбор описания станет асинхронным, и
    /// скелетон по форме будущего профиля работает и сейчас, и тогда.
    /// </summary>
    private async Task GenerateProfileAsync()
    {
        if (isGenerating)
        {
            return;
        }

        isGenerating = true;
        isIndustryOpen = false;
        StateHasChanged();

        // Уступаем поток, чтобы скелетон успел отрисоваться. Когда разбор
        // описания станет асинхронным, здесь будет await настоящего вызова,
        // и состояние загрузки заработает без правок разметки.
        await Task.Yield();

        try
        {
            var draft = BuildDraft();
            var generated = AssetProfileService.CreateProfile(new AssetProfileRequest
            {
                AssetType = draft.AssetType,
                Name = draft.Name,
                Description = draft.Description,
                Industry = draft.Industry,
                IncludeGovernmentSupport = draft.IncludeGovernmentSupport,
                GrowthPotential = growthPotential
            });

            draftIndustry = draft.Industry;
            profile = generated;
            ActiveAssetContext.SetProfile(draft, generated);

            // Лента уведомлений — singleton, IActiveAssetContext — scoped,
            // поэтому подпиской создание актива не поймать: о нём сообщает
            // страница, как «Новости» сообщают ленте о введённой новости.
            NotificationFeed.NoteAssetCreated(
                draft.Name,
                ActiveAssetDefaults.BuildSymbol(draft.Name));
        }
        finally
        {
            isGenerating = false;
        }
    }

    private void SyncDraft()
    {
        if (isGenerating || profile is not null)
        {
            return;
        }

        ActiveAssetContext.SetDraft(BuildDraft());
    }

    private ActiveAssetDraft BuildDraft() =>
        new(
            Name: assetName.Trim(),
            Description: assetDescription.Trim(),
            AssetType: selectedAssetType,
            Industry: selectedIndustry ?? string.Empty,
            IncludeGovernmentSupport: includeGovernmentSupport,
            GrowthPotential: growthPotential ?? 0);

    private sealed record AssetTypeOption(AssetType Type, string Name, string Hint);

    private sealed record PromiseItem(string Title, string Text);
}
