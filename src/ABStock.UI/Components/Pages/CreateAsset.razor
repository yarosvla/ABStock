@page "/create-asset"
@page "/assets/new"
@rendermode InteractiveServer
@using ABStock.AI.Models
@using ABStock.AI.Services
@using ABStock.Shared
@using ABStock.UI.Services
@inject IAssetProfileService AssetProfileService
@inject IAssetRegistry Registry
@inject ISessionMarkets Markets
@inject INotificationFeed NotificationFeed
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>@(editing is null ? "Новый актив" : $"Описание {editing.Symbol}")</PageTitle>

<div class="app-bg" aria-hidden="true"><div class="app-bg__noise"></div></div>

<div class="create-shell">
    <TopNavigation ActivePage="Assets" ShowClock="true" />

    <main class="create-page">
        @* «Новый актив» вложен в «Активы» (DESIGN.md 16.1); правка описания —
           в карточку актива. *@
        <Breadcrumbs Items="@BuildCrumbs()" />

        <PageHead Title="@(editing is null ? "Новый актив" : "Изменить описание")">
            <Context>
                @(editing is null
                    ? "Опишите компанию словами — система соберёт профиль, по которому рынок будет реагировать на новости."
                    : "Профиль соберётся заново по новому описанию. Тикер останется прежним.")
            </Context>
        </PageHead>

            @if (isGenerating)
            {
                @* Загрузка — скелетоны по форме будущего профиля (раздел 9.16).
                   Процентов здесь нет: честно посчитать их нельзя ни сейчас,
                   ни когда разбор описания станет асинхронным. *@
                <div class="loading" aria-live="polite" aria-busy="true">
                    <span class="sr-only">Профиль строится</span>

                    <div class="loading__strip panel">
                        <div class="loading__step"><Skeleton Width="62px" Height="9px" /><Skeleton Width="88%" Height="14px" /></div>
                        <span class="loading__arrow" aria-hidden="true">→</span>
                        <div class="loading__step loading__step--wide"><Skeleton Width="140px" Height="9px" /><Skeleton Width="110px" Height="34px" /><Skeleton Height="14px" /></div>
                        <span class="loading__arrow" aria-hidden="true">→</span>
                        <div class="loading__step"><Skeleton Width="96px" Height="9px" /><Skeleton Width="92%" Height="14px" /></div>
                    </div>

                    <div class="loading__balance">
                        <Skeleton Width="120px" Height="9px" />
                        <Skeleton Height="16px" />
                    </div>

                    <div class="loading__factors">
                        <div class="loading__card panel">
                            <Skeleton Width="150px" Height="14px" />
                            <Skeleton Width="92%" Height="12px" />
                            <Skeleton Width="78%" Height="12px" />
                            <Skeleton Width="85%" Height="12px" />
                            <Skeleton Width="66%" Height="12px" />
                        </div>
                        <div class="loading__card panel">
                            <Skeleton Width="168px" Height="14px" />
                            <Skeleton Width="88%" Height="12px" />
                            <Skeleton Width="72%" Height="12px" />
                            <Skeleton Width="80%" Height="12px" />
                        </div>
                    </div>

                </div>
            }
            else
            {
                <div class="layout">
                    <Panel Class="form rise rise-1" Flush="true">
                        <ChildContent>
                            <section class="field">
                                <div class="field__head">
                                    <span class="field__no">01</span>
                                    <span class="label">Тип актива</span>
                                </div>
                                <div class="types" role="group" aria-label="Тип актива">
                                    @foreach (var type in AssetTypes)
                                    {
                                        var isSelected = type.Type == selectedAssetType;
                                        @* Тип существующего актива не меняется: от него
                                           зависят профиль и стартовая цена, и каталог
                                           такую правку отклоняет. *@
                                        <button class="type @(isSelected ? "is-selected" : null)" type="button"
                                                aria-pressed="@(isSelected ? "true" : "false")"
                                                disabled="@(editing is not null && !isSelected)"
                                                @onclick="() => SelectAssetType(type.Type)">
                                            <strong>@type.Name</strong>
                                            <small>@type.Hint</small>
                                            @* Отметка выбора формой, а не цветом. В графите
                                               скрыта токеном --selected-mark: там выбор
                                               держит подложка акцента. *@
                                            @if (isSelected)
                                            {
                                                <span class="type__check" aria-hidden="true"><Icon Name="check" Size="12" /></span>
                                            }
                                        </button>
                                    }
                                </div>
                            </section>

                            <section class="field">
                                <div class="field__head">
                                    <span class="field__no">02</span>
                                    <label class="label" for="asset-name">Название</label>
                                </div>
                                <TextField Id="asset-name"
                                           Value="@assetName"
                                           ValueChanged="SetAssetName"
                                           MaxLength="120"
                                           Placeholder="Например, Гелиос Энерго"
                                           Invalid="NameInvalid"
                                           InvalidTone="down"
                                           DescribedBy="@(NameInvalid ? "asset-name-error" : null)" />
                                @if (!string.IsNullOrWhiteSpace(assetName))
                                {
                                    @* Тикер система собирает сама; занятый заменяется вторым
                                       вариантом, а не дублем (контракт 2.1). *@
                                    <span class="ticker-preview">
                                        <span class="field__hint">тикер</span>
                                        <Ticker Symbol="@SuggestedSymbol" Large="true" />
                                        <span class="field__hint">@(SuggestedSymbol == AssetSymbols.Build(assetName) ? "свободен" : $"{AssetSymbols.Build(assetName)} занят — выбран другой вариант")</span>
                                    </span>
                                }
                                @if (NameInvalid)
                                {
                                    <span id="asset-name-error" class="field__error">
                                        <Icon Name="alert" Size="14" />
                                        <span>Введите название — из него генерируется тикер</span>
                                    </span>
                                }
                            </section>

                            <section class="field">
                                <div class="field__head field__head--split">
                                    <div class="field__head-main">
                                        <span class="field__no">03</span>
                                        <label class="label" for="asset-description">Описание</label>
                                        <span class="field__hint">главное поле — из него строится профиль</span>
                                    </div>
                                    <span class="field__counter @(DescriptionInvalid ? "is-invalid" : null)">@assetDescription.Length / @MaxDescriptionLength</span>
                                </div>
                                <textarea id="asset-description" class="textarea @(DescriptionInvalid ? "is-invalid" : null)"
                                          maxlength="@MaxDescriptionLength" rows="6"
                                          placeholder="Чем занимается компания, на чём зарабатывает, от чего зависит её выручка. Три-четыре предложения обычным языком."
                                          aria-invalid="@(DescriptionInvalid ? "true" : "false")"
                                          aria-describedby="@(DescriptionInvalid ? "asset-description-error" : null)"
                                          @bind="assetDescription" @bind:event="oninput" @bind:after="TouchForm"></textarea>
                                @if (DescriptionInvalid)
                                {
                                    <span id="asset-description-error" class="field__error">
                                        <Icon Name="alert" Size="14" />
                                        <span>Слишком коротко: нужно не меньше @MinDescriptionLength символов, чтобы собрать факторы</span>
                                    </span>
                                }
                            </section>

                            <section class="field">
                                <div class="field__head">
                                    <span class="field__no">04</span>
                                    <span class="label">Параметры</span>
                                </div>
                                <div class="params">
                                    <div class="param">
                                        <span class="param__label" id="industry-label">Отрасль</span>
                                        <div class="select">
                                            <button class="select__trigger @(selectedIndustry is null ? "is-empty" : null)" type="button"
                                                    aria-labelledby="industry-label"
                                                    aria-expanded="@(isIndustryOpen ? "true" : "false")"
                                                    @onclick="ToggleIndustry">
                                                <span>@(selectedIndustry ?? "Выберите отрасль")</span>
                                                <Icon Name="chevron-down" Size="14" />
                                            </button>
                                            @if (isIndustryOpen)
                                            {
                                                <div class="select__panel glass" role="listbox" aria-label="Отрасль">
                                                    @foreach (var industry in Industries)
                                                    {
                                                        var isChosen = industry == selectedIndustry;
                                                        <button class="select__option @(isChosen ? "is-chosen" : null)" type="button"
                                                                role="option" aria-selected="@(isChosen ? "true" : "false")"
                                                                @onclick="() => SelectIndustry(industry)">
                                                            <span>@industry</span>
                                                            @if (isChosen)
                                                            {
                                                                <Icon Name="check" Size="14" />
                                                            }
                                                        </button>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <div class="param">
                                        <span class="param__label" id="support-label">Государственная поддержка</span>
                                        <div class="param__control">
                                            <Toggle Value="includeGovernmentSupport"
                                                    ValueChanged="SetGovernmentSupport"
                                                    LabelledBy="support-label"
                                                    Text="@(includeGovernmentSupport ? "учитывать" : "не учитывать")" />
                                        </div>
                                    </div>

                                    <div class="param">
                                        <span class="param__label" id="growth-label">Потенциал роста</span>
                                        <div class="param__control">
                                            <NumberStepper Value="growthPotential"
                                                           ValueChanged="SetGrowthPotential"
                                                           Min="0" Max="100" Editable="true"
                                                           Label="Потенциал роста, от 0 до 100"
                                                           DecrementLabel="Уменьшить потенциал роста"
                                                           IncrementLabel="Увеличить потенциал роста" />
                                            <span class="param__range">0 – 100</span>
                                        </div>

                                        @* Дорожка с маркером — раздел 9.2.1: «диапазон — своя
                                           дорожка с маркером», и артборд 05 показывает её под
                                           полем. Дорожка ПОКАЗЫВАЕТ положение, а вводит по-прежнему
                                           поле со степпером: нативный range запрещён тем же
                                           разделом, а свой перетаскиваемый ползунок — это контрол,
                                           которого нет ни в ките, ни в разделе 9.
                                           Пункт 81 docs/ui-backlog.md. *@
                                        <div class="param__track" aria-hidden="true">
                                            <span class="param__track-line"></span>
                                            @if (growthPotential is { } value)
                                            {
                                                <span class="param__track-mark" style="left:@(value)%"></span>
                                            }
                                            <span class="param__track-min num-xs">0</span>
                                            <span class="param__track-max num-xs">100</span>
                                        </div>
                                    </div>
                                </div>
                            </section>

                            <footer class="form__foot hairline-top">
                                <p class="form__note">
                                    @if (Markets.IsRunning && editing is null)
                                    {
                                        <StatusDot Tone="up" />
                                    }
                                    @SessionNote
                                </p>
                                <div class="form__actions">
                                    @if (editing is not null)
                                    {
                                        <AppButton Variant="ghost" Href="@($"/assets/{editing.Symbol}")">Отмена</AppButton>
                                    }
                                    else
                                    {
                                        <AppButton Variant="ghost" OnClick="ClearForm">Очистить</AppButton>
                                    }
                                    <AppButton Variant="primary" Disabled="@(!CanSubmit)" OnClick="GenerateProfileAsync">@(editing is null ? "Создать актив" : "Собрать профиль заново")</AppButton>
                                </div>
                            </footer>

                            @if (ShowErrors && !IsValid)
                            {
                                <p class="form__verdict hairline-top">Актив не создан — исправьте @(ErrorCount == 1 ? "одно поле" : "два поля").</p>
                            }
                        </ChildContent>
                    </Panel>

                    <div class="create-rail">
                        <Panel Title="Что получится" Class="promise rise rise-2">
                            <ChildContent>
                                <dl class="promise__list">
                                    @foreach (var item in ProfilePromise)
                                    {
                                        <div class="promise__row">
                                            <dt>@item.Title</dt>
                                            <dd>@item.Text</dd>
                                        </div>
                                    }
                                </dl>
                                <p class="promise__foot hairline-top">Новость разбирается сразу по всем активам сессии: профиль решает, заденет ли она этот актив и насколько.</p>
                            </ChildContent>
                        </Panel>

                        <Panel Title="Активы сессии" Class="rise rise-3" Flush="true">
                            <MetaContent><span class="num-sm">@Registry.Assets.Count</span> из <span class="num-sm">@IAssetRegistry.Limit</span></MetaContent>
                            <ChildContent>
                                <div class="slots">
                                    @foreach (var asset in Registry.Assets)
                                    {
                                        <span class="slot @(asset.Symbol == editing?.Symbol ? "slot--new" : null)">
                                            <Ticker Symbol="@asset.Symbol" />
                                            <span class="slot__state">@(Markets.IsRunning && Markets.Trades(asset.Id) ? "в торгах" : "до запуска")</span>
                                        </span>
                                    }
                                    @if (editing is null && !Registry.IsFull && !string.IsNullOrWhiteSpace(assetName))
                                    {
                                        <span class="slot slot--new">
                                            <Ticker Symbol="@SuggestedSymbol" />
                                            <span class="slot__state">новый</span>
                                        </span>
                                    }
                                    @for (var i = Registry.Assets.Count + (editing is null && !string.IsNullOrWhiteSpace(assetName) ? 1 : 0); i < IAssetRegistry.Limit; i++)
                                    {
                                        <span class="slot slot--free" aria-hidden="true"></span>
                                    }
                                </div>
                            </ChildContent>
                        </Panel>
                    </div>
                </div>
            }
    </main>
</div>

@code {
    private const int MinDescriptionLength = 120;
    private const int MaxDescriptionLength = 1200;

    // Диапазон и зоны — общие: Services/SensitivityScale. Ту же шкалу
    // размечают «Новости» и «Торги», и разъехавшаяся разметка означала бы,
    // что на одном экране 0,70 «средняя», а на другом «высокая».
    private const decimal SensitivityMin = SensitivityScale.Min;
    private const decimal SensitivityMax = SensitivityScale.Max;

    private static readonly ZoneScale.Zone[] SensitivityZones =
        SensitivityScale.Zones.Select(zone => new ZoneScale.Zone(zone.Name, zone.To)).ToArray();

    private static readonly AssetTypeOption[] AssetTypes =
    [
        new(AssetType.Stock, "Акция", "доля в компании"),
        new(AssetType.Bond, "Облигация", "долговая бумага"),
        new(AssetType.Commodity, "Товар", "сырьё и ресурсы"),
        new(AssetType.Crypto, "Криптовалюта", "цифровой актив")
    ];

    private static readonly string[] Industries =
    [
        "Энергетика",
        "Технологии",
        "Финансы",
        "Промышленность",
        "Транспорт",
        "Розничная торговля"
    ];

    private static readonly PromiseItem[] ProfilePromise =
    [
        new("Профиль", "позитивные и негативные факторы с весом"),
        new("Чувствительность к новостям", "0,45–0,95"),
        new("Стартовая цена", "рассчитает система"),
        new("Тикер", "3–4 латинские буквы, из названия")
    ];

    /// <summary>Тикер из адреса: <c>/assets/new?edit=GLEN</c> — правка описания этого актива.</summary>
    [SupplyParameterFromQuery(Name = "edit")] public string? Edit { get; set; }

    private SessionAsset? editing;

    private AssetType selectedAssetType = AssetType.Stock;
    private string assetName = string.Empty;
    private string assetDescription = string.Empty;
    private string? selectedIndustry;
    private bool includeGovernmentSupport;
    private int? growthPotential;

    private bool isIndustryOpen;
    private bool isGenerating;
    private bool isFormTouched;

    protected override void OnInitialized()
    {
        Registry.Changed += HandleRegistryChanged;
        Markets.Changed += HandleRegistryChanged;
    }

    protected override void OnParametersSet()
    {
        editing = Registry.Find(Edit);

        // Правка — форма заполнена тем, с чем актив создавали. Новый актив —
        // черновиком, если человек уходил со страницы и вернулся.
        var draft = editing is { } asset
            ? new AssetDraft(asset.Name, asset.Description, asset.AssetType, asset.Industry ?? string.Empty,
                asset.IncludeGovernmentSupport, asset.GrowthPotential ?? 0)
            : Registry.Draft;

        if (draft is null)
        {
            return;
        }

        selectedAssetType = draft.AssetType;
        assetName = draft.Name;
        assetDescription = draft.Description;
        selectedIndustry = string.IsNullOrWhiteSpace(draft.Industry) ? null : draft.Industry;
        includeGovernmentSupport = draft.IncludeGovernmentSupport;

        // Ноль и «не задан» неразличимы, а нулевой потенциал роста смысла не
        // имеет — читаем ноль как незаполненное поле.
        growthPotential = draft.GrowthPotential > 0 ? draft.GrowthPotential : null;
        isFormTouched = true;
    }

    private void HandleRegistryChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Registry.Changed -= HandleRegistryChanged;
        Markets.Changed -= HandleRegistryChanged;
    }

    private Crumb[] BuildCrumbs() =>
        editing is { } asset
            ? [new("Активы", Href: "/assets"), new(asset.Name, Href: $"/assets/{asset.Symbol}"), new("Описание")]
            : [new("Активы", Href: "/assets"), new("Новый актив")];

    /// <summary>Тикер, который получит актив: свободный, а не просто собранный из имени.</summary>
    private string SuggestedSymbol =>
        editing?.Symbol ?? Registry.SuggestSymbol(assetName);

    private string SessionNote
    {
        get
        {
            if (editing is not null)
            {
                return "Новый профиль заменит прежний; прошлые прогоны остаются в истории.";
            }

            if (Registry.IsFull)
            {
                return $"В сессии уже {IAssetRegistry.Limit} активов — это предел. Удалите актив, чтобы создать новый.";
            }

            var place = Registry.Assets.Count + 1;
            return Markets.IsRunning
                ? $"Торги идут — актив сразу вступит в торги, агенты получат по {IAgentComposition.InitialPosition:0} шт. Он будет {place}-м из {IAssetRegistry.Limit} возможных в сессии."
                : $"Актив вступит в торги при запуске. Он будет {place}-м из {IAssetRegistry.Limit} возможных в сессии.";
        }
    }

    private bool CanSubmit => IsValid && !isGenerating && (editing is not null || !Registry.IsFull);

    // ── Валидация ───────────────────────────────────────────────────────────

    private bool NameValid => !string.IsNullOrWhiteSpace(assetName);
    private bool DescriptionValid => assetDescription.Trim().Length >= MinDescriptionLength;
    private bool IsValid => NameValid && DescriptionValid;

    /// <summary>Ошибки показываются, как только пользователь начал заполнять форму.</summary>
    private bool ShowErrors => isFormTouched;

    private bool NameInvalid => ShowErrors && !NameValid;
    private bool DescriptionInvalid => ShowErrors && !DescriptionValid;
    private int ErrorCount => (NameValid ? 0 : 1) + (DescriptionValid ? 0 : 1);

    // ── Действия формы ──────────────────────────────────────────────────────

    private void TouchForm()
    {
        isFormTouched = true;
        SyncDraft();
    }

    private void SelectAssetType(AssetType assetType)
    {
        selectedAssetType = assetType;
        isIndustryOpen = false;
        SyncDraft();
    }

    private void ToggleIndustry() => isIndustryOpen = !isIndustryOpen;

    private void SelectIndustry(string industry)
    {
        selectedIndustry = industry;
        isIndustryOpen = false;
        SyncDraft();
    }

    private void SetGrowthPotential(int? value)
    {
        growthPotential = value;
        SyncDraft();
    }

    private void SetGovernmentSupport(bool value)
    {
        includeGovernmentSupport = value;
        SyncDraft();
    }

    private void SetAssetName(string value)
    {
        assetName = value;
        TouchForm();
    }

    private void ClearForm()
    {
        selectedAssetType = AssetType.Stock;
        assetName = string.Empty;
        assetDescription = string.Empty;
        selectedIndustry = null;
        includeGovernmentSupport = false;
        growthPotential = null;
        isIndustryOpen = false;
        isFormTouched = false;
        Registry.SetDraft(null);
    }

    /// <summary>
    /// Генерация профиля моделью идёт десятки секунд — всё это время на
    /// экране скелетон по форме будущего профиля. Готовый профиль уходит в
    /// каталог бэкенда, и человек попадает в карточку актива: там профиль и
    /// живёт (DESIGN.md 16.1.1).
    /// </summary>
    private async Task GenerateProfileAsync()
    {
        if (!IsValid)
        {
            isFormTouched = true;
            return;
        }

        if (!CanSubmit)
        {
            return;
        }

        isGenerating = true;
        isIndustryOpen = false;
        StateHasChanged();

        SessionAsset saved;

        try
        {
            var draft = BuildDraft();
            var generated = await AssetProfileService.CreateProfileAsync(new AssetProfileRequest
            {
                AssetType = draft.AssetType,
                Name = draft.Name,
                Description = draft.Description,
                Industry = draft.Industry,
                IncludeGovernmentSupport = draft.IncludeGovernmentSupport,
                GrowthPotential = growthPotential
            });

            if (editing is { } asset)
            {
                saved = Registry.Update(asset.Symbol, draft, generated);
            }
            else
            {
                // Если торги идут, актив вступает в них сразу (DESIGN.md 16).
                saved = Registry.Add(draft, generated);

                // Уведомление пишет страница: колокольчик — про то, что сделал
                // человек, а не про любое изменение каталога.
                NotificationFeed.NoteAssetCreated(draft.Name, saved.Symbol);
            }
        }
        finally
        {
            isGenerating = false;
        }

        Navigation.NavigateTo($"/assets/{saved.Symbol}");
    }

    /// <summary>Черновик нового актива переживает уход со страницы; правка описания черновика не пишет.</summary>
    private void SyncDraft()
    {
        if (isGenerating || editing is not null)
        {
            return;
        }

        Registry.SetDraft(BuildDraft());
    }

    private AssetDraft BuildDraft() =>
        new(
            Name: assetName.Trim(),
            Description: assetDescription.Trim(),
            AssetType: selectedAssetType,
            Industry: selectedIndustry ?? string.Empty,
            IncludeGovernmentSupport: includeGovernmentSupport,
            GrowthPotential: growthPotential ?? 0);

    private sealed record AssetTypeOption(AssetType Type, string Name, string Hint);

    private sealed record PromiseItem(string Title, string Text);
}
