@page "/agents/{Name}"
@rendermode InteractiveServer
@using ABStock.Application.MarketHistory
@using ABStock.Application.Simulation
@using ABStock.Shared
@using ABStock.UI.Services
@using static ABStock.UI.Services.NumberFormat
@implements IDisposable
@implements IAsyncDisposable
@inject ISimulationRunner SimulationRunner
@inject IAgentStatisticsReader AgentStatisticsReader
@inject IActiveAssetContext ActiveAssetContext
@inject IJSRuntime JS

<PageTitle>Агент · @InstanceName</PageTitle>

<div class="app-bg" aria-hidden="true"><div class="app-bg__noise"></div></div>

<div class="agents-shell">
    <TopNavigation ActivePage="Agents" ShowClock="true" />

    <main class="detail-page agent-@ToneKey">

        <Breadcrumbs Items="@(new Crumb[]
                     {
                         new("Активы", Href: "/create-asset"),
                         new(CurrentAsset.Draft.Name, IsAsset: true),
                         new("Агенты", Href: "/agents"),
                         new(InstanceName)
                     })" />

        @if (!HasSession)
        {
            <PageHead Title="@InstanceName">
                <Context>торги не запущены</Context>
            </PageHead>

            <Panel Class="rise rise-1">
                <ChildContent>
                    <EmptyState IconName="users"
                                Title="Агент ещё не торговал"
                                Description="Сессия не запущена: у агента нет ни сделок, ни позиции, ни результата.">
                        <Action>
                            <AppButton Variant="primary" Href="/trading">Перейти к торгам</AppButton>
                        </Action>
                    </EmptyState>
                </ChildContent>
            </Panel>
        }
        else if (!IsKnownAgent)
        {
            @* Артборд 04: имя из адреса не встретилось в сессии. Состав сессии
               в пояснении отвечает на следующий вопрос — а кто в ней есть.
               Заголовка страницы здесь нет: он повторил бы слово в слово
               заголовок пустого состояния под ним. *@
            <Panel Class="rise rise-1">
                <ChildContent>
                    <EmptyState IconName="search"
                                Title="@($"Агент «{Name}» не найден")"
                                Description="@CompositionSentence">
                        <Action>
                            <AppButton Variant="primary" Href="/agents">Все агенты</AppButton>
                        </Action>
                    </EmptyState>
                </ChildContent>
            </Panel>
        }
        else
        {
            <PageHead>
                <TitleContent>
                    <div class="ident">
                        <h1>@InstanceName</h1>
                        <span class="ident__kind">
                            <StatusDot Tone="@AgentDisplay.GetTypeTone(AgentTypeValue)" />
                            <span>@AgentDisplay.GetStrategyKind(AgentTypeValue)</span>
                        </span>
                        @if (IsIdle)
                        {
                            <span class="ident__state">@IdleStateLabel</span>
                        }
                    </div>
                </TitleContent>
                <Context>
                    @CurrentAsset.Draft.Name · <span class="num-sm">@CurrentAsset.Symbol</span>
                    @if (StartedAtLabel is not null)
                    {
                        <text> · в сессии с <span class="num-sm">@StartedAtLabel</span></text>
                    }
                    <text> · </text>
                    @if (TradeCount > 0)
                    {
                        <span class="tone-up">торгует</span>
                    }
                    else
                    {
                        <text>заявок не выставлял</text>
                    }
                </Context>
                <Actions>
                    <AppButton Variant="secondary" Href="/agents">Все агенты</AppButton>
                    @if (IsIdle && AgentTypeValue == AgentType.NewsDriven)
                    {
                        <AppButton Variant="primary" Href="/news">Добавить новость</AppButton>
                    }
                </Actions>
            </PageHead>

            @* Полоса связи — одна на экран (раздел 9.19). Здесь она проходит
               путь от решения агента до влияния на его результат, и именно она
               делает объяснение проверяемым, а не просто текстом. *@
            <CausalityStrip Class="rise rise-1" Label="От решения агента до его результата">
                <CausalityStep Label="Последнее решение" Weight="1.1" Value="@DecisionLabel" />
                <CausalityStep Label="Объяснение" Weight="1.9" Truncate="true" Value="@ExplanationLabel" />
                <CausalityStep Label="Заявка" Weight="1" Value="@OrderLabel" />
                <CausalityStep Label="Сделка" Weight="1" Value="@LastTradeLabel" />
                <CausalityStep Label="Влияние на результат" Weight="1.1">
                    @* Число здесь то же, что в панели P/L справа: разойтись им
                       нельзя, иначе экран сам себе противоречит (раздел 10.1).
                       Сделок может не быть, а позиция с открытия — быть, и тогда
                       нереализованный P/L у бездействующего агента ненулевой. *@
                    <span class="causality__impact">
                        позиция <span class="num-sm @DeltaTone(CurrentPosition)">@Position0(CurrentPosition)</span>
                        <text> · нереализованный </text>
                        <span class="num-sm @DeltaTone(Unrealized)">@Pnl2(Unrealized)</span>
                    </span>
                </CausalityStep>
            </CausalityStrip>

            <div class="detail-work">

                @* ─── ЛЕВЫЙ РЕЛЬС · хронология сделок агента (раздел 13) ─── *@
                <div class="rail rail--left">
                    <Panel Title="Сделки агента" Class="rise rise-2 trades" Flush="true">
                        <MetaContent>
                            @if (TradeCount > 0)
                            {
                                <text><span class="num-sm">@TradeCount</span> за сессию</text>
                            }
                            else
                            {
                                <span class="num-sm">0</span>
                            }
                        </MetaContent>
                        <ChildContent>
                            @if (TradeCount == 0)
                            {
                                <EmptyState IconName="news"
                                            Title="Сделок нет"
                                            Description="@NoTradesReason">
                                    <Action>
                                        @if (AgentTypeValue == AgentType.NewsDriven)
                                        {
                                            <AppButton Variant="primary" Href="/news">Добавить новость</AppButton>
                                        }
                                    </Action>
                                </EmptyState>
                            }
                            else
                            {
                                <div class="tape">
                                    <div class="tape__head">
                                        <span class="label tape__c-time">Время</span>
                                        <span class="label tape__c-price">Цена</span>
                                        <span class="label tape__c-qty">Кол-во</span>
                                    </div>
                                    <div class="tape__list">
                                        @foreach (var trade in TradeViews)
                                        {
                                            <button type="button"
                                                    class="tape__row @(ActiveTrade == trade.Index ? "is-current" : null)"
                                                    @key="trade.Index"
                                                    @onclick="() => SelectTrade(trade.Index)"
                                                    @onmouseenter="() => HoverTrade(trade.Index)"
                                                    @onmouseleave="() => HoverTrade(null)">
                                                <span class="num-xs tape__c-time">@trade.Time</span>
                                                <span class="num-sm tape__c-price @(trade.IsBuy ? "tone-up" : "tone-down")">
                                                    @(trade.IsBuy ? "↗" : "↘") @Price2(trade.Price)
                                                </span>
                                                <span class="num-sm tape__c-qty">@Quantity1(trade.Quantity)</span>
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </ChildContent>
                    </Panel>
                </div>

                @* ─── ЦЕНТР · главная панель — цена с маркерами сделок ─── *@
                <div class="center">
                    <Panel Class="rise rise-2 price">
                        <Head>
                            <div class="price__id">
                                <h2>@CurrentAsset.Draft.Name</h2>
                                <span class="chip num-sm">@CurrentAsset.Symbol</span>
                                <StatusDot Tone="@AgentDisplay.GetTypeTone(AgentTypeValue)">@MarkersLabel</StatusDot>
                            </div>
                            <Segmented TValue="string"
                                       Label="Таймфрейм"
                                       Items="@TimeframeItems"
                                       Value="@selectedTimeframe"
                                       ValueChanged="SetTimeframe" />
                        </Head>
                        <ChildContent>
                            <div class="price__ohlc">
                                <span><small>откр</small><span class="num-sm">@Price2(OpenPrice)</span></span>
                                <span><small>макс</small><span class="num-sm">@Price2(HighPrice)</span></span>
                                <span><small>мин</small><span class="num-sm">@Price2(LowPrice)</span></span>
                                <span><small>посл</small><span class="num-sm">@Price2(EffectiveLastPrice)</span></span>
                                <span class="num-sm @DeltaTone(PriceChange)">
                                    @(PriceChange > 0m ? "↗" : PriceChange < 0m ? "↘" : "·") @Pnl2(PriceChange) ₽ ·
                                    @Sign(PriceChangePercent)@Percent2(Math.Abs(PriceChangePercent)) %
                                </span>
                            </div>

                            <div class="price__stage" @ref="priceChart" role="img"
                                 aria-label="Цена @CurrentAsset.Draft.Name и сделки агента @InstanceName"></div>

                            @if (TradeCount > 0)
                            {
                                <div class="price__legend hairline-top">
                                    <span class="marker marker--buy" aria-hidden="true"></span><span>покупка</span>
                                    <span class="marker marker--sell" aria-hidden="true"></span><span>продажа</span>
                                    @if (ActiveTrade is not null && ActiveTradeView is { } current)
                                    {
                                        <span class="marker marker--current" aria-hidden="true"></span>
                                        <span class="price__legend-current">
                                            выбранная сделка <span class="num-xs">@current.Time</span>
                                        </span>
                                    }
                                </div>
                            }
                            else
                            {
                                @* Артборд 03: объяснить, почему маркеров нет,
                                   вместо пустой легенды. *@
                                <p class="price__note hairline-top">
                                    Цена идёт на решениях других агентов сессии.
                                    Маркеров этого агента на графике нет.
                                </p>
                            }
                        </ChildContent>
                    </Panel>

                    <Panel Title="Капитал агента" Class="rise rise-3 equity">
                        <MetaContent>
                            @if (TradeCount > 0)
                            {
                                <text>
                                    вход <span class="num-sm">@Money0(InitialPortfolio)</span>
                                    → сейчас <span class="num-sm">@Money0(CurrentPortfolio)</span>
                                </text>
                            }
                            else
                            {
                                <text><span class="num-sm">@Money0(CurrentPortfolio)</span> · без изменения</text>
                            }
                        </MetaContent>
                        <ChildContent>
                            @if (TradeCount > 0)
                            {
                                <div class="equity__stage" @ref="equityChart" role="img"
                                     aria-label="Стоимость портфеля агента @InstanceName во времени"></div>
                            }
                            else
                            {
                                @* Плоская линия на одном уровне занимала бы площадь
                                   наравне с содержательной кривой и ничего бы не
                                   сообщала (раздел 7.2). Это говорится словами. *@
                                <p class="equity__note">Капитал не менялся: сделок не было.</p>
                            }
                        </ChildContent>
                    </Panel>
                </div>

                @* ─── ПРАВЫЙ РЕЛЬС · состояние на сейчас (раздел 13) ─── *@
                <div class="rail rail--right">
                    <Panel Title="P/L" Class="rise rise-2">
                        <MetaContent>от стоимости портфеля на входе</MetaContent>
                        <ChildContent>
                            <div class="kv-row kv-row--lead">
                                <span class="kv__key">Общий</span>
                                <span class="num-lg @DeltaTone(TotalPnl)">@Pnl2(TotalPnl)</span>
                            </div>
                            <div class="kv-group hairline-top">
                                <div class="kv-row">
                                    <span class="kv__key">Реализованный</span>
                                    <span class="num-sm @DeltaTone(Realized)">@Pnl2(Realized)</span>
                                </div>
                                <div class="kv-row">
                                    <span class="kv__key">Нереализованный</span>
                                    <span class="num-sm @DeltaTone(Unrealized)">@Pnl2(Unrealized)</span>
                                </div>
                            </div>
                            @if (TradeCount == 0 && CurrentPosition == 0m)
                            {
                                <p class="panel-note">
                                    Позиции нет и сделок не было — переоценивать нечего.
                                    Это не отсутствие данных.
                                </p>
                            }
                        </ChildContent>
                    </Panel>

                    <Panel Title="Покупки и продажи" Class="rise rise-3">
                        <MetaContent>
                            @if (TradeCount > 0)
                            {
                                <text><span class="num-sm">@TradeCount</span> @Plural(TradeCount, "сделка", "сделки", "сделок")</text>
                            }
                            else
                            {
                                <span class="num-sm">0</span>
                            }
                        </MetaContent>
                        <ChildContent>
                            <div class="split">
                                <div class="split__half">
                                    <span class="label">Покупок</span>
                                    <span class="num-lg">@Buys</span>
                                </div>
                                <div class="split__half">
                                    <span class="label">Продаж</span>
                                    <span class="num-lg">@Sells</span>
                                </div>
                            </div>

                            <div class="hairline-top split__foot">
                                @if (TradeCount > 0)
                                {
                                    @* Полоса баланса — раздел 9.18: половины различаются
                                       светлотой, зелёный и красный заняты движением цены. *@
                                    <div class="balance" role="img"
                                         aria-label="@($"Куплено {Quantity1(BuyQuantity)}, продано {Quantity1(SellQuantity)}")">
                                        <span class="balance__buy" style="@BuyShareStyle"></span>
                                        <span class="balance__sell"></span>
                                    </div>
                                }
                                <div class="split">
                                    <div class="split__half">
                                        <span class="num-sm">@(BuyQuantity > 0m ? Quantity1(BuyQuantity) : "—")</span>
                                        <span class="split__note">куплено</span>
                                    </div>
                                    <div class="split__half split__half--end">
                                        <span class="num-sm">@(SellQuantity > 0m ? Quantity1(SellQuantity) : "—")</span>
                                        <span class="split__note">продано</span>
                                    </div>
                                </div>
                            </div>
                        </ChildContent>
                    </Panel>

                    <Panel Title="Состояние на сейчас" Class="rise rise-4">
                        <MetaContent><span class="num-sm">@UpdatedAtLabel</span></MetaContent>
                        <ChildContent>
                            <div class="kv-group">
                                <div class="kv-row">
                                    <span class="kv__key">Деньги</span>
                                    <span class="num-sm">@Money0(CurrentCash)</span>
                                </div>
                                <div class="kv-row">
                                    <span class="kv__key">Позиция</span>
                                    <span class="num-sm @DeltaTone(CurrentPosition)">@Position0(CurrentPosition)</span>
                                </div>
                                <div class="kv-row">
                                    <span class="kv__key">Стоимость портфеля</span>
                                    <span class="num-sm">@Money0(CurrentPortfolio)</span>
                                </div>
                            </div>
                        </ChildContent>
                    </Panel>
                </div>
            </div>
        }
    </main>
</div>

@code {
    [Parameter] public string Name { get; set; } = "";

    private const int MaxChartPoints = 400;

    private static readonly SegmentedItem<string>[] TimeframeItems =
    [
        new("10s", "10s"), new("30s", "30s"), new("1m", "1m"),
        new("5m", "5m"), new("15m", "15m"), new("1h", "1h")
    ];

    private static readonly Dictionary<string, int> TimeframeSeconds = new()
    {
        ["10s"] = 10,
        ["30s"] = 30,
        ["1m"] = 60,
        ["5m"] = 300,
        ["15m"] = 900,
        ["1h"] = 3600,
    };

    /// <summary>
    /// Стартовый таймфрейм мельче, чем на «Торгах»: здесь важно, где именно
    /// агент входил относительно движения, а на крупной корзине его сделки
    /// схлопываются в одну свечу и связка «сделка ↔ маркер» теряет смысл.
    /// </summary>
    private string selectedTimeframe = "10s";

    private ElementReference equityChart;
    private ElementReference priceChart;
    private IJSObjectReference? chartModule;
    private DotNetObjectReference<AgentDetail>? selfRef;

    private AgentStatisticsReport? report;
    private AgentSnapshot? liveAgent;
    private decimal liveLastPrice;
    private DateTimeOffset lastUpdate = DateTimeOffset.Now;

    private int? selectedTrade;
    private int? hoveredTrade;

    private int renderedTradeCount = -1;
    private int renderedPriceCount = -1;
    private string renderedTimeframe = "";
    private int renderedActiveTrade = -2;

    private int IntervalSeconds => TimeframeSeconds.GetValueOrDefault(selectedTimeframe, 30);

    private ActiveAssetView CurrentAsset => ActiveAssetContext.GetView();

    private IReadOnlyList<AgentSnapshot> SessionAgents => SimulationRunner.Current?.Agents ?? [];

    /// <summary>Прогон есть: идущий — или закончившийся, но со сделками агента.</summary>
    private bool HasSession => SessionAgents.Count > 0 || Trades.Count > 0;

    /// <summary>
    /// Агент существует, если он есть в составе сессии или у него есть сделки.
    /// Ряд цен в отчёте сюда не годится: он принадлежит прогону, а не агенту,
    /// и приходит непустым на любое имя из адреса — с ним несуществующий агент
    /// показывался полной страницей нулей вместо «не найден».
    /// </summary>
    private bool IsKnownAgent => liveAgent is not null || Trades.Count > 0;

    /// <summary>
    /// Человеческое имя экземпляра. Номер считается тем же методом, что и на
    /// списке, — иначе один и тот же агент назывался бы там и здесь по-разному.
    /// </summary>
    private string InstanceName => AgentDisplay.GetInstanceName(SessionAgents, Name);

    private string CompositionSentence
    {
        get
        {
            var parts = SessionAgents
                .GroupBy(agent => agent.Type)
                .OrderBy(group => group.Key)
                .Select(group => $"{AgentDisplay.GetTypeLabel(group.Key)} ×{group.Count()}");

            return $"В сессии {SessionAgents.Count} " +
                   $"{Plural(SessionAgents.Count, "экземпляр", "экземпляра", "экземпляров")}: " +
                   $"{string.Join(", ", parts)}.";
        }
    }

    private void SetTimeframe(string timeframe)
    {
        if (timeframe == selectedTimeframe)
        {
            return;
        }

        selectedTimeframe = timeframe;
        renderedTimeframe = ""; // заставляет перерисовать ряд на следующем рендере
    }

    private AgentType AgentTypeValue => liveAgent?.Type ?? AgentType.MarketMaker;

    /// <summary>Ключ типа для js-модуля: цвет маркеров берётся по нему.</summary>
    private string ToneKey => AgentTypeValue switch
    {
        AgentType.TrendFollowing => "trend",
        AgentType.CounterTrend => "counter",
        AgentType.MarketMaker => "mm",
        _ => "news"
    };

    private int TradeCount => report?.Trades.Count ?? 0;

    /// <summary>Агент в сессии есть, но ещё ничего не сделал.</summary>
    private bool IsIdle => TradeCount == 0;

    private string IdleStateLabel => AgentTypeValue == AgentType.NewsDriven
        ? "ожидает сигнала"
        : "заявок не выставлял";

    private string NoTradesReason => AgentTypeValue == AgentType.NewsDriven
        ? "Агент не выставлял заявок: новость в сессию не поступала, сигнала для решения нет."
        : "Агент ещё не совершал сделок в этой сессии.";

    private string? StartedAtLabel => report?.PriceSeries.Count > 0
        ? report.PriceSeries[0].Time.ToLocalTime().ToString("HH:mm")
        : null;

    private string UpdatedAtLabel => lastUpdate.ToString("HH:mm:ss");

    private string MarkersLabel => TradeCount > 0
        ? $"сделки: {InstanceName}"
        : $"сделок {InstanceName} нет";

    // ── Полоса связи ────────────────────────────────────────────────────────

    private AgentDecision? LastDecision => SimulationRunner.Current?.Decisions
        .LastOrDefault(decision => string.Equals(decision.AgentName, Name, StringComparison.Ordinal));

    private string DecisionLabel
    {
        get
        {
            var decision = LastDecision;
            if (decision is null)
            {
                return "—";
            }

            var order = decision.Orders.FirstOrDefault();
            return decision.Action switch
            {
                TradeAction.Buy when order is not null =>
                    $"покупает {Quantity1(order.Quantity)} по {Price2(order.Price ?? EffectiveLastPrice)}",
                TradeAction.Sell when order is not null =>
                    $"продаёт {Quantity1(order.Quantity)} по {Price2(order.Price ?? EffectiveLastPrice)}",
                TradeAction.Buy => "покупает",
                TradeAction.Sell => "продаёт",
                _ when decision.Orders.Count > 0 => "держит спред",
                _ => "бездействует"
            };
        }
    }

    private string ExplanationLabel =>
        string.IsNullOrWhiteSpace(LastDecision?.Explanation) ? "—" : LastDecision!.Explanation.Trim();

    private string OrderLabel
    {
        get
        {
            var orders = LastDecision?.Orders;
            if (orders is null || orders.Count == 0)
            {
                return "—";
            }

            var order = orders[0];
            var side = order.Side == OrderSide.Buy ? "покупка" : "продажа";
            var price = order.Price is { } value ? Price2(value) : "по рынку";
            var tail = orders.Count > 1 ? $" · всего заявок {orders.Count}" : "";

            return $"{side} {Quantity1(order.Quantity)} по {price}{tail}";
        }
    }

    private string LastTradeLabel
    {
        get
        {
            if (Trades.Count == 0)
            {
                return "—";
            }

            var trade = Trades[^1];
            return $"{trade.ExecutedAt.ToLocalTime():HH:mm:ss} · {Price2(trade.Price)} · {Quantity1(trade.Quantity)}";
        }
    }

    // ── Связка «сделка ↔ маркер» ────────────────────────────────────────────

    /// <summary>
    /// Наведение — предпросмотр, клик — стойкий выбор. Действует то из них,
    /// что сейчас ближе к курсору.
    /// </summary>
    private int? ActiveTrade => hoveredTrade ?? selectedTrade;

    private TradeView? ActiveTradeView =>
        ActiveTrade is { } index && index >= 0 && index < Trades.Count
            ? BuildTradeView(index)
            : null;

    private void SelectTrade(int index)
    {
        selectedTrade = selectedTrade == index ? null : index;
        _ = PushActiveTradeAsync();
    }

    private void HoverTrade(int? index)
    {
        if (hoveredTrade == index)
        {
            return;
        }

        hoveredTrade = index;
        _ = PushActiveTradeAsync();
    }

    /// <summary>Обратная сторона связки: клик по маркеру выбирает строку.</summary>
    [JSInvokable]
    public Task SelectTradeFromChart(int index)
    {
        selectedTrade = index;
        hoveredTrade = null;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task PushActiveTradeAsync()
    {
        if (chartModule is null)
        {
            return;
        }

        try
        {
            renderedActiveTrade = ActiveTrade ?? -1;
            await chartModule.InvokeVoidAsync("setActiveTrade", priceChart, renderedActiveTrade);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    // ── Жизненный цикл ──────────────────────────────────────────────────────

    protected override void OnInitialized()
    {
        SimulationRunner.OnTick += HandleTick;
        SimulationRunner.OnStateChanged += HandleStateChanged;
        LoadData();
    }

    protected override void OnParametersSet()
    {
        // Другой агент в адресе — прежний выбор сделки к нему не относится.
        selectedTrade = null;
        hoveredTrade = null;
        LoadData();
    }

    private void HandleTick(SimulationTickResult tickResult) =>
        _ = InvokeAsync(() =>
        {
            LoadData();
            StateHasChanged();
        });

    private void HandleStateChanged() => _ = InvokeAsync(StateHasChanged);

    private void LoadData()
    {
        var current = SimulationRunner.Current;
        liveAgent = current?.Agents.FirstOrDefault(a => string.Equals(a.Name, Name, StringComparison.Ordinal));
        liveLastPrice = current?.Snapshot.LastPrice ?? 0m;
        report = AgentStatisticsReader.GetReport(SimulationRunner.CurrentRunId, Name);
        lastUpdate = DateTimeOffset.Now;
    }

    // ── Восстановленное состояние агента ────────────────────────────────────
    //    Расчёты перенесены как были: страница меняет оформление, не арифметику.

    private IReadOnlyList<AgentTradeRecord> Trades => report?.Trades ?? [];

    private decimal NetCashFlow => Trades.Sum(t => t.Side == OrderSide.Sell ? t.Price * t.Quantity : -t.Price * t.Quantity);

    private decimal NetPositionFlow => Trades.Sum(t => t.Side == OrderSide.Buy ? t.Quantity : -t.Quantity);

    private decimal CurrentCash => liveAgent?.Cash ?? (InitialCash + NetCashFlow);
    private decimal CurrentPosition => liveAgent?.Position ?? (InitialPosition + NetPositionFlow);
    private decimal CurrentPortfolio => liveAgent?.PortfolioValue ?? (CurrentCash + CurrentPosition * EffectiveLastPrice);

    private decimal EffectiveLastPrice => liveLastPrice > 0m
        ? liveLastPrice
        : (report?.PriceSeries.Count > 0 ? report.PriceSeries[^1].Price : 0m);

    // Стартовое состояние не хранится — восстанавливается из живого снимка и
    // потока сделок.
    private decimal InitialCash => liveAgent is not null ? liveAgent.Cash - NetCashFlow : 0m;
    private decimal InitialPosition => liveAgent is not null ? liveAgent.Position - NetPositionFlow : 0m;

    private decimal InitialPrice => report?.PriceSeries.Count > 0
        ? report.PriceSeries[0].Price
        : (Trades.Count > 0 ? Trades[0].Price : EffectiveLastPrice);

    private decimal InitialPortfolio => InitialCash + InitialPosition * InitialPrice;

    private decimal TotalPnl => CurrentPortfolio - InitialPortfolio;

    private decimal OpenPrice => report?.PriceSeries.Count > 0 ? report.PriceSeries[0].Price : EffectiveLastPrice;
    private decimal HighPrice => report?.PriceSeries.Count > 0 ? report.PriceSeries.Max(p => p.Price) : EffectiveLastPrice;
    private decimal LowPrice => report?.PriceSeries.Count > 0 ? report.PriceSeries.Min(p => p.Price) : EffectiveLastPrice;
    private decimal PriceChange => EffectiveLastPrice - OpenPrice;
    private decimal PriceChangePercent => OpenPrice != 0m ? PriceChange / OpenPrice * 100m : 0m;

    private (decimal Realized, decimal Unrealized) PnlBreakdown
    {
        get
        {
            decimal realized = 0m;
            decimal pos = InitialPosition;
            decimal avg = InitialPrice;

            foreach (var trade in Trades)
            {
                var signed = trade.Side == OrderSide.Buy ? trade.Quantity : -trade.Quantity;

                if (pos == 0m || Math.Sign(pos) == Math.Sign(signed))
                {
                    var totalAbs = Math.Abs(pos) + trade.Quantity;
                    avg = totalAbs == 0m ? trade.Price : (avg * Math.Abs(pos) + trade.Price * trade.Quantity) / totalAbs;
                    pos += signed;
                }
                else
                {
                    var closing = Math.Min(trade.Quantity, Math.Abs(pos));
                    realized += (trade.Price - avg) * closing * Math.Sign(pos);
                    var remaining = trade.Quantity - closing;
                    pos += signed;
                    if (remaining > 0m)
                    {
                        avg = trade.Price;
                    }
                }
            }

            var unrealized = (EffectiveLastPrice - avg) * pos;
            return (realized, unrealized);
        }
    }

    private decimal Realized => PnlBreakdown.Realized;
    private decimal Unrealized => PnlBreakdown.Unrealized;
    private int Buys => Trades.Count(t => t.Side == OrderSide.Buy);
    private int Sells => Trades.Count(t => t.Side == OrderSide.Sell);
    private decimal BuyQuantity => Trades.Where(t => t.Side == OrderSide.Buy).Sum(t => t.Quantity);
    private decimal SellQuantity => Trades.Where(t => t.Side == OrderSide.Sell).Sum(t => t.Quantity);

    private string BuyShareStyle
    {
        get
        {
            var total = BuyQuantity + SellQuantity;
            var share = total > 0m ? BuyQuantity / total * 100m : 50m;
            return $"width:{share.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%";
        }
    }

    /// <summary>Хронология идёт сверху вниз от свежей сделки к старой.</summary>
    private TradeView[] TradeViews => Enumerable
        .Range(0, Trades.Count)
        .Reverse()
        .Select(BuildTradeView)
        .ToArray();

    private TradeView BuildTradeView(int index)
    {
        var trade = Trades[index];
        return new TradeView(
            index,
            trade.ExecutedAt.ToLocalTime().ToString("HH:mm:ss"),
            trade.Side == OrderSide.Buy,
            trade.Price,
            trade.Quantity);
    }

    // ── Ряды для графиков ───────────────────────────────────────────────────

    private List<ChartPoint> BuildEquitySeries()
    {
        var series = report?.PriceSeries;
        if (series is null || series.Count == 0)
        {
            return [];
        }

        var trades = Trades;
        var points = new List<ChartPoint>(series.Count);
        var tradeIndex = 0;
        var cash = InitialCash;
        var position = InitialPosition;

        foreach (var pricePoint in series)
        {
            while (tradeIndex < trades.Count && trades[tradeIndex].ExecutedAt <= pricePoint.Time)
            {
                var trade = trades[tradeIndex];
                var value = trade.Price * trade.Quantity;
                if (trade.Side == OrderSide.Buy)
                {
                    cash -= value;
                    position += trade.Quantity;
                }
                else
                {
                    cash += value;
                    position -= trade.Quantity;
                }

                tradeIndex++;
            }

            var equity = cash + position * pricePoint.Price;
            points.Add(new ChartPoint(pricePoint.Time.ToUnixTimeSeconds(), equity));
        }

        return ChartSeries.Downsample(
            ChartSeries.BucketByInterval(ChartSeries.DedupeBySecond(points), IntervalSeconds),
            MaxChartPoints);
    }

    /// <summary>
    /// Свечи собираются из ряда цен группировкой по интервалу таймфрейма:
    /// открытие — первая цена корзины, закрытие — последняя. Это оформление
    /// уже имеющегося ряда, а не новый расчёт.
    /// </summary>
    private List<Candle> BuildCandles()
    {
        var series = report?.PriceSeries;
        if (series is null || series.Count == 0)
        {
            return [];
        }

        var interval = Math.Max(1, IntervalSeconds);
        var candles = new List<Candle>();

        foreach (var bucket in series.GroupBy(point => point.Time.ToUnixTimeSeconds() / interval))
        {
            var prices = bucket.OrderBy(point => point.Time).Select(point => point.Price).ToArray();

            candles.Add(new Candle(
                bucket.Key * interval,
                prices[0],
                prices.Max(),
                prices.Min(),
                prices[^1]));
        }

        return candles.OrderBy(candle => candle.Time).ToList();
    }

    /// <summary>
    /// Маркер на каждую сделку — один к одному со строками рельса (раздел 10.1).
    /// Время подтягивается к сетке свечей: библиотека рисует маркер на баре, и
    /// маркер вне сетки просто не появился бы.
    /// </summary>
    private List<TradeMarker> BuildMarkers(List<Candle> candles)
    {
        if (candles.Count == 0 || Trades.Count == 0)
        {
            return [];
        }

        var grid = candles.Select(candle => candle.Time).ToArray();
        var markers = new List<TradeMarker>(Trades.Count);

        for (var index = 0; index < Trades.Count; index++)
        {
            var trade = Trades[index];
            var seconds = trade.ExecutedAt.ToUnixTimeSeconds();

            var slot = Array.BinarySearch(grid, seconds);
            if (slot < 0)
            {
                slot = ~slot - 1;
            }

            slot = Math.Clamp(slot, 0, grid.Length - 1);

            markers.Add(new TradeMarker(
                grid[slot],
                index,
                trade.Side == OrderSide.Buy,
                trade.Price,
                trade.Quantity));
        }

        return markers;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!HasSession || !IsKnownAgent)
        {
            return;
        }

        var priceCount = report?.PriceSeries.Count ?? 0;
        var tradeCount = TradeCount;
        var active = ActiveTrade ?? -1;

        if (!firstRender
            && priceCount == renderedPriceCount
            && tradeCount == renderedTradeCount
            && selectedTimeframe == renderedTimeframe
            && active == renderedActiveTrade)
        {
            return;
        }

        renderedPriceCount = priceCount;
        renderedTradeCount = tradeCount;
        renderedTimeframe = selectedTimeframe;
        renderedActiveTrade = active;

        try
        {
            chartModule ??= await JS.InvokeAsync<IJSObjectReference>(
                "import", ResolveModulePath("Components/Pages/AgentDetail.razor.js"));

            selfRef ??= DotNetObjectReference.Create(this);

            var candles = BuildCandles();

            await chartModule.InvokeVoidAsync("renderPrice", priceChart, new
            {
                candles,
                trades = BuildMarkers(candles),
                tone = ToneKey
            }, selfRef);

            await chartModule.InvokeVoidAsync("setActiveTrade", priceChart, active);

            if (tradeCount > 0)
            {
                await chartModule.InvokeVoidAsync("renderEquity", equityChart, BuildEquitySeries(), ToneKey);
            }
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
            // Элемент ещё не в разметке — следующая отрисовка повторит попытку.
            renderedPriceCount = -1;
            renderedTradeCount = -1;
            renderedTimeframe = "";
            renderedActiveTrade = -2;
        }
    }

    private string ResolveModulePath(string asset)
    {
        var path = Assets[asset];

        return path.StartsWith("./", StringComparison.Ordinal)
            || path.StartsWith('/')
            || path.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                ? path
                : $"./{path}";
    }

    public void Dispose()
    {
        SimulationRunner.OnTick -= HandleTick;
        SimulationRunner.OnStateChanged -= HandleStateChanged;
        selfRef?.Dispose();
    }

    public async ValueTask DisposeAsync()
    {
        if (chartModule is null)
        {
            return;
        }

        try
        {
            await chartModule.InvokeVoidAsync("dispose", priceChart);
            await chartModule.InvokeVoidAsync("dispose", equityChart);
            await chartModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private sealed record TradeView(int Index, string Time, bool IsBuy, decimal Price, decimal Quantity);
    private sealed record Candle(long Time, decimal Open, decimal High, decimal Low, decimal Close);
    private sealed record TradeMarker(long Time, int Index, bool IsBuy, decimal Price, decimal Quantity);
}
