@page "/agents/{Name}"
@rendermode InteractiveServer
@using System.Globalization
@using ABStock.Application.MarketHistory
@using ABStock.Shared
@using ABStock.UI.Services
@using static ABStock.UI.Services.NumberFormat
@implements IDisposable
@implements IAsyncDisposable
@inject ISessionMarkets Markets
@inject IAssetRegistry Registry
@inject IAgentStatisticsReader AgentStatistics
@inject IJSRuntime JS

<PageTitle>@(Account is null ? "Агент" : InstanceName)</PageTitle>

@{
    var account = Account;
    var ledger = Ledger;
    var isRunning = Markets.IsRunning;
}

<div class="app-bg" aria-hidden="true"><div class="app-bg__noise"></div></div>

<div class="agents-shell">
    <TopNavigation ActivePage="Agents" ShowClock="true" />

    <main class="detail-page @AgentDisplay.GetTypeTone(account?.AgentType ?? AgentType.MarketMaker)">
        @* Агенты общие, поэтому в пути нет актива: Активы › Агенты › экземпляр (раздел 13). *@
        <Breadcrumbs Items="@(new Crumb[] { new("Активы", Href: "/assets"), new("Агенты", Href: "/agents"), new(account is null ? Name : InstanceName) })">
            <Aside>
                <SessionChip Running="isRunning" Elapsed="@SessionClock.Format(Markets)" />
            </Aside>
        </Breadcrumbs>

        @if (account is null || ledger is null)
        {
            <PageHead Title="Агент" />
            <Panel Class="rise rise-1">
                <EmptyState IconName="users" Title="Такого агента в сессии нет"
                            Description="Агенты живут столько же, сколько сессия: после новой сессии ссылка на прошлого агента ведёт в никуда.">
                    <Action>
                        <AppButton Variant="primary" Href="/agents">Все агенты</AppButton>
                    </Action>
                </EmptyState>
            </Panel>
        }
        else
        {
            var decision = LastTradeDecision;
            var focus = FocusSymbol(decision);
            var focusAsset = ledger.Assets.FirstOrDefault(asset => asset.Symbol == focus);

            <PageHead>
                <TitleContent>
                    <span class="ident">
                        <h1>@InstanceName</h1>
                        <span class="ident__kind"><StatusDot Tone="@AgentDisplay.GetTypeTone(account.AgentType)" />@AgentDisplay.GetStrategyKind(account.AgentType)</span>
                    </span>
                </TitleContent>
                <Context>
                    @(Markets.StartedAt is { } started ? $"В работе с {started:HH:mm}" : "Сессия не запущена") ·
                    торгует <span class="num-sm">@ledger.Assets.Count</span> @Plural(ledger.Assets.Count, "активом", "активами", "активами") из одного кошелька@(decision is null ? null : $" · сейчас {Verb(decision.Value.Decision)} {decision.Value.Symbol}")
                </Context>
                <Actions>
                    <AppButton Variant="secondary" Href="/agents">Все агенты</AppButton>
                </Actions>
            </PageHead>

            @* Цепочка последнего решения. Шаг «Почему GLEN» — у общего агента
               выбор актива и есть главное объяснение (DESIGN.md 16.4). *@
            <CausalityStrip Class="rise rise-1" Label="Последнее решение агента">
                <CausalityStep Label="@(decision is null ? "Решение" : $"Решение · {DecisionTime:HH:mm:ss}")"
                               Value="@(decision is null ? "ждёт" : $"{Verb(decision.Value.Decision)} {decision.Value.Symbol}")"
                               Note="@(decision is null ? "на последнем шаге заявок не ставил" : OrderNote(decision.Value.Decision))" />

                <CausalityStep Label="@($"Почему {focus ?? "этот актив"}")" Weight="2">
                    <span class="trendpick">
                        @foreach (var row in TrendRows)
                        {
                            <span class="trendpick__row @(row.Symbol == focus ? "is-picked" : null)">
                                <Ticker Symbol="@row.Symbol" />
                                <span class="num-sm @DeltaTone(row.Change)">@Sign(row.Change)@Percent2(Math.Abs(row.Change)) %</span>
                            </span>
                        }
                    </span>
                    <span class="ui-causality__note">ход активов с открытия — агент сравнивает их по своей стратегии</span>
                </CausalityStep>

                <CausalityStep Label="Объяснение" Weight="1.4"
                               Value="@(decision?.Decision.Explanation ?? "—")" />

                <CausalityStep Label="Сделка" Weight="0.9">
                    @if (ledger.Trades.FirstOrDefault(trade => trade.Symbol == focus) is { } last)
                    {
                        <span class="num-md t1">@Price2(last.Price) · @Quantity1(last.Quantity)</span>
                        <span class="ui-causality__note">@(last.Side == OrderSide.Buy ? "покупка" : "продажа") в <span class="num-xs">@last.At.ToLocalTime().ToString("HH:mm:ss")</span></span>
                    }
                    else
                    {
                        <span class="ui-causality__value">сделок не было</span>
                    }
                </CausalityStep>

                <CausalityStep Label="@($"Позиция {focus ?? ""}")" Weight="0.9">
                    @if (focusAsset is not null)
                    {
                        <span class="nowrap"><span class="num-lg">@Quantity1(focusAsset.Quantity)</span> <span class="num-xs @DeltaTone(focusAsset.Change)">@Position1(focusAsset.Change)</span></span>
                        <span class="ui-causality__note">за сессию</span>
                    }
                    else
                    {
                        <span class="ui-causality__value">—</span>
                    }
                </CausalityStep>
            </CausalityStrip>

            <div class="detail-work">
                @* ─── Левый рельс — хронология: сделки агента по всем активам ─── *@
                <Panel Title="Сделки агента" Class="rise rise-2" Flush="true">
                    <MetaContent><span class="num-sm">@Count0(ledger.Trades.Count)</span> за сессию</MetaContent>
                    <ChildContent>
                        @if (ledger.Trades.Count == 0)
                        {
                            <p class="panel-note">@NoTradesReason(account.AgentType)</p>
                        }
                        else
                        {
                            <div class="tape__head">
                                <span class="label tape__c-time">Время</span>
                                <span class="label tape__c-sym">Актив</span>
                                <span class="label tape__c-price">Цена</span>
                                <span class="label tape__c-qty">Кол</span>
                            </div>
                            <div class="tape__list is-scrollable">
                                @foreach (var trade in ledger.Trades.Take(MaxTapeRows))
                                {
                                    <div class="tape__row @(trade.Symbol == chartSymbol ? "is-chart" : null)">
                                        <span class="num-xs tape__c-time">@trade.At.ToLocalTime().ToString("HH:mm:ss")</span>
                                        <span class="num-xs tape__c-sym">@trade.Symbol</span>
                                        <span class="num-sm tape__c-price @(trade.Side == OrderSide.Buy ? "tone-up" : "tone-down")">@(trade.Side == OrderSide.Buy ? "↗" : "↘") @Price2(trade.Price)</span>
                                        <span class="num-sm tape__c-qty">@Quantity1(trade.Quantity)</span>
                                    </div>
                                }
                            </div>
                            <div class="tape__foot">
                                <span>↗ покупка · ↘ продажа</span>
                                @if (chartSymbol is not null)
                                {
                                    <span>@chartSymbol выделен</span>
                                }
                            </div>
                        }
                    </ChildContent>
                </Panel>

                @* ─── Центр — график выбранного актива с метками сделок агента ─── *@
                <div class="center">
                    <Panel Class="price rise rise-2" Flush="true">
                        <Head>
                            <span class="price__id">
                                <Segmented TValue="string"
                                           Label="Актив на графике"
                                           Items="@(ledger.Assets.Select(asset => new SegmentedItem<string>(asset.Symbol, asset.Symbol)).ToArray())"
                                           Value="@chartSymbol"
                                           ValueChanged="SelectChartSymbol" />
                                <span class="caption">сделки агента в @chartSymbol: <span class="num-xs">@ChartTrades.Count</span></span>
                            </span>
                            <Segmented TValue="string"
                                       Label="Таймфрейм"
                                       Items="@TimeframeItems"
                                       Value="@selectedTimeframe"
                                       ValueChanged="SetTimeframe" />
                        </Head>
                        <ChildContent>
                            <div class="price__body">
                                <div class="price__stage" @ref="priceChart" role="img"
                                     aria-label="Цена @chartSymbol и сделки агента @InstanceName"></div>
                            </div>
                            <div class="price__legend hairline-top">
                                <span class="marker marker--buy" aria-hidden="true"></span><span>покупка</span>
                                <span class="marker marker--sell" aria-hidden="true"></span><span>продажа</span>
                            </div>
                        </ChildContent>
                    </Panel>

                    <Panel Title="Капитал агента" Class="equity rise rise-3">
                        <MetaContent>
                            вход <span class="num-sm">@Money0(ledger.InitialPortfolio)</span> → сейчас <span class="num-sm t1">@Money0(ledger.Portfolio)</span>
                        </MetaContent>
                        <ChildContent>
                            @if (ledger.Equity.Count > 1)
                            {
                                <div class="equity__stage" @ref="equityChart" role="img"
                                     aria-label="Стоимость портфеля агента @InstanceName во времени"></div>
                            }
                            else
                            {
                                <p class="equity__note">Истории цен ещё нет — кривая появится после первых шагов торгов.</p>
                            }
                        </ChildContent>
                    </Panel>
                </div>

                @* ─── Правый рельс — состояние: P/L по активам и портфель ─── *@
                <div class="rail">
                    <Panel Title="P/L по активам" Class="rise rise-2" Flush="true">
                        <MetaContent>с начала сессии</MetaContent>
                        <ChildContent>
                            <div class="pl">
                                <div class="kv-row kv-row--lead">
                                    <span class="kv__key">Общий</span>
                                    <span class="num-lg @DeltaTone(ledger.Pnl)">@Pnl2(ledger.Pnl)</span>
                                </div>
                                @{ var maxPnl = Math.Max(0.01m, ledger.Assets.Max(asset => Math.Abs(asset.Pnl))); }
                                @foreach (var asset in ledger.Assets)
                                {
                                    <div class="plbar">
                                        <Ticker Symbol="@asset.Symbol" />
                                        <span class="plbar__track">
                                            <span class="plbar__axis"></span>
                                            <span class="plbar__fill plbar__fill--@(asset.Pnl >= 0m ? "up" : "down")" style="@PlBarStyle(asset.Pnl, maxPnl)"></span>
                                        </span>
                                        <span class="num-sm right @DeltaTone(asset.Pnl)">@Pnl2(asset.Pnl)</span>
                                    </div>
                                }
                            </div>
                            <p class="pl__note">P/L актива — стоимость позиции сейчас минус стартовый запас по цене открытия, плюс деньги от сделок этим активом.</p>
                        </ChildContent>
                    </Panel>

                    <Panel Title="Портфель" Class="rise rise-3">
                        <MetaContent><span class="num-xs">@DateTimeOffset.Now.ToString("HH:mm:ss")</span></MetaContent>
                        <ChildContent>
                            <div class="kv-group">
                                <div class="kv-row"><span class="kv__key">Деньги</span><span class="num-sm">@Money0(account.Cash)</span></div>
                                @foreach (var asset in ledger.Assets)
                                {
                                    <div class="kv-row">
                                        <span class="kv__key holding">
                                            <Ticker Symbol="@asset.Symbol" />
                                            <span class="num-xs t2">@Quantity1(asset.Quantity) шт</span>
                                            <span class="num-xs @DeltaTone(asset.Change)">@Position1(asset.Change)</span>
                                        </span>
                                        <span class="num-sm">@Money0(asset.Value)</span>
                                    </div>
                                }
                            </div>
                            <div class="kv-group hairline-top">
                                <div class="kv-row"><span class="kv__key t1">Стоимость портфеля</span><span class="num-sm">@Money0(ledger.Portfolio)</span></div>
                            </div>
                        </ChildContent>
                    </Panel>

                    <Panel Quiet="true" Class="rise rise-4">
                        <div class="split">
                            <span class="split__half"><span class="split__note">покупок</span><span class="num-lg">@ledger.Assets.Sum(asset => asset.Buys)</span></span>
                            <span class="split__half split__half--end"><span class="split__note">продаж</span><span class="num-lg">@ledger.Assets.Sum(asset => asset.Sells)</span></span>
                        </div>
                    </Panel>
                </div>
            </div>
        }
    </main>
</div>

@code {
    /// <summary>Строк в ленте сделок: дальше никто не листает, а рельс не растёт.</summary>
    private const int MaxTapeRows = 200;

    /// <summary>Как часто перечитывается история агента: тики идут раз в секунду, а это запросы к базе.</summary>
    private static readonly TimeSpan ReloadInterval = TimeSpan.FromSeconds(2);

    private static readonly SegmentedItem<string>[] TimeframeItems =
    [
        new("10s", "10s"), new("30s", "30s"), new("1m", "1m"),
        new("5m", "5m"), new("15m", "15m"), new("1h", "1h")
    ];

    private static readonly Dictionary<string, int> TimeframeSeconds = new()
    {
        ["10s"] = 10, ["30s"] = 30, ["1m"] = 60, ["5m"] = 300, ["15m"] = 900, ["1h"] = 3600
    };

    [Parameter] public string Name { get; set; } = string.Empty;

    /// <summary>
    /// Мельче, чем на «Торгах»: здесь важно, где агент входил относительно
    /// движения, а на крупной свече сделки схлопываются в одну.
    /// </summary>
    private string selectedTimeframe = "10s";
    private string? chartSymbol;

    private ElementReference priceChart;
    private ElementReference equityChart;
    private IJSObjectReference? chartModule;
    private DotNetObjectReference<AgentDetail>? selfRef;

    private Dictionary<Guid, AgentStatisticsReport?> reports = [];
    private DateTimeOffset lastReload = DateTimeOffset.MinValue;
    private LedgerView? ledgerCache;
    private string renderedKey = string.Empty;

    private AgentAccountSnapshot? Account =>
        Markets.Accounts.FirstOrDefault(account => string.Equals(account.AgentName, Name, StringComparison.Ordinal));

    /// <summary>«Трендовый 1» — та же нумерация, что на «Агентах».</summary>
    private string InstanceName
    {
        get
        {
            var account = Account;

            if (account is null)
            {
                return Name;
            }

            var index = Markets.Accounts
                .Where(item => item.AgentType == account.AgentType)
                .Select((item, position) => (item.AgentName, position))
                .First(item => item.AgentName == account.AgentName).position;

            return $"{AgentDisplay.GetTypeLabel(account.AgentType)} {index + 1}";
        }
    }

    private IReadOnlyList<LedgerMarket> LedgerMarkets =>
        Markets.Markets
            .Select(market => (Market: market, Asset: Registry.Find(market.AssetId)))
            .Where(item => item.Asset is not null)
            .Select(item => new LedgerMarket(item.Market.AssetId, item.Asset!.Symbol, item.Market.Open,
                item.Market.LastPrice, reports.GetValueOrDefault(item.Market.AssetId)))
            .ToArray();

    private LedgerView? Ledger => ledgerCache;

    private IReadOnlyList<AgentTradeRecord> ChartTrades =>
        ChartMarket?.Report?.Trades ?? [];

    private LedgerMarket? ChartMarket => LedgerMarkets.FirstOrDefault(market => market.Symbol == chartSymbol);

    private sealed record TrendRow(string Symbol, decimal Change);

    /// <summary>Ход активов с открытия, от сильнейшего роста к сильнейшему падению.</summary>
    private IReadOnlyList<TrendRow> TrendRows =>
        Markets.Markets
            .Select(market => new TrendRow(Registry.Find(market.AssetId)?.Symbol ?? "—", market.ChangePercent))
            .OrderByDescending(row => row.Change)
            .ToArray();

    /// <summary>
    /// Последнее решение с заявкой — по всем рынкам. Агент решает по каждому
    /// активу на каждом шаге; объяснимо то решение, после которого он купил
    /// или продал.
    /// </summary>
    private (string Symbol, AgentDecision Decision)? LastTradeDecision
    {
        get
        {
            foreach (var market in Markets.Markets.OrderByDescending(market => market.Last.Tick))
            {
                var decision = market.Last.Decisions.FirstOrDefault(item =>
                    item.AgentName == Name && item.Action is TradeAction.Buy or TradeAction.Sell);

                if (decision is not null && Registry.Find(market.AssetId) is { } asset)
                {
                    return (asset.Symbol, decision);
                }
            }

            return null;
        }
    }

    /// <summary>Время последнего шага: шаг симуляции — ровно секунда от начала сессии.</summary>
    private DateTimeOffset DecisionTime => (Markets.StartedAt ?? DateTimeOffset.Now).AddSeconds(Markets.Tick);

    private string? FocusSymbol((string Symbol, AgentDecision Decision)? decision) =>
        decision?.Symbol ?? ledgerCache?.Trades.FirstOrDefault()?.Symbol ?? chartSymbol;

    private static string Verb(AgentDecision decision) =>
        decision.Action == TradeAction.Buy ? "покупает" : "продаёт";

    private static string OrderNote(AgentDecision decision)
    {
        var order = decision.Orders.FirstOrDefault();
        return order is null
            ? "заявка не выставлена"
            : order.Type == OrderType.Market
                ? $"{Quantity1(order.Quantity)} шт по рынку"
                : $"{Quantity1(order.Quantity)} шт по {Price2(order.Price ?? 0m)}";
    }

    private static string NoTradesReason(AgentType type) => type == AgentType.NewsDriven
        ? "Новостной агент ждёт новость — до неё он не торгует."
        : "Сделок пока не было: заявки агента ещё не встретили встречных.";

    private static string Position1(decimal value) => Sign(value) + Quantity1(Math.Abs(value));

    /// <summary>Полоса P/L растёт от середины: вправо прибыль, влево убыток.</summary>
    private static string PlBarStyle(decimal pnl, decimal max)
    {
        var width = Math.Abs(pnl) / max * 50m;
        var left = pnl >= 0m ? 50m : 50m - width;
        return $"left:{left.ToString("0.#", CultureInfo.InvariantCulture)}%;width:{width.ToString("0.#", CultureInfo.InvariantCulture)}%";
    }

    protected override void OnInitialized()
    {
        Markets.Changed += HandleChanged;
        Reload(force: true);
    }

    protected override void OnParametersSet() => Reload(force: true);

    private void HandleChanged() => _ = InvokeAsync(() =>
    {
        Reload(force: false);
        StateHasChanged();
    });

    /// <summary>История агента по каждому прогону: сделки и ряд цен — не чаще раза в две секунды.</summary>
    private void Reload(bool force)
    {
        var now = DateTimeOffset.Now;

        if (!force && now - lastReload < ReloadInterval && ledgerCache is not null)
        {
            return;
        }

        lastReload = now;
        reports = Markets.Markets.ToDictionary(
            market => market.AssetId,
            market => market.RunId == Guid.Empty ? null : AgentStatistics.GetReport(market.RunId, Name));

        var markets = LedgerMarkets;
        chartSymbol ??= FocusSymbol(LastTradeDecision) ?? markets.FirstOrDefault()?.Symbol;
        ledgerCache = Account is { } account ? AgentLedger.Build(account, markets) : null;
    }

    private void SelectChartSymbol(string symbol) => chartSymbol = symbol;

    private void SetTimeframe(string timeframe) => selectedTimeframe = timeframe;

    [JSInvokable]
    public Task SelectTradeFromChart(int index) => Task.CompletedTask;

    // ── Ряды для графиков ───────────────────────────────────────────────────

    private int IntervalSeconds => TimeframeSeconds.GetValueOrDefault(selectedTimeframe, 10);

    /// <summary>
    /// Свечи выбранного актива из ряда цен его прогона: открытие — первая цена
    /// корзины, закрытие — последняя, объём — разность накопленного объёма.
    /// </summary>
    private List<Candle> BuildCandles()
    {
        var series = ChartMarket?.Report?.PriceSeries;

        if (series is null || series.Count == 0)
        {
            return [];
        }

        var interval = Math.Max(1, IntervalSeconds);
        var candles = new List<Candle>();
        decimal? previousTotalVolume = null;

        foreach (var bucket in series.GroupBy(point => point.Time.ToUnixTimeSeconds() / interval).OrderBy(bucket => bucket.Key))
        {
            var points = bucket.OrderBy(point => point.Time).ToArray();
            var prices = points.Select(point => point.Price).ToArray();
            var openTotal = previousTotalVolume ?? points[0].TotalVolume;
            previousTotalVolume = points[^1].TotalVolume;

            candles.Add(new Candle(bucket.Key * interval, prices[0], prices.Max(), prices.Min(), prices[^1],
                Math.Max(0m, points[^1].TotalVolume - openTotal)));
        }

        return candles;
    }

    /// <summary>
    /// Метки сделок агента в выбранном активе — не больше одной на свечу и
    /// сторону: иначе сотни сделок закрывают свечи решёткой точек.
    /// </summary>
    private List<TradeMarker> BuildMarkers(List<Candle> candles)
    {
        var trades = ChartTrades;

        if (candles.Count == 0 || trades.Count == 0)
        {
            return [];
        }

        var grid = candles.Select(candle => candle.Time).ToArray();
        var chosen = new Dictionary<(long Slot, bool IsBuy), TradeMarker>();

        for (var index = 0; index < trades.Count; index++)
        {
            var trade = trades[index];
            var slot = Array.BinarySearch(grid, trade.ExecutedAt.ToUnixTimeSeconds());

            if (slot < 0)
            {
                slot = ~slot - 1;
            }

            slot = Math.Clamp(slot, 0, grid.Length - 1);
            var isBuy = trade.Side == OrderSide.Buy;
            chosen.TryAdd((grid[slot], isBuy), new TradeMarker(grid[slot], index, isBuy, trade.Price, trade.Quantity));
        }

        return chosen.Values.OrderBy(marker => marker.Time).ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (ledgerCache is null)
        {
            return;
        }

        var key = $"{chartSymbol}|{selectedTimeframe}|{ChartMarket?.Report?.PriceSeries.Count}|{ChartTrades.Count}|{ledgerCache.Equity.Count}";

        if (!firstRender && key == renderedKey)
        {
            return;
        }

        renderedKey = key;

        try
        {
            chartModule ??= await JS.InvokeAsync<IJSObjectReference>(
                "import", ResolveModulePath("Components/Pages/AgentDetail.razor.js"));
            selfRef ??= DotNetObjectReference.Create(this);

            var tone = ToneKey(Account?.AgentType);
            var candles = BuildCandles();

            await chartModule.InvokeVoidAsync("renderPrice", priceChart, new { candles, trades = BuildMarkers(candles), tone }, selfRef);

            if (ledgerCache.Equity.Count > 1)
            {
                var points = ChartSeries.Downsample(
                    ChartSeries.BucketByInterval([.. ledgerCache.Equity], IntervalSeconds), 400);
                await chartModule.InvokeVoidAsync("renderEquity", equityChart, points, tone);
            }
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
            renderedKey = string.Empty;
        }
    }

    private static string ToneKey(AgentType? type) => type switch
    {
        AgentType.TrendFollowing => "trend",
        AgentType.CounterTrend => "counter",
        AgentType.NewsDriven => "news",
        _ => "mm"
    };

    private string ResolveModulePath(string asset)
    {
        var path = Assets[asset];

        return path.StartsWith("./", StringComparison.Ordinal)
            || path.StartsWith('/')
            || path.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                ? path
                : $"./{path}";
    }

    public void Dispose()
    {
        Markets.Changed -= HandleChanged;
        selfRef?.Dispose();
    }

    public async ValueTask DisposeAsync()
    {
        if (chartModule is null)
        {
            return;
        }

        try
        {
            await chartModule.InvokeVoidAsync("dispose", priceChart);
            await chartModule.InvokeVoidAsync("dispose", equityChart);
            await chartModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private sealed record Candle(long Time, decimal Open, decimal High, decimal Low, decimal Close, decimal Volume);

    private sealed record TradeMarker(long Time, int Index, bool IsBuy, decimal Price, decimal Quantity);
}
