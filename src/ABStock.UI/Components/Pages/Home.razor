@page "/"
@using ABStock.UI.Services
@inject IAssetRegistry Registry
@inject ISessionMarkets Markets

@* Приветственная страница — титульный экран, не лендинг. Три вещи: знак,
   одно предложение, одно действие.

   Визуальный объект экрана — знак (раздел 7.2): у титульной страницы нет ни
   данных, ни настроек, и форму здесь несёт он. Бегущая строка котировок,
   поддельный график или анимированный фон запрещены разделами 2 и 10. Ни
   одного числа на этой странице нет — даже «3 актива»: актив называется
   тикером.

   Навигации приложения здесь нет: шапка с пунктами появляется после входа.

   Режим отрисовки статический, @rendermode не задан намеренно: две ссылки и
   ни одного обработчика, а статическая отрисовка даёт мгновенную первую
   отрисовку на самом первом экране продукта. *@

<PageTitle>ABStock</PageTitle>

<div class="app-bg" aria-hidden="true"><div class="app-bg__noise"></div></div>

@{
    // Значения снимаются один раз: рынки живут своим циклом шагов, и сессия
    // может остановиться между двумя чтениями.
    var isRunning = Markets.IsRunning;
    var assets = Registry.Assets;

    // Идут торги — вернуться к ним, с тикерами того, что торгуется.
    // Активы есть, торгов нет — следующий шаг на «Активах»: там состав и
    // запуск. Активов нет — создать первый.
    var tickers = isRunning
        ? assets.Where(asset => Markets.Trades(asset.Id)).Select(asset => asset.Symbol)
        : assets.Select(asset => asset.Symbol);
    var suffix = string.Join(", ", tickers);
}

<main class="welcome">
    <div class="welcome__group">
        <span class="welcome__mark rise"><BrandMark /></span>

        @* Слово «ABStock» на странице ровно один раз. *@
        <h1 class="welcome__name rise rise-1">ABStock</h1>

        <p class="welcome__lead rise rise-2">Вы создаёте активы, агенты торгуют ими каждый по своей стратегии, а вы вводите новости и видите, как их решения складываются в цены.</p>

        <div class="welcome__actions rise rise-3">
            @if (assets.Count > 0)
            {
                @* Слово меняется по состоянию: «вернуться» к идущей сессии и
                   «перейти» к ещё не начатой — разные действия. @if стоит с
                   новой строки: приписанный вплотную к слову, он попал бы под
                   правило Razor про адреса почты. *@
                <AppButton Variant="primary" Size="40" Href="@(isRunning ? "/trading" : "/assets")">
                    @(isRunning ? "Вернуться к торгам" : "Перейти к активам")
                    @if (suffix.Length > 0)
                    {
                        <span class="welcome__asset">·&#160;@suffix</span>
                    }
                </AppButton>

                @if (!Registry.IsFull)
                {
                    <AppButton Variant="ghost" Size="32" Href="/assets/new">Создать актив</AppButton>
                }
            }
            else
            {
                @* Кнопка называет действие, а не «Начать» — раздел 17. *@
                <AppButton Variant="primary" Size="40" Href="/assets/new">Создать актив</AppButton>
            }
        </div>
    </div>
</main>
