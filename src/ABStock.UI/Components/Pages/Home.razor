@page "/"
@using ABStock.Application.Simulation
@using ABStock.UI.Services
@inject ISimulationRunner SimulationRunner
@inject IActiveAssetContext ActiveAsset

@* Приветственная страница — титульный экран, не лендинг. Три вещи: знак,
   одно предложение, одно действие.

   Визуальный объект экрана — знак (раздел 7.2): у титульной страницы нет ни
   данных, ни настроек, и форму здесь несёт он. Дорисовывать бегущую строку
   котировок, поддельный график или анимированный фон запрещено разделами 2
   и 10: выдуманные числа на первом же экране обесценивают настоящие на всех
   следующих. Ни одного числа на этой странице нет.

   Навигации приложения здесь нет: шапка с пунктами появляется после входа.

   Режим отрисовки статический, @rendermode не задан намеренно (не «забыт»).
   Интерактивности здесь не требуется — две ссылки и ни одного обработчика, —
   а статическая отрисовка даёт мгновенную первую отрисовку на самом первом
   экране продукта. *@

<PageTitle>ABStock</PageTitle>

<div class="app-bg" aria-hidden="true"><div class="app-bg__noise"></div></div>

@{
    // Все значения снимаются ОДИН раз. IsRunning и CurrentAssetName — два
    // чтения синглтона, который живёт своим циклом тиков, и сессия может
    // остановиться между ними. Состояние страницы определяет isRunning;
    // имя — только суффикс на кнопке, и его отсутствие при isRunning = true
    // нормально.
    var isRunning = SimulationRunner.IsRunning;

    // Актив есть — значит человек уже прошёл создание, и следующий его шаг
    // по разделу 16 — «Торги», а не создание заново. Без этой ветки экраны
    // «актива нет», «актив создан» и «торги остановлены» были попиксельно
    // одинаковыми, и тому, у кого сессия только что закончилась, предлагалось
    // единственное действие — создать актив ещё раз (раздел 14).
    var createdAssetName = ActiveAsset.Draft?.Name;

    var assetName = isRunning
        ? SessionAssetName(SimulationRunner.CurrentAssetName)
        : createdAssetName;

    var hasAsset = isRunning || createdAssetName is not null;
}

<main class="welcome">
    <div class="welcome__group">
        <span class="welcome__mark rise"><BrandMark /></span>

        @* Слово «ABStock» на странице ровно один раз. *@
        <h1 class="welcome__name rise rise-1">ABStock</h1>

        <p class="welcome__lead rise rise-2">Вы создаёте актив, агенты торгуют им каждый по своей стратегии, а вы вводите новости и видите, как их решения складываются в цену.</p>

        <div class="welcome__actions rise rise-3">
            @if (hasAsset)
            {
                @* Актив уже есть — первично «Торги», а создание уходит вниз
                   текстовой ссылкой. Слово меняется по состоянию: «вернуться»
                   к идущей сессии и «перейти» к ещё не начатой — это разные
                   действия, и называть их одинаково значило бы соврать про
                   то, что происходит за экраном. *@
                @* @if стоит с новой строки не для красоты: приписанный
                   вплотную к слову, «торгам@if» попадает под правило Razor
                   про адреса почты и выводится текстом как есть. *@
                <AppButton Variant="primary" Size="40" Href="/trading">
                    @(isRunning ? "Вернуться к торгам" : "Перейти к торгам")
                    @if (assetName is not null)
                    {
                        <span class="welcome__asset">·&#160;@assetName</span>
                    }
                </AppButton>

                @* «Другой»: актив в сессии один, и новый заменит текущий —
                   так это и подписано на «Создании актива». *@
                <AppButton Variant="ghost" Size="32" Href="/create-asset">Создать другой актив</AppButton>
            }
            else
            {
                @* Кнопка называет действие, а не «Начать» — раздел 17. *@
                <AppButton Variant="primary" Size="40" Href="/create-asset">Создать актив</AppButton>
            }
        </div>
    </div>
</main>

@code {
    /// <summary>
    /// Название актива для подписи кнопки — или <see langword="null"/>, если
    /// показывать нечего.
    /// </summary>
    /// <remarks>
    /// Торги можно запустить, не создав актив: «Торги» берут актив через
    /// <c>IActiveAssetContext.GetView()</c>, а тот подставляет
    /// демонстрационную заглушку, когда настоящего актива нет, — и её имя
    /// уезжает в конфигурацию прогона. На титульном экране такое имя было бы
    /// поддельным, поэтому заглушка отсекается по имени: сверять больше не с
    /// чем, признак «это демо» до раннера не доходит и доходить не должен.
    /// Совпадение настоящего названия с демонстрационным просто снимет
    /// суффикс — это безопасный отказ, в отличие от обратного.
    /// </remarks>
    private static string? SessionAssetName(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return null;
        }

        return string.Equals(name, ActiveAssetDefaults.DemoDraft.Name, StringComparison.Ordinal)
            ? null
            : name;
    }
}
