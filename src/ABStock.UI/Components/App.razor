<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["design-system.css"]" />
    @* Белая тема (раздел 19) — только переопределение значений под
       :root[data-theme="light"]. После design-system.css, чтобы при равной
       специфичности всё равно выигрывала белая. *@
    <link rel="stylesheet" href="@Assets["design-system-light.css"]" />
    <link rel="stylesheet" href="@Assets["ABStock.UI.styles.css"]" />
    <ImportMap />
    @* Иконка вкладки — раздел 9.22: знак на графитовой подложке, а не знак
       сам по себе. Панель вкладок бывает светлой, и светлый знак на
       прозрачном фоне на ней исчезает. Переменные в favicon не работают,
       поэтому литералы, но взятые из токенов: подложка --gph-900,
       знак --text-1. *@
    <link rel="icon" type="image/svg+xml" href="@Assets["favicon.svg"]" />
    <HeadOutlet />

    @* Акцент интерфейса — раздел 3.1. Скрипт стоит в конце <head> и
       выполняется ДО первой отрисовки: примени мы акцент из Blazor, человек
       увидел бы вспышку графита и только потом выбранный цвет.

       Инлайн, а не модуль: модуль откладывается до разбора документа, то
       есть ровно до того момента, которого мы избегаем.

       Всё обёрнуто в try/catch: в приватном режиме и при запрете на данные
       сайта само обращение к localStorage бросает исключение, и страница не
       должна из-за настройки не открыться. Значение сверяется со списком —
       испорченное или чужое молча игнорируется, остаётся графит. *@
    <script>
        (function () {
            var KEYS = {
                theme: 'abstock.theme',
                accent: 'abstock.accent',
                timeframe: 'abstock.timeframe',
                notifyTrades: 'abstock.notify.trades',
                notifyNews: 'abstock.notify.news',
                notifySystem: 'abstock.notify.system'
            };
            var ACCENTS = ['graphite', 'steel', 'ultramarine', 'azure', 'turquoise',
                           'lavender', 'amethyst', 'orchid', 'brass', 'copper'];
            var THEMES = ['dark', 'light'];

            function read(key) {
                try { return window.localStorage.getItem(key); } catch (e) { return null; }
            }

            // Что ДОЛЖНО стоять на <html>. Атрибут — отражение этого
            // состояния, а не его источник: см. наблюдатель ниже.
            var wanted = { theme: null, accent: null };

            function sync(name, value) {
                var root = document.documentElement;
                if (value) {
                    if (root.dataset[name] !== value) { root.dataset[name] = value; }
                } else if (name in root.dataset) {
                    delete root.dataset[name];
                }
            }

            function applyAccent(value) {
                // Графит — это отсутствие атрибута: :root уже содержит его
                // значения, и лишний атрибут только даёт второй источник истины.
                wanted.accent = value && value !== 'graphite' && ACCENTS.indexOf(value) >= 0 ? value : null;
                sync('accent', wanted.accent);
            }

            // Тема — раздел 19. Тот же приём, что у акцента: тёмная — это
            // отсутствие атрибута, белая — data-theme="light" на <html>.
            // Графики рисуют на холсте и CSS не видят, поэтому смену темы
            // объявляем событием: скрипты графиков перечитывают токены и
            // перекрашиваются без перезагрузки. При загрузке события нет —
            // графиков ещё не существует, и они сразу прочтут нужную тему.
            function applyTheme(value) {
                wanted.theme = value && value !== 'dark' && THEMES.indexOf(value) >= 0 ? value : null;
                sync('theme', wanted.theme);
            }

            applyTheme(read(KEYS.theme));
            applyAccent(read(KEYS.accent));

            // Переход между разделами — улучшенная навигация Blazor: документ
            // не перезагружается, а сверяется с ответом сервера, и атрибуты
            // <html> приводятся к серверным. Сервер темы и акцента не знает
            // (они в localStorage), поэтому data-theme и data-accent снимались,
            // а этот скрипт повторно не выполняется — тема сбрасывалась в
            // тёмную на каждом переходе. Наблюдатель возвращает атрибуты сразу:
            // его колбэк — микрозадача, она выполняется до отрисовки, и
            // вспышки графита нет.
            new MutationObserver(function () {
                sync('theme', wanted.theme);
                sync('accent', wanted.accent);
            }).observe(document.documentElement, {
                attributes: true,
                attributeFilter: ['data-theme', 'data-accent']
            });

            window.abstockPrefs = {
                get: function (key) { return read(key); },
                set: function (key, value) {
                    try { window.localStorage.setItem(key, value); } catch (e) { /* режим без хранилища */ }
                },
                setAccent: function (value) {
                    applyAccent(value);
                    window.abstockPrefs.set(KEYS.accent, value);
                },
                setTheme: function (value) {
                    applyTheme(value);
                    window.abstockPrefs.set(KEYS.theme, value);
                    window.dispatchEvent(new CustomEvent('abstock:themechange'));
                }
            };
        })();
    </script>
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
