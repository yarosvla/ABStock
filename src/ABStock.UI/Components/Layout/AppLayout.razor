@inherits LayoutComponentBase
@using ABStock.UI.Services
@inject IUserPreferences Preferences

@Body

@code {
    // Настройки читаются один раз на контур и именно отсюда: до первой
    // отрисовки JS-интеропа в Blazor Server не существует, а макет —
    // единственное место, общее для всех разделов.
    //
    // Акцент к этому моменту уже применён загрузочным скриптом App.razor,
    // так что вспышки графита здесь быть не может: чтение нужно страницам,
    // а не документу.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Preferences.EnsureLoadedAsync();
        }
    }
}
