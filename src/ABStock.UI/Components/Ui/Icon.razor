@* Штриховой набор в стиле Lucide: обводка 1.5, stroke=currentColor, без заливки.
   Один набор на весь интерфейс — раздел 9.17.

   Пути рисуются @foreach-ом в разметке, а не RenderTreeBuilder-ом со счётчиком:
   Blazor требует, чтобы номера последовательности были константами времени
   компиляции. Счётчик давал разные номера для разных иконок, диффер путал
   узлы и привязывал обработчики событий не к тем элементам. *@

<svg class="ui-icon" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none"
     stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="true" focusable="false">
    @foreach (var path in GetPaths(Name))
    {
        <path d="@path" />
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 16;

    private static string[] GetPaths(string name) => name switch
    {
        "bell" => ["M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9", "M13.7 21a2 2 0 0 1-3.4 0"],
        "check" => ["m5 13 4 4 10-10"],
        "chevron-down" => ["m6 9 6 6 6-6"],
        "chevron-right" => ["m9 6 6 6-6 6"],
        "plus" => ["M12 5v14M5 12h14"],
        "minus" => ["M5 12h14"],
        // Карандаш — правка имени оператора на «Профиле» (артборд 01).
        "pencil" => ["M4 20h4L18.5 9.5a2.1 2.1 0 0 0-3-3L5 17v3Z", "m13.5 6.5 4 4"],
        "alert" => ["M12 3 2 20h20L12 3Z", "M12 9v5M12 17.5v.5"],
        "book" => ["M4 5v14a2 2 0 0 0 2 2h14V7H6a2 2 0 0 1-2-2Z", "M20 3H6", "M9 11h8M9 15h5"],
        "play" => ["M6 4l14 8-14 8V4Z"],
        "square" => ["M6 6h12v12H6z"],
        "news" => ["M4 5h13v14H5a1 1 0 0 1-1-1V5Z", "M17 9h3v8a2 2 0 0 1-2 2", "M7 9h7M7 13h7M7 16h4"],
        "users" =>
        [
            "M16 20v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2",
            "M9 10a3 3 0 1 0 0-6 3 3 0 0 0 0 6",
            "M22 20v-2a4 4 0 0 0-3-3.87",
            "M16 4.13A4 4 0 0 1 16 11.6"
        ],
        "activity" => ["M22 12h-4l-3 9L9 3l-3 9H2"],
        "search" => ["M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14", "m16.2 16.2 4.3 4.3"],
        _ => ["M12 8v5M12 16.5v.5", "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18"]
    };
}
