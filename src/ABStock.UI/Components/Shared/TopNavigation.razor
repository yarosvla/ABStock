@using ABStock.Application.Simulation
@using ABStock.UI.Services
@implements IDisposable
@inject ISimulationRunner SimulationRunner
@inject IUserPreferences Preferences
@inject INotificationFeed NotificationFeed
@inject IAgentEquityHistory EquityHistory

@* Оболочка приложения — раздел 13. Шапка 56px, стекло (под ней реально
   проезжает контент), нижняя кромка --line-1. Активный раздел — --text-1
   плюс светлая линия 2px снизу. *@

<nav class="topnav glass glass--nav" aria-label="Основная навигация">
    <div class="topnav__left">
        @* Знак слева от слова — раздел 9.22. Цвет знака наследуется от ссылки
           (--text-1) и на смену акцента не отзывается. *@
        <a class="topnav__brand" href="/">
            <BrandMark />
            <span>ABStock</span>
        </a>

        <div class="topnav__links">
            @foreach (var item in Sections)
            {
                var isActive = item.Key == ActivePage;
                <a class="topnav__link @(isActive ? "is-active" : null)"
                   href="@item.Href"
                   aria-current="@(isActive ? "page" : null)">
                    @item.Title
                    @if (isActive)
                    {
                        <span class="topnav__underline" aria-hidden="true"></span>
                    }
                </a>
            }
        </div>
    </div>

    <div class="topnav__right">
        <StatusDot Tone="@(IsTradingActive ? "up" : "muted")" Live="IsTradingActive">@MarketStatusLabel</StatusDot>

        @if (ShowClock)
        {
            <span class="topnav__clock num-sm">@Clock</span>
        }

        <div class="topnav__bell">
            <button class="topnav__icon-button" type="button"
                    aria-label="@NotificationSummaryText"
                    aria-expanded="@(IsNotificationsOpen ? "true" : "false")"
                    @onclick="ToggleNotifications">
                <Icon Name="bell" Size="16" />
                @if (UnreadNotificationsCount > 0)
                {
                    <span class="topnav__unread" aria-hidden="true"></span>
                }
            </button>
        </div>

        <a class="topnav__avatar" href="/profile" aria-label="Профиль пользователя">
            <span>@AvatarInitials</span>
        </a>
    </div>
</nav>

@if (IsNotificationsOpen)
{
    <div class="notif-layer" @onclick="CloseNotifications">
        <div class="notif glass" role="dialog" aria-label="Уведомления" @onclick:stopPropagation="true">
            <div class="notif__head">
                <div>
                    <h3>Уведомления</h3>
                    <span class="notif__summary">@NotificationSummaryText</span>
                </div>
                <AppButton Variant="ghost" Size="26" OnClick="ClearNotifications">Очистить</AppButton>
            </div>

            @* Строка — раздел 9.14 и 2: без иконки, время моноширинное, вид
               события различается подписью, а не цветной плашкой. *@
            <div class="notif__list">
                @if (Visible.Count > 0)
                {
                    @foreach (var notification in Visible)
                    {
                        <div class="notif__item @(notification.IsRead ? null : "is-unread")">
                            <span class="notif__dot" aria-hidden="true"></span>
                            <div class="notif__body">
                                <span class="notif__kind label">@KindLabel(notification.Kind)</span>
                                <strong>@notification.Title</strong>
                                <p>@notification.Detail</p>
                            </div>
                            <time class="notif__time num-xs" datetime="@notification.At.ToString("O")">@notification.At.ToString("HH:mm:ss")</time>
                        </div>
                    }
                }
                else if (HasHiddenByFilter)
                {
                    @* Честная причина пустоты: события есть, но их вид выключен
                       на «Профиле». Пустое состояние «уведомлений нет» здесь
                       было бы неправдой. *@
                    <EmptyState IconName="bell" Title="Все виды событий выключены"
                                Description="Включить их можно в настройках интерфейса.">
                        <Action>
                            <AppButton Variant="secondary" Size="26" Href="/profile">Открыть «Профиль»</AppButton>
                        </Action>
                    </EmptyState>
                }
                else
                {
                    <EmptyState IconName="bell" Title="Событий пока нет"
                                Description="Запустите торги — здесь появится хронология сессии." />
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string ActivePage { get; set; } = "CreateAsset";
    [Parameter] public bool ShowClock { get; set; } = false;

    /// <summary>
    /// Инициалы считаются из имени оператора, а не задаются параметром.
    /// Пока здесь стояла константа «АК», шапка и «Профиль» показывали разных
    /// людей на одном экране.
    /// </summary>
    private string AvatarInitials => UserPreferences.GetInitials(Preferences.OperatorName);

    // Ровно пять разделов — раздел 16.
    private static readonly NavSection[] Sections =
    [
        new("CreateAsset", "/create-asset", "Создание актива"),
        new("Trading", "/trading", "Торги"),
        new("News", "/news", "Новости"),
        new("Agents", "/agents", "Агенты"),
        new("Profile", "/profile", "Профиль")
    ];

    private bool IsNotificationsOpen { get; set; }
    private bool IsTradingActive => SimulationRunner.IsRunning;

    /// <summary>
    /// Три состояния, а не два. До первого запуска торги не «остановлены» —
    /// их не было, и утверждать обратное значит говорить о прошлом, которого
    /// не случилось (пункт 95 docs/ui-backlog.md). Артборды «Создания актива»
    /// показывают здесь «Торги не запущены», и подзаголовок «Агентов» уже
    /// различает эти два случая — не различала только шапка.
    ///
    /// Признак «прогон был» — идентификатор в истории: она заполняется первым
    /// же тиком и переживает остановку, в отличие от CurrentRunId раннера.
    /// </summary>
    private string MarketStatusLabel => IsTradingActive
        ? "Торги активны"
        : EquityHistory.RunId == Guid.Empty
            ? "Торги не запущены"
            : "Торги остановлены";
    private string Clock => DateTimeOffset.Now.ToString("HH:mm:ss");

    /// <summary>
    /// Фильтрация происходит ЗДЕСЬ, при отображении, а не при записи в ленту:
    /// выключенный на «Профиле» вид перестаёт показываться, но события не
    /// теряются, и включение обратно возвращает их.
    /// </summary>
    private IReadOnlyList<NotificationEntry> Visible =>
        NotificationFeed.Entries.Where(entry => IsKindEnabled(entry.Kind)).ToArray();

    /// <summary>События в ленте есть, но все их виды выключены.</summary>
    private bool HasHiddenByFilter => NotificationFeed.Entries.Count > 0;

    private bool IsKindEnabled(NotificationKind kind) => kind switch
    {
        NotificationKind.Trade => Preferences.NotifyTrades,
        NotificationKind.News => Preferences.NotifyNews,
        _ => Preferences.NotifySystem
    };

    private static string KindLabel(NotificationKind kind) => kind switch
    {
        NotificationKind.Trade => "сделки",
        NotificationKind.News => "новости",
        _ => "система"
    };

    // Счётчик считает по тому же фильтру, что и список: иначе колокольчик
    // показывал бы число, которого в открытом списке не найти.
    private int UnreadNotificationsCount => Visible.Count(entry => !entry.IsRead);

    private string NotificationSummaryText => UnreadNotificationsCount switch
    {
        0 => "Нет новых событий",
        1 => "1 новое событие",
        _ => $"{UnreadNotificationsCount} новых событий"
    };

    protected override void OnInitialized()
    {
        // Имя оператора и переключатели уведомлений живут в настройках, а
        // шапка показывает и то, и другое: без подписки инициалы и счётчик
        // застыли бы на значениях, прочитанных при создании контура.
        Preferences.Changed += HandlePreferencesChanged;
        NotificationFeed.Changed += HandleNotificationsChanged;

        SimulationRunner.OnTick += HandleSimulationTick;

        // После остановки тики прекращаются, поэтому одной подписки на OnTick
        // мало: статус навсегда застывал бы на «Торги активны».
        SimulationRunner.OnStateChanged += HandleStateChanged;
    }

    private void HandleStateChanged() => _ = InvokeAsync(StateHasChanged);

    private void HandlePreferencesChanged() => _ = InvokeAsync(StateHasChanged);

    private void HandleNotificationsChanged() => _ = InvokeAsync(StateHasChanged);

    private void ToggleNotifications()
    {
        IsNotificationsOpen = !IsNotificationsOpen;

        // Открыли список — значит прочитали. Счётчик непрочитанного, который
        // не сбрасывается при просмотре, перестаёт что-либо значить.
        if (IsNotificationsOpen)
        {
            NotificationFeed.MarkAllRead();
        }
    }

    private void CloseNotifications() => IsNotificationsOpen = false;

    private void ClearNotifications() => NotificationFeed.Clear();

    private void HandleSimulationTick(SimulationTickResult tick) => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        SimulationRunner.OnTick -= HandleSimulationTick;
        SimulationRunner.OnStateChanged -= HandleStateChanged;
        Preferences.Changed -= HandlePreferencesChanged;
        NotificationFeed.Changed -= HandleNotificationsChanged;
    }

    private sealed record NavSection(string Key, string Href, string Title);
}
